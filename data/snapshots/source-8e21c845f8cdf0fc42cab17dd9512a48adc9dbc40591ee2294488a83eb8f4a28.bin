    <script>

        function CoveoPANConfig() {
            let token, orgID;
            $.ajax({
              dataType: "json",
              url: '/apps/techdocs/search/legacy',
                  async: false,
              success: function(response) {
                $.each( response, function( key, val ) {
                    if(key === 'cat'){
                      token = val;
                    } else if (key === 'orgId'){
                      orgID = val;
                    }
                  });
              }});
            this.apiKey = token;
            this.orgID = orgID;
        }

        function GoogleTagManagerConfig() {
            let token;
            $.ajax({
              dataType: "json",
              url: '/apps/techdocs/gtm/token',
                  async: false,
              success: function(response) {
                $.each( response, function( key, val ) {
                    if(key === 'token'){
                      token = val;
                    }
                  });
              }});
            this.gtmToken = token;
        }

        function DtmConfig() {
            let js;
            $.ajax({
              dataType: "json",
              url: '/apps/techdocs/dtm/js',
                  async: false,
              success: function(response) {
                $.each( response, function( key, val ) {
                    if(key === 'url'){
                      js = val;
                    }
                  });
              }});
            this.dtmJs = js;
        }

        function UsabillaInPageConfig() {
            let js;
            $.ajax({
              dataType: "json",
              url: '/apps/techdocs/usabilla',
                  async: false,
              success: function(response) {
                $.each( response, function( key, val ) {
                    if(key === 'usabilla'){
                      js = val;
                    }
                  });
              }});
            this.usabillaJS = js;
        }

        let gtm_config = new GoogleTagManagerConfig();

        let coveo_config = window.COVEO_CONFIG;

        if (!coveo_config) {
          coveo_config = new CoveoPANConfig();
        }

				let usabilla_config = new UsabillaInPageConfig();
    </script>

