    <input type="text" id="landing-page-xml" style="display: none;" value="%3C%3Fxml%20version%3D%221.0%22%20encoding%3D%22UTF-8%22%3F%3E%0A%3Clanding-page%20version%3D%222.0%22%3E%0A%20%20%20%3Ctitle%3EAWS%20Key%20Management%20Service%20Documentation%3C%2Ftitle%3E%0A%20%20%20%3Ctitleabbrev%3EAWS%20KMS%3C%2Ftitleabbrev%3E%0A%20%20%20%3Cabstract%3EAWS%20Key%20Management%20Service%20%28AWS%20KMS%29%20is%20an%20encryption%20and%20key%20management%20service%20scaled%20for%20the%20cloud.%20AWS%20KMS%20keys%20and%20functionality%20are%20used%20by%20other%20AWS%20services%2C%20and%20you%20can%20use%20them%20to%20protect%20data%20in%20your%20own%20applications%20that%20use%20AWS.%3C%2Fabstract%3E%0A%20%20%20%3CfeedbackCTI%3EKey%20Management%20Service%20%28KMS%29%3C%2FfeedbackCTI%3E%0A%20%20%20%3Csections%3E%0A%20%20%20%20%20%20%3Csection%20id%3D%22%22%3E%0A%20%20%20%20%20%20%20%20%20%3Ctitle%2F%3E%0A%20%20%20%20%20%20%20%20%20%3Ccards%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Clayout%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccolumns%20xxs%3D%222%22%20m%3D%223%22%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Flayout%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Csimple-card%20href%3D%22%2Fkms%2Flatest%2Fdeveloperguide%2F%22%20guide%3D%22true%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctitle%3EDeveloper%20Guide%3C%2Ftitle%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cabstract%3E%20Provides%20conceptual%20overviews%20of%20AWS%20Key%20Management%20Service%20and%20explains%20how%20to%20use%20it%20to%20protect%20data%20in%20your%20own%20applications%20that%20use%20AWS.%3C%2Fabstract%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cfooter%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fsimple-card%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Csimple-card%20href%3D%22%2Fkms%2Flatest%2FAPIReference%2F%22%20guide%3D%22true%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctitle%3EAPI%20Reference%3C%2Ftitle%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cabstract%3E%20Describes%20in%20detail%20the%20API%20operations%20for%20AWS%20Key%20Management%20Service.%20Also%20provides%20sample%20requests%2C%20responses%2C%20and%20errors%20for%20the%20supported%20web%20services%20protocols.%3C%2Fabstract%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cfooter%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fsimple-card%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Csimple-card%20href%3D%22%2Fcli%2Flatest%2Freference%2Fkms%2Findex.html%22%20guide%3D%22true%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctitle%3EAWS%20KMS%20in%20the%20AWS%20CLI%20Reference%3C%2Ftitle%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cabstract%3E%20Describes%20the%20AWS%20Key%20Management%20Service%20commands%20that%20are%20available%20in%20the%20AWS%20Command%20Line%20Interface.%3C%2Fabstract%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cfooter%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fsimple-card%3E%0A%20%20%20%20%20%20%20%20%20%3C%2Fcards%3E%0A%20%20%20%20%20%20%3C%2Fsection%3E%0A%20%20%20%20%20%20%3Csection%20id%3D%22learn-about-aws-cryptography-services%22%3E%0A%20%20%20%20%20%20%20%20%20%3Ctitle%3ELearn%20About%20AWS%20Cryptography%20Services%3C%2Ftitle%3E%0A%20%20%20%20%20%20%20%20%20%3Cdescription%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cul%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Culink%20type%3D%22marketing%22%20url%3D%22%2Faws-crypto-tools%2F%22%3EAWS%20Crypto%20Tools%3C%2Fulink%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Culink%20type%3D%22marketing%22%20url%3D%22%2Fcloudhsm%2F%22%3EAWS%20CloudHSM%3C%2Fulink%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Culi