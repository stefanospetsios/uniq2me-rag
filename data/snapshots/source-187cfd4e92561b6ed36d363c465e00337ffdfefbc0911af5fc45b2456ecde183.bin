    <script type="module">
      const primer = await window.portal.primer.onReady();
      await primer.components.include('cp-ask-red-hat');

      const cpAsk = document.querySelector('cp-ask-red-hat');
      await cpAsk.updateComplete;

      const askRedHatEndpoints = {
        healthCheckEndpoint: 'https://access.redhat.com/api/ask/v1/health',
        graphqlEndpoint: 'https://graphql.redhat.com',
        href: 'https://access.redhat.com/ask',
      };

      function syncAskRedHatAuth() {
        if (primer.session.isAuthenticated()) {
          cpAsk.authToken = primer.session.getEncodedToken();
          cpAsk.userId = primer.session.getUserInfo().sub;
        } else {
          cpAsk.authToken = undefined;
          cpAsk.userId = undefined;
          sessionStorage.removeItem('ifd-access');
        }
      }

      function configureAskRedHatEndpoints() {
        cpAsk.healthCheckEndpoint = askRedHatEndpoints.healthCheckEndpoint;
        cpAsk.graphqlEndpoint = askRedHatEndpoints.graphqlEndpoint;
        cpAsk.href = askRedHatEndpoints.href;
      }

      function initAskRedHat() {
        syncAskRedHatAuth();
        configureAskRedHatEndpoints();
      }

      primer.session.onInit(initAskRedHat);
      primer.session.on('AuthSuccess', syncAskRedHatAuth);
      primer.session.on('AuthLogout', syncAskRedHatAuth);
    </script>
    

    
