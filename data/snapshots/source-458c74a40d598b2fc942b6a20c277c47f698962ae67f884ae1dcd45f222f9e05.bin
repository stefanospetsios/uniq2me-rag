<script type="text/javascript" id="script18526">
    var windowIsLoaded18526=false;
    var documentIsReady18526=false;

    function setModuleHeight18526() {
        var moduleId=".DnnModule-18526";
        var thisModule=$(moduleId+":first");
        var nextSiblings=thisModule.nextAll(".DnnModule").slice(0,1);
        if(nextSiblings) {
            var height=0;
            nextSiblings.each(function() {
                $(this).css({
                    'overflow': 'auto',
                    'position': 'relative'
                });
                height+=$(this).outerHeight(true);
            });
            var updatedCss={
                "height": height+"px",
                "marginBottom": "-"+height+"px"
            }
            thisModule.find('.pdbg-container').css(updatedCss);
        }
    }

    function pdInit18526() {
        if(windowIsLoaded18526&&documentIsReady18526) {
            setModuleHeight18526();
            window.addEventListener('resize',setModuleHeight18526);

            
        }
    }

    $(document).ready(function() {
        documentIsReady18526=true;
        pdInit18526();
