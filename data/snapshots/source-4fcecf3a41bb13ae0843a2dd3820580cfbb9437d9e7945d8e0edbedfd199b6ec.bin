ent\"\u003e\"address\"\u003c/span\u003e: \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003euser/{userId}/signedup\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e\u003c/span\u003e,\n  \u003cspan class=\"pl-ent\"\u003e\"parameters\"\u003c/span\u003e: {\n    \u003cspan class=\"pl-ent\"\u003e\"userId\"\u003c/span\u003e: {\n      \u003cspan class=\"pl-ent\"\u003e\"description\"\u003c/span\u003e: \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003eId of the user.\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e\u003c/span\u003e,\n      \u003cspan class=\"pl-ent\"\u003e\"location\"\u003c/span\u003e: \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e$message.payload#/user/id\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e\u003c/span\u003e\n    }\n  }\n}\u003c/pre\u003e\u003c/div\u003e\n\n\u003cdiv class=\"highlight highlight-source-yaml notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"address: user/{userId}/signedup\nparameters:\n  userId:\n    description: Id of the user.\n    location: $message.payload#/user/id\"\u003e\u003cpre\u003e\u003cspan class=\"pl-ent\"\u003eaddress\u003c/span\u003e: \u003cspan class=\"pl-s\"\u003euser/{userId}/signedup\u003c/span\u003e\n\u003cspan class=\"pl-ent\"\u003eparameters\u003c/span\u003e:\n  \u003cspan class=\"pl-ent\"\u003euserId\u003c/span\u003e:\n    \u003cspan class=\"pl-ent\"\u003edescription\u003c/span\u003e: \u003cspan class=\"pl-s\"\u003eId of the user.\u003c/span\u003e\n    \u003cspan class=\"pl-ent\"\u003elocation\u003c/span\u003e: \u003cspan class=\"pl-s\"\u003e$message.payload#/user/id\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch4 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e\u003ca name=\"user-content-serverBindingsObject\"\u003e\u003c/a\u003eServer Bindings Object\u003c/h4\u003e\u003ca id=\