    <span class="pl-ent">"address"</span>: {
      <span class="pl-ent">"$ref"</span>: <span class="pl-s"><span class="pl-pds">"</span>#/components/schemas/Address<span class="pl-pds">"</span></span>
    },
    <span class="pl-ent">"age"</span>: {
