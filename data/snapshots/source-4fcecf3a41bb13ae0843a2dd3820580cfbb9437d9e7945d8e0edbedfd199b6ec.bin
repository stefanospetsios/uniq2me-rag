=\"center\"\u003eType\u003c/th\u003e\n\u003cth\u003eDescription\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-oauthflowsimplicit\"\u003e\u003c/a\u003eimplicit\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"#oauthFlowObject\"\u003eOAuth Flow Object\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eConfiguration for the OAuth Implicit flow.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-oauthflowspassword\"\u003e\u003c/a\u003epassword\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"#oauthFlowObject\"\u003eOAuth Flow Object\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eConfiguration for the OAuth Resource Owner Protected Credentials flow.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-oauthflowsclientcredentials\"\u003e\u003c/a\u003eclientCredentials\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"#oauthFlowObject\"\u003eOAuth Flow Object\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eConfiguration for the OAuth Client Credentials flow.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-oauthflowsauthorizationcode\"\u003e\u003c/a\u003eauthorizationCode\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"#oauthFlowObject\"\u003eOAuth Flow Object\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eConfiguration for the OAuth Authorization Code flow.\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003eThis object MAY be extended with \u003ca href=\"#specificationExtensions\"\u003eSpecification Extensions\u003c/a\u003e.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch4 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e\u003ca name=\"user-content-oauthFlowObject\"\u003e\u003c/a\u003eOAuth Flow Object\u003c/h4