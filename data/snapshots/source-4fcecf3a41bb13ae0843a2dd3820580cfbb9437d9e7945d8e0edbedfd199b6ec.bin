03e\u003c/a\u003e\u003ccode\u003emqtt\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"https://github.com/asyncapi/bindings/blob/master/mqtt/README.md#message\"\u003eMQTT Message Binding\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eProtocol-specific information for an MQTT message.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-messagebindingsobjectmqtt5\"\u003e\u003c/a\u003e\u003ccode\u003emqtt5\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"https://github.com/asyncapi/bindings/blob/master/mqtt5/README.md#message\"\u003eMQTT 5 Message Binding\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eProtocol-specific information for an MQTT 5 message.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-messagebindingsobjectnats\"\u003e\u003c/a\u003e\u003ccode\u003enats\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"https://github.com/asyncapi/bindings/blob/master/nats/README.md#message\"\u003eNATS Message Binding\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eProtocol-specific information for a NATS message.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-messagebindingsobjectjms\"\u003e\u003c/a\u003e\u003ccode\u003ejms\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"https://github.com/asyncapi/bindings/blob/master/jms/README.md#message\"\u003eJMS Message Binding\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eProtocol-specific information for a JMS message.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-messagebindingsobjectsns\"\u003e\u003c/a\u003e\u003ccode\u003esns\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"https://github.com/asyncapi/bindings/blob/master/sns/README.md#message\"\u003eSNS Message Binding\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eProtocol-specific information for an SNS message.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-messagebindingsobjectsolace\"\u003e\u003c/a\u003e\u003ccode\u003esolace\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"https://github.com/asyncapi/bindings/blob/master/solace#message\"\u003eSolace Server Binding\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eProtocol-specific information for a Solace message.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-messagebindingsobjectsqs\"\u003e\u003c/a\u003e\u003ccode\u003esqs\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"https://github.com/asyncapi/bindings/blob/master/sqs/README.md#message\"\u003eSQS Message Binding\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eProtocol-specific information for an SQS message.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-messagebindingsobjectstomp\"\u003e\u003c/a\u003e\u003ccode\u003estomp\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"https://github.com/asyncapi/bindings/blob/master/stomp/README.md#message\"\u003eSTOMP Message Binding\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eProtocol-specific information for a STOMP message.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-messagebindingsobjectredis\"\u003e\u003c/a\u003e\u003ccode\u003eredis\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca href=\"https://github.com/asyncapi/bindings/blob/master/redis#message\"\u003eRedis Message Binding\u003c/a\u003e\u003c/td\u003e\n\u003ctd\u003eProtocol-specific information for a Redis message.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ca name=\"user-content-messagebindingsobjectmercure\"\u003e\u003c/a\u003e\u003ccode\u003emercure\u003c/code\u003e\u003c/td\u003e\n\u003ctd align=\"center\"\u003e\u003ca h