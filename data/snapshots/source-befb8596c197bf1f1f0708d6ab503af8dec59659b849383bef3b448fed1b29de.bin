ZZ7%252Fuploads%252Fgit-blob-56f9092e83705384fce4c16bd7d085ef5c5d1a4f%252Fimage.png%3Falt%3Dmedia&amp;width=768&amp;dpr=3&amp;quality=100&amp;sign=6d13047ad9e0e4caaa923de9e7e8c6a1&amp;sv=3 2304w" sizes="(max-width: 640px) 400px, 768px" width="1764" height="424"/></div></div></div></div><h2 id="additional-notes" class="text-xl @xs:text-2xl @lg:text-3xl font-semibold heading font-heading pdf-heading block pr-6 pointer-fine:flex pointer-fine:items-baseline pointer-fine:pr-0 scroll-mt-(--content-scroll-margin) text-start self-start justify-start relative group/hash decoration-primary/6 max-w-3xl w-full print:break-inside-avoid column-first-of-type:pt-0 pt-[1em]" data-heading-reveal-wrapper="true"><span data-cover-aware-text="" class="pointer-fine:flex-1 z-1 justify-self-start max-w-full break-words page-cover-background:text-contrast-cover text-start self-start justify-start leading-tight">Additional Notes</span><span class="hash inline-grid grid-area-1-1 pointer-fine:h-[1em] border-0 opacity-0 pointer-events-none site-background rounded transition-opacity pointer-fine:pointer-events-auto pointer-fine:group-hover/hash:opacity-100 pointer-fine:group-focus-within/hash:opacity-100 [.hash-revealed_&amp;]:opacity-100 [.hash-revealed_&amp;]:pointer-events-auto absolute [transform:translateY(0.125em)] pointer-fine:-ml-6 pointer-fine:relative pointer-fine:order-first pointer-fine:self-center pointer-fine:pr-2 pointer-fine:[transform:none] pointer-fine:[.flip-heading-hash_&amp;]:order-last pointer-fine:[.flip-heading-hash_&amp;]:ml-1 pointer-fine:[.flip-heading-hash_&amp;]:pl-2"><a class="inline-flex items-center p-1 pointer-fine:h-full pointer-fine:p-0 leading-tight" aria-label="Direct link to heading" href="#additional-notes"><svg viewBox="0 0 512 512" fill="currentColor" style="overflow:visible" class="gb-icon self-center transition-colors text-transparent pointer-fine:group-hover/hash:text-tint-subtle contrast-more:pointer-fine:group-hover/hash:text-tint-strong pointer-fine: