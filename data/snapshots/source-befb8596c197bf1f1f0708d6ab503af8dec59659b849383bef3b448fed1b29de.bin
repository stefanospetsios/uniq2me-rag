com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-65a1a1082b60c75a31661e901a76d8008f2b32e5%252Fimage.png%3Falt%3Dmedia&amp;width=768&amp;dpr=3&amp;quality=100&amp;sign=64285b4f7f3023a479ff6ce39fe9b934&amp;sv=3 2304w" sizes="(max-width: 640px) 400px, 768px" width="2524" height="1132"/></div></div></div></div><h2 id="repositories" class="text-xl @xs:text-2xl @lg:text-3xl font-semibold heading font-heading pdf-heading block pr-6 pointer-fine:flex pointer-fine:items-baseline pointer-fine:pr-0 scroll-mt-(--content-scroll-margin) text-start self-start justify-start relative group/hash decoration-primary/6 max-w-3xl w-full print:break-inside-avoid column-first-of-type:pt-0 pt-[1em]" data-heading-reveal-wrapper="true"><span data-cover-aware-text="" class="pointer-fine:flex-1 z-1 justify-self-start max-w-full break-words page-cover-background:text-contrast-cover text-start self-start justify-start leading-tight">Repositories</span><span class="hash inline-grid grid-area-1-1 pointer-fine:h-[1em] border-0 opacity-0 pointer-events-none site-background rounded transition-opacity pointer-fine:pointer-events-auto pointer-fine:group-hover/hash:opacity-100 pointer-fine:group-focus-within/hash:opacity-100 [.hash-revealed_&amp;]:opacity-100 [.hash-revealed_&amp;]:pointer-events-auto absolute [transform:translateY(0.125em)] pointer-fine:-ml-6 pointer-fine:relative pointer-fine:order-first pointer-fine:self-center pointer-fine:pr-2 pointer-fine:[transform:none] pointer-fine:[.flip-heading-hash_&amp;]:order-last pointer-fine:[.flip-heading-hash_&amp;]:ml-1 pointer-fine:[.flip-heading-hash_&amp;]:pl-2"><a class="inline-flex items-center p-1 pointer-fine:h-full pointer-fine:p-0 leading-tight" aria-label="Direct link to heading" href="#repositories"><svg viewBox="0 0 512 512" fill="currentColor" style="overflow:visible" class="gb-icon self-center transition-colors text-transparent pointer-fine:group-hover/hash:text-tint-subtle contrast-more:pointer-fine:group-hover/hash:text-tint-strong pointer-fine:group-focus-within/hash:text-tint-subtle contrast-more:pointer-fine:group-focus-within/hash:text-tint-strong [.hash-revealed_&amp;]:text-tint-subtle contrast-more:[.hash-revealed_&amp;]:text-tint-strong size-4"><path fill="currentColor" d="M202.2 .4c8.6 1.9 14.1 10.4 12.3 19L191.2 128 375.8 128 400.5 12.6c1.9-8.6 10.4-14.1 19-12.3s14.1 10.4 12.3 19L408.5 128 496 128c8.8 0 16 7.2 16 16s-7.2 16-16 16l-94.4 0-41.1 192 87.5 0c8.8 0 16 7.2 16 16s-7.2 16-16 16l-94.4 0-24.7 115.4c-1.8 8.6-10.4 14.1-19 12.3s-14.1-10.4-12.3-19l23.3-108.7-184.6 0-24.7 115.4c-1.9 8.6-10.4 14.1-19 12.3s-14.1-10.4-12.3-19L103.6 384 16 384c-8.8 0-16-7.2-16-16s7.2-16 16-16l94.5 0 41.1-192-87.6 0c-8.8 0-16-7.2-16-16s7.2-16 16-16l94.5 0 24.7-115.4c1.9-8.6 10.4-14.1 19-12.3zM184.4 160l-41.1 192 184.6 0 41.1-192-184.6 0z"/></svg></a></span></h2><div class="hint transition-colors rounded-corners:rounded-md circular-corners:rounded-xl overflow-hidden bg-warning border-warning text-sm grid grid-cols-[auto_1fr] decoration-primary/6 max-w-3xl w-full print:break-inside-avoid" aria-label="Warning" role="note"><div class="py-4 pl-4 text-warning-subtle contrast-more:text-warning"><svg viewBox="0 0 512 512" fill="currentColor" style="overflow:visible" class="gb-icon size-[1.2em] mt-px leading-normal"><path fill="currentColor" d="M256 512a256 256 0 1 1 0-512 256 256 0 1 1 0 512zm0-480a224 224 0 1 0 0 448 224 224 0 1 0 0-448zm0 352a24 24 0 1 1 0-48 24 24 0 1 1 0 48zm0-256c13.5 0 24.3 11.4 23.5 24.9l-7.6 136c-.5 8.5-7.5 15.1-16 15.1s-15.5-6.6-16-15.1l-7.6-136c-.8-13.5 10-24.9 23.5-24.9z"/></svg></div><div class="p-4 pl-3 empty:p-0 -row-end-1 -col-end-1 min-w-0 space-y-3 [&amp;_.hint]:border [&amp;_pre]:border [&amp;_pre]:border-neutral"><div data-ask-ai-paragraph="" class="group/ask-ai relative max-w-3xl w-full print:break-inside-avoid text-neutral-strong links-default:[&amp;_a:not(.button)]:text-warning links-default:[&amp;_a:not(.button):hover]:text-warning-strong links-default:[&amp;_a:not(.button)]:decoration-warning/6 links-accent:[&amp;_a:not(.button)]:decoration-warning decoration-warning/6 [&amp;_.can-override-bg]:bg-warning-active [&amp;_.can-override-text]:text-warning-strong flip-heading-hash text-start self-start justify-start"><p data-cover-aware-text="" class="paragraph max-w-3xl w-full print:break-inside-avoid text-neutral-strong links-default:[&amp;_a:not(.button)]:text-warning links-default:[&amp;_a:not(.button):hover]:text-warning-strong links-default:[&amp;_a:not(.button)]:decoration-warning/6 links-accent:[&amp;_a:not(.button)]:decoration-warning decoration-warning/6 [&amp;_.can-override-bg]:bg-warning-active [&amp;_.can-override-text]:text-warning-strong flip-heading-hash text-start self-start justify-start"><strong class="font-bold">Unlock White-Box Testing</strong>
Without source code, the system scans blind. Connecting your repositories upgrades the test from external guessing to internal verification.</p></div></div></div><div data-ask-ai-paragraph="" class="group/ask-ai relative decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start"><p data-cover-aware-text="" class="paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start">Connecting your repositories is the single most impactful step you can take. Instead of just poking at endpoints from the outside, the system analyzes the actual source code to understand how the application processes data.</p></div><ul class="min-w-0 space-y-2 decoration-primary/6 max-w-3xl w-full"><li class="leading-normal flex items-start"><div class="text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint"><div class="before:content-(--pseudoBefore--content) before:font-var" style="--pseudoBefore--content:&#x27;•&#x27;;--font-family:Arial;font-size:min(1.5em, 24px);line-height:1"></div></div><div class="flex min-w-0 flex-1 flex-col space-y-2"><div data-ask-ai-paragraph="" class="group/ask-ai relative decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start"><p data-cover-aware-text="" class="paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start"><strong class="font-bold">Why it matters:</strong> It finds deep-logic vulnerabilities that external scanning simply cannot see.</p></div></div></li><li class="leading-normal flex items-start"><div class="text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint"><div class="before:content-(--pseudoBefore--content) before:font-var" style="--pseudoBefore--content:&#x27;•&#x27;;--font-family:Arial;font-size:min(1.5em, 24px);line-height:1"></div></div><div class="flex min-w-0 flex-1 flex-col space-y-2"><div data-ask-ai-paragraph="" class="group/ask-ai relative decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start"><p data-cover-aware-text="" class="paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start"><strong class="font-bold">What to select:</strong> Include all repos involved in the scope (Frontend, Backend, IaC).</p></div><ul class="min-w-0 space-y-2 decoration-primary/6 max-w-3xl w-full min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0"><li class="leading-normal flex items-start"><div class="text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint"><div class="before:content-(--pseudoBefore--content) before:font-var" style="--pseudoBefore--content:&#x27;◦&#x27;;--font-family:Arial;font-size:min(1.5em, 24px);line-height:1"></div></div><div class="flex min-w-0 flex-1 flex-col space-y-2"><div data-ask-ai-paragraph="" class="group/ask-ai relative decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start"><p data-cover-aware-text="" class="paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start">You can connect a maximum of 20 repositories per pentest. This limit keeps the pentest focused on a single application. Overloading the scope with unrelated services can dilute the depth of the analysis.</p></div></div></li><li class="leading-normal flex items-start"><div class="text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint"><div class="before:content-(--pseudoBefore--content) before:font-var" style="--pseudoBefore--content:&#x27;◦&#x27;;--font-family:Arial;font-size:min(1.5em, 24px);line-height:1"></div></div><div class="flex min-w-0 flex-1 flex-col space-y-2"><div data-ask-ai-paragraph="" class="group/ask-ai relative decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start"><p data-cover-aware-text="" class="paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start"><strong class="font-bold">Need more?</strong> If your application relies on more than 20 repositories, reach out to our support team and we can increase the limit for your specific use case.</p></div></div></li></ul></div></li><li class="leading-normal flex items-start"><div class="text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint"><div class="before:content-(--pseudoBefore--content) before:font-var" style="--pseudoBefore--content:&#x27;•&#x27;;--font-family:Arial;font-size:min(1.5em, 24px);line-height:1"></div></div><div class="flex min-w-0 flex-1 flex-col space-y-2"><div data-ask-ai-paragraph="" class="group/ask-ai relative decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start"><p data-cover-aware-text="" class="paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start"><strong class="font-bold">The result:</strong> The system maps your routes and logic directly from the source. It doesn&#x27;t need to guess your API structure, it reads it.</p></div></div></li></ul><div class="decoration-primary/6 max-w-3xl layout-wide:max-w-6xl mx-auto print:break-inside-avoid flex w-full justify-center"><div class="flex flex-row gap-3"><div class="relative overflow-hidden"><div class="relative overflow-hidden after:block after:absolute after:-inset-0 after:pointer-events-none w-fit"><img data-testid="zoom-image" alt="" style="max-width:100%;height:auto" loading="lazy" class="block rounded-corners:rounded-sm circular-corners:rounded-2xl" src="https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-9572bd199f424d88f02ce965d784dd68b8d02a89%252Fimage.png%3Falt%3Dmedia&amp;width=768&amp;dpr=3&amp;quality=100&amp;sign=beb3f83f79deb6876ddb8ab82b6b7e84&amp;sv=3" srcSet="https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-9572bd199f424d88f02ce965d784dd68b8d02a89%252Fimage.png%3Falt%3Dmedia&amp;width=400&amp;dpr=1&amp;quality=100&amp;sign=beb3f83f79deb6876ddb8ab82b6b7e84&amp;sv=3 400w, https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-9572bd199f424d88f02ce965d784dd68b8d02a89%252Fimage.png%3Falt%3Dmedia&amp;width=400&amp;dpr=2&amp;quality=100&amp;sign=beb3f83f79deb6876ddb8ab82b6b7e84&amp;sv=3 800w, https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-9572bd199f424d88f02ce965d784dd68b8d02a89%252Fimage.png%3Falt%3Dmedia&amp;width=400&amp;dpr=3&amp;quality=100&amp;sign=beb3f83f79deb6876ddb8ab82b6b7e84&amp;sv=3 1200w, https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-9572bd199f424d88f02ce965d784dd68b8d02a89%252Fimage.png%3Falt%3Dmedia&amp;width=768&amp;dpr=1&amp;quality=100&amp;sign=beb3f83f79deb6876ddb8ab82b6b7e84&amp;sv=3 768w, https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-9572bd199f424d88f02ce965d784dd68b8d02a89%252Fimage.png%3Falt%3Dmedia&amp;width=768&amp;dpr=2&amp;quality=100&amp;sign=beb3f83f79deb6876ddb8ab82b6b7e84&amp;sv=3 1536w, https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-9572bd199f424d88f02ce965d784dd68b8d02a89%252Fimage.png%3Falt%3Dmedia&amp;width=768&amp;dpr=3&amp;quality=100&amp;sign=beb3f83f79deb6876ddb8ab82b6b7e84&amp;sv=3 2304w" sizes="(max-width: 640px) 400px, 768px" width="1762" height="508"/></div></div></div></div><h3 id="exclude-paths-from-a-repository" class="text-lg @xs:text-xl @lg:text-2xl font-semibold heading font-heading pdf-heading block pr-6 pointer-fine:flex pointer-fine:items-baseline pointer-fine:pr-0 scroll-mt-(--content-scroll-margin) text-start self-start justify-start relative group/hash decoration-primary/6 max-w-3xl w-full print:break-inside-avoid column-first-of-type:pt-0 pt-[0.75em]" data-heading-reveal-wrapper="true"><span data-cover-aware-text="" class="pointer-fine:flex-1 z-1 justify-self-start max-w-full break-words page-cover-background:text-contrast-cover text-start self-start justify-start leading-snug">Exclude paths from a repository</span><span class="hash inline-grid grid-area-1-1 pointer-fine:h-[1em] border-0 opacity-0 pointer-events-none site-background rounded transition-opacity pointer-fine:pointer-events-auto pointer-fine:group-hover/hash:opacity-100 pointer-fine:group-focus-within/hash:opacity-100 [.hash-revealed_&amp;]:opacity-100 [.hash-revealed_&amp;]:pointer-events-auto absolute [transform:translateY(0.17em)] pointer-fine:-ml-6 pointer-fine:relative pointer-fine:order-first pointer-fine:self-center pointer-fine:pr-2 pointer-fine:[transform:none] pointer-fine:[.flip-heading-hash_&amp;]:order-last pointer-fine:[.flip-heading-hash_&amp;]:ml-1 pointer-fine:[.flip-heading-hash_&amp;]:pl-2"><a class="inline-flex items-center p-1 pointer-fine:h-full pointer-fine:p-0 leading-snug" aria-label="Direct link to heading" href="#exclude-paths-from-a-repository"><svg viewBox="0 0 512 512" fill="currentColor" style="overflow:visible" class="gb-icon self-center transition-colors text-transparent pointer-fine:group-hover/hash:text-tint-subtle contrast-more:pointer-fine:group-hover/hash:text-tint-strong pointer-fine:group-focus-within/hash:text-tint-subtle contrast-more:pointer-fine:group-focus-within/hash:text-tint-strong [.hash-revealed_&amp;]:text-tint-subtle contrast-more:[.hash-revealed_&amp;]:text-tint-strong size-4"><path fill="currentColor" d="M202.2 .4c8.6 1.9 14.1 10.4 12.3 19L191.2 128 375.8 128 400.5 12.6c1.9-8.6 10.4-14.1 19-12.3s14.1 10.4 12.3 19L408.5 128 496 128c8.8 0 16 7.2 16 16s-7.2 16-16 16l-94.4 0-41.1 192 87.5 0c8.8 0 16 7.2 16 16s-7.2 16-16 16l-94.4 0-24.7 115.4c-1.8 8.6-10.4 14.1-19 12.3s-14.1-10.4-12.3-19l23.3-108.7-184.6 0-24.7 115.4c-1.9 8.6-10.4 14.1-19 12.3s-14.1-10.4-12.3-19L103.6 384 16 384c-8.8 0-16-7.2-16-16s7.2-16 16-16l94.5 0 41.1-192-87.6 0c-8.8 0-16-7.2-16-16s7.2-16 16-16l94.5 0 24.7-115.4c1.9-8.6 10.4-14.1 19-12.3zM184.4 160l-41.1 192 184.6 0 41.1-192-184.6 0z"/></svg></a></span></h3><div data-ask-ai-paragraph="" class="group/ask-ai relative decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start"><p data-cover-aware-text="" class="paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start">For monorepos, click <strong class="font-bold">Exclude Paths</strong> next to a selected repository and exclude specific directories to keep the pentest focused on the services in scope. Excluded paths are also removed from the <strong class="font-bold">Rightsized</strong> credit estimate, so the recommended amount only reflects the code being tested.</p></div><div class="hint transition-colors rounded-corners:rounded-md circular-corners:rounded-xl overflow-hidden bg-info border-info theme-muted-tint:bg-info-solid/2 [html.sidebar-filled.theme-bold.tint_&amp;]:bg-info-solid/2 text-sm grid grid-cols-[auto_1fr] decoration-primary/6 max-w-3xl w-full print:break-inside-avoid" aria-label="Information" role="note"><div class="py-4 pl-4 text-info-subtle contrast-more:text-info"><svg viewBox="0 0 512 512" fill="currentColor" style="overflow:visible" class="gb-icon size-[1.2em] mt-px leading-normal"><path fill="currentColor" d="M256 32a224 224 0 1 1 0 448 224 224 0 1 1 0-448zm0 480a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM208 352c-8.8 0-16 7.2-16 16s7.2 16 16 16l96 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-32 0 0-112c0-8.8-7.2-16-16-16l-48 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l32 0 0 96-32 0zm48-168a24 24 0 1 0 0-48 24 24 0 1 0 0 48z"/></svg></div><div class="p-4 pl-3 empty:p-0 -row-end-1 -col-end-1 min-w-0 space-y-3 [&amp;_.hint]:border [&amp;_pre]:border [&amp;_pre]:border-neutral"><div data-ask-ai-paragraph="" class="group/ask-ai relative decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-neutral-strong [&amp;_.can-override-bg]:bg-neutral-active [&amp;_.can-override-text]:text-neutral-strong flip-heading-hash text-start self-start justify-start"><p data-cover-aware-text="" class="paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-neutral-strong [&amp;_.can-override-bg]:bg-neutral-active [&amp;_.can-override-text]:text-neutral-strong flip-heading-hash text-start self-start justify-start">Only files that meaningfully impact your attack surface are counted toward the estimate. Excluding images, documentation, READMEs, or other non-code assets won&#x27;t lower the credit estimate, and we recommend against it. Aikido uses these as context to better understand your application, which improves the quality of the pentest. Exclude unrelated services or applications instead.</p></div></div></div><div class="decoration-primary/6 max-w-3xl layout-wide:max-w-6xl mx-auto print:break-inside-avoid flex w-full justify-center"><div class="flex flex-row gap-3 rounded-2xl border border-[rgb(234,235,238)] dark:border-[rgb(45,50,58)] relative overflow-hidden w-fit"><div class="relative overflow-hidden"><div class="relative overflow-hidden after:block after:absolute after:-inset-0 after:pointer-events-none w-fit p-2"><img data-testid="zoom-image" alt="Exclude Paths button next to a selected repository" style="max-width:100%;height:auto" loading="lazy" class="block rounded-xl" src="https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-738e8311f3af420f58e748dbfdaff91da6576561%252Fexclude-repository-paths.png%3Falt%3Dmedia&amp;width=768&amp;dpr=3&amp;quality=100&amp;sign=e56ac490abdea28d8042ba32c0f9d193&amp;sv=3" srcSet="https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-738e8311f3af420f58e748dbfdaff91da6576561%252Fexclude-repository-paths.png%3Falt%3Dmedia&amp;width=400&amp;dpr=1&amp;quality=100&amp;sign=e56ac490abdea28d8042ba32c0f9d193&amp;sv=3 400w, https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%252Fgit-blob-738e8311f3af420f58e748dbfdaff91da6576561%252Fexclude-repository-paths.png%3Falt%3Dmedia&amp;width=400&amp;dpr=2&amp;quality=100&amp;sign=e56ac490abdea28d8042ba32c0f9d193&amp;sv=3 800w, https://help.aikido.dev/~gitbook/image?url=https%3A%2F%2F3149773201-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252FyKbzcQGrx7UtrG0nPZZ7%252Fuploads%