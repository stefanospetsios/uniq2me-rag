  position: relative;
  height: auto;
}

.modal-close {
  position: absolute;
  top: 8px;
  right: 12px;
  border: none;
  background: none;
  font-size: 30px;
  cursor: pointer;
}

.st-trust-tabs-wrap {
    background: #f5f5f5;
    -webkit-box-shadow: inset 1px -2px 10px rgba(0, 0, 0, 0.1);
    box-shadow: inset 1px -2px 10px rgba(0, 0, 0, 0.1);
    position: relative;
    text-align: center;
    z-index: 121;
}

body {
    margin: 0;
}

.st-trust-tabs-wrap {display: flex;margin: auto;justify-content: center;gap: 20px;}

.st-trust-tabs {
    max-width: 1053px;
    text-align: center;
    justify-content: flex-start;
}

.st-tabs-tab {
    cursor: pointer;
    color: #666;
    position: relative;
    width: 100%;
    min-width: fit-content;
}

span.st-tabs-tab-headline {
    display: inline-block;
    font-size: 14px;
    height: 100%;
    justify-content: center;
    line-height: 24px;
    font-family: Arial;
    padding: 15px 12px 15px;
    position: relative;
    transition: all .3s;
    white-space: nowrap;
}

.st-trust-tab-item.active  span.st-tabs-tab-headline {
    color: #3cb4e6;
    text-shadow: 0.5px 0 0 #3cb4e6;
    -webkit-transition: all .2s;
    transition: all .2s;
}



.st-trust-tab-item.active .st-tabs-tab {
    background-color: #f5f5f5;
    padding: 0 8px;
}

.section.tab-content {
    max-width: 1040px;
    margin: 50px auto;
}

.st-trust-tab-item {
    display: flex;
    /* padding: 0 8px; */
}

.inner-tabs {
    display: inline-flex;
    gap: 10px;
    border-bottom: 1px solid #dfdfdf;
    width: 100%;
    margin-bottom: 25px;
    margin-top: 50px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
}

button.inner-st-trust-tab-item.active,
button.inner-st-trust-tab-item:hover {
    color: #0047b2;
    border-bottom: 2px solid;
    margin-bottom: -1px;
}

button.inner-st-trust-tab-item {
    background: transparent;
    outline: 0;
    border: 0;
    color: #03234b;
    font-size: 15px;
    font-weight: bold;
    padding: 8px;
    cursor: pointer;
    margin: 0;
}

.inner-tab-content {
    display: none;
}

.inner-tab-content.active {
    display: flex;
    flex-wrap:wrap;
}

a.card svg {
    max-width: 110px;
}

a.card h4 {
    font-family: Arial;
    font-size: 15px;
    color: #03234b;
    margin-top: 5px;
}

a.card:hover h4 {
    color: #0047b2;
}

.tab-back {
    font-family: Arial;
    color: #03234b;
    font-size: 18px;
    cursor: pointer;
    font-weight: bold;
    margin-bottom: 50px;
}

.tab-back svg {
    width: 25px;
    height: 13px;
    fill: #03234b;
    transform: rotate(180deg);
    margin-right: 10px;
}

.trust-grid-mosaic[hidden] {
    display: none;
}

a.card:hover svg g {
    fill: #0047b2 !important;
}

.modal-content h2 {
    margin-top: 0;
}

.standard-table-content thead {
    height: 88px;
    background: var(--Neutral-Grey-0---White, #FFF);
    box-shadow: inset 0 -2px 0 #3cb4e6, inset 0 1px var(--neutral-grey-3-disabled-border, #dbdee2);
}

.standard-table-content th {
    height: 88px;
    padding: 24px;
    text-align: left;
    color: #525a63;
    font-size: 14px;
    font-weight: bold;
    font-family: Arial;
}

.standard-table-content tbody td {
    padding: 24px;
    font-family: Arial;
    color: #525a63;
    font-size: 14px;
    line-height: 28px;
}

.standard-table-content tbody tr {
    transition: all .25s ease-in-out;
    border-bottom: 1px solid var(--neutral-grey-3-disabled-border-divider, #dbdee2);
    background: var(--Neutral-Grey-0---White, #FFF);
}

.standard-table-content table {
    border-collapse: collapse;
}

.map-wrap {
    margin: 50px 0;
}

.standard-table-content tbody td:first-child {
    font-weight: bold;
}

.neias-campaign-banner-imagewrap {
    display: block;
    position: relative;
}

.neias-campaign-banner-imagewrap img {
    width: 100%;
    object-position: center;
}

.neias-campaign-banner-overlayedcontent {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.neias-campaign-banner-overlay-text h1 {
    font-size: 80px;
    font-family: 'LubalinGraphStd-Medium';
    font-weight: 100;
}

.large-12.columns {
    padding: 0;
}

.row.st-row {
    max-width: unset;
}

.st-breadcrumbs+.st-container {
    padding: 0;
}

.st-breadcrumbs {
    display: none;
}

.st-long-commercial-banner--slider {
    max-width: 1080px;
    margin: auto;
}

.tab-back:hover,
.tab-back:hover svg{
    color: #0047b2;
    fill: #0047b2;
}

.section.tab-content .modal-content button.modal-close {
    background: transparent;
    color: #032;
    margin: 0;
    padding: 10px;
}

.st-selected-files-overlay {
    top: -15px;
}

table.resourcetable.simple-table-layout thead td {
    font-size: 10px;
    border: 0 !important;
    padding-bottom: 0;
}

.st-selected-files-overlay span {
    margin-right: 10px;
}

.fade-in {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.8s ease-out, transform 0.8s ease-out;
}

.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

button.modal-close {
    background: transparent !important;
    color: #000 !important;
    padding: 10px;
    margin: 0 !important;
}

.section p, 
.section ul {
    color: #03234b;
    font-size: 18px;
    line-height: 32px;
    font-family: Arial;
    width: 100%;
}

.section h2 {
    color: #3cb4e6;
    font-family: 'LubalinGraphStd-Medium';
    font-weight: normal;
    font-size: 22px;
}

.modal-content h2 {
    font-size: 22px;
    font-family: 'LubalinGraphStd-Medium';
    font-weight: normal;
}

.modal-content p {
    font-size: 16px;
    line-height: 28px;
}

.modal-content {
    padding: 50px;
}

.standard-table-content td {
    font-size: 15px;
}

.small-12.columns h2 {
    font-size: 15px;
    color: #555;
    font-family: Arial;
    font-weight: bold;
}

table tbody tr:first-child>td {
    border-top: 1px solid #3cb4e6;
}

.stm32-trainings td {
    padding: 20px 15px;
}

.stm32-trainings td a {
    color: #03234b;
    font-weight: bold;
    font-family: Arial;
    font-size: 15px;
    display: block;
}

.stm32-trainings td a:after {
    content:"";
      position:absolute;
      width:8px;
      height:8px;
      border-top:2px solid #03234b;
      border-right:2px solid #03234b;
      transform:rotate(45deg);
    top: 8px;
    right: 0;
}

.stm32-trainings td a:hover:after{
      border-top:2px solid #3cb4e6;
      border-right:2px solid #3cb4e6;
}

.stm32-trainings td a:hover {
    color: #3cb4e6;
}

.stm32trust-training-container,
table.percent100.no-footer.stm32trust-producttable.simple-table-layout {
    background: #fff;
}

circle.active {
    fill: #ffd200;
}

.swipe-hint,
.neias-campaign-banner-image-mobile {
    display: none;
}

ul.grey-section-list li {
    color: #777;
}

.st-table--boxed table:not(.ui-datepicker-calendar) td {
    background: #fff;
}

.partners-cta-wrap {
    margin: 30px auto;
    text-align: center;
}

.partners-cta-wrap a {
    background: #03234b;
    color: #fff;
    padding: 14px 30px;
    border-radius: 8px 0px;
    font-size: 18px;
}

ul.list-nested {
    margin-top: -20px;
}

.section a:hover {
    text-decoration: none !important;
}

button.modal-close {
    text-decoration: none !important;
}

button.inner-st-trust-tab-item:hover,
button.inner-st-trust-tab-item.active{
    text-decoration: none !important;
}

.partners-cta-wrap a:hover {
    background: #042e62;
}

@media (max-width: 1024px) {
    .section {
        padding: 0 20px;
        width: 100%;
    }

    .neias-campaign-banner-image-mobile {
        display: block;
    }

    .section h2 {
        font-size: 18px;
    }

    .neias-campaign-banner-overlay-text h1 {
        font-size: 36px;
    }

    img.neias-campaign-banner-image-desktop.lazyloaded {
        display: none;
    }

    .section p, .section ul {
        font-size: 16px;
    }

    .trust-grid-mosaic {
        grid-template-columns: repeat(1, minmax(150px, 1fr));
    }

    .trust-grid-mosaic-box {
        height: 150px;
    }

    .trust-grid-mosaic-box img {
        display: inline-block;
    }

    .trust-grid-mosaic-box svg {
        position: absolute;
        bottom: 20px;
        right: 50px;
    }

    .trust-grid-mosaic-box .content {
        max-width: 300px;
        padding-right: 0;
        bottom: 50%;
        transform: translate(0%, 50%);
    }

    .trust-grid-mosaic-box .content p {
        display: none;
    }

    .js-st-micro.stmicro.cxv1 .st-container:not(.st-container--keep-padding) > .row > .large-12 {
        background-size: 400px auto;
    }

    .trust-grid-mosaic-box h3 {
        margin: 0;
    }

    .map-wrap {
        overflow-x: scroll;
    }

    .simple-table-layout td {
        display: table-cell;
    }

    .st-table--small.st-table--boxed.show-for-small-only {
        padding: 0 20px;
    }

    .scroll-wrapper {
        position: relative;
    }

    .map-wrap {
        overflow-x: auto;
        white-space: nowrap;
    }

    .swipe-hint {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        padding: 6px 10px;
        font-size: 12px;
        color: #03234b;
        background: rgba(255, 255, 255, 0.9);
        pointer-events: none;
        opacity: 0;
        transition: opacity .3s ease;
        display: flex;
        border: 1px solid #dfdfdf;
        justify-content: center;
        align-items: center;
    }

    .swipe-hint.visible {
        opacity: 1;
    }

    .swipe-hint.visible {
        animation: swipe-bounce 3s infinite;
    }

    @keyframes swipe-bounce {
        0%   { transform: translateY(-50%) translateX(0); }
        10%  { transform: translateY(-50%) translateX(-10px); }
        20%  { transform: translateY(-50%) translateX(0); }

        35%  { transform: translateY(-50%) translateX(-10px); }
        45%  { transform: translateY(-50%) translateX(0); }

        100% { transform: translateY(-50%) translateX(0); }
    }
}

.stm32-secfunctional-container {
    padding: 10px;
    background: #fff;
    position: relative;
    height: auto;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.stm32-secfunctional-container > p {
    width: 100%;
    flex: 0 0 100%;
}

.stm32-secfunctional-container .columns * {
    font-size: 14px;
    margin: 0;
    line-height: 18px;
}

.stm32-secfunctional-container .columns p {
    margin-bottom: 15px;
}
