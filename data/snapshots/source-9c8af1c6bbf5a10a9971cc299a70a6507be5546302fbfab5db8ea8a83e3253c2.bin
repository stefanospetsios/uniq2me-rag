    border: 0px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .12);
    cursor: pointer;
    display: flex;
    padding: 2px 8px;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background .18s, border-color .18s, opacity .25s, transform .18s;
