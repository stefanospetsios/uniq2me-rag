count" id="Top_Menu_Login_Aside" data-activitymap-region="Login"> <ul class="off-canvas-list "> <li> <label> <svg class="st-svg st-svg--user" alt="Icon-user logo" aria-hidden="true"> <use xlink:href="#icon-user"></use> </svg> My Account <svg class="st-svg--block st-svg--close js-nav-bottom-off-canvas-close" alt="Icon-close logo" aria-hidden="true"> <use xlink:href="#icon-close"></use> </svg> </label> </li> <li> <a href="/content/my_st_com/en/my-space/my-preferences.html" onclick="s_objectID=this.dataset['activitymapText'];" data-activitymap-text="My Space"> My Space </a> </li> <li> <a href="/content/my_st_com/en/my-space/manage-my-account/Update_My_Profile.html" onclick="s_objectID=this.dataset['activitymapText'];" data-activitymap-text="My Account"> My Account </a> </li> <li> <a href="#" class="js-cas-logout" onclick="s_objectID=this.dataset['activitymapText'];" data-activitymap-text="Logout"> Logout </a> <!-- Logout is delegated to the backend logout servlet via a same-origin POST. The resource selects the SAML login endpoint: /cas/login_zh for Chinese, /cas/login_ja for Japanese, /cas/login otherwise (STM-42209). --> <form class="js-cas-logout-form" action="/bin/st/cas_logout" method="post" hidden> <input type="hidden" name="resource" value="/cas/login"/> </form> </li> </ul> </aside> <script>
        (function () {
            var links = document.querySelectorAll('a.js-cas-logout:not([data-cas-logout-init])');
            for (var i = 0; i < links.length; i++) {
                var link = links[i];
                link.setAttribute('data-cas-logout-init', 'true');
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    var form = this.parentNode.querySelector('form.js-cas-logout-form');
                    if (form) {
                        form.submit();
                    }
                });
            }
        })();
