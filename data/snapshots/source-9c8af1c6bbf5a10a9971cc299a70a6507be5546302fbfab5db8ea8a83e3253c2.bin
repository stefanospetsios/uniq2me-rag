  }
  .tabs-arrow:hover {
    background: #2563eb;
    border-color: #2563eb;
  }
  .tabs-arrow:hover svg { stroke: #fff; }
  .tabs-arrow.hidden {
    opacity: 0;
    pointer-events: none;
  }
  .tabs-arrow--left  { left: 0px; }
  .tabs-arrow--right { right: -30px; }
  .tabs-arrow svg { stroke: #6b7280; transition: stroke .18s; }

  /* ── Fade sui bordi ── */
  .st-trust-tabs-container::before,
  .st-trust-tabs-container::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 44px;
    z-index: 5;
    pointer-events: none;
    transition: opacity .3s;
  }
  .st-trust-tabs-container::before {
    left: 0px;
    background: linear-gradient(to right, rgba(255,255,255,.95), transparent);
  }
  .st-trust-tabs-container::after {
    right: 0px;
    background: linear-gradient(to left, rgba(255,255,255,.95), transparent);
  }
  .st-trust-tabs-container.at-start::before { opacity: 0; }
  .st-trust-tabs-container.at-end::after   { opacity: 0; }

  @media(max-width: 1024px){
    .tabs-arrow--right {
    right: -10px;
}
  }

