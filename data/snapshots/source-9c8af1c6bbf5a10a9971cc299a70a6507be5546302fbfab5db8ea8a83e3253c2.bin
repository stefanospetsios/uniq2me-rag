[data-tab-content] {
  display: none;
}
[data-tab-content]:not([hidden]) {
  display: block;
}

.st-nav-tabs {
    margin-top: 0;
}

.st-tabs-tab a {
    color: #666 !important;
}

.js-st-active a,
.st-tabs-tab a:hover {
    color: #3cb4e6 !important;
}

.st-trust-tabs {
    display: flex;
}

.st-trust-tab-item.st-tab-active .st-tabs-tab {
    background: #fff;
}

.st-trust-tab-item.st-tab-active .st-tabs-tab .st-tabs-tab-headline {
    color: #3cb4e6;
    text-shadow: 0.5px 0 0 #3cb4e6;
    -webkit-transition: all .2s;
    transition: all .2s;
}

.st-trust-tab-item.st-tab-active,
.st-trust-tab-item:hover {
    background-color: #f5f5f5;
    -webkit-box-shadow: 0 2px 10px 5px rgb(0 0 0 / 10%);
    box-shadow: 0 2px 10px 5px rgb(0 0 0 / 10%);
}

.st-trust-tabs {
    overflow-x: scroll;
    overflow-y: hidden;
    scroll-behavior: unset;
    -ms-overflow-style: none;
    scrollbar-width: none;
}

h1,h2,h3 {
    color: #03234b;
    font-family: Arial;
}

.section p {
    color: #74757c;
    font-size: 16px;
    line-height: 1.5;
    font-family: Arial;
}

.trust-grid-mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(150px, 1fr));
    overflow: hidden;
    gap: 20px;
    margin-bottom: 80px;
}

.trust-grid-mosaic-box {
    display: flex;
    height: 340px;
    position: relative;
    transition: all 0.2s linear;
    cursor: pointer;
    background: #03234b;
    width: 100%;
}

.trust-grid-mosaic-box img {
    transition: all 0.1s linear;
    display: block;
    height: auto;
    width: 100%;
    object-fit: cover;
    filter: brightness(0.6);
}

.trust-grid-mosaic-box .content {
    position: absolute;
    bottom: 30px;
    padding: 0 100px 0 40px;
}

.trust-grid-mosaic-box h3 {
    color: #fff;
    font-size: 25px;
    font-weight: 100;
    font-family: 'LubalinGraphStd-Medium';
}

.js-st-micro.stmicro.cxv1 .st-container:not(.st-container--keep-padding) > .row > .large-12 {
    background: #f5f5f5;
}

.trust-grid-mosaic-box p {
    display: none;
    color: #fff !important;
    font-size: 14px !important;
    font-weight: 100 !important;
    line-height: 1.5 !important;
}

.trust-grid-mosaic-box:hover img {
    filter: brightness(0.4);
}

.trust-grid-mosaic-box:hover p {
    display: flex;
}

.trust-grid-mosaic-box:hover svg {
    position: absolute;
    bottom: 80px;
    right: 30px;
}

.step-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 25px;
}

.step-numb {
    display: flex;
}

.step-numb span {
    background: #03234b;
    color: #fff;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 26px;
    font-family: Arial;
}

.section {
    margin: 50px 0;
}

.step-content h3 {
    margin-bottom: 10px;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  padding: 24px;
  width: 100%;
}

.card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  background: #ffffff;
  border-radius: 2px;
  text-decoration: none;
  /* color: #1a1a1a; */
  font-weight: 600;
  flex-direction: column;
  font-size: 1.1rem;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:hover {
  transform: scale(1.08);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
}

/* Responsive */
@media (max-width: 1024px) {
  .card-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .card-grid {
    grid-template-columns: 1fr;
  }
}


.modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.6);
  display: none;
  align-items: center;
  justify-content: center;
}

.modal.is-open {
  display: flex;
}

.modal-content {
  background: #fff;
  padding: 30px;
  max-width: 800px;
  width: 100%;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 8px;
  right: 12px;
  border: none;
  background: none;
  font-size: 30px;
  cursor: pointer;
}

.st-trust-tabs-wrap {
    background: #f5f5f5;
    -webkit-box-shadow: inset 1px -2px 10px rgba(0, 0, 0, 0.1);
    box-shadow: inset 1px -2px 10px rgba(0, 0, 0, 0.1);
    position: relative;
    text-align: center;
    z-index: 121;
}

body {
    margin: 0;
}

.st-trust-tabs-wrap {display: flex;margin: auto;justify-content: center;gap: 20px;}

.st-trust-tabs {
    max-width: 1053px;
    text-align: center;
    justify-content: center;
}

.st-tabs-tab {
    cursor: pointer;
    color: #666;
    position: relative;
    width: 100%;
    min-width: fit-content;
}

span.st-tabs-tab-headline {
    display: inline-block;
    font-size: 16px;
    height: 100%;
    justify-content: center;
    line-height: 24px;
    padding: 15px 8px 15px;
    position: relative;
    transition: all .3s;
    white-space: nowrap;
}

.st-trust-tab-item.active  span.st-tabs-tab-headline {
    color: #3cb4e6;
    text-shadow: 0.5px 0 0 #3cb4e6;
    -webkit-transition: all .2s;
    transition: all .2s;
}

.st-trust-tab-item.active .st-tabs-tab {
    background-color: #fff;
    padding: 0 8px;
    background: linear-gradient(to bottom, #ffffff, #f5f5f5);
}

table th:before {
    content: unset;
}

.standard-table-content th {
    border: 0;
    vertical-align: middle;
}

.section.tab-content {
    max-width: 1040px;
    margin: 50px auto;
}

.st-trust-tab-item {
    display: flex;
}

button.inner-st-trust-tab-item.active,
button.inner-st-trust-tab-item:hover {
    color: #0047b2;
    border-bottom: 2px solid;
    margin-bottom: -1px;
    background: transparent;
    height: auto;
    line-height: 0;
    transition: none;
}

button.inner-st-trust-tab-item {
    background: #f5f5f5;
    outline: 0;
    border: 0;
    color: #03234b;
    font-size: 15px;
    font-weight: bold;
    padding: 8px;
    cursor: pointer;
}

.inner-tab-content {
    display: none;
}

.inner-tab-content.active {
    display: flex;
    flex-wrap:wrap;
}

a.card svg {
    max-width: 110px;
}

a.card h4 {
    font-family: Arial;
    font-size: 15px;
    color: #03234b;
    margin-top: 5px;
}

a.card:hover h4 {
    color: #0047b2;
}

.tab-back {
    font-family: Arial;
    color: #03234b;
    font-size: 14px;
    cursor: pointer;
    font-weight: bold;
}

.tab-back svg {
    width: 25px;
    height: 13px;
    fill: #03234b;
    transform: rotate(180deg);
    margin-right: 10px;
}

.trust-grid-mosaic[hidden] {
    display: none;
}

a.card:hover svg g {
    fill: #0047b2 !important;
}

.modal-content h2 {
    margin-top: 0;
}

.standard-table-content thead {
    height: 88px;
    background: var(--Neutral-Grey-0---White, #FFF);
    box-shadow: inset 0 -2px 0 #3cb4e6, inset 0 1px var(--neutral-grey-3-disabled-border, #dbdee2);
}

.standard-table-content th {
    height: 88px;
    padding: 24px;
    text-align: left;
    color: #525a63;
    font-size: 14px;
    font-weight: bold;
    font-family: Arial;
}

.standard-table-content tbody td {
    padding: 24px;
    font-family: Arial;
    color: #525a63;
    font-size: 14px;
    line-height: 28px;
}

.standard-table-content tbody tr {
    transition: all .25s ease-in-out;
    border-bottom: 1px solid var(--neutral-grey-3-disabled-border-divider, #dbdee2);
    background: var(--Neutral-Grey-0---White, #FFF);
}

.standard-table-content table {
    border-collapse: collapse;
}

.map-wrap {
    margin: 50px 0;
}

.standard-table-content tbody td:first-child {
    font-weight: bold;
}


