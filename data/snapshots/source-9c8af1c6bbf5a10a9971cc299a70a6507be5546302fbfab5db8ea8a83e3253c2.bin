            var searchWidgetKeywordsNoConfig = getSearchConfig("", "");
        } else {
            var searchWidgetProductNoConfig = getSearchConfig("", "");
            var searchWidgetKeywordsNoConfig = getSearchConfig("", "");
        }
    })
