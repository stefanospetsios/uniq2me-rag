  <p class="hidden-xs" id="qrcodeLink">
    <span class="glyphicon glyphicon-qrcode"
          title="Show QR code for this page"></span>
    Show QR code for this page
  </p>
  <img data-src="/qrgen?url=https%3A%2F%2Fproductinfo.se.com%2Fpactcybersecurity%2Fdoca0122-cybersecurity-guide%2FEnglish%2FBM_novA_Cybersecurity%2520Guide_53457272_T001003726.xml%2F%24%2FCyber_Rec_IFE_Disposal_0000940268&size=180"
       id="qrcode"
       style="width: 180px; height: 180px;"
       alt="QR Code is a registered trademark of DENSO WAVE INCORPORATED in Japan and other countries."
       title="QR Code is a registered trademark of DENSO WAVE INCORPORATED in Japan and other countries.">
<script>
  $(function() {
    var $qr = $('#qrcode')
    , $link = $('#qrcodeLink')
    , on = $qr.is('visible')
    , shown = false;
    ;

    function show() {
      var pos = $link.position();
      $qr.css({
        position: 'absolute',
        left: pos.left + 'px',
        top: pos.top + 'px'
      });
      // Defer the image rendering until requested.
      $qr.attr('src', $qr.attr('data-src'));
      $qr.fadeIn();
      on = true;
      shown = true;
    }

    function toggle() {
      if (on) {
        $qr.fadeOut();
        on = false;
      } else {
        show();
      }
    }

    $link.click(toggle);
    $qr.click(toggle);
  });
</script>
  </div>
</div>
 		  
		  

