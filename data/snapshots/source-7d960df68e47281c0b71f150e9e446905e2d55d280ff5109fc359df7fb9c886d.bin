            <div class="col-xs-12 content-container">
<div class="itemPreview"><a name="CybersecurityRecommendationsForIFEI-87B271CC" class="xmlId"></a><article class="topic concept" data-id="CybersecurityRecommendationsForIFEI-87B271CC" lang="en" data-xtrc="concept:1" data-xtrf="harp://606efaa34659bd000198cf58/pr/ORIGINAL/English/Cyber_Rec_IFE_Disposal_0000940268.xml">
      <h1 class="title" data-xtrc="title:1" lang="en">Cybersecurity Recommendations for Disposal or Decommissioning</h1>
      <div class="body conbody" data-xtrc="conbody:1" lang="en">
         <p class="p" data-xtrc="p:1" lang="en">The <span class="ph" data-xtrc="ph:1" lang="en"><a href="/pactcybersecurity/doca0122-cybersecurity-guide/English/BM_novA_Cybersecurity%20Guide_53457272_T001003726.xml/$/GTD_EIFE_interface_53457272_T001003944#gl_D_SE_0060290.9" class="xref">EIFE</a></span> and <span class="ph" data-xtrc="ph:2" lang="en"><a href="/pactcybersecurity/doca0122-cybersecurity-guide/English/BM_novA_Cybersecurity%20Guide_53457272_T001003726.xml/$/GTD_IFE_interface_53457272_T001003941#gl_D_SE_0060290.8" class="xref">IFE</a></span> interfaces and <a href="/pactcybersecurity/doca0122-cybersecurity-guide/English/BM_novA_Cybersecurity%20Guide_53457272_T001003726.xml/$/GTD_IFE_server_53457272_T001003942#gl_D_SE_0060290.21" class="xref"><span class="ph" data-xtrc="ph:3" lang="en">IFE</span> server</a> contain confidential information configured during commissioning,
            recent data values and logs. For example, this information can include
            passwords or measured power consumptions.</p>
         <p class="p" data-xtrc="p:2" lang="en">It is required to perform a factory reset before disposing of the <span class="ph" data-xtrc="ph:4" lang="en"><a href="/pactcybersecurity/doca0122-cybersecurity-guide/English/BM_novA_Cybersecurity%20Guide_53457272_T001003726.xml/$/GTD_EIFE_interface_53457272_T001003944#gl_D_SE_0060290.9" class="xref">EIFE</a></span> or <span class="ph" data-xtrc="ph:5" lang="en"><a href="/pactcybersecurity/doca0122-cybersecurity-guide/English/BM_novA_Cybersecurity%20Guide_53457272_T001003726.xml/$/GTD_IFE_interface_53457272_T001003941#gl_D_SE_0060290.8" class="xref">IFE</a></span> interface, or <a href="/pactcybersecurity/doca0122-cybersecurity-guide/English/BM_novA_Cybersecurity%20Guide_53457272_T001003726.xml/$/GTD_IFE_server_53457272_T001003942#gl_D_SE_0060290.21" class="xref"><span class="ph" data-xtrc="ph:6" lang="en">IFE</span> server</a>. For more information, refer to the relevant user guide for your
            interface.</p>
      </div>
   </article>
</div>            </div>
          </div>
<script type="text/javascript">
  var refId = 'Cyber_Rec_IFE_Disposal_0000940268';
  $(document).ready(function() {

  function updateFeedbackTabPosition() {
    var viewportWidth, viewportHeight, offsetLeft, offsetTop;

    offsetLeft = window.scrollX || window.pageXOffset || 0;
    offsetTop  = window.scrollY || window.pageYOffset || 0;

    if (window.visualViewport) {
      viewportWidth  = window.visualViewport.width;
      viewportHeight = window.visualViewport.height;
      offsetLeft     = window.visualViewport.offsetLeft;
      offsetTop      = window.visualViewport.offsetTop;
    } else {
      viewportWidth  = window.innerWidth  || document.documentElement.clientWidth;
      viewportHeight = window.innerHeight || document.documentElement.clientHeight;
    }

    var tab    = $('#feedbackTab');
    var tabH   = tab.outerHeight() || 80;
    var tabW   = tab.outerWidth()  || 40;

    tab.css({
      left:      (offsetLeft + viewportWidth - tabW) + 'px',
      top:       (offsetTop + (viewportHeight / 2) - (tabH / 2)) + 'px',
      right:     'auto',
      transform: 'none'
    });

    var comp  = $('#feedbackComponent');
    var compW = comp.outerWidth() || 300;
    var compH = comp.outerHeight() || 150;

    comp.css({
      left:      (offsetLeft + viewportWidth - tabW - compW - 5) + 'px',
      top:       (offsetTop + (viewportHeight / 2) - (compH / 2)) + 'px',
      right:     'auto',
      transform: 'none'
    });
  }

  if (window.visualViewport) {
    window.visualViewport.addEventListener('scroll', updateFeedbackTabPosition);
    window.visualViewport.addEventListener('resize', updateFeedbackTabPosition);
  } else {
    $(window).on('scroll resize', updateFeedbackTabPosition);
  }

  $(document).on('touchend touchmove', updateFeedbackTabPosition);

  updateFeedbackTabPosition();
  $(window).on('load', updateFeedbackTabPosition);
  setTimeout(updateFeedbackTabPosition, 100);
  setTimeout(updateFeedbackTabPosition, 500);

    function sendFeedback(feedback, type) {
      $.ajax({
        url : HARPPortal.getPortalRpcUrl('feedback'),
        type : type,
        data : JSON.stringify(feedback),
        contentType : 'application/json',
      });
    }

    function confirmFeedback(fromNegative) {
      $('#feedbackComponent').children().fadeOut(500);
      var confirmHtml = '<button class="feedbackClose">&times;</button><div class="feedbackContent">' + $('#feedbackConfirm').html() + '</div>';
      $('#feedbackComponent').html($(confirmHtml).fadeIn(500));
    }

    function closeFeedback() {
      $('#feedbackComponent').fadeOut(300);
    }

    function closeFeedbackAndHideTab() {
      $('#feedbackComponent').fadeOut(300);
      $('#feedbackTab').fadeOut(300);
    }

    function resetFeedbackComponent() {
      $('#feedbackInput').val('');
      $('#feedbackComponent').html(
        '<button class="feedbackClose">&times;</button><div class="feedbackContent">' +
        $('#feedbackHelpful').html() +
        '</div>'
      );
    }

    // Toggle feedback component visibility
    $('#feedbackTab').click(function() {
      if ($('#feedbackComponent').is(':visible')) {
        $('#feedbackComponent').fadeOut(300);
      } else {
        resetFeedbackComponent();
        $('#feedbackComponent').fadeIn(300);
      }
    });

    // Close button handler using event delegation
    $(document).on('click', '.feedbackClose', function(event) {
      closeFeedback();
      resetFeedbackComponent();
    });
    // Use event delegation for dynamically added buttons
    $(document).on('click', '.feedbackButton', function(event) {
      var feedback = {}, contentElement = $("#viewerContent");

      feedback.id = $('body').attr('data-pageId');
      feedback.topicUseful = this.value;
      feedback.portalKey = contentElement.attr("data-portalKey");
      feedback.topicKey = contentElement.attr("data-itemKey");
      feedback.projectKey = contentElement.attr("data-projectKey");
      feedback.parentKey = contentElement.attr("data-parentKey");
      feedback.refId = refId;

      sendFeedback(feedback, 'POST');

      $('#feedbackComponent').children().fadeOut(500);
      var commentHtml = '<button class="feedbackClose">&times;</button><div class="feedbackContent">' + $('#feedbackComment').html() + '</div>';
      $('#feedbackComponent').html($(commentHtml).fadeIn(500));

      $(document).off('click', '#commentButton').on('click', '#commentButton', function() {
        $('#feedbackComponent').off('keypress');
        var comment = $("#feedbackInput").val().trim();
        if (comment !== "") {
          feedback.comment = comment;
          sendFeedback(feedback, 'PUT');
        }
        confirmFeedback(true);
      });

      $('#feedbackInput').focus();

      $('#feedbackComponent').off('keypress').on('keypress', function(e) {
        if (e.which === 13) {
          $('#commentButton').trigger('click');
        }
      });
    });
  });
</script>

<div id="feedbackTab">
  <span>Feedback</span>
</div>

<div id="feedbackComponent">
  <button class="feedbackClose">&times;</button>
  <div class="feedbackContent">
  </div>
</div>

<div id="feedbackHelpful" style="display: none">
  <p>Was this helpful?</p>
  <div id="buttonDiv">
    <button class="btn btn-primary btn-xs feedbackButton" value="true">Yes</button>
    <button class="btn btn-primary btn-xs feedbackButton" value="false">No</button>
  </div>
</div>

<div id="feedbackConfirm" style="display: none">
  <p>Thank you for the feedback!</p>
  <p><a href="https://www.se.com/ww/en/work/support" target="_blank">Click Here for Added Support</a></p>
</div>

<div id="feedbackComment" style="display: none">
  <label for="feedbackInput">Tell us why!</label><br>
  <textarea rows="4" id="feedbackInput"></textarea><br>
  <button class="btn btn-primary btn-xs" id="commentButton">Send</button>
</div>

