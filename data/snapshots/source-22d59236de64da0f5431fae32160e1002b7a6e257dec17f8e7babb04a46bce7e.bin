275,"path":264,"pinia":2279},["ShallowReactive",3],{"info-buckethtmldocument-rfc7696":4},{"rfc":5,"tableOfContents":52,"documentHtmlType":179,"documentHtmlObj":180,"maxPreformattedLineLength":2251,"errataList":2253,"timestampIso":2270},{"number":6,"title":7,"published":8,"pages":9,"status":10,"subseries":13,"authors":16,"group":25,"stream":29,"identifiers":32,"obsoletes":36,"obsoleted_by":37,"updates":38,"updated_by":39,"keywords":40,"formats":41,"abstract":48,"reefSubjectTags":49},7696,"Guidelines for Cryptographic Algorithm Agility and Selecting Mandatory-to-Implement Algorithms","2015-11-18",19,{"slug":11,"name":12},"bcp","best current practice",[14],{"type":11,"number":15},201,[17],{"titlepage_name":18,"is_editor":19,"person":20,"email":21,"affiliation":22,"country":23,"datatracker_person_path":24},"R. Housley",false,5376,"housley@vigilsec.com","Vigil Security","","\u002Fperson\u002FRuss%20Housley",{"acronym":26,"name":27,"type":28},"sec","Security Area","area",{"slug":30,"name":30,"description":31},"IETF","Internet Engineering Task Force (IETF)",[33],{"type":34,"value":35},"doi","10.17487\u002FRFC7696",[],[],[],[],[],[42,44,46],{"format":43},"txt",{"format":45},"html",{"format":47},"json","Many IETF protocols use cryptographic algorithms to provide confidentiality, integrity, authentication, or digital signature.  Communicating peers must support a common set of cryptographic algorithms for these mechanisms to work properly.  This memo provides guidelines to ensure that protocols have the ability to migrate from one mandatory-to-implement algorithm suite to another over time.",[50],{"slug":51,"title":51},"cryptography",{"title":53,"sections":54},"Table of contents",[55,66,133,159,164,169,174],{"links":56,"sections":60},[57],{"id":58,"title":59},"section-1","1.  Introduction",[61],{"links":62},[63],{"id":64,"title":65},"section-1.1","1.1.  Terminology",{"links":67,"sections":71},[68],{"id":69,"title":70},"section-2","2.  Algorithm Agility Guidelines",[72,77,98,103,108,113,118,123,128],{"links":73},[74],{"id":75,"title":76},"section-2.1","2.1.  Algorithm Identifiers",{"links":78,"sections":82},[79],{"id":80,"title":81},"section-2.2","2.2.  Mandatory-to-Implement Algorithms",[83,88,93],{"links":84},[85],{"id":86,"title":87},"section-2.2.1","2.2.1.  Platform Specifications",{"links":89},[90],{"id":91,"title":92},"section-2.2.2","2.2.2.  Cryptographic Key Size",{"links":94},[95],{"id":96,"title":97},"section-2.2.3","2.2.3.  Providing Notice of Expected Changes",{"links":99},[100],{"id":101,"title":102},"section-2.3","2.3.  Transitioning from Weak Algorithms",{"links":104},[105],{"id":106,"title":107},"section-2.4","2.4.  Algorithm Transition Mechanisms",{"links":109},[110],{"id":111,"title":112},"section-2.5","2.5.  Cryptographic Key Establishment",{"links":114},[115],{"id":116,"title":117},"section-2.6","2.6.  Preserving Interoperability",{"links":119},[120],{"id":121,"title":122},"section-2.7","2.7.  Balancing Security Strength",{"links":124},[125],{"id":126,"title":127},"section-2.8","2.8.  Balancing Protocol Complexity",{"links":129},[130],{"id":131,"title":132},"section-2.9","2.9.  Opportunistic Security",{"links":134,"sections":138},[135],{"id":136,"title":137},"section-3","3.  Cryptographic Algorithm Specifications",[139,144,149,154],{"links":140},[141],{"id":142,"title":143},"section-3.1","3.1.  Choosing Mandatory-to-Implement Algorithms",{"links":145},[146],{"id":147,"title":148},"section-3.2","3.2.  Too Many Choices Can Be Harmful",{"links":150},[151],{"id":152,"title":153},"section-3.3","3.3.  Picking One True Cipher Suite Can Be Harmful",{"links":155},[156],{"id":157,"title":158},"section-3.4","3.4.  National Cipher Suites",{"links":160},[161],{"id":162,"title":163},"section-4","4.  Security Considerations",{"links":165},[166],{"id":167,"title":168},"section-5","5.  IANA Considerations",{"links":170},[171],{"id":172,"title":173},"section-6","6.  Normative References",{"links":175},[176],{"id":177,"title":178},"section-7","7.  Informative References","plaintext",[181,243,245,250,642,643,646,700,701,704,776,777,780,869,870,873,967,968,971,1034,1035,1038,1099,1100,1103,1145,1146,1149,1230,1231,1234,1295,1296,1299,1347,1348,1351,1400,1401,1404,1462,1463,1466,1534,1535,1538,1686,1687,1690,1893,1894,1897,2134,2135,2138,2250],{"type":182,"nodeName":183,"attributes":184,"children":185},"Element","pre",{},[186,189,196,198,203,205,212,214,220,222,228,230,235,237],{"type":187,"textContent":188},"Text","Internet Engineering Task Force (IETF)                        R. Housley\nRequest for Comments: 7696                                Vigil Security\nBCP: 201                                                   November 2015\nCategory: Best Current Practice\nISSN: 2070-1721\n\n\n             ",{"type":182,"nodeName":190,"attributes":191,"children":193},"span",{"class":192},"h1",[194],{"type":187,"textContent":195},"Guidelines for Cryptographic Algorithm Agility",{"type":187,"textContent":197},"\n            ",{"type":182,"nodeName":190,"attributes":199,"children":200},{"class":192},[201],{"type":187,"textContent":202},"and Selecting Mandatory-to-Implement Algorithms",{"type":187,"textContent":204},"\n\nAbstract\n\n   Many IETF protocols use cryptographic algorithms to provide\n   confidentiality, integrity, authentication, or digital signature.\n   Communicating peers must support a common set of cryptographic\n   algorithms for these mechanisms to work properly.  This memo provides\n   guidelines to ensure that protocols have the ability to migrate from\n   one mandatory-to-implement algorithm suite to another over time.\n\nStatus of This Memo\n\n   This memo documents an Internet Best Current Practice.\n\n   This document is a product of the Internet Engineering Task Force\n   (IETF).  It represents the consensus of the IETF community.  It has\n   received public review and has been approved for publication by the\n   Internet Engineering Steering Group (IESG).  Further information on\n   BCPs is available in ",{"type":182,"nodeName":206,"attributes":207,"children":209},"a",{"href":208},"\u002Finfo\u002Frfc5741\u002F#section-2",[210],{"type":187,"textContent":211},"Section 2 of RFC 5741",{"type":187,"textContent":213},".\n\n   Information about the current status of this document, any errata,\n   and how to provide feedback on it may be obtained at\n   ",{"type":182,"nodeName":206,"attributes":215,"children":217},{"href":216},"\u002Finfo\u002Frfc7696",[218],{"type":187,"textContent":219},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc7696",{"type":187,"textContent":221},".\n\nCopyright Notice\n\n   Copyright (c) 2015 IETF Trust and the persons identified as the\n   document authors.  All rights reserved.\n\n   This document is subject to ",{"type":182,"nodeName":206,"attributes":223,"children":225},{"href":224},"\u002Fbcp\u002Fbcp78",[226],{"type":187,"textContent":227},"BCP 78",{"type":187,"textContent":229}," and the IETF Trust's Legal\n   Provisions Relating to IETF Documents\n   (",{"type":182,"nodeName":206,"attributes":231,"children":233},{"href":232},"http:\u002F\u002Ftrustee.ietf.org\u002Flicense-info",[234],{"type":187,"textContent":232},{"type":187,"textContent":236},") in effect on the date of\n   publication of this document.  Please review these documents\n   carefully, as they describe your rights and restrictions with respect\n   to this document.  Code Components extracted from this document must\n   include Simplified BSD License text as described in Section 4.e of\n   the Trust Legal Provisions and are provided without warranty as\n   described in the Simplified BSD License.\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":238,"children":240},{"class":239},"grey",[241],{"type":187,"textContent":242},"Housley                   Best Current Practice                 [Page 1]",{"type":187,"textContent":244},"\n",{"type":182,"nodeName":246,"attributes":247,"children":249},"hr",{"class":248},"noprint",[],{"type":182,"nodeName":183,"attributes":251,"children":253},{"class":252},"newpage",[254,258,259,270,272,278,280,286,288,294,296,302,304,309,311,315,316,322,324,330,331,337,339,345,347,353,355,359,360,366,368,372,373,379,381,387,388,394,396,400,401,407,409,415,416,422,424,430,431,437,439,443,444,450,452,458,459,465,467,473,474,480,482,486,487,492,494,500,501,507,509,513,514,520,522,528,529,535,537,543,544,550,552,558,559,564,566,570,571,576,578,584,585,590,592,596,597,602,604,608,610,616,618,622,624,635,637],{"type":182,"nodeName":190,"attributes":255,"children":257},{"id":256},"page-2",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":260,"children":261},{"class":239},[262,268],{"type":182,"nodeName":206,"attributes":263,"children":265},{"href":264},"\u002Finfo\u002Frfc7696\u002F",[266],{"type":187,"textContent":267},"RFC 7696",{"type":187,"textContent":269},"        Guidelines for Cryptographic Alg Agility   November 2015",{"type":187,"textContent":271},"\n\n\nTable of Contents\n\n   ",{"type":182,"nodeName":206,"attributes":273,"children":275},{"href":274},"#section-1",[276],{"type":187,"textContent":277},"1",{"type":187,"textContent":279},".  Introduction . . . . . . . . . . . . . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":281,"children":283},{"href":282},"#page-2",[284],{"type":187,"textContent":285},"2",{"type":187,"textContent":287},"\n     ",{"type":182,"nodeName":206,"attributes":289,"children":291},{"href":290},"#section-1.1",[292],{"type":187,"textContent":293},"1.1",{"type":187,"textContent":295},".  Terminology  . . . . . . . . . . . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":297,"children":299},{"href":298},"#page-3",[300],{"type":187,"textContent":301},"3",{"type":187,"textContent":303},"\n   ",{"type":182,"nodeName":206,"attributes":305,"children":307},{"href":306},"#section-2",[308],{"type":187,"textContent":285},{"type":187,"textContent":310},".  Algorithm Agility Guidelines . . . . . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":312,"children":313},{"href":298},[314],{"type":187,"textContent":301},{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":317,"children":319},{"href":318},"#section-2.1",[320],{"type":187,"textContent":321},"2.1",{"type":187,"textContent":323},".  Algorithm Identifiers  . . . . . . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":325,"children":327},{"href":326},"#page-4",[328],{"type":187,"textContent":329},"4",{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":332,"children":334},{"href":333},"#section-2.2",[335],{"type":187,"textContent":336},"2.2",{"type":187,"textContent":338},".  Mandatory-to-Implement Algorithms  . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":340,"children":342},{"href":341},"#page-5",[343],{"type":187,"textContent":344},"5",{"type":187,"textContent":346},"\n       ",{"type":182,"nodeName":206,"attributes":348,"children":350},{"href":349},"#section-2.2.1",[351],{"type":187,"textContent":352},"2.2.1",{"type":187,"textContent":354},".  Platform Specifications  . . . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":356,"children":357},{"href":341},[358],{"type":187,"textContent":344},{"type":187,"textContent":346},{"type":182,"nodeName":206,"attributes":361,"children":363},{"href":362},"#section-2.2.2",[364],{"type":187,"textContent":365},"2.2.2",{"type":187,"textContent":367},".  Cryptographic Key Size . . . . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":369,"children":370},{"href":341},[371],{"type":187,"textContent":344},{"type":187,"textContent":346},{"type":182,"nodeName":206,"attributes":374,"children":376},{"href":375},"#section-2.2.3",[377],{"type":187,"textContent":378},"2.2.3",{"type":187,"textContent":380},".  Providing Notice of Expected Changes . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":382,"children":384},{"href":383},"#page-6",[385],{"type":187,"textContent":386},"6",{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":389,"children":391},{"href":390},"#section-2.3",[392],{"type":187,"textContent":393},"2.3",{"type":187,"textContent":395},".  Transitioning from Weak Algorithms . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":397,"children":398},{"href":383},[399],{"type":187,"textContent":386},{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":402,"children":404},{"href":403},"#section-2.4",[405],{"type":187,"textContent":406},"2.4",{"type":187,"textContent":408},".  Algorithm Transition Mechanisms  . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":410,"children":412},{"href":411},"#page-7",[413],{"type":187,"textContent":414},"7",{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":417,"children":419},{"href":418},"#section-2.5",[420],{"type":187,"textContent":421},"2.5",{"type":187,"textContent":423},".  Cryptographic Key Management . . . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":425,"children":427},{"href":426},"#page-8",[428],{"type":187,"textContent":429},"8",{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":432,"children":434},{"href":433},"#section-2.6",[435],{"type":187,"textContent":436},"2.6",{"type":187,"textContent":438},".  Preserving Interoperability  . . . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":440,"children":441},{"href":426},[442],{"type":187,"textContent":429},{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":445,"children":447},{"href":446},"#section-2.7",[448],{"type":187,"textContent":449},"2.7",{"type":187,"textContent":451},".  Balancing Security Strength  . . . . . . . . . . . . . . .  ",{"type":182,"nodeName":206,"attributes":453,"children":455},{"href":454},"#page-9",[456],{"type":187,"textContent":457},"9",{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":460,"children":462},{"href":461},"#section-2.8",[463],{"type":187,"textContent":464},"2.8",{"type":187,"textContent":466},".  Balancing Protocol Complexity  . . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":468,"children":470},{"href":469},"#page-10",[471],{"type":187,"textContent":472},"10",{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":475,"children":477},{"href":476},"#section-2.9",[478],{"type":187,"textContent":479},"2.9",{"type":187,"textContent":481},".  Opportunistic Security . . . . . . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":483,"children":484},{"href":469},[485],{"type":187,"textContent":472},{"type":187,"textContent":303},{"type":182,"nodeName":206,"attributes":488,"children":490},{"href":489},"#section-3",[491],{"type":187,"textContent":301},{"type":187,"textContent":493},".  Cryptographic Algorithm Specifications . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":495,"children":497},{"href":496},"#page-11",[498],{"type":187,"textContent":499},"11",{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":502,"children":504},{"href":503},"#section-3.1",[505],{"type":187,"textContent":506},"3.1",{"type":187,"textContent":508},".  Choosing Mandatory-to-Implement Algorithms . . . . . . . . ",{"type":182,"nodeName":206,"attributes":510,"children":511},{"href":496},[512],{"type":187,"textContent":499},{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":515,"children":517},{"href":516},"#section-3.2",[518],{"type":187,"textContent":519},"3.2",{"type":187,"textContent":521},".  Too Many Choices Can Be Harmful  . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":523,"children":525},{"href":524},"#page-12",[526],{"type":187,"textContent":527},"12",{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":530,"children":532},{"href":531},"#section-3.3",[533],{"type":187,"textContent":534},"3.3",{"type":187,"textContent":536},".  Picking One True Cipher Suite Can Be Harmful . . . . . . . ",{"type":182,"nodeName":206,"attributes":538,"children":540},{"href":539},"#page-13",[541],{"type":187,"textContent":542},"13",{"type":187,"textContent":287},{"type":182,"nodeName":206,"attributes":545,"children":547},{"href":546},"#section-3.4",[548],{"type":187,"textContent":549},"3.4",{"type":187,"textContent":551},".  National Cipher Suites . . . . . . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":553,"children":555},{"href":554},"#page-14",[556],{"type":187,"textContent":557},"14",{"type":187,"textContent":303},{"type":182,"nodeName":206,"attributes":560,"children":562},{"href":561},"#section-4",[563],{"type":187,"textContent":329},{"type":187,"textContent":565},".  Security Considerations  . . . . . . . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":567,"children":568},{"href":554},[569],{"type":187,"textContent":557},{"type":187,"textContent":303},{"type":182,"nodeName":206,"attributes":572,"children":574},{"href":573},"#section-5",[575],{"type":187,"textContent":344},{"type":187,"textContent":577},".  IANA Considerations  . . . . . . . . . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":579,"children":581},{"href":580},"#page-16",[582],{"type":187,"textContent":583},"16",{"type":187,"textContent":303},{"type":182,"nodeName":206,"attributes":586,"children":588},{"href":587},"#section-6",[589],{"type":187,"textContent":386},{"type":187,"textContent":591},".  Normative References . . . . . . . . . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":593,"children":594},{"href":580},[595],{"type":187,"textContent":583},{"type":187,"textContent":303},{"type":182,"nodeName":206,"attributes":598,"children":600},{"href":599},"#section-7",[601],{"type":187,"textContent":414},{"type":187,"textContent":603},".  Informative References . . . . . . . . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":605,"children":606},{"href":580},[607],{"type":187,"textContent":583},{"type":187,"textContent":609},"\n   Acknowledgements . . . . . . . . . . . . . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":611,"children":613},{"href":612},"#page-19",[614],{"type":187,"textContent":615},"19",{"type":187,"textContent":617},"\n   Author's Address . . . . . . . . . . . . . . . . . . . . . . . . . ",{"type":182,"nodeName":206,"attributes":619,"children":620},{"href":612},[621],{"type":187,"textContent":615},{"type":187,"textContent":623},"\n\n",{"type":182,"nodeName":190,"attributes":625,"children":627},{"class":626},"h2",[628,633],{"type":182,"nodeName":206,"attributes":629,"children":631},{"class":630,"id":58,"href":274},"selflink",[632],{"type":187,"textContent":277},{"type":187,"textContent":634},".  Introduction",{"type":187,"textContent":636},"\n\n   Many IETF protocols use cryptographic algorithms to provide\n   confidentiality, integrity, authentication, or digital signature.\n   For interoperability, communicating peers must support a common set\n   of cryptographic algorithms.  In most cases, a combination of\n   compatible cryptographic algorithms will be used to provide the\n   desired security services.  The set of cryptographic algorithms being\n   used at a particular time is often referred to as a cryptographic\n   algorithm suite or cipher suite.  In a protocol, algorithm\n   identifiers might name a single cryptographic algorithm or a full\n   suite of algorithms.\n\n   Cryptographic algorithms age; they become weaker with time.  As new\n   cryptanalysis techniques are developed and computing capabilities\n   improve, the work required to break a particular cryptographic\n   algorithm will reduce, making an attack on the algorithm more\n   feasible for more attackers.  While it is unknown how cryptoanalytic\n   attacks will evolve, it is certain that they will get better.  It is\n\n\n\n",{"type":182,"nodeName":190,"attributes":638,"children":639},{"class":239},[640],{"type":187,"textContent":641},"Housley                   Best Current Practice                 [Page 2]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":644,"children":645},{"class":248},[],{"type":182,"nodeName":183,"attributes":647,"children":648},{"class":252},[649,653,654,662,664,674,676,682,684,693,695],{"type":182,"nodeName":190,"attributes":650,"children":652},{"id":651},"page-3",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":655,"children":656},{"class":239},[657,661],{"type":182,"nodeName":206,"attributes":658,"children":659},{"href":264},[660],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":663},"\n\n\n   unknown how much better they will become or when the advances will\n   happen.  Protocol designers need to assume that advances in computing\n   power or advances in cryptoanalytic techniques will eventually make\n   any algorithm obsolete.  For this reason, protocols need mechanisms\n   to migrate from one algorithm suite to another over time.\n\n   Algorithm agility is achieved when a protocol can easily migrate from\n   one algorithm suite to another more desirable one, over time.  For\n   the protocol implementer, this means that implementations should be\n   modular to easily accommodate the insertion of new algorithms or\n   suites of algorithms.  Ideally, implementations will also provide a\n   way to measure when deployed implementations have shifted away from\n   the old algorithms and to the better ones.  For the protocol\n   designer, algorithm agility means that one or more algorithm or suite\n   identifiers must be supported, the set of mandatory-to-implement\n   algorithms will change over time, and an IANA registry of algorithm\n   identifiers will be needed.\n\n   Algorithm identifiers by themselves are not sufficient to ensure easy\n   migration.  Action by people that maintain implementations and\n   operate services is needed to develop, deploy, and adjust\n   configuration settings to enable the new more desirable algorithms\n   and to deprecate or disable older, less desirable ones.  For various\n   reasons, most notably interoperability concerns, experience has shown\n   that it has proven difficult for implementers and administrators to\n   remove or disable weak algorithms.  Further, the inability of legacy\n   systems and resource-constrained devices to support new algorithms\n   adds to those concerns.  As a result, people live with weaker\n   algorithms, sometimes seriously flawed ones, well after experts\n   recommend migration.\n\n",{"type":182,"nodeName":190,"attributes":665,"children":667},{"class":666},"h3",[668,672],{"type":182,"nodeName":206,"attributes":669,"children":670},{"class":630,"id":64,"href":290},[671],{"type":187,"textContent":293},{"type":187,"textContent":673},".  Terminology",{"type":187,"textContent":675},"\n\n   The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\",\n   \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\" in this\n   document are to be interpreted as described in [",{"type":182,"nodeName":206,"attributes":677,"children":679},{"href":678},"\u002Finfo\u002Frfc2119\u002F",[680],{"type":187,"textContent":681},"RFC2119",{"type":187,"textContent":683},"].\n\n",{"type":182,"nodeName":190,"attributes":685,"children":686},{"class":626},[687,691],{"type":182,"nodeName":206,"attributes":688,"children":689},{"class":630,"id":69,"href":306},[690],{"type":187,"textContent":285},{"type":187,"textContent":692},".  Algorithm Agility Guidelines",{"type":187,"textContent":694},"\n\n   These guidelines are for use by IETF working groups and protocol\n   authors for IETF protocols that make use of cryptographic algorithms.\n   Past attempts at algorithm agility have not been completely\n   successful, and this section provides some insights from those\n   experiences.\n\n\n\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":696,"children":697},{"class":239},[698],{"type":187,"textContent":699},"Housley                   Best Current Practice                 [Page 3]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":702,"children":703},{"class":248},[],{"type":182,"nodeName":183,"attributes":705,"children":706},{"class":252},[707,711,712,720,722,731,733,739,741,747,749,755,757,763,765,769,771],{"type":182,"nodeName":190,"attributes":708,"children":710},{"id":709},"page-4",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":713,"children":714},{"class":239},[715,719],{"type":182,"nodeName":206,"attributes":716,"children":717},{"href":264},[718],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":721},"\n\n\n",{"type":182,"nodeName":190,"attributes":723,"children":724},{"class":666},[725,729],{"type":182,"nodeName":206,"attributes":726,"children":727},{"class":630,"id":75,"href":318},[728],{"type":187,"textContent":321},{"type":187,"textContent":730},".  Algorithm Identifiers",{"type":187,"textContent":732},"\n\n   IETF protocols that make use of cryptographic algorithms MUST support\n   one or more algorithms or suites.  The protocol MUST include a\n   mechanism to identify the algorithm or suite that is being used.  An\n   algorithm identifier might be explicitly carried in the protocol.\n   Alternatively, a management mechanism can be used to identify the\n   algorithm.  For example, an entry in a key table that includes a key\n   value and an algorithm identifier might be sufficient.\n\n   If a protocol does not carry an algorithm identifier, then the\n   protocol version number or some other major change is needed to\n   transition from one algorithm to another.  The inclusion of an\n   algorithm identifier is a minimal step toward cryptographic algorithm\n   agility.\n\n   Sometimes a combination of protocol version number and explicit\n   algorithm or suite identifiers is appropriate.  For example, the\n   Transport Layer Security (TLS) [",{"type":182,"nodeName":206,"attributes":734,"children":736},{"href":735},"\u002Finfo\u002Frfc5246\u002F",[737],{"type":187,"textContent":738},"RFC5246",{"type":187,"textContent":740},"] version number names the\n   default key derivation function, and the cipher suite identifier\n   names the rest of the needed algorithms.\n\n   Some approaches carry one identifier for each algorithm that is used.\n   Other approaches carry one identifier for a full suite of algorithms.\n   Both approaches are used in IETF protocols.  Designers are encouraged\n   to pick one of these approaches and use it consistently throughout\n   the protocol or family of protocols.  Suite identifiers make it\n   easier for the protocol designer to ensure that the algorithm\n   selections are complete and compatible for future assignments.\n   However, suite identifiers inherently face a combinatoric explosion\n   as new algorithms are defined.  Algorithm identifiers, on the other\n   hand, impose a burden on implementations by forcing a determination\n   at run-time regarding which algorithm combinations are acceptable.\n\n   Regardless of the approach used, protocols historically negotiate the\n   symmetric cipher and cipher mode together to ensure that they are\n   compatible.\n\n   In the IPsec protocol suite, the Internet Key Exchange Protocol\n   version 2 (IKEv2) [",{"type":182,"nodeName":206,"attributes":742,"children":744},{"href":743},"\u002Finfo\u002Frfc7296\u002F",[745],{"type":187,"textContent":746},"RFC7296",{"type":187,"textContent":748},"] carries the algorithm identifiers for the\n   Authentication Header (AH) [",{"type":182,"nodeName":206,"attributes":750,"children":752},{"href":751},"\u002Finfo\u002Frfc4302\u002F",[753],{"type":187,"textContent":754},"RFC4302",{"type":187,"textContent":756},"] and the Encapsulating Security\n   Payload (ESP) [",{"type":182,"nodeName":206,"attributes":758,"children":760},{"href":759},"\u002Finfo\u002Frfc4303\u002F",[761],{"type":187,"textContent":762},"RFC4303",{"type":187,"textContent":764},"].  Such separation is a completely fine design\n   choice.  In contrast, TLS [",{"type":182,"nodeName":206,"attributes":766,"children":767},{"href":735},[768],{"type":187,"textContent":738},{"type":187,"textContent":770},"] carries cipher suite identifiers,\n   which is also a completely fine design choice.\n\n\n\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":772,"children":773},{"class":239},[774],{"type":187,"textContent":775},"Housley                   Best Current Practice                 [Page 4]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":778,"children":779},{"class":248},[],{"type":182,"nodeName":183,"attributes":781,"children":782},{"class":252},[783,787,788,796,798,807,809,815,817,823,825,835,837,843,845,851,853,862,864],{"type":182,"nodeName":190,"attributes":784,"children":786},{"id":785},"page-5",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":789,"children":790},{"class":239},[791,795],{"type":182,"nodeName":206,"attributes":792,"children":793},{"href":264},[794],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":797},"\n\n\n   An IANA registry SHOULD be used for these algorithm or suite\n   identifiers.  Once an algorithm identifier is added to the registry,\n   it should not be changed or removed.  However, it is desirable to\n   mark a registry entry as deprecated when implementation is no longer\n   advisable.\n\n",{"type":182,"nodeName":190,"attributes":799,"children":800},{"class":666},[801,805],{"type":182,"nodeName":206,"attributes":802,"children":803},{"class":630,"id":80,"href":333},[804],{"type":187,"textContent":336},{"type":187,"textContent":806},".  Mandatory-to-Implement Algorithms",{"type":187,"textContent":808},"\n\n   For secure interoperability, ",{"type":182,"nodeName":206,"attributes":810,"children":812},{"href":811},"\u002Fbcp\u002Fbcp61",[813],{"type":187,"textContent":814},"BCP 61",{"type":187,"textContent":816}," [",{"type":182,"nodeName":206,"attributes":818,"children":820},{"href":819},"\u002Finfo\u002Frfc3365\u002F",[821],{"type":187,"textContent":822},"RFC3365",{"type":187,"textContent":824},"] recognizes that\n   communicating peers that use cryptographic mechanisms must support a\n   common set of strong cryptographic algorithms.  For this reason, IETF\n   protocols that employ cryptography MUST specify one or more strong\n   mandatory-to-implement algorithms or suites.  This does not require\n   all deployments to use this algorithm or suite, but it does require\n   that it be available to all deployments.\n\n   The IETF needs to be able to change the mandatory-to-implement\n   algorithms over time.  It is highly desirable to make this change\n   without updating the base protocol specification.  To achieve this\n   goal, it is RECOMMENDED that the base protocol specification includes\n   a reference to a companion algorithms document, allowing the update\n   of one document without necessarily requiring an update to the other.\n   This division also facilitates the advancement of the base protocol\n   specification on the standards maturity ladder even if the algorithm\n   document changes frequently.\n\n   The IETF SHOULD keep the set of mandatory-to-implement algorithms\n   small.  To do so, the set of algorithms will necessarily change over\n   time, and the transition SHOULD happen before the algorithms in the\n   current set have weakened to the breaking point.\n\n",{"type":182,"nodeName":190,"attributes":826,"children":828},{"class":827},"h4",[829,833],{"type":182,"nodeName":206,"attributes":830,"children":831},{"class":630,"id":86,"href":349},[832],{"type":187,"textContent":352},{"type":187,"textContent":834},".  Platform Specifications",{"type":187,"textContent":836},"\n\n   Note that mandatory-to-implement algorithms or suites are not\n   specified for protocols that are embedded in other protocols; in\n   these cases, the system-level protocol specification identifies the\n   mandatory-to-implement algorithm or suite.  For example, S\u002FMIME\n   [",{"type":182,"nodeName":206,"attributes":838,"children":840},{"href":839},"\u002Finfo\u002Frfc5751\u002F",[841],{"type":187,"textContent":842},"RFC5751",{"type":187,"textContent":844},"] makes use of the cryptographic message Syntax (CMS)\n   [",{"type":182,"nodeName":206,"attributes":846,"children":848},{"href":847},"\u002Finfo\u002Frfc5652\u002F",[849],{"type":187,"textContent":850},"RFC5652",{"type":187,"textContent":852},"], and S\u002FMIME specifies the mandatory-to-implement\n   algorithms, not CMS.  This approach allows other protocols to make\n   use of CMS and make different mandatory-to-implement algorithm\n   choices.\n\n",{"type":182,"nodeName":190,"attributes":854,"children":855},{"class":827},[856,860],{"type":182,"nodeName":206,"attributes":857,"children":858},{"class":630,"id":91,"href":362},[859],{"type":187,"textContent":365},{"type":187,"textContent":861},".  Cryptographic Key Size",{"type":187,"textContent":863},"\n\n   Some cryptographic algorithms are inherently tied to a specific key\n   size, but others allow many different key sizes.  Likewise, some\n   algorithms support parameters of different sizes, such as integrity\n\n\n\n",{"type":182,"nodeName":190,"attributes":865,"children":866},{"class":239},[867],{"type":187,"textContent":868},"Housley                   Best Current Practice                 [Page 5]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":871,"children":872},{"class":248},[],{"type":182,"nodeName":183,"attributes":874,"children":875},{"class":252},[876,880,881,889,891,897,898,904,906,912,913,919,920,929,931,937,938,943,945,949,951,960,962],{"type":182,"nodeName":190,"attributes":877,"children":879},{"id":878},"page-6",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":882,"children":883},{"class":239},[884,888],{"type":182,"nodeName":206,"attributes":885,"children":886},{"href":264},[887],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":890},"\n\n\n   check values or nonces.  The algorithm specification MUST identify\n   the specific key sizes and parameter sizes that are to be supported.\n   When more than one key size is available, expect the mandatory-to-\n   implement key size to increase over time.\n\n   Guidance on cryptographic key size for asymmetric keys can be found\n   in ",{"type":182,"nodeName":206,"attributes":892,"children":894},{"href":893},"\u002Fbcp\u002Fbcp86",[895],{"type":187,"textContent":896},"BCP 86",{"type":187,"textContent":816},{"type":182,"nodeName":206,"attributes":899,"children":901},{"href":900},"\u002Finfo\u002Frfc3766\u002F",[902],{"type":187,"textContent":903},"RFC3766",{"type":187,"textContent":905},"].\n\n   Guidance on cryptographic key size for symmetric keys can be found in\n   ",{"type":182,"nodeName":206,"attributes":907,"children":909},{"href":908},"\u002Fbcp\u002Fbcp195",[910],{"type":187,"textContent":911},"BCP 195",{"type":187,"textContent":816},{"type":182,"nodeName":206,"attributes":914,"children":916},{"href":915},"\u002Finfo\u002Frfc7525\u002F",[917],{"type":187,"textContent":918},"RFC7525",{"type":187,"textContent":683},{"type":182,"nodeName":190,"attributes":921,"children":922},{"class":827},[923,927],{"type":182,"nodeName":206,"attributes":924,"children":925},{"class":630,"id":96,"href":375},[926],{"type":187,"textContent":378},{"type":187,"textContent":928},".  Providing Notice of Expected Changes",{"type":187,"textContent":930},"\n\n   Fortunately, algorithm failures without warning are rare.  More\n   often, algorithm transition is the result of age.  For example, the\n   transition from DES to Triple-DES to AES took place over decades,\n   causing a shift in symmetric block cipher strength from 56 bits to\n   112 bits to 128 bits.  Where possible, authors SHOULD provide notice\n   to implementers about expected algorithm transitions.  One approach\n   that was first used in ",{"type":182,"nodeName":206,"attributes":932,"children":934},{"href":933},"\u002Finfo\u002Frfc4307\u002F",[935],{"type":187,"textContent":936},"RFC 4307",{"type":187,"textContent":816},{"type":182,"nodeName":206,"attributes":939,"children":940},{"href":933},[941],{"type":187,"textContent":942},"RFC4307",{"type":187,"textContent":944},"] is to use SHOULD+, SHOULD-,\n   and MUST- in the specification of algorithms.  The definitions below\n   are slightly modified from those in ",{"type":182,"nodeName":206,"attributes":946,"children":947},{"href":933},[948],{"type":187,"textContent":936},{"type":187,"textContent":950},".\n\n      SHOULD+  This term means the same as SHOULD.  However, it is\n               likely that an algorithm marked as SHOULD+ will be\n               promoted to a MUST in the future.\n\n      SHOULD-  This term means the same as SHOULD.  However, it is\n               likely that an algorithm marked as SHOULD- will be\n               deprecated to a MAY or worse in the future.\n\n      MUST-    This term means the same as MUST.  However, it is\n               expected that an algorithm marked as MUST- will be\n               downgraded in the future.  Although the status of the\n               algorithm will be determined at a later time, it is\n               reasonable to expect that a the status of a MUST-\n               algorithm will remain at least a SHOULD or a SHOULD-.\n\n",{"type":182,"nodeName":190,"attributes":952,"children":953},{"class":666},[954,958],{"type":182,"nodeName":206,"attributes":955,"children":956},{"class":630,"id":101,"href":390},[957],{"type":187,"textContent":393},{"type":187,"textContent":959},".  Transitioning from Weak Algorithms",{"type":187,"textContent":961},"\n\n   Transition from an old algorithm that is found to be weak can be\n   tricky.  It is of course straightforward to specify the use of a new,\n   better algorithm.  And then, when the new algorithm is widely\n   deployed, the old algorithm ought no longer be used.  However,\n   knowledge about the implementation and deployment of the new\n   algorithm will always be imperfect, so one cannot be completely\n   assured of interoperability with the new algorithm.\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":963,"children":964},{"class":239},[965],{"type":187,"textContent":966},"Housley                   Best Current Practice                 [Page 6]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":969,"children":970},{"class":248},[],{"type":182,"nodeName":183,"attributes":972,"children":973},{"class":252},[974,978,979,987,989,993,995,1001,1003,1009,1010,1016,1018,1027,1029],{"type":182,"nodeName":190,"attributes":975,"children":977},{"id":976},"page-7",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":980,"children":981},{"class":239},[982,986],{"type":182,"nodeName":206,"attributes":983,"children":984},{"href":264},[985],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":988},"\n\n\n   Algorithm transition is naturally facilitated as part of an algorithm\n   selection or negotiation mechanism.  Protocols traditionally select\n   the best algorithm or suite that is supported by all communicating\n   peers and acceptable by their policies.  In addition, a mechanism is\n   needed to determine whether the new algorithm has been deployed.  For\n   example, SMIMECapabilities [",{"type":182,"nodeName":206,"attributes":990,"children":991},{"href":839},[992],{"type":187,"textContent":842},{"type":187,"textContent":994},"] allows S\u002FMIME mail user agents\n   to share the list of algorithms that they are willing to use in\n   preference order.  For another example, the DNSSEC EDNS0 option\n   [",{"type":182,"nodeName":206,"attributes":996,"children":998},{"href":997},"\u002Finfo\u002Frfc6975\u002F",[999],{"type":187,"textContent":1000},"RFC6975",{"type":187,"textContent":1002},"] measures the acceptance and use of new digital signing\n   algorithms.\n\n   In the Resource Public Key Infrastructure (RPKI), a globally\n   recognized digital signature is needed.  ",{"type":182,"nodeName":206,"attributes":1004,"children":1006},{"href":1005},"\u002Fbcp\u002Fbcp182",[1007],{"type":187,"textContent":1008},"BCP 182",{"type":187,"textContent":816},{"type":182,"nodeName":206,"attributes":1011,"children":1013},{"href":1012},"\u002Finfo\u002Frfc6916\u002F",[1014],{"type":187,"textContent":1015},"RFC6916",{"type":187,"textContent":1017},"] provides\n   an approach to transition, where a second signature algorithm is\n   introduced and then the original one is phased out.\n\n   In the worst case, the old algorithm may be found to be tragically\n   flawed, permitting a casual attacker to download a simple script to\n   break it.  Sadly, this has happened when a secure algorithm is used\n   incorrectly or used with poor key management, resulting in a weak\n   cryptographic algorithm suite.  In such situations, the protection\n   offered by the algorithm is severely compromised, perhaps to the\n   point that one wants to stop using the weak suite altogether,\n   rejecting offers to use the weak suite well before the new suite is\n   widely deployed.\n\n   In any case, there comes a point in time where one refuses to use the\n   old, weak algorithm or suite.  This can happen on a flag day, or each\n   installation can select a date on their own.\n\n",{"type":182,"nodeName":190,"attributes":1019,"children":1020},{"class":666},[1021,1025],{"type":182,"nodeName":206,"attributes":1022,"children":1023},{"class":630,"id":106,"href":403},[1024],{"type":187,"textContent":406},{"type":187,"textContent":1026},".  Algorithm Transition Mechanisms",{"type":187,"textContent":1028},"\n\n   Cryptographic algorithm selection or negotiation SHOULD be integrity\n   protected.  If selection is not integrity protected, then the\n   protocol will be subject to a downgrade attack.  Without integrity\n   protection of algorithm or suite selection, the attempt to transition\n   to a new algorithm or suite may introduce new opportunities for\n   downgrade attacks.\n\n   Transition mechanisms need to consider the algorithm that is used to\n   provide integrity protection for algorithm negotiation itself.\n\n   If a protocol specifies a single mandatory-to-implement integrity\n   algorithm, eventually that algorithm will be found to be weak.\n\n\n\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":1030,"children":1031},{"class":239},[1032],{"type":187,"textContent":1033},"Housley                   Best Current Practice                 [Page 7]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1036,"children":1037},{"class":248},[],{"type":182,"nodeName":183,"attributes":1039,"children":1040},{"class":252},[1041,1045,1046,1054,1056,1065,1067,1073,1075,1081,1083,1092,1094],{"type":182,"nodeName":190,"attributes":1042,"children":1044},{"id":1043},"page-8",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1047,"children":1048},{"class":239},[1049,1053],{"type":182,"nodeName":206,"attributes":1050,"children":1051},{"href":264},[1052],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":1055},"\n\n\n   Extra care is needed when a mandatory-to-implement algorithm is used\n   to provide integrity protection for the negotiation of other\n   cryptographic algorithms.  In this situation, a flaw in the\n   mandatory-to-implement algorithm may allow an attacker to influence\n   the choices of the other algorithms.\n\n",{"type":182,"nodeName":190,"attributes":1057,"children":1058},{"class":666},[1059,1063],{"type":182,"nodeName":206,"attributes":1060,"children":1061},{"class":630,"id":111,"href":418},[1062],{"type":187,"textContent":421},{"type":187,"textContent":1064},".  Cryptographic Key Establishment",{"type":187,"textContent":1066},"\n\n   Traditionally, protocol designers have avoided more than one approach\n   to exchanges that establish cryptographic keys because it makes the\n   security analysis of the overall protocol more difficult.  When\n   frameworks such as the Extensible Authentication Protocol (EAP)\n   [",{"type":182,"nodeName":206,"attributes":1068,"children":1070},{"href":1069},"\u002Finfo\u002Frfc3748\u002F",[1071],{"type":187,"textContent":1072},"RFC3748",{"type":187,"textContent":1074},"] and Simple Authentication and Security Layer (SASL)\n   [",{"type":182,"nodeName":206,"attributes":1076,"children":1078},{"href":1077},"\u002Finfo\u002Frfc4422\u002F",[1079],{"type":187,"textContent":1080},"RFC4422",{"type":187,"textContent":1082},"] are employed, key establishment is very flexible, often\n   hiding many of the details from the application.  This results in\n   protocols that support multiple key establishment approaches.  In\n   fact, the key establishment approach itself is negotiable, which\n   creates a design challenge to protect the negotiation of the key\n   establishment approach before it is used to produce cryptographic\n   keys.\n\n   Protocols can negotiate a key establishment approach, derive an\n   initial cryptographic key, and then authenticate the negotiation.\n   However, if the authentication fails, the only recourse is to start\n   the negotiation over from the beginning.\n\n   Some environments will restrict the key establishment approaches by\n   policy.  Such policies tend to improve interoperability within a\n   particular environment, but they cause problems for individuals that\n   need to work in multiple incompatible environments.\n\n",{"type":182,"nodeName":190,"attributes":1084,"children":1085},{"class":666},[1086,1090],{"type":182,"nodeName":206,"attributes":1087,"children":1088},{"class":630,"id":116,"href":433},[1089],{"type":187,"textContent":436},{"type":187,"textContent":1091},".  Preserving Interoperability",{"type":187,"textContent":1093},"\n\n   Cryptographic algorithm deprecation is very difficult.  People do not\n   like to introduce interoperability problems, even to preserve\n   security.  As a result, flawed algorithms are supported for far too\n   long.  The impact of legacy software and long support tails on\n   security can be reduced by making it easy to transition from old\n   algorithms and suites to new ones.  Social pressure is often needed\n   to cause the transition to happen.\n\n   Implementers have been reluctant to remove deprecated algorithms or\n   suites from server software, and server administrators have been\n   reluctant to disable them over concerns that some party will no\n   longer have the ability to connect to their server.  Implementers and\n   administrators want to improve security by using the best supported\n   algorithms, but their actions are tempered by the desire to preserve\n   connectivity.  Recently, some browser vendors have started to provide\n\n\n\n",{"type":182,"nodeName":190,"attributes":1095,"children":1096},{"class":239},[1097],{"type":187,"textContent":1098},"Housley                   Best Current Practice                 [Page 8]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1101,"children":1102},{"class":248},[],{"type":182,"nodeName":183,"attributes":1104,"children":1105},{"class":252},[1106,1110,1111,1119,1121,1127,1129,1138,1140],{"type":182,"nodeName":190,"attributes":1107,"children":1109},{"id":1108},"page-9",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1112,"children":1113},{"class":239},[1114,1118],{"type":182,"nodeName":206,"attributes":1115,"children":1116},{"href":264},[1117],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":1120},"\n\n\n   visual warnings when a deprecated algorithm or suite is used.  These\n   visual warnings provide a new incentive to transition away from\n   deprecated algorithms and suites, prompting customers to ask for\n   improved security.\n\n   Transition in Internet infrastructure is particularly difficult.  The\n   digital signature on the certificate for an intermediate\n   certification authority (CA) [",{"type":182,"nodeName":206,"attributes":1122,"children":1124},{"href":1123},"\u002Finfo\u002Frfc5280\u002F",[1125],{"type":187,"textContent":1126},"RFC5280",{"type":187,"textContent":1128},"] is often expected to last\n   decades, which hinders the transition away from a weak signature\n   algorithm or short key length.  Once a long-lived certificate is\n   issued with a particular signature algorithm, that algorithm will be\n   used by many relying parties, and none of them can stop supporting it\n   without invalidating all of the subordinate certificates.  In a\n   hierarchical system, many subordinate certificates could be impacted\n   by the decision to drop support for a weak signature algorithm or an\n   associated hash function.\n\n   Organizations that have a significant influence can assist by\n   coordinating the demise of an algorithm suite, making the transition\n   easier for their own users as well as others.\n\n",{"type":182,"nodeName":190,"attributes":1130,"children":1131},{"class":666},[1132,1136],{"type":182,"nodeName":206,"attributes":1133,"children":1134},{"class":630,"id":121,"href":446},[1135],{"type":187,"textContent":449},{"type":187,"textContent":1137},".  Balancing Security Strength",{"type":187,"textContent":1139},"\n\n   When selecting or negotiating a suite of cryptographic algorithms,\n   the strength of each algorithm SHOULD be considered.  The algorithms\n   in a suite SHOULD be roughly equal by providing comparable best-known\n   attack work factors.  However, the security service provided by each\n   algorithm in a particular context needs to be considered when making\n   the selection.  Algorithm strength needs to be considered at the time\n   a protocol is designed.  It also needs to be considered at the time a\n   protocol implementation is deployed and configured.  Advice from\n   experts is useful, but, in reality, such advice is often unavailable\n   to system administrators that are deploying a protocol\n   implementation.  For this reason, protocol designers SHOULD provide\n   clear guidance to implementers, leading to balanced options being\n   available at the time of deployment.\n\n   Performance is always a factor is selecting cryptographic algorithms.\n   Performance and security need to be balanced.  Some algorithms offer\n   flexibility in their strength by adjusting the key size, number of\n   rounds, authentication tag size, prime group size, and so on.  For\n   example, TLS cipher suites include Diffie-Hellman or RSA without\n   specifying a particular public key length.  If the algorithm\n   identifier or suite identifier named a particular public key length,\n   migration to longer ones would be more difficult.  On the other hand,\n   inclusion of a public key length would make it easier to migrate away\n   from short ones when computational resources available to attacker\n   dictate the need to do so.  The flexibility on asymmetric key length\n\n\n\n",{"type":182,"nodeName":190,"attributes":1141,"children":1142},{"class":239},[1143],{"type":187,"textContent":1144},"Housley                   Best Current Practice                 [Page 9]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1147,"children":1148},{"class":248},[],{"type":182,"nodeName":183,"attributes":1150,"children":1151},{"class":252},[1152,1156,1157,1165,1167,1171,1173,1182,1184,1189,1191,1200,1202,1207,1209,1215,1217,1223,1225],{"type":182,"nodeName":190,"attributes":1153,"children":1155},{"id":1154},"page-10",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1158,"children":1159},{"class":239},[1160,1164],{"type":182,"nodeName":206,"attributes":1161,"children":1162},{"href":264},[1163],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":1166},"\n\n\n   has led to interoperability problems, and to avoid these problems in\n   the future any aspect of the algorithm not specified by the algorithm\n   identifiers need to be negotiated, including key size and parameters.\n\n   In CMS [",{"type":182,"nodeName":206,"attributes":1168,"children":1169},{"href":847},[1170],{"type":187,"textContent":850},{"type":187,"textContent":1172},"], a previously distributed symmetric key-encryption\n   key can be used to encrypt a content-encryption key, which in turn is\n   used to encrypt the content.  The key-encryption and content-\n   encryption algorithms are often different.  If, for example, a\n   message content is encrypted with a 128-bit AES key and the content-\n   encryption key is wrapped with a 256-bit AES key, then at most 128\n   bits of protection is provided.  In this situation, the algorithm and\n   key size selections should ensure that the key encryption is at least\n   as strong as the content encryption.  In general, wrapping one key\n   with another key of a different size yields the security strength of\n   the shorter key.\n\n",{"type":182,"nodeName":190,"attributes":1174,"children":1175},{"class":666},[1176,1180],{"type":182,"nodeName":206,"attributes":1177,"children":1178},{"class":630,"id":126,"href":461},[1179],{"type":187,"textContent":464},{"type":187,"textContent":1181},".  Balancing Protocol Complexity",{"type":187,"textContent":1183},"\n\n   Protocol designs need to anticipate changes in the supported\n   cryptographic algorithm set over time.  There are a number of ways to\n   enable the transition, and ",{"type":182,"nodeName":206,"attributes":1185,"children":1186},{"href":489},[1187],{"type":187,"textContent":1188},"Section 3",{"type":187,"textContent":1190}," discusses some of the related\n   issues.\n\n   Keep implementations as simple as possible.  Complex protocol\n   negotiation provides opportunities for attack, such as downgrade\n   attacks.  Support for many algorithm alternatives is also harmful.\n   Both of these can lead to portions of the implementation that are\n   rarely used, increasing the opportunity for undiscovered exploitable\n   implementation bugs.\n\n",{"type":182,"nodeName":190,"attributes":1192,"children":1193},{"class":666},[1194,1198],{"type":182,"nodeName":206,"attributes":1195,"children":1196},{"class":630,"id":131,"href":476},[1197],{"type":187,"textContent":479},{"type":187,"textContent":1199},".  Opportunistic Security",{"type":187,"textContent":1201},"\n\n   Despite the guidance in ",{"type":182,"nodeName":206,"attributes":1203,"children":1204},{"href":403},[1205],{"type":187,"textContent":1206},"Section 2.4",{"type":187,"textContent":1208},", opportunistic security [",{"type":182,"nodeName":206,"attributes":1210,"children":1212},{"href":1211},"\u002Finfo\u002Frfc7435\u002F",[1213],{"type":187,"textContent":1214},"RFC7435",{"type":187,"textContent":1216},"]\n   also deserves consideration, especially at the time a protocol\n   implementation is deployed and configured.  Opportunistic security,\n   like other reasons for encrypting traffic, needs to make use of the\n   strongest encryption algorithms that are implemented and allowed by\n   policy.  When communicating parties do not have strong algorithms in\n   common, using algorithms that are weak against advanced attackers but\n   sufficient against others is one way to make pervasive surveillance\n   significantly more difficult.  As a result, when communicating\n   parties do not have strong algorithms in common, algorithms that\n   would not be acceptable in many negotiated situations are acceptable\n   for opportunistic security when legacy systems are in use for\n   unauthenticated encrypted sessions (as discussed in ",{"type":182,"nodeName":206,"attributes":1218,"children":1220},{"href":1219},"\u002Finfo\u002Frfc7435\u002F#section-3",[1221],{"type":187,"textContent":1222},"Section 3 of\n   [RFC7435]",{"type":187,"textContent":1224},") as long as their use does not facilitate downgrade\n   attacks.  Similarly, weaker algorithms and shorter key sizes are also\n   acceptable for opportunistic security with the same constraints.\n\n\n\n",{"type":182,"nodeName":190,"attributes":1226,"children":1227},{"class":239},[1228],{"type":187,"textContent":1229},"Housley                   Best Current Practice                [Page 10]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1232,"children":1233},{"class":248},[],{"type":182,"nodeName":183,"attributes":1235,"children":1236},{"class":252},[1237,1241,1242,1250,1252,1261,1263,1272,1274,1280,1282,1288,1290],{"type":182,"nodeName":190,"attributes":1238,"children":1240},{"id":1239},"page-11",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1243,"children":1244},{"class":239},[1245,1249],{"type":182,"nodeName":206,"attributes":1246,"children":1247},{"href":264},[1248],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":1251},"\n\n\n   That said, the use of strong algorithms is always preferable.\n\n",{"type":182,"nodeName":190,"attributes":1253,"children":1254},{"class":626},[1255,1259],{"type":182,"nodeName":206,"attributes":1256,"children":1257},{"class":630,"id":136,"href":489},[1258],{"type":187,"textContent":301},{"type":187,"textContent":1260},".  Cryptographic Algorithm Specifications",{"type":187,"textContent":1262},"\n\n   There are tradeoffs between the number of cryptographic algorithms\n   that are supported and the time to deploy a new algorithm.  This\n   section provides some of the insights about the tradeoff faced by\n   protocol designers.\n\n   Ideally, two independent sets of mandatory-to-implement algorithms\n   will be specified, allowing for a primary suite and a secondary\n   suite.  This approach ensures that the secondary suite is widely\n   deployed if a flaw is found in the primary one.\n\n",{"type":182,"nodeName":190,"attributes":1264,"children":1265},{"class":666},[1266,1270],{"type":182,"nodeName":206,"attributes":1267,"children":1268},{"class":630,"id":142,"href":503},[1269],{"type":187,"textContent":506},{"type":187,"textContent":1271},".  Choosing Mandatory-to-Implement Algorithms",{"type":187,"textContent":1273},"\n\n   It may seem as if the ability to use an algorithm of one's own\n   choosing is very desirable; however, the selection is often better\n   left to experts.  When there are choices, end-users might select\n   between configuration profiles that have been defined by experts.\n   Further, experts need not specify each and every cryptographic\n   algorithm alternative.  Specifying all possible choices will not lead\n   to them all being available in every implementation.  Mandatory-to-\n   implement algorithms MUST have a stable public specification and\n   public documentation that has been well studied, giving rise to\n   significant confidence.  The IETF has always had a preference for\n   unencumbered algorithms.  There are significant benefits in selecting\n   algorithms and suites that are widely deployed.  The selected\n   algorithms need to be resistant to side-channel attacks and also meet\n   the performance, power, and code size requirements on a wide variety\n   of platforms.  In addition, inclusion of too many alternatives may\n   add complexity to algorithm selection or negotiation.  Specification\n   of too many alternatives will likely hamper interoperability and may\n   hamper security as well.  When specifying new algorithms or suites,\n   protocol designers would be prudent to consider whether existing ones\n   can be deprecated.\n\n   There is significant benefit in selecting the same algorithms and\n   suites for different protocols.  Using the same algorithms can\n   simplify implementation when more than one of the protocols is used\n   in the same device or system.\n\n   Sometimes more than one mandatory-to-implement algorithm is needed to\n   increase the likelihood of interoperability among a diverse\n   population.  For example, authenticated encryption is provided by\n   AES-CCM [",{"type":182,"nodeName":206,"attributes":1275,"children":1277},{"href":1276},"\u002Finfo\u002Frfc3610\u002F",[1278],{"type":187,"textContent":1279},"RFC3610",{"type":187,"textContent":1281},"] and AES-GCM [",{"type":182,"nodeName":206,"attributes":1283,"children":1285},{"href":1284},"#ref-GCM",[1286],{"type":187,"textContent":1287},"GCM",{"type":187,"textContent":1289},"].  Both of these algorithms are\n   considered to be secure.  AES-CCM is available in hardware used by\n   many small devices, and AES-GCM is parallelizable and well suited to\n\n\n\n",{"type":182,"nodeName":190,"attributes":1291,"children":1292},{"class":239},[1293],{"type":187,"textContent":1294},"Housley                   Best Current Practice                [Page 11]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1297,"children":1298},{"class":248},[],{"type":182,"nodeName":183,"attributes":1300,"children":1301},{"class":252},[1302,1306,1307,1315,1317,1326,1328,1334,1335,1340,1342],{"type":182,"nodeName":190,"attributes":1303,"children":1305},{"id":1304},"page-12",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1308,"children":1309},{"class":239},[1310,1314],{"type":182,"nodeName":206,"attributes":1311,"children":1312},{"href":264},[1313],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":1316},"\n\n\n   high-speed devices.  Therefore, an application needing authenticated\n   encryption might specify one of these algorithms or both of these\n   algorithms, depending on the population.\n\n",{"type":182,"nodeName":190,"attributes":1318,"children":1319},{"class":666},[1320,1324],{"type":182,"nodeName":206,"attributes":1321,"children":1322},{"class":630,"id":147,"href":516},[1323],{"type":187,"textContent":519},{"type":187,"textContent":1325},".  Too Many Choices Can Be Harmful",{"type":187,"textContent":1327},"\n\n   It is fairly easy to specify the use of any arbitrary cryptographic\n   algorithm, and once the specification is available, the algorithm\n   gets implemented and deployed.  Some people say that the freedom to\n   specify algorithms independently from the rest of the protocol has\n   led to the specification of too many cryptographic algorithms.  Once\n   deployed, even with moderate uptake, it is quite difficult to remove\n   algorithms because interoperability with some party will be impacted.\n   As a result, weaker ciphers stick around far too long.  Sometimes\n   implementers are forced to maintain cryptographic algorithm\n   implementations well beyond their useful lifetime.\n\n   In order to manage the proliferation of algorithm choices and provide\n   an expectation of interoperability, many protocols specify mandatory-\n   to-implement algorithms or suites.  All implementers are expected to\n   support the mandatory-to-implement cryptographic algorithm, and they\n   can include any others algorithms that they desire.  The mandatory-\n   to-implement algorithms are chosen to be highly secure and follow the\n   guidance in ",{"type":182,"nodeName":206,"attributes":1329,"children":1331},{"href":1330},"\u002Finfo\u002Frfc1984\u002F",[1332],{"type":187,"textContent":1333},"RFC 1984",{"type":187,"textContent":816},{"type":182,"nodeName":206,"attributes":1336,"children":1337},{"href":1330},[1338],{"type":187,"textContent":1339},"RFC1984",{"type":187,"textContent":1341},"].  Of course, many other factors,\n   including intellectual property rights, have an impact on the\n   cryptographic algorithms that are selected by the community.\n   Generally, the mandatory-to-implement algorithms ought to be\n   preferred, and the other algorithms ought to be selected only in\n   special situations.  However, it can be very difficult for a skilled\n   system administrator to determine the proper configuration to achieve\n   these preferences.\n\n   In some cases, more than one mandatory-to-implement cryptographic\n   algorithm has been specified.  This is intended to ensure that at\n   least one secure cryptographic algorithm will be available, even if\n   other mandatory-to-implement algorithms are broken.  To achieve this\n   goal, the selected algorithms must be diverse, so that a\n   cryptoanalytic advance against one of the algorithms does not also\n   impact the other selected algorithms.  The idea is to have an\n   implemented and deployed algorithm as a fallback.  However, all of\n   the selected algorithms need to be routinely exercised to ensure\n   quality implementation.  This is not always easy to do, especially if\n   the various selected algorithms require different credentials.\n   Obtaining multiple credentials for the same installation is an\n   unacceptable burden on system administrators.  Also, the manner by\n   which system administrators are advised to switch algorithms or\n   suites is, at best, ad hoc and, at worst, entirely absent.\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":1343,"children":1344},{"class":239},[1345],{"type":187,"textContent":1346},"Housley                   Best Current Practice                [Page 12]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1349,"children":1350},{"class":248},[],{"type":182,"nodeName":183,"attributes":1352,"children":1353},{"class":252},[1354,1358,1359,1367,1368,1377,1379,1385,1387,1393,1395],{"type":182,"nodeName":190,"attributes":1355,"children":1357},{"id":1356},"page-13",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1360,"children":1361},{"class":239},[1362,1366],{"type":182,"nodeName":206,"attributes":1363,"children":1364},{"href":264},[1365],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":721},{"type":182,"nodeName":190,"attributes":1369,"children":1370},{"class":666},[1371,1375],{"type":182,"nodeName":206,"attributes":1372,"children":1373},{"class":630,"id":152,"href":531},[1374],{"type":187,"textContent":534},{"type":187,"textContent":1376},".  Picking One True Cipher Suite Can Be Harmful",{"type":187,"textContent":1378},"\n\n   In the past, protocol designers have chosen one cryptographic\n   algorithm or suite, and then tied many protocol details to that\n   selection.  Plan for algorithm transition, either because a mistake\n   is made in the initial selection or because the protocol is\n   successfully used for a long time and the algorithm becomes weak with\n   age.  Either way, the design should enable transition.\n\n   Protocol designers are sometimes misled by the simplicity that\n   results from selecting one true algorithm or suite.  Since algorithms\n   age, the selection cannot be stable forever.  Even the most simple\n   protocol needs a version number to signal which algorithm is being\n   used.  This approach has at least two desirable consequences.  First,\n   the protocol is simpler because there is no need for algorithm\n   negotiation.  Second, system administrators do not need to make any\n   algorithm-related configuration decisions.  However, the only way to\n   respond to news that an algorithm that is part of the one true cipher\n   suite has been broken is to update the protocol specification to the\n   next version, implement the new specification, and then get it\n   deployed.\n\n   The first IEEE 802.11 [",{"type":182,"nodeName":206,"attributes":1380,"children":1382},{"href":1381},"#ref-WiFi",[1383],{"type":187,"textContent":1384},"WiFi",{"type":187,"textContent":1386},"] specification included Wired Equivalent\n   Privacy (WEP) as the only encryption technique.  Many of the protocol\n   details were driven by the selected algorithm.  WEP was found to be\n   quite weak [",{"type":182,"nodeName":206,"attributes":1388,"children":1390},{"href":1389},"#ref-WEP",[1391],{"type":187,"textContent":1392},"WEP",{"type":187,"textContent":1394},"], and a very large effort was needed to specify,\n   implement, and deploy the alternative encryption techniques.  This\n   effort was made even harder by the protocol design choices that were\n   tied to the initial algorithm selection and the desire for backward\n   compatibility.\n\n   Experience with the transition from SHA-1 to SHA-256 indicates that\n   the time from protocol specification to widespread use takes more\n   than five years.  In this case, the protocol specifications and\n   implementation were straightforward and fairly prompt.  In many\n   software products, the new algorithm was not considered an update to\n   the existing release, so the roll-out of the next release, subsequent\n   deployment, and finally adjustment of the configuration by system\n   administrators took many years.  In many consumer hardware products,\n   firmware to implement the new algorithm was difficult to locate and\n   install, or it was simply not available.  Further, infrastructure\n   providers were unwilling to make the transition until all of their\n   potential clients were able to use the new algorithm.\n\n\n\n\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":1396,"children":1397},{"class":239},[1398],{"type":187,"textContent":1399},"Housley                   Best Current Practice                [Page 13]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1402,"children":1403},{"class":248},[],{"type":182,"nodeName":183,"attributes":1405,"children":1406},{"class":252},[1407,1411,1412,1420,1421,1430,1432,1441,1443,1447,1449,1455,1457],{"type":182,"nodeName":190,"attributes":1408,"children":1410},{"id":1409},"page-14",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1413,"children":1414},{"class":239},[1415,1419],{"type":182,"nodeName":206,"attributes":1416,"children":1417},{"href":264},[1418],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":721},{"type":182,"nodeName":190,"attributes":1422,"children":1423},{"class":666},[1424,1428],{"type":182,"nodeName":206,"attributes":1425,"children":1426},{"class":630,"id":157,"href":546},[1427],{"type":187,"textContent":549},{"type":187,"textContent":1429},".  National Cipher Suites",{"type":187,"textContent":1431},"\n\n   Some nations specify cryptographic algorithms, and then require their\n   use through legislation or regulations.  These algorithms may not\n   have wide public review, and they can have limited geographic scope\n   in their deployment.  Yet, the legislative or regulatory mandate\n   creates a captive market.  As a result, such algorithms will get\n   specified, implemented, and deployed.  The default server or\n   responder configuration SHOULD disable such algorithms; in this way,\n   explicit action by the system administrator is needed to enable them\n   where they are actually required.  For tiny devices with no user\n   interface, an administrator action may only be possible at the time\n   the device is purchased.\n\n   National algorithms can force an implementer to produce several\n   incompatible product releases for different countries or regions;\n   this has significantly greater cost over development of a product\n   using a globally acceptable algorithm.  This situation could be even\n   worse if the various national algorithms impose different\n   requirements on the protocol, its key management, or its use of\n   random values.\n\n",{"type":182,"nodeName":190,"attributes":1433,"children":1434},{"class":626},[1435,1439],{"type":182,"nodeName":206,"attributes":1436,"children":1437},{"class":630,"id":162,"href":561},[1438],{"type":187,"textContent":329},{"type":187,"textContent":1440},".  Security Considerations",{"type":187,"textContent":1442},"\n\n   This document provides guidance to working groups and protocol\n   designers.  The security of the Internet is improved when broken or\n   weak cryptographic algorithms can be easily replaced with strong\n   ones.\n\n   From a software development and maintenance perspective,\n   cryptographic algorithms can often be added and removed without\n   making changes to surrounding data structures, protocol parsing\n   routines, or state machines.  This approach separates the\n   cryptographic algorithm implementation from the rest of the code,\n   which makes it easier to tackle special security concerns such as key\n   exposure and constant-time execution.\n\n   Sometimes application-layer protocols can make use of transport-layer\n   security protocols, such as TLS [",{"type":182,"nodeName":206,"attributes":1444,"children":1445},{"href":735},[1446],{"type":187,"textContent":738},{"type":187,"textContent":1448},"] or Datagram TLS (DTLS)\n   [",{"type":182,"nodeName":206,"attributes":1450,"children":1452},{"href":1451},"\u002Finfo\u002Frfc6347\u002F",[1453],{"type":187,"textContent":1454},"RFC6347",{"type":187,"textContent":1456},"].  This insulates the application-layer protocol from the\n   details of cryptography, but it is likely to still be necessary to\n   handle the transition from unprotected traffic to protected traffic\n   in the application-layer protocol.  In addition, the application-\n   layer protocol may need to handle the downgrade from encrypted\n   communication to plaintext communication.\n\n\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":1458,"children":1459},{"class":239},[1460],{"type":187,"textContent":1461},"Housley                   Best Current Practice                [Page 14]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1464,"children":1465},{"class":248},[],{"type":182,"nodeName":183,"attributes":1467,"children":1468},{"class":252},[1469,1473,1474,1482,1484,1490,1492,1498,1500,1506,1508,1514,1516,1520,1522,1527,1529],{"type":182,"nodeName":190,"attributes":1470,"children":1472},{"id":1471},"page-15",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1475,"children":1476},{"class":239},[1477,1481],{"type":182,"nodeName":206,"attributes":1478,"children":1479},{"href":264},[1480],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":1483},"\n\n\n   Hardware offers challenges in the transition of algorithms, for both\n   tiny devices and very high-end data center equipment.  Many tiny\n   devices do not include the ability to update the firmware at all.\n   Even if the firmware can be updated, tiny devices are often deployed\n   in places that make it very inconvenient to do so.  High-end data\n   center equipment may use special-purpose chips to achieve very high\n   performance, which means that board-level replacement may be needed\n   to change the algorithm.  Cost and downtime are both factors in such\n   an upgrade.\n\n   In most cases, the cryptographic algorithm remains strong, but an\n   attack is found against the way that the strong algorithm is used in\n   a particular protocol.  In these cases, a protocol change will\n   probably be needed.  For example, the order of cryptographic\n   operations in the TLS protocol has evolved as various attacks have\n   been discovered.  Originally, TLS performed encryption after\n   computation of the message authentication code (MAC).  This order of\n   operations is called MAC-then-encrypt, which actually involves MAC\n   computation, padding, and then encryption.  This is no longer\n   considered secure [",{"type":182,"nodeName":206,"attributes":1485,"children":1487},{"href":1486},"#ref-BN",[1488],{"type":187,"textContent":1489},"BN",{"type":187,"textContent":1491},"] [",{"type":182,"nodeName":206,"attributes":1493,"children":1495},{"href":1494},"#ref-K",[1496],{"type":187,"textContent":1497},"K",{"type":187,"textContent":1499},"].  As a result, a mechanism was specified\n   to use encrypt-then-MAC instead [",{"type":182,"nodeName":206,"attributes":1501,"children":1503},{"href":1502},"\u002Finfo\u002Frfc7366\u002F",[1504],{"type":187,"textContent":1505},"RFC7366",{"type":187,"textContent":1507},"].  Future versions of TLS\n   are expected to use exclusively authenticated encryption algorithms\n   [",{"type":182,"nodeName":206,"attributes":1509,"children":1511},{"href":1510},"\u002Finfo\u002Frfc5116\u002F",[1512],{"type":187,"textContent":1513},"RFC5116",{"type":187,"textContent":1515},"], which should resolve the ordering discussion altogether.\n   After discovery of such attacks, updating the cryptographic\n   algorithms is not likely to be sufficient to thwart the new attack.\n   It may necessary to make significant changes to the protocol.\n\n   Some protocols are used to protect stored data.  For example, S\u002FMIME\n   [",{"type":182,"nodeName":206,"attributes":1517,"children":1518},{"href":839},[1519],{"type":187,"textContent":842},{"type":187,"textContent":1521},"] can protect a message kept in a mailbox.  To recover the\n   protected stored data, protocol implementations need to support older\n   algorithms, even when they no longer use the older algorithms for the\n   protection of new stored data.\n\n   Support for too many algorithms can lead to implementation\n   vulnerabilities.  When many algorithms are supported, some of them\n   will be rarely used.  Any code that is rarely used can contain\n   undetected bugs, and algorithm implementations are no different.\n   Measurements SHOULD be used to determine whether implemented\n   algorithms are actually being used, and if they are not, future\n   releases should remove them.  In addition, unused algorithms or\n   suites SHOULD be marked as deprecated in the IANA registry.  In\n   short, eliminate the cruft.\n\n   ",{"type":182,"nodeName":206,"attributes":1523,"children":1524},{"href":390},[1525],{"type":187,"textContent":1526},"Section 2.3",{"type":187,"textContent":1528}," talks about algorithm transition without considering any\n   other aspects of the protocol design.  In practice, there are\n   dependencies between the cryptographic algorithm and other aspects of\n\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":1530,"children":1531},{"class":239},[1532],{"type":187,"textContent":1533},"Housley                   Best Current Practice                [Page 15]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1536,"children":1537},{"class":248},[],{"type":182,"nodeName":183,"attributes":1539,"children":1540},{"class":252},[1541,1545,1546,1554,1556,1562,1564,1568,1570,1579,1581,1590,1592,1597,1599,1605,1607,1612,1614,1620,1622,1627,1629,1633,1634,1639,1641,1647,1649,1658,1659,1664,1666,1672,1674,1679,1681],{"type":182,"nodeName":190,"attributes":1542,"children":1544},{"id":1543},"page-16",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1547,"children":1548},{"class":239},[1549,1553],{"type":182,"nodeName":206,"attributes":1550,"children":1551},{"href":264},[1552],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":1555},"\n\n\n   the protocol.  For example, the BEAST attack [",{"type":182,"nodeName":206,"attributes":1557,"children":1559},{"href":1558},"#ref-BEAST",[1560],{"type":187,"textContent":1561},"BEAST",{"type":187,"textContent":1563},"] against TLS\n   [",{"type":182,"nodeName":206,"attributes":1565,"children":1566},{"href":735},[1567],{"type":187,"textContent":738},{"type":187,"textContent":1569},"] caused many sites to turn off modern cryptographic\n   algorithms in favor of older and clearly weaker algorithms.\n\n   Mechanisms for timely update of devices are needed to deploy a\n   replacement algorithm or suite.  It takes a long time to specify,\n   implement, and deploy a replacement; therefore, the transition\n   process needs to begin when practically exploitable flaws become\n   known.  The update processes on some devices involve certification,\n   which further increases the time to deploy a replacement.  For\n   example, devices that are part of health or safety systems often\n   require certification before deployment.  Embedded systems and SCADA\n   (supervisory control and data acquisition) systems often have upgrade\n   cycles stretching over many years, leading to similar time-to-\n   deployment issues.  Prompt action is needed if a replacement has any\n   hope of being deployed before exploitation techniques become widely\n   available.\n\n",{"type":182,"nodeName":190,"attributes":1571,"children":1572},{"class":626},[1573,1577],{"type":182,"nodeName":206,"attributes":1574,"children":1575},{"class":630,"id":167,"href":573},[1576],{"type":187,"textContent":344},{"type":187,"textContent":1578},".  IANA Considerations",{"type":187,"textContent":1580},"\n\n   This document does not establish any new IANA registries, nor does it\n   add any entries to existing registries.\n\n   This document does RECOMMEND a convention for new registries for\n   cryptographic algorithm or suite identifiers.  Once an algorithm or\n   suite identifier is added to the registry, it SHOULD NOT be changed\n   or removed.  However, it is desirable to include a means of marking a\n   registry entry as deprecated when implementation is no longer\n   advisable.\n\n",{"type":182,"nodeName":190,"attributes":1582,"children":1583},{"class":626},[1584,1588],{"type":182,"nodeName":206,"attributes":1585,"children":1586},{"class":630,"id":172,"href":587},[1587],{"type":187,"textContent":386},{"type":187,"textContent":1589},".  Normative References",{"type":187,"textContent":1591},"\n\n   [",{"type":182,"nodeName":206,"attributes":1593,"children":1595},{"id":1594},"ref-RFC2119",[1596],{"type":187,"textContent":681},{"type":187,"textContent":1598},"] Bradner, S., \"Key words for use in RFCs to Indicate\n             Requirement Levels\", ",{"type":182,"nodeName":206,"attributes":1600,"children":1602},{"href":1601},"\u002Fbcp\u002Fbcp14",[1603],{"type":187,"textContent":1604},"BCP 14",{"type":187,"textContent":1606},", ",{"type":182,"nodeName":206,"attributes":1608,"children":1609},{"href":678},[1610],{"type":187,"textContent":1611},"RFC 2119",{"type":187,"textContent":1613},",\n             DOI 10.17487\u002FRFC2119, March 1997,\n             \u003C",{"type":182,"nodeName":206,"attributes":1615,"children":1617},{"href":1616},"\u002Finfo\u002Frfc2119",[1618],{"type":187,"textContent":1619},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc2119",{"type":187,"textContent":1621},">.\n\n   [",{"type":182,"nodeName":206,"attributes":1623,"children":1625},{"id":1624},"ref-RFC3766",[1626],{"type":187,"textContent":903},{"type":187,"textContent":1628},"] Orman, H. and P. Hoffman, \"Determining Strengths For Public\n             Keys Used For Exchanging Symmetric Keys\", ",{"type":182,"nodeName":206,"attributes":1630,"children":1631},{"href":893},[1632],{"type":187,"textContent":896},{"type":187,"textContent":1606},{"type":182,"nodeName":206,"attributes":1635,"children":1636},{"href":900},[1637],{"type":187,"textContent":1638},"RFC 3766",{"type":187,"textContent":1640},",\n             DOI 10.17487\u002FRFC3766, April 2004,\n             \u003C",{"type":182,"nodeName":206,"attributes":1642,"children":1644},{"href":1643},"\u002Finfo\u002Frfc3766",[1645],{"type":187,"textContent":1646},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc3766",{"type":187,"textContent":1648},">.\n\n",{"type":182,"nodeName":190,"attributes":1650,"children":1651},{"class":626},[1652,1656],{"type":182,"nodeName":206,"attributes":1653,"children":1654},{"class":630,"id":177,"href":599},[1655],{"type":187,"textContent":414},{"type":187,"textContent":1657},".  Informative References",{"type":187,"textContent":1591},{"type":182,"nodeName":206,"attributes":1660,"children":1662},{"id":1661},"ref-BEAST",[1663],{"type":187,"textContent":1561},{"type":187,"textContent":1665},"]   Wikipedia, \"BEAST attack\" under \"Transport Layer Security\",\n             November 2015, \u003C",{"type":182,"nodeName":206,"attributes":1667,"children":1669},{"href":1668},"https:\u002F\u002Fen.wikipedia.org\u002Fw\u002Findex.php?title=Transport_Layer_Security&oldid=689441642#BEAST_attack",[1670],{"type":187,"textContent":1671},"https:\u002F\u002Fen.wikipedia.org\u002Fw\u002Findex.php?title=",{"type":187,"textContent":1673},"\n             ",{"type":182,"nodeName":206,"attributes":1675,"children":1676},{"href":1668},[1677],{"type":187,"textContent":1678},"Transport_Layer_Security&oldid=689441642#BEAST_attack",{"type":187,"textContent":1680},">.\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":1682,"children":1683},{"class":239},[1684],{"type":187,"textContent":1685},"Housley                   Best Current Practice                [Page 16]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1688,"children":1689},{"class":248},[],{"type":182,"nodeName":183,"attributes":1691,"children":1692},{"class":252},[1693,1697,1698,1706,1708,1713,1715,1720,1722,1727,1729,1734,1736,1742,1743,1747,1749,1755,1756,1761,1763,1767,1769,1774,1776,1782,1783,1788,1790,1795,1797,1803,1804,1809,1811,1816,1818,1824,1825,1830,1832,1837,1839,1845,1846,1851,1853,1858,1860,1866,1867,1872,1874,1878,1880,1886,1888],{"type":182,"nodeName":190,"attributes":1694,"children":1696},{"id":1695},"page-17",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1699,"children":1700},{"class":239},[1701,1705],{"type":182,"nodeName":206,"attributes":1702,"children":1703},{"href":264},[1704],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":1707},"\n\n\n   [",{"type":182,"nodeName":206,"attributes":1709,"children":1711},{"id":1710},"ref-BN",[1712],{"type":187,"textContent":1489},{"type":187,"textContent":1714},"]      Bellare, M. and C. Namprempre, \"Authenticated Encryption:\n             Relations among notions and analysis of the generic\n             composition paradigm\", Proceedings of AsiaCrypt '00,\n             Springer-Verlag LNCS No. 1976, p. 531,\n             DOI 10.1007\u002F3-540-44448-3_41, December 2000.\n\n   [",{"type":182,"nodeName":206,"attributes":1716,"children":1718},{"id":1717},"ref-GCM",[1719],{"type":187,"textContent":1287},{"type":187,"textContent":1721},"]     Dworkin, M, \"Recommendation for Block Cipher Modes of\n             Operation: Galois\u002FCounter Mode (GCM) and GMAC\", NIST\n             Special Publication 800-30D, November 2007.\n\n   [",{"type":182,"nodeName":206,"attributes":1723,"children":1725},{"id":1724},"ref-K",[1726],{"type":187,"textContent":1497},{"type":187,"textContent":1728},"]       Krawczyk, H., \"The Order of Encryption and Authentication\n             for Protecting Communications (or: How Secure Is SSL?)\",\n             Proceedings of Crypto '01, Springer-Verlag LNCS No. 2139,\n             p. 310, DOI 10.1007\u002F3-540-44647-8_19, August 2001.\n\n   [",{"type":182,"nodeName":206,"attributes":1730,"children":1732},{"id":1731},"ref-RFC1984",[1733],{"type":187,"textContent":1339},{"type":187,"textContent":1735},"] IAB and IESG, \"IAB and IESG Statement on Cryptographic\n             Technology and the Internet\", ",{"type":182,"nodeName":206,"attributes":1737,"children":1739},{"href":1738},"\u002Fbcp\u002Fbcp200",[1740],{"type":187,"textContent":1741},"BCP 200",{"type":187,"textContent":1606},{"type":182,"nodeName":206,"attributes":1744,"children":1745},{"href":1330},[1746],{"type":187,"textContent":1333},{"type":187,"textContent":1748},",\n             DOI 10.17487\u002FRFC1984, August 1996,\n             \u003C",{"type":182,"nodeName":206,"attributes":1750,"children":1752},{"href":1751},"\u002Finfo\u002Frfc1984",[1753],{"type":187,"textContent":1754},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc1984",{"type":187,"textContent":1621},{"type":182,"nodeName":206,"attributes":1757,"children":1759},{"id":1758},"ref-RFC3365",[1760],{"type":187,"textContent":822},{"type":187,"textContent":1762},"] Schiller, J., \"Strong Security Requirements for Internet\n             Engineering Task Force Standard Protocols\", ",{"type":182,"nodeName":206,"attributes":1764,"children":1765},{"href":811},[1766],{"type":187,"textContent":814},{"type":187,"textContent":1768},",\n             ",{"type":182,"nodeName":206,"attributes":1770,"children":1771},{"href":819},[1772],{"type":187,"textContent":1773},"RFC 3365",{"type":187,"textContent":1775},", DOI 10.17487\u002FRFC3365, August 2002,\n             \u003C",{"type":182,"nodeName":206,"attributes":1777,"children":1779},{"href":1778},"\u002Finfo\u002Frfc3365",[1780],{"type":187,"textContent":1781},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc3365",{"type":187,"textContent":1621},{"type":182,"nodeName":206,"attributes":1784,"children":1786},{"id":1785},"ref-RFC3610",[1787],{"type":187,"textContent":1279},{"type":187,"textContent":1789},"] Whiting, D., Housley, R., and N. Ferguson, \"Counter with\n             CBC-MAC (CCM)\", ",{"type":182,"nodeName":206,"attributes":1791,"children":1792},{"href":1276},[1793],{"type":187,"textContent":1794},"RFC 3610",{"type":187,"textContent":1796},", DOI 10.17487\u002FRFC3610, September\n             2003, \u003C",{"type":182,"nodeName":206,"attributes":1798,"children":1800},{"href":1799},"\u002Finfo\u002Frfc3610",[1801],{"type":187,"textContent":1802},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc3610",{"type":187,"textContent":1621},{"type":182,"nodeName":206,"attributes":1805,"children":1807},{"id":1806},"ref-RFC3748",[1808],{"type":187,"textContent":1072},{"type":187,"textContent":1810},"] Aboba, B., Blunk, L., Vollbrecht, J., Carlson, J., and H.\n             Levkowetz, Ed., \"Extensible Authentication Protocol (EAP)\",\n             ",{"type":182,"nodeName":206,"attributes":1812,"children":1813},{"href":1069},[1814],{"type":187,"textContent":1815},"RFC 3748",{"type":187,"textContent":1817},", DOI 10.17487\u002FRFC3748, June 2004,\n             \u003C",{"type":182,"nodeName":206,"attributes":1819,"children":1821},{"href":1820},"\u002Finfo\u002Frfc3748",[1822],{"type":187,"textContent":1823},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc3748",{"type":187,"textContent":1621},{"type":182,"nodeName":206,"attributes":1826,"children":1828},{"id":1827},"ref-RFC4302",[1829],{"type":187,"textContent":754},{"type":187,"textContent":1831},"] Kent, S., \"IP Authentication Header\", ",{"type":182,"nodeName":206,"attributes":1833,"children":1834},{"href":751},[1835],{"type":187,"textContent":1836},"RFC 4302",{"type":187,"textContent":1838},",\n             DOI 10.17487\u002FRFC4302, December 2005,\n             \u003C",{"type":182,"nodeName":206,"attributes":1840,"children":1842},{"href":1841},"\u002Finfo\u002Frfc4302",[1843],{"type":187,"textContent":1844},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc4302",{"type":187,"textContent":1621},{"type":182,"nodeName":206,"attributes":1847,"children":1849},{"id":1848},"ref-RFC4303",[1850],{"type":187,"textContent":762},{"type":187,"textContent":1852},"] Kent, S., \"IP Encapsulating Security Payload (ESP)\",\n             ",{"type":182,"nodeName":206,"attributes":1854,"children":1855},{"href":759},[1856],{"type":187,"textContent":1857},"RFC 4303",{"type":187,"textContent":1859},", DOI 10.17487\u002FRFC4303, December 2005,\n             \u003C",{"type":182,"nodeName":206,"attributes":1861,"children":1863},{"href":1862},"\u002Finfo\u002Frfc4303",[1864],{"type":187,"textContent":1865},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc4303",{"type":187,"textContent":1621},{"type":182,"nodeName":206,"attributes":1868,"children":1870},{"id":1869},"ref-RFC4307",[1871],{"type":187,"textContent":942},{"type":187,"textContent":1873},"] Schiller, J., \"Cryptographic Algorithms for Use in the\n             Internet Key Exchange Version 2 (IKEv2)\", ",{"type":182,"nodeName":206,"attributes":1875,"children":1876},{"href":933},[1877],{"type":187,"textContent":936},{"type":187,"textContent":1879},",\n             DOI 10.17487\u002FRFC4307, December 2005,\n             \u003C",{"type":182,"nodeName":206,"attributes":1881,"children":1883},{"href":1882},"\u002Finfo\u002Frfc4307",[1884],{"type":187,"textContent":1885},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc4307",{"type":187,"textContent":1887},">.\n\n\n\n\n\n",{"type":182,"nodeName":190,"attributes":1889,"children":1890},{"class":239},[1891],{"type":187,"textContent":1892},"Housley                   Best Current Practice                [Page 17]",{"type":187,"textContent":244},{"type":182,"nodeName":246,"attributes":1895,"children":1896},{"class":248},[],{"type":182,"nodeName":183,"attributes":1898,"children":1899},{"class":252},[1900,1904,1905,1913,1914,1919,1921,1926,1928,1934,1935,1940,1942,1947,1949,1955,1956,1961,1963,1968,1970,1976,1977,1982,1984,1989,1991,1997,1998,2003,2005,2010,2012,2018,2019,2024,2026,2031,2033,2039,2040,2045,2047,2052,2054,2060,2061,2066,2068,2072,2073,2078,2080,2086,2087,2092,2094,2099,2101,2107,2108,2113,2115,2120,2122,2128,2129],{"type":182,"nodeName":190,"attributes":1901,"children":1903},{"id":1902},"page-18",[],{"type":187,"textContent":244},{"type":182,"nodeName":190,"attributes":1906,"children":1907},{"class":239},[1908,1912],{"type":182,"nodeName":206,"attributes":1909,"children":1910},{"href":264},[1911],{"type":187,"textContent":267},{"type":187,"textContent":269},{"type":187,"textContent":1707},{"type":182,"nodeName":206,"attributes":1915,"children":1917},{"id":1916},"ref-RFC4422",[1918],{"type":187,"textContent":1080},{"type":187,"textContent":1920},"] Melnikov, A., Ed., and K. Zeilenga, Ed., \"Simple\n             Authentication and Security Layer (SASL)\", ",{"type":182,"nodeName":206,"attributes":1922,"children":1923},{"href":1077},[1924],{"type":187,"textContent":1925},"RFC 4422",{"type":187,"textContent":1927},",\n             DOI 10.17487\u002FRFC4422, June 2006,\n             \u003C",{"type":182,"nodeName":206,"attributes":1929,"children":1931},{"href":1930},"\u002Finfo\u002Frfc4422",[1932],{"type":187,"textContent":1933},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc4422",{"type":187,"textContent":1621},{"type":182,"nodeName":206,"attributes":1936,"children":1938},{"id":1937},"ref-RFC5116",[1939],{"type":187,"textContent":1513},{"type":187,"textContent":1941},"] McGrew, D., \"An Interface and Algorithms for Authenticated\n             Encryption\", ",{"type":182,"nodeName":206,"attributes":1943,"children":1944},{"href":1510},[1945],{"type":187,"textContent":1946},"RFC 5116",{"type":187,"textContent":1948},", DOI 10.17487\u002FRFC5116, January 2008,\n             \u003C",{"type":182,"nodeName":206,"attributes":1950,"children":1952},{"href":1951},"\u002Finfo\u002Frfc5116",[1953],{"type":187,"textContent":1954},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc5116",{"type":187,"textContent":1621},{"type":182,"nodeName":206,"attributes":1957,"children":1959},{"id":1958},"ref-RFC5246",[1960],{"type":187,"textContent":738},{"type":187,"textContent":1962},"] Dierks, T. and E. Rescorla, \"The Transport Layer Security\n             (TLS) Protocol Version 1.2\", ",{"type":182,"nodeName":206,"attributes":1964,"children":1965},{"href":735},[1966],{"type":187,"textContent":1967},"RFC 5246",{"type":187,"textContent":1969},",\n             DOI 10.17487\u002FRFC5246, August 2008,\n             \u003C",{"type":182,"nodeName":206,"attributes":1971,"children":1973},{"href":1972},"\u002Finfo\u002Frfc5246",[1974],{"type":187,"textContent":1975},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc5246",{"type":187,"textContent":1621},{"type":182,"nodeName":206,"attributes":1978,"children":1980},{"id":1979},"ref-RFC5280",[1981],{"type":187,"textContent":1126},{"type":187,"textContent":1983},"] Cooper, D., Santesson, S., Farrell, S., Boeyen, S.,\n             Housley, R., and W. Polk, \"Internet X.509 Public Key\n             Infrastructure Certificate and Certificate Revocation List\n             (CRL) Profile\", ",{"type":182,"nodeName":206,"attributes":1985,"children":1986},{"href":1123},[1987],{"type":187,"textContent":1988},"RFC 5280",{"type":187,"textContent":1990},", DOI 10.17487\u002FRFC5280, May 2008,\n             \u003C",{"type":182,"nodeName":206,"attributes":1992,"ch