		<script>
			window.StarlightThemeProvider = (() => {
				const storedTheme =
					typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
				const theme =
					storedTheme ||
					(window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
				document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
				window.addEventListener('beforeprint', () => {
					if (document.documentElement.dataset.theme !== 'dark') return;
					document.documentElement.dataset.theme = 'light';
					document.documentElement.dataset.printRestoreTheme = 'dark';
				});
				window.addEventListener('afterprint', () => {
					if (!document.documentElement.dataset.printRestoreTheme) return;
					document.documentElement.dataset.theme = 'dark';
					delete document.documentElement.dataset.printRestoreTheme;
				});
				return {
					updatePickers(theme = storedTheme || 'auto') {
						document.querySelectorAll('starlight-theme-select').forEach((picker) => {
							const select = picker.querySelector('select');
							if (select) select.value = theme;
							/** @type {HTMLTemplateElement | null} */
							const tmpl = document.querySelector(`#theme-icons`);
							const newIcon = tmpl && tmpl.content.querySelector('.' + theme);
							if (newIcon) {
								const oldIcon = picker.querySelector('svg.label-icon');
								if (oldIcon) {
									oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
								}
							}
						});
					},
				};
			})();
		</script>

<script>
	(function () {
		if (!document.getAnimations || typeof CSSTransition === 'undefined') return;
		let prePrint;
		let preScroll;
		window.addEventListener('beforeprint', () => {
			prePrint = new Set(document.getAnimations());
			preScroll = [window.scrollX, window.scrollY];
		});
		window.addEventListener('afterprint', () => {
			const seen = prePrint;
			const [x, y] = preScroll || [];
			prePrint = undefined;
			preScroll = undefined;
			if (!seen) return;
			const finishRestarted = () => {
				if (window.scrollX !== x || window.scrollY !== y) {
					window.scrollTo({ left: x, top: y, behavior: 'instant' });
				}
				for (const animation of document.getAnimations()) {
					if (seen.has(animation) || animation.playState === 'paused') continue;
					if (!(animation instanceof CSSAnimation || animation instanceof CSSTransition)) continue;
					if (animation.timeline !== document.timeline) continue;
					if (animation.effect?.getComputedTiming().iterations === Infinity) continue;
					animation.finish();
				}
			};
			finishRestarted();
			requestAnimationFrame(finishRestarted);
		});
	})();
</script>
