</svg>
	<svg width="1em" height="1em" viewBox="0 0 24 24" class="chat-launcher__glyph chat-launcher__glyph--open astro-pr2o3lpr" aria-hidden="true" data-icon="tabler:chevron-down">
  
  
  <symbol id="ai:tabler:chevron-down"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9l6 6l6-6"/></symbol><use href="#ai:tabler:chevron-down"></use>
      
</svg>
</button>

<script>
	document.currentScript.previousElementSibling.addEventListener(
		'click',
		(e) => (e.currentTarget.dataset.clicked = ''),
		{ once: true }
	);
</script>
<span id="chat-launcher-status" class="chat-launcher-status print:hidden astro-pr2o3lpr" role="status"></span>

