<script>
	// Before first paint, show the thank-you state for a page rated earlier (same key as below).
	(() => {
		const root = document.currentScript?.previousElementSibling;
		const path = location.pathname.replace(/\/index\.html?$/, '/').replace(/\/{2,}/g, '/');
		try {
			if (localStorage.getItem(`feedback-submitted:${path.replace(/\/?$/, '/')}`) !== '1') return;
		} catch {
			return;
		}
		const title = root?.querySelector('[data-feedback-title]');
		const buttons = root?.querySelector('[data-feedback-buttons]');
		const success = root?.querySelector('[data-feedback-success]');
		const text = root?.querySelector('[data-feedback-success-text]');
		if (!title || !buttons || !success || !text) return;
		root.dataset.feedbackState = 'success';
		title.hidden = true;
		buttons.hidden = true;
		text.textContent = text.dataset.already;
		success.hidden = false;
	})();
</script>


