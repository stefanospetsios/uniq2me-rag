	<body class="astro-qyu5y5dt">
		<a href="#_top" class="astro-jrhdpbm7">Skip to content</a>
<div id="cc-main" class="print:hidden" data-pagefind-ignore>
	<section class="cm" aria-labelledby="cm-title" aria-describedby="cm-desc" hidden>
		<p id="cm-title" class="cm__title">
			We use cookies
		</p>
		<p id="cm-desc" class="cm__desc">
			We use cookies for site analytics, to measure our advertising campaigns and, if you allow it, to load the site search from Google. Nothing optional is set until you choose. You can change your choice anytime in Your Privacy Choices at the bottom of every page. <a href="/cookie-policy/">Cookie Policy</a>
		</p>
		<div class="cm__btns">
			<button type="button" class="n-button n-button--filled n-button--primary n-button--md print:hidden" data-cc="accept-all">
			Accept all
		</button>
			<button type="button" class="n-button n-button--outlined n-button--primary n-button--md print:hidden" data-cc="reject-all">
			
				Reject all
			
		</button>
		</div>
		<button type="button" class="n-button n-button--text n-button--primary n-button--sm print:hidden cm__manage" data-cc="show-preferences">
			
			Manage preferences
		
		</button>
	</section>
	
	<script>
		if (window.tbConsent?.analytics === undefined) {
			document.currentScript.previousElementSibling.hidden = false;
			document.documentElement.dataset.ccOpen = '';
		}
	</script><dialog class="pm" aria-labelledby="pm-title">
		<div class="pm__header">
			<p id="pm-title" class="pm__title">
				Cookie preferences
			</p>
			<form method="dialog">
				<button type="submit" class="pm__close" aria-label="Close">
					✕
				</button>
			</form>
		</div>
		<div class="pm__body">
			<p class="pm__desc">
				We use cookies for our own analytics, to see how our campaigns perform and, if you allow it, to load content from other services such as the Google site search. We never sell your data. Necessary cookies keep the site working and cannot be switched off. See our <a href="/cookie-policy/">Cookie Policy</a> for details and our 
				<a href="/legal/privacy-policy/">Privacy Policy</a> for how we handle personal data.
			</p>
			<div class="pm__section">
				<label class="pm__section-head">
					<span>Strictly necessary</span>
					<input type="checkbox" role="switch" class="pm__switch" checked disabled>
				</label>
				<p class="pm__section-desc">Security, load balancing and remembering your cookie choice.</p>
			</div>
			<div class="pm__section">
					<label class="pm__section-head">
						<span>Analytics</span>
						<input type="checkbox" role="switch" class="pm__switch" data-category="analytics">
					</label>
					<p class="pm__section-desc">Show us which pages people read, how they find the site and where they get stuck, so we can improve it (Google Analytics, Microsoft Clarity).</p>
					
				</div><div class="pm__section">
					<label class="pm__section-head">
						<span>Marketing</span>
						<input type="checkbox" role="switch" class="pm__switch" data-category="marketing">
					</label>
					<p class="pm__section-desc">Show us which of our ad campaigns bring visitors to the site and remember the campaign or partner link you arrived from (Google Ads, LinkedIn, Meta, partner program). We do not use these cookies to build advertising profiles.</p>
					<p id="pm-gpc-note" class="pm__section-desc" hidden>
							Your browser sent a Global Privacy Control signal, so Marketing stays off.
						</p>
				</div><div class="pm__section">
					<label class="pm__section-head">
						<span>External media</span>
						<input type="checkbox" role="switch" class="pm__switch" data-category="media">
					</label>
					<p class="pm__section-desc">Load the site search from Google when you use it. Google sets its own cookies and shows ads in the search results.</p>
					
				</div>
		</div>
		<div class="pm__footer">
			<div class="cm__btns">
				<button type="button" class="n-button n-button--outlined n-button--primary n-button--md print:hidden" data-cc="reject-all">
			
					Reject all
				
		</button>
				<button type="button" class="n-button n-button--filled n-button--primary n-button--md print:hidden" data-cc="accept-all">
			Accept all
		</button>
			</div>
			<button type="button" class="n-button n-button--outlined n-button--primary n-button--md print:hidden" data-cc="save">
			
				Save preferences
			
		</button>
		</div>
	</dialog>
</div>

<script type="module" src="/_astro/CookieConsent.astro_astro_type_script_index_0_lang.BmBXEWE6.js"></script>
<style>@property --chat-hue { syntax: '<color>'; inherits: true; initial-value: #3d50f5; }
@keyframes chat-hues { 0.00% { --chat-hue: var(--chat-hue-0); } 16.67% { --chat-hue: var(--chat-hue-1); } 33.33% { --chat-hue: var(--chat-hue-2); } 50.00% { --chat-hue: var(--chat-hue-3); } 66.67% { --chat-hue: var(--chat-hue-4); } 83.33% { --chat-hue: var(--chat-hue-5); } 100% { --chat-hue: var(--chat-hue-0); } }
:root { --chat-hue-0: var(--color-brand); --chat-hue-1: #b44100; --chat-hue-2: #b3268f; --chat-hue-3: #7a37e7; --chat-hue-4: #006bc7; --chat-hue-5: #007c7b; --chat-anim: chat-hues; --chat-cycle: 15s; }</style>

<button type="button" id="chat-launcher" class="chat-launcher print:hidden astro-pr2o3lpr" aria-label="Ask the ThingsBoard AI expert" title="Ask the ThingsBoard AI expert" aria-expanded="false">
	<svg width="1em" height="1em" viewBox="0 0 24 24" class="chat-launcher__glyph chat-launcher__glyph--rest astro-pr2o3lpr" aria-hidden="true" data-icon="question-bold">
  
  
