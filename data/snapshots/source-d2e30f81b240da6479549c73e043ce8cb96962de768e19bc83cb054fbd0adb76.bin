<td>TCP</td>
<td>All ports</td>
<td>80</td>
</tr>
<tr>
<td>Windows Time Probe - DNS (UDP-Out)</td>
<td>Outbound</td>
<td>Allow</td>
<td>W32Time</td>
<td>UDP</td>
