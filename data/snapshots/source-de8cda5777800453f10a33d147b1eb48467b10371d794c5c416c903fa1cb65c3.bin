</li>
<li>
<p>CAR_DOOR_TEXT(451)</p>
</li>
<li>
<p>CAR_DOOR_ZONE(452)</p>
</li>
<li>
<p>CAR_DRIVE_STATUS(453)</p>
</li>
<li>
<p>CAR_LOAD(454)</p>
</li>
<li>
<p>CAR_LOAD_UNITS(455)</p>
</li>
<li>
<p>CAR_MODE(456)</p>
</li>
<li>
<p>CAR_MOVING_DIRECTION(457)</p>
