437,441,442,447,449,453,454,459,461,467,468,474,476,480,481,487,489,493,495,501,503,507,509],{"type":177,"nodeName":194,"attributes":243,"children":245},{"id":244},"page-2",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":248,"children":249},{"class":227},[250,256],{"type":177,"nodeName":185,"attributes":251,"children":253},{"href":252},"\u002Finfo\u002Frfc8221\u002F",[254],{"type":182,"textContent":255},"RFC 8221",{"type":182,"textContent":257},"            ESP and AH Algorithm Requirements       October 2017",{"type":182,"textContent":259},"\n\n\nCopyright Notice\n\n   Copyright (c) 2017 IETF Trust and the persons identified as the\n   document authors.  All rights reserved.\n\n   This document is subject to ",{"type":177,"nodeName":185,"attributes":261,"children":263},{"href":262},"\u002Fbcp\u002Fbcp78",[264],{"type":182,"textContent":265},"BCP 78",{"type":182,"textContent":267}," and the IETF Trust's Legal\n   Provisions Relating to IETF Documents\n   (",{"type":177,"nodeName":185,"attributes":269,"children":271},{"href":270},"https:\u002F\u002Ftrustee.ietf.org\u002Flicense-info",[272],{"type":182,"textContent":270},{"type":182,"textContent":274},") in effect on the date of\n   publication of this document.  Please review these documents\n   carefully, as they describe your rights and restrictions with respect\n   to this document.  Code Components extracted from this document must\n   include Simplified BSD License text as described in Section 4.e of\n   the Trust Legal Provisions and are provided without warranty as\n   described in the Simplified BSD License.\n\nTable of Contents\n\n   ",{"type":177,"nodeName":185,"attributes":276,"children":278},{"href":277},"#section-1",[279],{"type":182,"textContent":280},"1",{"type":182,"textContent":282},".  Introduction  . . . . . . . . . . . . . . . . . . . . . . . .   ",{"type":177,"nodeName":185,"attributes":284,"children":286},{"href":285},"#page-3",[287],{"type":182,"textContent":288},"3",{"type":182,"textContent":290},"\n     1.1.  Updating Algorithm Implementation Requirements and Usage\n           Guidance  . . . . . . . . . . . . . . . . . . . . . . . .   ",{"type":177,"nodeName":185,"attributes":292,"children":293},{"href":285},[294],{"type":182,"textContent":288},{"type":182,"textContent":296},"\n     ",{"type":177,"nodeName":185,"attributes":298,"children":300},{"href":299},"#section-1.2",[301],{"type":182,"textContent":302},"1.2",{"type":182,"textContent":304},".  Updating Algorithm Requirement Levels . . . . . . . . . .   ",{"type":177,"nodeName":185,"attributes":306,"children":307},{"href":285},[308],{"type":182,"textContent":288},{"type":182,"textContent":296},{"type":177,"nodeName":185,"attributes":311,"children":313},{"href":312},"#section-1.3",[314],{"type":182,"textContent":315},"1.3",{"type":182,"textContent":317},".  Document Audience . . . . . . . . . . . . . . . . . . . .   ",{"type":177,"nodeName":185,"attributes":319,"children":321},{"href":320},"#page-4",[322],{"type":182,"textContent":323},"4",{"type":182,"textContent":325},"\n   ",{"type":177,"nodeName":185,"attributes":327,"children":329},{"href":328},"#section-2",[330],{"type":182,"textContent":331},"2",{"type":182,"textContent":333},".  Requirements Language . . . . . . . . . . . . . . . . . . . .   ",{"type":177,"nodeName":185,"attributes":335,"children":337},{"href":336},"#page-5",[338],{"type":182,"textContent":339},"5",{"type":182,"textContent":325},{"type":177,"nodeName":185,"attributes":342,"children":344},{"href":343},"#section-3",[345],{"type":182,"textContent":288},{"type":182,"textContent":347},".  Manual Keying . . . . . . . . . . . . . . . . . . . . . . . .   ",{"type":177,"nodeName":185,"attributes":349,"children":350},{"href":336},[351],{"type":182,"textContent":339},{"type":182,"textContent":325},{"type":177,"nodeName":185,"attributes":354,"children":356},{"href":355},"#section-4",[357],{"type":182,"textContent":323},{"type":182,"textContent":359},".  Encryption Must Be Authenticated  . . . . . . . . . . . . . .   ",{"type":177,"nodeName":185,"attributes":361,"children":363},{"href":362},"#page-6",[364],{"type":182,"textContent":365},"6",{"type":182,"textContent":325},{"type":177,"nodeName":185,"attributes":368,"children":370},{"href":369},"#section-5",[371],{"type":182,"textContent":339},{"type":182,"textContent":373},".  ESP Encryption Algorithms . . . . . . . . . . . . . . . . . .   ",{"type":177,"nodeName":185,"attributes":375,"children":377},{"href":376},"#page-7",[378],{"type":182,"textContent":379},"7",{"type":182,"textContent":325},{"type":177,"nodeName":185,"attributes":382,"children":384},{"href":383},"#section-6",[385],{"type":182,"textContent":365},{"type":182,"textContent":387},".  ESP and AH Authentication Algorithms  . . . . . . . . . . . .   ",{"type":177,"nodeName":185,"attributes":389,"children":391},{"href":390},"#page-9",[392],{"type":182,"textContent":393},"9",{"type":182,"textContent":325},{"type":177,"nodeName":185,"attributes":396,"children":398},{"href":397},"#section-7",[399],{"type":182,"textContent":379},{"type":182,"textContent":401},".  ESP and AH Compression Algorithms . . . . . . . . . . . . . .  ",{"type":177,"nodeName":185,"attributes":403,"children":405},{"href":404},"#page-10",[406],{"type":182,"textContent":407},"10",{"type":182,"textContent":325},{"type":177,"nodeName":185,"attributes":410,"children":412},{"href":411},"#section-8",[413],{"type":182,"textContent":414},"8",{"type":182,"textContent":416},".  Summary of Changes from ",{"type":177,"nodeName":185,"attributes":418,"children":419},{"href":187},[420],{"type":182,"textContent":206},{"type":182,"textContent":422},"  . . . . . . . . . . . . . .  ",{"type":177,"nodeName":185,"attributes":424,"children":426},{"href":425},"#page-11",[427],{"type":182,"textContent":428},"11",{"type":182,"textContent":325},{"type":177,"nodeName":185,"attributes":431,"children":433},{"href":432},"#section-9",[434],{"type":182,"textContent":393},{"type":182,"textContent":436},".  IANA Considerations . . . . . . . . . . . . . . . . . . . . .  ",{"type":177,"nodeName":185,"attributes":438,"children":439},{"href":425},[440],{"type":182,"textContent":428},{"type":182,"textContent":325},{"type":177,"nodeName":185,"attributes":443,"children":445},{"href":444},"#section-10",[446],{"type":182,"textContent":407},{"type":182,"textContent":448},". Security Considerations . . . . . . . . . . . . . . . . . . .  ",{"type":177,"nodeName":185,"attributes":450,"children":451},{"href":425},[452],{"type":182,"textContent":428},{"type":182,"textContent":325},{"type":177,"nodeName":185,"attributes":455,"children":457},{"href":456},"#section-11",[458],{"type":182,"textContent":428},{"type":182,"textContent":460},". References  . . . . . . . . . . . . . . . . . . . . . . . . .  ",{"type":177,"nodeName":185,"attributes":462,"children":464},{"href":463},"#page-12",[465],{"type":182,"textContent":466},"12",{"type":182,"textContent":296},{"type":177,"nodeName":185,"attributes":469,"children":471},{"href":470},"#section-11.1",[472],{"type":182,"textContent":473},"11.1",{"type":182,"textContent":475},".  Normative References . . . . . . . . . . . . . . . . . .  ",{"type":177,"nodeName":185,"attributes":477,"children":478},{"href":463},[479],{"type":182,"textContent":466},{"type":182,"textContent":296},{"type":177,"nodeName":185,"attributes":482,"children":484},{"href":483},"#section-11.2",[485],{"type":182,"textContent":486},"11.2",{"type":182,"textContent":488},".  Informative References . . . . . . . . . . . . . . . . .  ",{"type":177,"nodeName":185,"attributes":490,"children":491},{"href":463},[492],{"type":182,"textContent":466},{"type":182,"textContent":494},"\n   Acknowledgements  . . . . . . . . . . . . . . . . . . . . . . . .  ",{"type":177,"nodeName":185,"attributes":496,"children":498},{"href":497},"#page-15",[499],{"type":182,"textContent":500},"15",{"type":182,"textContent":502},"\n   Authors' Addresses  . . . . . . . . . . . . . . . . . . . . . . .  ",{"type":177,"nodeName":185,"attributes":504,"children":505},{"href":497},[506],{"type":182,"textContent":500},{"type":182,"textContent":508},"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":177,"nodeName":194,"attributes":510,"children":511},{"class":227},[512],{"type":182,"textContent":513},"Wouters, et al.              Standards Track                    [Page 2]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":516,"children":517},{"class":236},[],{"type":177,"nodeName":178,"attributes":519,"children":520},{"class":240},[521,525,526,534,536,547,549,555,557,563,565,571,573,585,587,593,595,604,606],{"type":177,"nodeName":194,"attributes":522,"children":524},{"id":523},"page-3",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":527,"children":528},{"class":227},[529,533],{"type":177,"nodeName":185,"attributes":530,"children":531},{"href":252},[532],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":535},"\n\n\n",{"type":177,"nodeName":194,"attributes":537,"children":539},{"class":538},"h2",[540,545],{"type":177,"nodeName":185,"attributes":541,"children":543},{"class":542,"id":95,"href":277},"selflink",[544],{"type":182,"textContent":280},{"type":182,"textContent":546},".  Introduction",{"type":182,"textContent":548},"\n\n   The Encapsulating Security Payload (ESP) [",{"type":177,"nodeName":185,"attributes":550,"children":552},{"href":551},"\u002Finfo\u002Frfc4303\u002F",[553],{"type":182,"textContent":554},"RFC4303",{"type":182,"textContent":556},"] and the\n   Authentication Header (AH) [",{"type":177,"nodeName":185,"attributes":558,"children":560},{"href":559},"\u002Finfo\u002Frfc4302\u002F",[561],{"type":182,"textContent":562},"RFC4302",{"type":182,"textContent":564},"] are the mechanisms for applying\n   cryptographic protection to data being sent over an IPsec Security\n   Association (SA) [",{"type":177,"nodeName":185,"attributes":566,"children":568},{"href":567},"\u002Finfo\u002Frfc4301\u002F",[569],{"type":182,"textContent":570},"RFC4301",{"type":182,"textContent":572},"].\n\n   This document provides guidance and recommendations so that ESP and\n   AH can be used with cryptographic algorithms that are up to date.\n   The challenge of such documents is making sure that, over time, IPsec\n   implementations can use secure and up-to-date cryptographic\n   algorithms while keeping IPsec interoperable.\n\n",{"type":177,"nodeName":194,"attributes":574,"children":576},{"class":575},"h3",[577,583],{"type":177,"nodeName":185,"attributes":578,"children":580},{"class":542,"id":101,"href":579},"#section-1.1",[581],{"type":182,"textContent":582},"1.1",{"type":182,"textContent":584},".  Updating Algorithm Implementation Requirements and Usage Guidance",{"type":182,"textContent":586},"\n\n   The field of cryptography evolves continuously: new, stronger\n   algorithms appear, and existing algorithms are found to be less\n   secure than originally thought.  Therefore, algorithm implementation\n   requirements and usage guidance need to be updated from time to time\n   to reflect the new reality.  The choices for algorithms must be\n   conservative to minimize the risk of algorithm compromise.\n   Algorithms need to be suitable for a wide variety of CPU\n   architectures and device deployments ranging from high-end bulk\n   encryption devices to small, low-power Internet of Things (IoT)\n   devices.\n\n   The algorithm implementation requirements and usage guidance may need\n   to change over time to adapt to the changing world.  For this reason,\n   the selection of mandatory-to-implement algorithms was removed from\n   the main Internet Key Exchange Protocol Version 2 (IKEv2)\n   specification [",{"type":177,"nodeName":185,"attributes":588,"children":590},{"href":589},"\u002Finfo\u002Frfc7296\u002F",[591],{"type":182,"textContent":592},"RFC7296",{"type":182,"textContent":594},"] and placed in a separate document.\n\n",{"type":177,"nodeName":194,"attributes":596,"children":597},{"class":575},[598,602],{"type":177,"nodeName":185,"attributes":599,"children":600},{"class":542,"id":106,"href":299},[601],{"type":182,"textContent":302},{"type":182,"textContent":603},".  Updating Algorithm Requirement Levels",{"type":182,"textContent":605},"\n\n   The mandatory-to-implement algorithm of tomorrow should already be\n   available in most implementations of AH\u002FESP by the time it is made\n   mandatory.  This document attempts to identify and introduce those\n   algorithms for future mandatory-to-implement status.  There is no\n   guarantee that the algorithms in use today may become mandatory in\n   the future.  Published algorithms are continuously subjected to\n   cryptographic attack and may become too weak or could become\n   completely broken before this document is updated.\n\n   This document only provides recommendations for the mandatory-to-\n   implement algorithms and \"too weak\" algorithms that are recommended\n   not to be implemented.  As a result, any algorithm listed at the\n   IPsec IANA registry that is not mentioned in this document MAY be\n   implemented.  It is expected that this document will be updated over\n\n\n\n",{"type":177,"nodeName":194,"attributes":607,"children":608},{"class":227},[609],{"type":182,"textContent":610},"Wouters, et al.              Standards Track                    [Page 3]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":613,"children":614},{"class":236},[],{"type":177,"nodeName":178,"attributes":616,"children":617},{"class":240},[618,622,623,631,633,638,640,645,647,656,658],{"type":177,"nodeName":194,"attributes":619,"children":621},{"id":620},"page-4",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":624,"children":625},{"class":227},[626,630],{"type":177,"nodeName":185,"attributes":627,"children":628},{"href":252},[629],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":632},"\n\n\n   time and future versions will only mention algorithms that have\n   evolved in status.  For clarification, when an algorithm has been\n   mentioned in [",{"type":177,"nodeName":185,"attributes":634,"children":635},{"href":187},[636],{"type":182,"textContent":637},"RFC7321",{"type":182,"textContent":639},"], this document states explicitly the update of\n   the status.\n\n   Although this document updates the algorithms to keep the AH\u002FESP\n   communication secure over time, it also aims at providing\n   recommendations so that AH\u002FESP implementations remain interoperable.\n   AH\u002FESP interoperability is addressed by an incremental introduction\n   or deprecation of algorithms.  In addition, this document also\n   considers the new use cases for AH\u002FESP deployment, such as IoT.\n\n   It is expected that deprecation of an algorithm be performed\n   gradually.  This provides time for various implementations to update\n   their implemented algorithms while remaining interoperable.  Unless\n   there are strong security reasons, an algorithm is expected to be\n   downgraded from MUST to MUST- or SHOULD, instead of MUST NOT (see\n   ",{"type":177,"nodeName":185,"attributes":641,"children":642},{"href":328},[643],{"type":182,"textContent":644},"Section 2",{"type":182,"textContent":646},").  Similarly, an algorithm that has not been mentioned as\n   mandatory-to-implement is expected to be introduced with a SHOULD\n   instead of a MUST.\n\n   The current trend toward IoT and its adoption of AH\u002FESP requires this\n   specific use case to be taken into account as well.  IoT devices are\n   resource-constrained devices, and their choice of algorithms is\n   motivated by minimizing the footprint of the code, the computation\n   effort, and the size of the messages to send.  This document\n   indicates \"(IoT)\" when a specified algorithm is specifically listed\n   for IoT devices.  Requirement levels that are marked as \"IoT\" apply\n   to IoT devices and to server-side implementations that might\n   presumably need to interoperate with them, including any general-\n   purpose VPN gateways.\n\n",{"type":177,"nodeName":194,"attributes":648,"children":649},{"class":575},[650,654],{"type":177,"nodeName":185,"attributes":651,"children":652},{"class":542,"id":111,"href":312},[653],{"type":182,"textContent":315},{"type":182,"textContent":655},".  Document Audience",{"type":182,"textContent":657},"\n\n   The recommendations of this document mostly target AH\u002FESP\n   implementers as implementations need to meet both high security\n   expectations as well as high interoperability between various vendors\n   and with different versions.  Interoperability requires a smooth move\n   to more secure cipher suites.  This may differ from a user point of\n   view that may deploy and configure AH\u002FESP with only the safest cipher\n   suite.\n\n   This document does not give any recommendations for the use of\n   algorithms, it only gives recommendations for implementations.  The\n   use of algorithms by a specific user is dictated by their own\n   security policy requirements, which are outside the scope of this\n   document.\n\n\n\n\n",{"type":177,"nodeName":194,"attributes":659,"children":660},{"class":227},[661],{"type":182,"textContent":662},"Wouters, et al.              Standards Track                    [Page 4]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":665,"children":666},{"class":236},[],{"type":177,"nodeName":178,"attributes":668,"children":669},{"class":240},[670,674,675,683,685,694,696,702,704,710,712,718,720,729,731,735,737],{"type":177,"nodeName":194,"attributes":671,"children":673},{"id":672},"page-5",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":676,"children":677},{"class":227},[678,682],{"type":177,"nodeName":185,"attributes":679,"children":680},{"href":252},[681],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":684},"\n\n\n   The algorithms considered here are listed by IANA as part of the\n   IKEv2 parameters.  IKEv1 is out of scope of this document.  IKEv1 is\n   deprecated; the recommendations of this document must not be\n   considered for IKEv1, nor may IKEv1 parameters be considered by this\n   document.\n\n   The IANA registry for \"Internet Key Exchange Version 2 (IKEv2)\n   Parameters\" contains some entries that are not for use with ESP or\n   AH.  This document does not modify the status of those algorithms.\n\n",{"type":177,"nodeName":194,"attributes":686,"children":687},{"class":538},[688,692],{"type":177,"nodeName":185,"attributes":689,"children":690},{"class":542,"id":116,"href":328},[691],{"type":182,"textContent":331},{"type":182,"textContent":693},".  Requirements Language",{"type":182,"textContent":695},"\n\n   The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\",\n   \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"NOT RECOMMENDED\", \"MAY\", and\n   \"OPTIONAL\" in this document are to be interpreted as described in\n   ",{"type":177,"nodeName":185,"attributes":697,"children":699},{"href":698},"\u002Fbcp\u002Fbcp14",[700],{"type":182,"textContent":701},"BCP 14",{"type":182,"textContent":703}," [",{"type":177,"nodeName":185,"attributes":705,"children":707},{"href":706},"\u002Finfo\u002Frfc2119\u002F",[708],{"type":182,"textContent":709},"RFC2119",{"type":182,"textContent":711},"] [",{"type":177,"nodeName":185,"attributes":713,"children":715},{"href":714},"\u002Finfo\u002Frfc8174\u002F",[716],{"type":182,"textContent":717},"RFC8174",{"type":182,"textContent":719},"] when, and only when, they appear in all\n   capitals, as shown here.\n\n   We define some additional terms here:\n\n   SHOULD+   This term means the same as SHOULD.  However, it is likely\n             that an algorithm marked as SHOULD+ will be promoted at\n             some future time to be a MUST.\n   SHOULD-   This term means the same as SHOULD.  However, an algorithm\n             marked as SHOULD- may be deprecated to a MAY in a future\n             version of this document.\n   MUST-     This term means the same as MUST.  However, we expect at\n             some point that this algorithm will no longer be a MUST in\n             a future document.  Although its status will be determined\n             at a later time, it is reasonable to expect that if a\n             future revision of a document alters the status of a MUST-\n             algorithm, it will remain at least a SHOULD or a SHOULD-\n             level.\n   IoT       The Internet of Things.\n\n",{"type":177,"nodeName":194,"attributes":721,"children":722},{"class":538},[723,727],{"type":177,"nodeName":185,"attributes":724,"children":725},{"class":542,"id":121,"href":343},[726],{"type":182,"textContent":288},{"type":182,"textContent":728},".  Manual Keying",{"type":182,"textContent":730},"\n\n   Manual keying SHOULD NOT be used, as it is inherently dangerous.\n   Without any secure keying protocol, such as IKE, IPsec does not offer\n   Perfect Forward Secrecy (PFS) protection; there is no entity to\n   ensure the refreshing of session keys, the tracking of Security\n   Parameter Index (SPI) uniqueness, and the single use of nonces,\n   Initialization Vectors (IVs), and counters.  This document was\n   written for deploying ESP\u002FAH using IKE [",{"type":177,"nodeName":185,"attributes":732,"children":733},{"href":589},[734],{"type":182,"textContent":592},{"type":182,"textContent":736},"] and assumes that\n   keying happens using IKEv2 or higher.\n\n\n\n\n\n\n",{"type":177,"nodeName":194,"attributes":738,"children":739},{"class":227},[740],{"type":182,"textContent":741},"Wouters, et al.              Standards Track                    [Page 5]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":744,"children":745},{"class":236},[],{"type":177,"nodeName":178,"attributes":747,"children":748},{"class":240},[749,753,754,762,764,770,772,781,783],{"type":177,"nodeName":194,"attributes":750,"children":752},{"id":751},"page-6",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":755,"children":756},{"class":227},[757,761],{"type":177,"nodeName":185,"attributes":758,"children":759},{"href":252},[760],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":763},"\n\n\n   If manual keying is used regardless, Counter Mode algorithms such as\n   ENCR_AES_CTR, ENCR_AES_CCM, ENCR_AES_GCM, and ENCR_CHACHA20_POLY1305\n   MUST NOT be used, as it is incompatible with a secure and persistent\n   handling of the counter (as explained in the Security Considerations\n   section of [",{"type":177,"nodeName":185,"attributes":765,"children":767},{"href":766},"\u002Finfo\u002Frfc3686\u002F",[768],{"type":182,"textContent":769},"RFC3686",{"type":182,"textContent":771},"]).  This particularly applies to IoT devices that\n   have no state across reboots.  At the time of writing, ENCR_AES_CBC\n   is the only mandatory-to-implement encryption algorithm suitable for\n   manual keying.\n\n",{"type":177,"nodeName":194,"attributes":773,"children":774},{"class":538},[775,779],{"type":177,"nodeName":185,"attributes":776,"children":777},{"class":542,"id":126,"href":355},[778],{"type":182,"textContent":323},{"type":182,"textContent":780},".  Encryption Must Be Authenticated",{"type":182,"textContent":782},"\n\n   Encryption without authentication is not effective and MUST NOT be\n   used.  IPsec offers three ways to provide both encryption and\n   authentication:\n\n   o  ESP with an Authenticated Encryption with Associated Data (AEAD)\n      cipher\n\n   o  ESP with a non-AEAD cipher + authentication\n\n   o  ESP with a non-AEAD cipher + AH with authentication\n\n   The fastest and most modern method is to use ESP with a combined mode\n   cipher, such as an AEAD cipher, that handles encryption\u002Fdecryption\n   and authentication in a single step.  In this case, the AEAD cipher\n   is set as the encryption algorithm, and the authentication algorithm\n   is set to none.  Examples of this are ENCR_AES_GCM_16 and\n   ENCR_CHACHA20_POLY1305.\n\n   A more traditional approach is to use ESP with an encryption and an\n   authentication algorithm.  This approach is slower, as the data has\n   to be processed twice: once for encryption\u002Fdecryption and once for\n   authentication.  An example of this is ENCR_AES_CBC combined with\n   AUTH_HMAC_SHA2_512_256.\n\n   The last method that can be used is ESP+AH.  This method is NOT\n   RECOMMENDED.  It is the slowest method and also takes up more octets\n   due to the double header of ESP+AH.  This results in a smaller\n   effective MTU for the encrypted data.  With this method, ESP is only\n   used for confidentiality without an authentication algorithm, and a\n   second IPsec protocol of type AH is used for authentication.  An\n   example of this is ESP with ENCR_AES_CBC with AH with\n   AUTH_HMAC_SHA2_512_256.\n\n\n\n\n\n\n\n\n",{"type":177,"nodeName":194,"attributes":784,"children":785},{"class":227},[786],{"type":182,"textContent":787},"Wouters, et al.              Standards Track                    [Page 6]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":790,"children":791},{"class":236},[],{"type":177,"nodeName":178,"attributes":793,"children":794},{"class":240},[795,799,800,808,809,818,820,826,828,834,836,840,842,848,850,856,858,864,866,872,874,880,882,887,889,893,895,899,901],{"type":177,"nodeName":194,"attributes":796,"children":798},{"id":797},"page-7",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":801,"children":802},{"class":227},[803,807],{"type":177,"nodeName":185,"attributes":804,"children":805},{"href":252},[806],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":535},{"type":177,"nodeName":194,"attributes":810,"children":811},{"class":538},[812,816],{"type":177,"nodeName":185,"attributes":813,"children":814},{"class":542,"id":131,"href":369},[815],{"type":182,"textContent":339},{"type":182,"textContent":817},".  ESP Encryption Algorithms",{"type":182,"textContent":819},"\n\n    +-------------------------+------------+---------+----------------+\n    | Name                    | Status     | AEAD    | Comment        |\n    +-------------------------+------------+---------+----------------+\n    | ENCR_DES_IV64           | MUST NOT   | No      | UNSPECIFIED    |\n    | ENCR_DES                | MUST NOT   | No      | [",{"type":177,"nodeName":185,"attributes":821,"children":823},{"href":822},"\u002Finfo\u002Frfc2405\u002F",[824],{"type":182,"textContent":825},"RFC2405",{"type":182,"textContent":827},"]      |\n    | ENCR_3DES               | SHOULD NOT | No      | [",{"type":177,"nodeName":185,"attributes":829,"children":831},{"href":830},"\u002Finfo\u002Frfc2451\u002F",[832],{"type":182,"textContent":833},"RFC2451",{"type":182,"textContent":835},"]      |\n    | ENCR_BLOWFISH           | MUST NOT   | No      | [",{"type":177,"nodeName":185,"attributes":837,"children":838},{"href":830},[839],{"type":182,"textContent":833},{"type":182,"textContent":841},"]      |\n    | ENCR_3IDEA              | MUST NOT   | No      | UNSPECIFIED    |\n    | ENCR_DES_IV32           | MUST NOT   | No      | UNSPECIFIED    |\n    | ENCR_NULL               | MUST       | No      | [",{"type":177,"nodeName":185,"attributes":843,"children":845},{"href":844},"\u002Finfo\u002Frfc2410\u002F",[846],{"type":182,"textContent":847},"RFC2410",{"type":182,"textContent":849},"]      |\n    | ENCR_AES_CBC            | MUST       | No      | [",{"type":177,"nodeName":185,"attributes":851,"children":853},{"href":852},"\u002Finfo\u002Frfc3602\u002F",[854],{"type":182,"textContent":855},"RFC3602",{"type":182,"textContent":857},"][1]   |\n    | ENCR_AES_CCM_8          | SHOULD     | Yes     | [",{"type":177,"nodeName":185,"attributes":859,"children":861},{"href":860},"\u002Finfo\u002Frfc4309\u002F",[862],{"type":182,"textContent":863},"RFC4309",{"type":182,"textContent":865},"](IoT) |\n    | ENCR_AES_GCM_16         | MUST       | Yes     | [",{"type":177,"nodeName":185,"attributes":867,"children":869},{"href":868},"\u002Finfo\u002Frfc4106\u002F",[870],{"type":182,"textContent":871},"RFC4106",{"type":182,"textContent":873},"][1]   |\n    | ENCR_CHACHA20_POLY1305  | SHOULD     | Yes     | [",{"type":177,"nodeName":185,"attributes":875,"children":877},{"href":876},"\u002Finfo\u002Frfc7634\u002F",[878],{"type":182,"textContent":879},"RFC7634",{"type":182,"textContent":881},"]      |\n    +-------------------------+------------+---------+----------------+\n\n   [",{"type":177,"nodeName":185,"attributes":883,"children":885},{"id":884},"ref-1",[886],{"type":182,"textContent":280},{"type":182,"textContent":888},"] - This requirement level is for 128-bit and 256-bit keys. 192-bit\n   keys remain at the MAY level.\n\n   (IoT) - This requirement is for interoperability with IoT.  Only\n   128-bit keys are at the given level.\n\n   IPsec sessions may have very long lifetime and carry multiple\n   packets, so there is a need to move to 256-bit keys in the long term.\n   For that purpose, the requirement level for 128-bit keys and 256-bit\n   keys is MUST (when applicable).  In that sense, the status for\n   256-bit keys has been raised from MAY in [",{"type":177,"nodeName":185,"attributes":890,"children":891},{"href":187},[892],{"type":182,"textContent":637},{"type":182,"textContent":894},"] to MUST.\n\n   IANA has allocated codes for cryptographic algorithms that have not\n   been specified by the IETF.  Such algorithms are noted as\n   UNSPECIFIED.  Usually, the use of these algorithms is limited to\n   specific cases, and the absence of specification makes\n   interoperability difficult for IPsec communications.  These\n   algorithms were not mentioned in [",{"type":177,"nodeName":185,"attributes":896,"children":897},{"href":187},[898],{"type":182,"textContent":637},{"type":182,"textContent":900},"], and this document\n   clarifies that such algorithms MUST NOT be implemented for IPsec\n   communications.\n\n   Similarly, IANA also allocated code points for algorithms that are\n   not expected to be used to secure IPsec communications.  Such\n   algorithms are noted as non-IPsec.  As a result, these algorithms\n   MUST NOT be implemented.\n\n   Various ciphers that are older, not well tested, and never widely\n   implemented have been changed to MUST NOT.\n\n\n\n\n\n",{"type":177,"nodeName":194,"attributes":902,"children":903},{"class":227},[904],{"type":182,"textContent":905},"Wouters, et al.              Standards Track                    [Page 7]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":908,"children":909},{"class":236},[],{"type":177,"nodeName":178,"attributes":911,"children":912},{"class":240},[913,917,918,926,928,932,934,938,940,944,946,950,952,956,958],{"type":177,"nodeName":194,"attributes":914,"children":916},{"id":915},"page-8",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":919,"children":920},{"class":227},[921,925],{"type":177,"nodeName":185,"attributes":922,"children":923},{"href":252},[924],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":927},"\n\n\n   ENCR_3DES status has been downgraded from MAY in [",{"type":177,"nodeName":185,"attributes":929,"children":930},{"href":187},[931],{"type":182,"textContent":637},{"type":182,"textContent":933},"] to SHOULD\n   NOT.  ENCR_CHACHA20_POLY1305 is a more modern approach and\n   alternative for ENCR_3DES than ENCR_AES_CBC, and so it is expected to\n   be favored to replace ENCR_3DES.\n\n   ENCR_BLOWFISH has been downgraded to MUST NOT as it has been\n   deprecated for years by TWOFISH, which is not standardized for ESP\n   and therefore not listed in this document.  Some implementations\n   support TWOFISH using a private range number.\n\n   ENCR_NULL status was set to MUST in [",{"type":177,"nodeName":185,"attributes":935,"children":936},{"href":187},[937],{"type":182,"textContent":637},{"type":182,"textContent":939},"] and remains a MUST to\n   enable the use of ESP with only authentication, which is preferred\n   over AH due to NAT traversal.  ENCR_NULL is expected to remain MUST\n   by protocol requirements.\n\n   ENCR_AES_CBC status remains at MUST.  ENCR_AES_CBC MUST be\n   implemented in order to enable interoperability between\n   implementations that followed [",{"type":177,"nodeName":185,"attributes":941,"children":942},{"href":187},[943],{"type":182,"textContent":637},{"type":182,"textContent":945},"].  However, there is a trend\n   for the industry to move to AEAD encryption, and the overhead of\n   ENCR_AES_CBC remains quite large, so it is expected to be replaced by\n   AEAD algorithms in the long term.\n\n   ENCR_AES_CCM_8 status was set to MAY in [",{"type":177,"nodeName":185,"attributes":947,"children":948},{"href":187},[949],{"type":182,"textContent":637},{"type":182,"textContent":951},"] and has been raised\n   from MAY to SHOULD in order to interact with IoT devices.  As this\n   case is not a general use case for VPNs, its status is expected to\n   remain as SHOULD.\n\n   ENCR_AES_GCM_16 status has been updated from SHOULD+ to MUST in order\n   to favor the use of authenticated encryption and AEAD algorithms.\n   ENCR_AES_GCM_16 has been widely implemented for ESP due to its\n   increased performance and key longevity compared to ENCR_AES_CBC.\n\n   ENCR_CHACHA20_POLY1305 was not ready to be considered at the time of\n   [",{"type":177,"nodeName":185,"attributes":953,"children":954},{"href":187},[955],{"type":182,"textContent":637},{"type":182,"textContent":957},"].  It has been recommended by the Crypto Forum Research\n   Group (CFRG) and others as an alternative to AES-CBC and AES-GCM.  At\n   the time of writing, there are not enough ESP implementations of\n   ENCR_CHACHA20_POLY1305 to be able to introduce it at the SHOULD+\n   level.  Its status has been set to SHOULD and is expected to become\n   MUST in the long term.\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":177,"nodeName":194,"attributes":959,"children":960},{"class":227},[961],{"type":182,"textContent":962},"Wouters, et al.              Standards Track                    [Page 8]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":965,"children":966},{"class":236},[],{"type":177,"nodeName":178,"attributes":968,"children":969},{"class":240},[970,974,975,983,984,993,995,999,1001,1007,1009,1015,1017,1023,1025,1031,1033,1037,1039,1045,1047,1051,1053,1057,1059,1064,1066,1070,1072,1078,1080,1084,1086,1090,1092],{"type":177,"nodeName":194,"attributes":971,"children":973},{"id":972},"page-9",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":976,"children":977},{"class":227},[978,982],{"type":177,"nodeName":185,"attributes":979,"children":980},{"href":252},[981],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":535},{"type":177,"nodeName":194,"attributes":985,"children":986},{"class":538},[987,991],{"type":177,"nodeName":185,"attributes":988,"children":989},{"class":542,"id":136,"href":383},[990],{"type":182,"textContent":365},{"type":182,"textContent":992},".  ESP and AH Authentication Algorithms",{"type":182,"textContent":994},"\n\n   Authentication algorithm recommendations in this section are\n   targeting two types of communications:\n\n   o  Authenticated-only communications without encryption, such as ESP\n      with NULL encryption or AH communications.\n\n   o  Communications that are encrypted with a non-AEAD algorithm that\n      MUST be combined with an authentication algorithm.\n\n   +------------------------+----------------+-------------------------+\n   | Name                   | Status         | Comment                 |\n   +------------------------+----------------+-------------------------+\n   | AUTH_NONE              | MUST \u002F         | [",{"type":177,"nodeName":185,"attributes":996,"children":997},{"href":589},[998],{"type":182,"textContent":592},{"type":182,"textContent":1000},"][RFC5282]      |\n   |                        | MUST NOT       | AEAD-only               |\n   | AUTH_HMAC_MD5_96       | MUST NOT       | [",{"type":177,"nodeName":185,"attributes":1002,"children":1004},{"href":1003},"\u002Finfo\u002Frfc2403\u002F",[1005],{"type":182,"textContent":1006},"RFC2403",{"type":182,"textContent":1008},"][RFC7296]      |\n   | AUTH_HMAC_SHA1_96      | MUST-          | [",{"type":177,"nodeName":185,"attributes":1010,"children":1012},{"href":1011},"\u002Finfo\u002Frfc2404\u002F",[1013],{"type":182,"textContent":1014},"RFC2404",{"type":182,"textContent":1016},"][RFC7296]      |\n   | AUTH_DES_MAC           | MUST NOT       | UNSPECIFIED             |\n   | AUTH_KPDK_MD5          | MUST NOT       | UNSPECIFIED             |\n   | AUTH_AES_XCBC_96       | SHOULD \u002F MAY   | [",{"type":177,"nodeName":185,"attributes":1018,"children":1020},{"href":1019},"\u002Finfo\u002Frfc3566\u002F",[1021],{"type":182,"textContent":1022},"RFC3566",{"type":182,"textContent":1024},"][RFC7296]      |\n   |                        |                | (IoT)                   |\n   | AUTH_AES_128_GMAC      | MAY            | [",{"type":177,"nodeName":185,"attributes":1026,"children":1028},{"href":1027},"\u002Finfo\u002Frfc4543\u002F",[1029],{"type":182,"textContent":1030},"RFC4543",{"type":182,"textContent":1032},"]               |\n   | AUTH_AES_256_GMAC      | MAY            | [",{"type":177,"nodeName":185,"attributes":1034,"children":1035},{"href":1027},[1036],{"type":182,"textContent":1030},{"type":182,"textContent":1038},"]               |\n   | AUTH_HMAC_SHA2_256_128 | MUST           | [",{"type":177,"nodeName":185,"attributes":1040,"children":1042},{"href":1041},"\u002Finfo\u002Frfc4868\u002F",[1043],{"type":182,"textContent":1044},"RFC4868",{"type":182,"textContent":1046},"]               |\n   | AUTH_HMAC_SHA2_512_256 | SHOULD         | [",{"type":177,"nodeName":185,"attributes":1048,"children":1049},{"href":1041},[1050],{"type":182,"textContent":1044},{"type":182,"textContent":1052},"]               |\n   +------------------------+----------------+-------------------------+\n\n   (IoT) - This requirement is for interoperability with IoT.\n\n   AUTH_NONE has been downgraded from MAY in [",{"type":177,"nodeName":185,"attributes":1054,"children":1055},{"href":187},[1056],{"type":182,"textContent":637},{"type":182,"textContent":1058},"] to MUST NOT.  The\n   only case where AUTH_NONE is acceptable is when authenticated\n   encryption algorithms are selected from ",{"type":177,"nodeName":185,"attributes":1060,"children":1061},{"href":369},[1062],{"type":182,"textContent":1063},"Section 5",{"type":182,"textContent":1065},".  In all other\n   cases, AUTH_NONE MUST NOT be selected.  As ESP and AH both provide\n   authentication, one may be tempted to combine these protocols to\n   provide authentication.  As mentioned by [",{"type":177,"nodeName":185,"attributes":1067,"children":1068},{"href":187},[1069],{"type":182,"textContent":637},{"type":182,"textContent":1071},"], it is NOT\n   RECOMMENDED to use ESP with NULL authentication (with non-\n   authenticated encryption) in conjunction with AH; some configurations\n   of this combination of services have been shown to be insecure\n   [",{"type":177,"nodeName":185,"attributes":1073,"children":1075},{"href":1074},"#ref-PD10",[1076],{"type":182,"textContent":1077},"PD10",{"type":182,"textContent":1079},"].  In addition, AUTH_NONE authentication cannot be combined\n   with ESP NULL encryption.\n\n   AUTH_HMAC_MD5_96 and AUTH_KPDK_MD5 were not mentioned in [",{"type":177,"nodeName":185,"attributes":1081,"children":1082},{"href":187},[1083],{"type":182,"textContent":637},{"type":182,"textContent":1085},"].\n   As MD5 is known to be vulnerable to collisions, these algorithms MUST\n   NOT be used.\n\n   AUTH_HMAC_SHA1_96 has been downgraded from MUST in [",{"type":177,"nodeName":185,"attributes":1087,"children":1088},{"href":187},[1089],{"type":182,"textContent":637},{"type":182,"textContent":1091},"] to MUST-\n   as there is an industry-wide trend to deprecate its usage.\n\n\n\n",{"type":177,"nodeName":194,"attributes":1093,"children":1094},{"class":227},[1095],{"type":182,"textContent":1096},"Wouters, et al.              Standards Track                    [Page 9]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":1099,"children":1100},{"class":236},[],{"type":177,"nodeName":178,"attributes":1102,"children":1103},{"class":240},[1104,1108,1109,1117,1119,1123,1125,1129,1131,1140,1142,1148,1150,1156,1158,1164,1166,1170,1172],{"type":177,"nodeName":194,"attributes":1105,"children":1107},{"id":1106},"page-10",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":1110,"children":1111},{"class":227},[1112,1116],{"type":177,"nodeName":185,"attributes":1113,"children":1114},{"href":252},[1115],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":1118},"\n\n\n   AUTH_DES_MAC was not mentioned in [",{"type":177,"nodeName":185,"attributes":1120,"children":1121},{"href":187},[1122],{"type":182,"textContent":637},{"type":182,"textContent":1124},"].  As DES is known to be\n   vulnerable, it MUST NOT be used.\n\n   AUTH_AES_XCBC_96 is set as SHOULD only in the scope of IoT, as IoT\n   deployments tend to prefer AES-based Hashed Message Authentication\n   Code (HMAC) functions in order to avoid implementing SHA2.  For the\n   wide VPN deployment, as it has not been widely adopted, it has been\n   downgraded from SHOULD to MAY.\n\n   AUTH_AES_128_GMAC status has been downgraded from SHOULD+ to MAY.\n   Along with AUTH_AES_192_GMAC and AUTH_AES_256_GMAC, these algorithms\n   should only be used for AH and not for ESP.  If using ENCR_NULL,\n   AUTH_HMAC_SHA2_256_128 is recommended for integrity.  If using AES-\n   GMAC in ESP without authentication, ENCR_NULL_AUTH_AES_GMAC is\n   recommended.  Therefore, these algorithms are kept at MAY.\n\n   AUTH_HMAC_SHA2_256_128 was not mentioned in [",{"type":177,"nodeName":185,"attributes":1126,"children":1127},{"href":187},[1128],{"type":182,"textContent":637},{"type":182,"textContent":1130},"], as no\n   SHA2-based authentication was mentioned.  AUTH_HMAC_SHA2_256_128 MUST\n   be implemented in order to replace AUTH_HMAC_SHA1_96.  Note that due\n   to a long standing common implementation bug of this algorithm that\n   truncates the hash at 96 bits instead of 128 bits, it is recommended\n   that implementations prefer AUTH_HMAC_SHA2_512_256 over\n   AUTH_HMAC_SHA2_256_128 if they implement AUTH_HMAC_SHA2_512_256.\n\n   AUTH_HMAC_SHA2_512_256 SHOULD be implemented as a future replacement\n   of AUTH_HMAC_SHA2_256_128 or when stronger security is required.\n   This value has been preferred to AUTH_HMAC_SHA2_384, as the\n   additional overhead of AUTH_HMAC_SHA2_512 is negligible.\n\n",{"type":177,"nodeName":194,"attributes":1132,"children":1133},{"class":538},[1134,1138],{"type":177,"nodeName":185,"attributes":1135,"children":1136},{"class":542,"id":141,"href":397},[1137],{"type":182,"textContent":379},{"type":182,"textContent":1139},".  ESP and AH Compression Algorithms",{"type":182,"textContent":1141},"\n\n                +----------------+----------+-------------+\n                | Name           | Status   | Comment     |\n                +----------------+----------+-------------+\n                | IPCOMP_OUI     | MUST NOT | UNSPECIFIED |\n                | IPCOMP_DEFLATE | MAY      | [",{"type":177,"nodeName":185,"attributes":1143,"children":1145},{"href":1144},"\u002Finfo\u002Frfc3173\u002F",[1146],{"type":182,"textContent":1147},"RFC3173",{"type":182,"textContent":1149},"]   |\n                | IPCOMP_LZS     | MAY      | [",{"type":177,"nodeName":185,"attributes":1151,"children":1153},{"href":1152},"\u002Finfo\u002Frfc2395\u002F",[1154],{"type":182,"textContent":1155},"RFC2395",{"type":182,"textContent":1157},"]   |\n                | IPCOMP_LZJH    | MAY      | [",{"type":177,"nodeName":185,"attributes":1159,"children":1161},{"href":1160},"\u002Finfo\u002Frfc3051\u002F",[1162],{"type":182,"textContent":1163},"RFC3051",{"type":182,"textContent":1165},"]   |\n                +----------------+----------+-------------+\n\n   Compression was not mentioned in [",{"type":177,"nodeName":185,"attributes":1167,"children":1168},{"href":187},[1169],{"type":182,"textContent":637},{"type":182,"textContent":1171},"].  As it is not widely\n   deployed, it remains optional and at the MAY level.\n\n\n\n\n\n\n\n\n\n",{"type":177,"nodeName":194,"attributes":1173,"children":1174},{"class":227},[1175],{"type":182,"textContent":1176},"Wouters, et al.              Standards Track                   [Page 10]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":1179,"children":1180},{"class":236},[],{"type":177,"nodeName":178,"attributes":1182,"children":1183},{"class":240},[1184,1188,1189,1197,1198,1210,1212,1216,1218,1222,1224,1228,1230,1239,1241,1250,1252],{"type":177,"nodeName":194,"attributes":1185,"children":1187},{"id":1186},"page-11",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":1190,"children":1191},{"class":227},[1192,1196],{"type":177,"nodeName":185,"attributes":1193,"children":1194},{"href":252},[1195],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":535},{"type":177,"nodeName":194,"attributes":1199,"children":1200},{"class":538},[1201,1205,1206],{"type":177,"nodeName":185,"attributes":1202,"children":1203},{"class":542,"id":146,"href":411},[1204],{"type":182,"textContent":414},{"type":182,"textContent":416},{"type":177,"nodeName":185,"attributes":1207,"children":1208},{"href":187},[1209],{"type":182,"textContent":206},{"type":182,"textContent":1211},"\n\n   The following table summarizes the changes from ",{"type":177,"nodeName":185,"attributes":1213,"children":1214},{"href":187},[1215],{"type":182,"textContent":206},{"type":182,"textContent":1217},".\n\n            +-------------------+----------+-----------------+\n            | Algorithm         | ",{"type":177,"nodeName":185,"attributes":1219,"children":1220},{"href":187},[1221],{"type":182,"textContent":206},{"type":182,"textContent":1223}," |     ",{"type":177,"nodeName":185,"attributes":1225,"children":1226},{"href":252},[1227],{"type":182,"textContent":255},{"type":182,"textContent":1229},"    |\n            +-------------------+----------+-----------------+\n            | ENCR_AES_GCM_16   | SHOULD+  |       MUST      |\n            | ENCR_AES_CCM_8    |   MAY    |      SHOULD     |\n            | ENCR_AES_CTR      |   MAY    |      MAY(*)     |\n            | ENCR_3DES         |   MAY    |    SHOULD NOT   |\n            | AUTH_HMAC_SHA1_96 |   MUST   |      MUST-      |\n            | AUTH_AES_128_GMAC | SHOULD+  |       MAY       |\n            | AUTH_NONE         |   MAY    | MUST \u002F MUST NOT |\n            +-------------------+----------+-----------------+\n\n   (*) This algorithm is not mentioned in the above sections, so it\n   defaults to MAY.\n\n",{"type":177,"nodeName":194,"attributes":1231,"children":1232},{"class":538},[1233,1237],{"type":177,"nodeName":185,"attributes":1234,"children":1235},{"class":542,"id":151,"href":432},[1236],{"type":182,"textContent":393},{"type":182,"textContent":1238},".  IANA Considerations",{"type":182,"textContent":1240},"\n\n   This document does not require any IANA actions.\n\n",{"type":177,"nodeName":194,"attributes":1242,"children":1243},{"class":538},[1244,1248],{"type":177,"nodeName":185,"attributes":1245,"children":1246},{"class":542,"id":156,"href":444},[1247],{"type":182,"textContent":407},{"type":182,"textContent":1249},".  Security Considerations",{"type":182,"textContent":1251},"\n\n   The security of a system that uses cryptography depends on both the\n   strength of the cryptographic algorithms chosen and the strength of\n   the keys used with those algorithms.  The security also depends on\n   the engineering and administration of the protocol used by the system\n   to ensure that there are no non-cryptographic ways to bypass the\n   security of the overall system.\n\n   This document concerns itself with the selection of cryptographic\n   algorithms for the use of ESP and AH, specifically with the selection\n   of mandatory-to-implement algorithms.  The algorithms identified in\n   this document as \"MUST implement\" or \"SHOULD implement\" are not known\n   to be broken at the current time, and cryptographic research to date\n   leads us to believe that they will likely remain secure into the\n   foreseeable future.  However, this is not necessarily forever.\n   Therefore, we expect that revisions of that document will be issued\n   from time to time to reflect the current best practice in this area.\n\n\n\n\n\n\n\n\n\n\n",{"type":177,"nodeName":194,"attributes":1253,"children":1254},{"class":227},[1255],{"type":182,"textContent":1256},"Wouters, et al.              Standards Track                   [Page 11]",{"type":182,"textContent":232},{"type":177,"nodeName":234,"attributes":1259,"children":1260},{"class":236},[],{"type":177,"nodeName":178,"attributes":1262,"children":1263},{"class":240},[1264,1268,1269,1277,1278,1287,1289,1298,1300,1305,1307,1311,1313,1318,1320,1326,1328,1333,1335,1340,1342,1348,1349,1354,1356,1361,1363,1369,1370,1375,1377,1382,1384,1390,1391,1396,1398,1402,1404,1410,1411,1416,1418,1423,1425,1430,1432,1436,1437,1442,1444,1450,1452,1461,1462,1467,1469,1474,1476,1481,1483,1489,1490,1495,1497,1502,1504,1510,1512],{"type":177,"nodeName":194,"attributes":1265,"children":1267},{"id":1266},"page-12",[],{"type":182,"textContent":232},{"type":177,"nodeName":194,"attributes":1270,"children":1271},{"class":227},[1272,1276],{"type":177,"nodeName":185,"attributes":1273,"children":1274},{"href":252},[1275],{"type":182,"textContent":255},{"type":182,"textContent":257},{"type":182,"textContent":535},{"type":177,"nodeName":194,"attributes":1279,"children":1280},{"class":538},[1281,1285],{"type":177,"nodeName":185,"attributes":1282,"children":1283},{"class":542,"id":161,"href":456},[1284],{"type":182,"textContent":428},{"type":182,"textContent":1286},".  References",{"type":182,"textContent":1288},"\n\n",{"type":177,"nodeName":194,"attributes":1290,"children":1291},{"class":575},[1292,1296],{"type":177,"nodeName":185,"attributes":1293,"children":1294},{"class":542,"id":167,"href":470},[1295],{"type":182,"textContent":473},{"type":182,"textContent":1297},".  Normative References",{"type":182,"textContent":1299},"\n\n   [",{"type":177,"nodeName":185,"attributes":1301,"children":1303},{"id":1302},"ref-RFC2119",[1304],{"type":182,"textContent":709},{"type":182,"textContent":1306},"]  Bradner, S., \"Key words for use in RFCs to Indicate\n              Requirement Levels\", ",{"type":177,"nodeName":185,"attributes":1308,"children":1309},{"href":698},[1310],{"type":182,"textContent":701},{"type":182,"textContent":1312},", ",{"type":177,"nodeName":185,"attributes":1314,"children":1315},{"href":706},[1316],{"type":182,"textContent":1317},"RFC 2119",{"type":182,"textContent":1319},",\n              DOI 10.17487\u002FRFC2119, March 1997,\n              \u003C",{"type":177,"nodeName":185,"attributes":1321,"children":1323},{"href":1322},"\u002Finfo\u002Frfc2119",[1324],{"type":182,"textContent":1325},"https:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc2119",{"type":182,"textContent":1327},">.\n\n   [",{"type":177,"nodeName":185,"attributes":1329,"children":1331},{"id":1330},"ref-RFC4301",[1332],{"type":182,"textContent":570},{"type":182,"textContent":1334},"]  Kent, S. and K. Seo, \"Security Architecture for the\n              Internet Protocol\", ",{"type":177,"nodeName":185,"attributes":1336,"children":1337},{"href":567},[1338],{"type":182,"textContent":1339},"RFC 4301",{"type":182,"textContent":1341},", DOI 10.17487\u002FRFC4301,\n              December 2005, \u003C",{"type":177,"nodeName":185,"attributes":1343,"children":1345},{"href":1344},"\u002Finfo\u002Frfc4301",[1346],{"type":182,"textContent":1347},"https:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc4301",{"type":182,"textContent":1327},{"type":177,"nodeName":185,"attributes":1350,"children":1352},{"id":1351},"ref-RFC4302",[1353],{"type":182,"textContent":562},{"type":182,"textContent":1355},"]  Kent, S., \"IP Authentication Header\", ",{"type":177,"nodeName":185,"attributes":1357,"children":1358},{"href":559},[1359],{"type":182,"textContent":1360},"RFC 4302",{"type":182,"textContent":1362},",\n              DOI 10.17487\u002FRFC4302, December 2005,\n              \u003C",{"type":177,"nodeName":185,"attributes":1364,"children":1366},{"href":1365},"\u002Finfo\u002Frfc4302",[1367],{"type":182,"textContent":1368},"https:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc4302",{"type":182,"textContent":1327},{"type":177,"nodeName":185,"attributes":1371,"children":1373},{"id":1372},"ref-RFC4303",[1374],{"type":182,"textContent":554},{"type":182,"textContent":1376},"]  Kent, S., \"IP Encapsulating Security Payload (ESP)\",\n              ",{"type":177,"nodeName":185,"attributes":1378,"children":1379},{"href":551},[1380],{"type":182,"textContent":1381},"RFC 4303",{"type":182,"textContent":1383},", DOI 10.17487\u002FRFC4303, December 2005,\n              \u003C",{"type":177,"nodeName":185,"attributes":1385,"children":1387},{"href":1386},"\u002Finfo\u002Frfc4303",[1388],{"type":182,"textContent":1389},"https:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc4303",{"type":182,"textContent":1327},{"type":177,"nodeName":185,"attributes":1392,"children":1394},{"id":1393},"ref-RFC7321",[1395],{"type":182,"textContent":637},{"type":182,"textContent":1397},"]  McGrew, D. and P. Hoffman, \"Cryptographic Algorithm\n              Implementation Requirements and Usage Guidance for\n              Encapsulating Security Payload (ESP) and Authentication\n              Header (AH)\", ",{"type":177,"nodeName":185,"attributes":1399,"children":1400},{"href":187},[1401],{"type":182,"textContent":206},{"type":182,"textContent":1403},", DOI 10.17487\u002FRFC7321, August 2014,\n              \u003C",{"type":177,"nodeName":185,"attributes":1405,"children":1407},{"href":1406},"\u002Finfo\u002Frfc7321",[1408],{"type":182,"textContent":1409},"https:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc7321",{"type":182,"textContent":1327},{"type":177,"nodeName":185,"attributes":1412,"children":1414},{"id":1413},"ref-RFC8174",[1415],{"type":182,"textContent":717},{"type":182,"textContent":1417},"]  Leiba, B., \"Ambiguity of Uppercase vs Lowercase in ",{"type":177,"nodeName":185,"attributes":1419,"children":1420},{"href":706},[1421],{"type":182,"textContent":1422},"RFC",{"type":182,"textContent":1424},"\n              ",{"type":177,"nodeName":185,"attributes":1426,"children":1427},{"href":706},[1428],{"type":182,"textContent":1429},"2119",{"type":182,"textContent":1431}," Key Words\", ",{"type":177,"nodeName":185,"attributes":1433,"children":1434},{"href":698},[1435],{"type":182,"textContent":701},{"type":182,"textContent":1312},{"type":177,"nodeName":185,"attributes":1438,"children":1439},{"href":714},[1440],{"type":182,"textContent":1441},"RFC 8174",{"type":182,"textContent":1443},", DOI 10.17487\u002FRFC8174,\n              May 2017, \u003C",{"type":177,"nodeName":185,"attributes":1445,"children":1447},{"href":1446},"\u002Finfo\u002Frfc8174",[1448],{"type":182,"textContent":1449},"https:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc8174",{"type":182,"textContent":1451},">.\n\n",{"type":177,"nodeName":194,"attributes":1453,"children":1454},{"class":575},[1455,1459],{"type":177,"nodeName":185,"attributes":1456,"children":1457},{"class":542,"id":172,"href":483},[1458],{"type":182,"textContent":486},{"type":182,"textContent":1460},".  Informative References",{"type":182,"textContent":1299},{"type":177,"nodeName":185,"attributes":1463,"children":1465},{"id":1464},"ref-PD10",[1466],{"type":182,"textContent":1077},{"type":182,"textContent":1468},"]     Paterson, K. and J. Degabriele, \"On the (in)security of\n              IPsec in MAC-then-encrypt configurations\", Proceedings of\n              the 17th ACM Conference on Computer and Communications\n              Security (ACM CCS), DOI 10.1145\u002F1866307.1866363, 2010.\n\n   [",{"type":177,"nodeName":185,"attributes":1470,"children":1472},{"id":1471},"ref-RFC2395",[1473],{"type":182,"textContent":1155},{"type":182,"textContent":1475},"]  Friend, R. and R. Monsour, \"IP Payload Compression Using\n              LZS\", ",{"type":177,"nodeName":185,"attributes":1477,"children":1478},{"href":1152},[1479],{"type":182,"textContent":1480},"RFC 2395",{"type":182,"textContent":1482},", DOI 10.17487\u002FRFC2395, December 1998,\n              \u003C",{"type":177,"nodeName":185,"attributes":1484,"children":1486},{"href":1485},"\u002Finfo\u002Frfc2395",[1487],{"type":182,"textContent":1488},"https:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc2395",{"type":182,"textContent":1327},{"type":177,"nodeName":185,"attributes":1491,"children":1493},{"id":1492},"ref-RFC2403",[1494],{"type":182,"textContent":1006},{"type":182,"textContent":1496},"]  Madson, C. and R. Glenn, \"The Use of HMAC-MD5-96 within\n              ESP and AH\", ",{"type":177,"nodeName":185,"attributes":1498,"children":1499},{"href":1003},[1500],{"type":182,"textContent":1501},"RFC 2403",{"type":182,"textContent":1503},", DOI 10.17487\u002FRFC2403, November\n              1998, \u003C",{"type":177,"nodeName":185,"attributes":1505,"children":1507},{"href":1506},"\u002Finfo\u002Frfc2403",[1508],{"type":182,"textContent":1509},"https:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc2403",{"type":182,"textContent":1511},">.\n\n\n\n\n\n\n",{"type":177,"nodeName":194,"attributes":1513,"children":1514},{"class":227},[1515],{"type":182,"textContent":1516},"Wouters, et al