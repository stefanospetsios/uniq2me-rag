tle":157},"section-10","10.  Security Considerations",{"links":159,"sections":163},[160],{"id":161,"title":162},"section-11","11.  References",[164,169],{"links":165},[166],{"id":167,"title":168},"section-11.1","11.1.  Normative References",{"links":170},[171],{"id":172,"title":173},"section-11.2","11.2.  Informative References","plaintext",[176,231,233,238,514,515,518,611,612,615,663,664,667,742,743,746,788,789,792,906,907,910,963,964,967,1097,1098,1101,1177,1178,1181,1257,1258,1261,1517,1518,1521,1755,1756,1759,1910,1911,1914,1938],{"type":177,"nodeName":178,"attributes":179,"children":180},"Element","pre",{},[181,184,191,193,200,202,207,209,215,217,223,225],{"type":182,"textContent":183},"Text","Internet Engineering Task Force (IETF)                        P. Wouters\nRequest for Comments: 8221                                       Red Hat\nObsoletes: ",{"type":177,"nodeName":185,"attributes":186,"children":188},"a",{"href":187},"\u002Finfo\u002Frfc7321\u002F",[189],{"type":182,"textContent":190},"7321",{"type":182,"textContent":192},"                                               D. Migault\nCategory: Standards Track                                    J. Mattsson\nISSN: 2070-1721                                                 Ericsson\n                                                                  Y. Nir\n                                                             Check Point\n                                                              T. Kivinen\n                                                            October 2017\n\n\n ",{"type":177,"nodeName":194,"attributes":195,"children":197},"span",{"class":196},"h1",[198],{"type":182,"textContent":199},"Cryptographic Algorithm Implementation Requirements and Usage Guidance",{"type":182,"textContent":201},"\nfor Encapsulating Security Payload (ESP) and Authentication Header (AH)\n\nAbstract\n\n   This document replaces ",{"type":177,"nodeName":185,"attributes":203,"children":204},{"href":187},[205],{"type":182,