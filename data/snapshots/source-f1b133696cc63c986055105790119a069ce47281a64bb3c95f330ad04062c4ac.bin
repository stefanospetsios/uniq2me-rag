								 </td><td align="left" valign="top" headers="idm140308465045280"> <p>
									no
								</p>
								 </td><td align="left" valign="top" headers="idm140308465044032"> <p>
									no
								</p>
								 </td></tr><tr><td align="left" valign="top" headers="idm140308465048704"> <p>
									<span class="strong strong"><strong>DH</strong></span>
								</p>
								 </td><td align="left" valign="top" headers="idm140308465047776"> <p>
									min. 2048-bit
								</p>
								 </td><td align="left" valign="top" headers="idm140308465046528"> <p>
									min. 2048-bit
								</p>
								 </td><td align="left" valign="top" headers="idm140308465045280"> <p>
									min. 2048-bit
								</p>
								 </td><td align="left" valign="top" headers="idm140308465044032"> <p>
									min. 3072-bit
								</p>
								 </td></tr><tr><td align="left" valign="top" headers="idm140308465048704"> <p>
									<span class="strong strong"><strong>RSA</strong></span>
								</p>
								 </td><td align="left" valign="top" headers="idm140308465047776"> <p>
									min. 2048-bit
								</p>
								 </td><td align="left" valign="top" headers="idm140308465046528"> <p>
									min. 2048-bit
