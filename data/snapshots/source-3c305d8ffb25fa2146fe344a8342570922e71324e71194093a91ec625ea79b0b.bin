721\n\n\n                 ",{"type":723,"nodeName":740,"attributes":741,"children":743},"span",{"class":742},"h1",[744],{"type":728,"textContent":7},{"type":728,"textContent":746},"\n\nAbstract\n\n   The OAuth 2.0 authorization framework enables a third-party\n   application to obtain limited access to an HTTP service, either on\n   behalf of a resource owner by orchestrating an approval interaction\n   between the resource owner and the HTTP service, or by allowing the\n   third-party application to obtain access on its own behalf.  This\n   specification replaces and obsoletes the OAuth 1.0 protocol described\n   in ",{"type":723,"nodeName":731,"attributes":748,"children":749},{"href":733},[750],{"type":728,"textContent":751},"RFC 5849",{"type":728,"textContent":753},".\n\nStatus of This Memo\n\n   This is an Internet Standards Track document.\n\n   This document is a product of the Internet Engineering Task Force\n   (IETF).  It represents the consensus of the IETF community.  It has\n   received public review and has been approved for publication by the\n   Internet Engineering Steering Group (IESG).  Further information on\n   Internet Standards is available in ",{"type":723,"nodeName":731,"attributes":755,"children":757},{"href":756},"\u002Finfo\u002Frfc5741\u002F#section-2",[758],{"type":728,"textContent":759},"Section 2 of RFC 5741",{"type":728,"textContent":761},".\n\n   Information about the current status of this document, any errata,\n   and how to provide feedback on it may be obtained at\n   ",{"type":723,"nodeName":731,"attributes":763,"children":765},{"href":764},"\u002Finfo\u002Frfc6749",[766],{"type":728,"textContent":767},"http:\u002F\u002Fwww.rfc-editor.org\u002Finfo\u002Frfc6749",{"type":728,"textContent":769},".\n\nCopyright Notice\n\n   Copyright (c) 2012 IETF Trust and the persons identified as the\n   document authors.  All rights reserved.\n\n   This document is subject to ",{"type":723,"nodeName":731,"attributes":771,"children":773},{"href":772},"\u002Fbcp\u002Fbcp78",[774],{"type":728,"textContent":775},"BCP 78",{"type":728,"textContent":777}," and the IETF Trust's Legal\n   Provisions Relating to IETF Documents\n   (",{"type":723,"nodeName":731,"attributes":779,"children":781},{"href":780},"http:\u002F\u002Ftrustee.ietf.org\u002Flicense-info",[782],{"type":728,"textContent":780},{"type":728,"textContent":784},") in effect on the date of\n   publication of this document.  Please review these documents\n   carefully, as they describe your rights and restrictions with respect\n   to this document.  Code Components extracted from this document must\n   include Simplified BSD License text as described in Section 4.e of\n   the Trust Legal Provisions and are provided without warranty as\n   described in the Simplified BSD License.\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":786,"children":788},{"class":787},"grey",[789],{"type":728,"textContent":790},"Hardt                        Standards Track                    [Page 1]",{"type":728,"textContent":792},"\n",{"type":723,"nodeName":794,"attributes":795,"children":797},"hr",{"class":796},"noprint",[],{"type":723,"nodeName":724,"attributes":799,"children":801},{"class":800},"newpage",[802,806,807,818,820,826,828,834,836,842,844,850,851,857,859,865,866,872,874,880,882,888,890,894,895,901,903,907,908,914,916,922,923,929,931,935,936,942,944,950,951,957,959,963,964,970,972,978,979,985,987,991,992,998,1000,1004,1005,1011,1013,1019,1021,1027,1029,1033,1034,1040,1042,1048,1049,1055,1057,1063,1064,1070,1072,1078,1079,1085,1087,1091,1092,1098,1100,1106,1107,1113,1115,1119,1120,1126,1128,1134,1135,1141,1143,1147,1148,1154,1156,1162,1163,1169,1171,1175,1176,1182,1184,1190,1191,1197,1199,1205,1206,1212,1214,1220,1221,1226,1228,1232,1233,1239,1241,1247,1248,1254,1256,1262,1263,1269,1271,1277,1278,1284,1286,1292,1293,1299,1301,1307,1308,1314,1316,1322,1323,1329,1330,1336,1337,1343,1344,1350,1351,1357,1359,1365,1366,1372,1374,1380,1381,1387,1388,1392,1393,1399,140