te\" Syntax ............................................",{"type":723,"nodeName":731,"attributes":2222,"children":2223},{"href":2208},[2224],{"type":728,"textContent":2211},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2227,"children":2229},{"href":2228},"#appendix-A.6",[2230],{"type":728,"textContent":2231},"A.6",{"type":728,"textContent":2233},".  \"redirect_uri\" Syntax .....................................",{"type":723,"nodeName":731,"attributes":2235,"children":2236},{"href":2208},[2237],{"type":728,"textContent":2211},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2240,"children":2242},{"href":2241},"#appendix-A.7",[2243],{"type":728,"textContent":2244},"A.7",{"type":728,"textContent":2246},".  \"error\" Syntax ............................................",{"type":723,"nodeName":731,"attributes":2248,"children":2249},{"href":2208},[2250],{"type":728,"textContent":2211},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2253,"children":2255},{"href":2254},"#appendix-A.8",[2256],{"type":728,"textContent":2257},"A.8",{"type":728,"textContent":2259},".  \"error_description\" Syntax ................................",{"type":723,"nodeName":731,"attributes":2261,"children":2262},{"href":2208},[2263],{"type":728,"textContent":2211},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2266,"children":2268},{"href":2267},"#appendix-A.9",[2269],{"type":728,"textContent":2270},"A.9",{"type":728,"textContent":2272},".  \"error_uri\" Syntax ........................................",{"type":723,"nodeName":731,"attributes":2274,"children":2275},{"href":2208},[2276],{"type":728,"textContent":2211},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2279,"children":2281},{"href":2280},"#appendix-A.10",[2282],{"type":728,"textContent":2283},"A.10",{"type":728,"textContent":2285},". \"grant_type\" Syntax .......................................",{"type":723,"nodeName":731,"attributes":2287,"children":2289},{"href":2288},"#page-73",[2290],{"type":728,"textContent":2291},"73",{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2294,"children":2296},{"href":2295},"#appendix-A.11",[2297],{"type":728,"textContent":2298},"A.11",{"type":728,"textContent":2300},". \"code\" Syntax .............................................",{"type":723,"nodeName":731,"attributes":2302,"children":2303},{"href":2288},[2304],{"type":728,"textContent":2291},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2307,"children":2309},{"href":2308},"#appendix-A.12",[2310],{"type":728,"textContent":2311},"A.12",{"type":728,"textContent":2313},". \"access_token\" Syntax .....................................",{"type":723,"nodeName":731,"attributes":2315,"children":2316},{"href":2288},[2317],{"type":728,"textContent":2291},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2320,"children":2322},{"href":2321},"#appendix-A.13",[2323],{"type":728,"textContent":2324},"A.13",{"type":728,"textContent":2326},". \"token_type\" Syntax .......................................",{"type":723,"nodeName":731,"attributes":2328,"children":2329},{"href":2288},[2330],{"type":728,"textContent":2291},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2333,"children":2335},{"href":2334},"#appendix-A.14",[2336],{"type":728,"textContent":2337},"A.14",{"type":728,"textContent":2339},". \"expires_in\" Syntax .......................................",{"type":723,"nodeName":731,"attributes":2341,"children":2342},{"href":2288},[2343],{"type":728,"textContent":2291},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2346,"children":2348},{"href":2347},"#appendix-A.15",[2349],{"type":728,"textContent":2350},"A.15",{"type":728,"textContent":2352},". \"username\" Syntax .........................................",{"type":723,"nodeName":731,"attributes":2354,"children":2355},{"href":2288},[2356],{"type":728,"textContent":2291},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2359,"children":2361},{"href":2360},"#appendix-A.16",[2362],{"type":728,"textContent":2363},"A.16",{"type":728,"textContent":2365},". \"password\" Syntax .........................................",{"type":723,"nodeName":731,"attributes":2367,"children":2368},{"href":2288},[2369],{"type":728,"textContent":2291},{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2372,"children":2374},{"href":2373},"#appendix-A.17",[2375],{"type":728,"textContent":2376},"A.17",{"type":728,"textContent":2378},". \"refresh_token\" Syntax ....................................",{"type":723,"nodeName":731,"attributes":2380,"children":2382},{"href":2381},"#page-74",[2383],{"type":728,"textContent":2384},"74",{"type":728,"textContent":2158},{"type":723,"nodeName":731,"attributes":2387,"children":2389},{"href":2388},"#appendix-A.18",[2390],{"type":728,"textContent":2391},"A.18",{"type":728,"textContent":2393},". Endpoint Parameter Syntax .................................",{"type":723,"nodeName":731,"attributes":2395,"children":2396},{"href":2381},[2397],{"type":728,"textContent":2384},{"type":728,"textContent":1020},{"type":723,"nodeName":731,"attributes":2400,"children":2402},{"href":2401},"#appendix-B",[2403],{"type":728,"textContent":2404},"Appendix B",{"type":728,"textContent":2406},". Use of application\u002Fx-www-form-urlencoded Media Type ...",{"type":723,"nodeName":731,"attributes":2408,"children":2409},{"href":2381},[2410],{"type":728,"textContent":2384},{"type":728,"textContent":1020},{"type":723,"nodeName":731,"attributes":2413,"children":2415},{"href":2414},"#appendix-C",[2416],{"type":728,"textContent":2417},"Appendix C",{"type":728,"textContent":2419},". Acknowledgements ......................................",{"type":723,"nodeName":731,"attributes":2421,"children":2423},{"href":2422},"#page-75",[2424],{"type":728,"textContent":2425},"75",{"type":728,"textContent":2427},"\n\n",{"type":723,"nodeName":740,"attributes":2429,"children":2431},{"class":2430},"h2",[2432,2437],{"type":723,"nodeName":731,"attributes":2433,"children":2435},{"class":2434,"id":97,"href":822},"selflink",[2436],{"type":728,"textContent":825},{"type":728,"textContent":2438},".  Introduction",{"type":728,"textContent":2440},"\n\n   In the traditional client-server authentication model, the client\n   requests an access-restricted resource (protected resource) on the\n   server by authenticating with the server using the resource owner's\n   credentials.  In order to provide third-party applications access to\n   restricted resources, the resource owner shares its credentials with\n   the third party.  This creates several problems and limitations:\n\n   o  Third-party applications are required to store the resource\n      owner's credentials for future use, typically a password in\n      clear-text.\n\n   o  Servers are required to support password authentication, despite\n      the security weaknesses inherent in passwords.\n\n   o  Third-party applications gain overly broad access to the resource\n      owner's protected resources, leaving resource owners without any\n      ability to restrict duration or access to a limited subset of\n      resources.\n\n   o  Resource owners cannot revoke access to an individual third party\n      without revoking access to all third parties, and must do so by\n      changing the third party's password.\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2442,"children":2443},{"class":787},[2444],{"type":728,"textContent":2445},"Hardt                        Standards Track                    [Page 4]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2448,"children":2449},{"class":796},[],{"type":723,"nodeName":724,"attributes":2451,"children":2452},{"class":800},[2453,2457,2458,2466,2468,2474,2476,2481,2483],{"type":723,"nodeName":740,"attributes":2454,"children":2456},{"id":2455},"page-5",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2459,"children":2460},{"class":787},[2461,2465],{"type":723,"nodeName":731,"attributes":2462,"children":2463},{"href":812},[2464],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2467},"\n\n\n   o  Compromise of any third-party application results in compromise of\n      the end-user's password and all of the data protected by that\n      password.\n\n   OAuth addresses these issues by introducing an authorization layer\n   and separating the role of the client from that of the resource\n   owner.  In OAuth, the client requests access to resources controlled\n   by the resource owner and hosted by the resource server, and is\n   issued a different set of credentials than those of the resource\n   owner.\n\n   Instead of using the resource owner's credentials to access protected\n   resources, the client obtains an access token -- a string denoting a\n   specific scope, lifetime, and other access attributes.  Access tokens\n   are issued to third-party clients by an authorization server with the\n   approval of the resource owner.  The client uses the access token to\n   access the protected resources hosted by the resource server.\n\n   For example, an end-user (resource owner) can grant a printing\n   service (client) access to her protected photos stored at a photo-\n   sharing service (resource server), without sharing her username and\n   password with the printing service.  Instead, she authenticates\n   directly with a server trusted by the photo-sharing service\n   (authorization server), which issues the printing service delegation-\n   specific credentials (access token).\n\n   This specification is designed for use with HTTP ([",{"type":723,"nodeName":731,"attributes":2469,"children":2471},{"href":2470},"\u002Finfo\u002Frfc2616\u002F",[2472],{"type":728,"textContent":2473},"RFC2616",{"type":728,"textContent":2475},"]).  The\n   use of OAuth over any protocol other than HTTP is out of scope.\n\n   The OAuth 1.0 protocol ([",{"type":723,"nodeName":731,"attributes":2477,"children":2478},{"href":733},[2479],{"type":728,"textContent":2480},"RFC5849",{"type":728,"textContent":2482},"]), published as an informational\n   document, was the result of a small ad hoc community effort.  This\n   Standards Track specification builds on the OAuth 1.0 deployment\n   experience, as well as additional use cases and extensibility\n   requirements gathered from the wider IETF community.  The OAuth 2.0\n   protocol is not backward compatible with OAuth 1.0.  The two versions\n   may co-exist on the network, and implementations may choose to\n   support both.  However, it is the intention of this specification\n   that new implementations support OAuth 2.0 as specified in this\n   document and that OAuth 1.0 is used only to support existing\n   deployments.  The OAuth 2.0 protocol shares very few implementation\n   details with the OAuth 1.0 protocol.  Implementers familiar with\n   OAuth 1.0 should approach this document without any assumptions as to\n   its structure and details.\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2484,"children":2485},{"class":787},[2486],{"type":728,"textContent":2487},"Hardt                        Standards Track                    [Page 5]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2490,"children":2491},{"class":796},[],{"type":723,"nodeName":724,"attributes":2493,"children":2494},{"class":800},[2495,2499,2500,2508,2510,2520,2522],{"type":723,"nodeName":740,"attributes":2496,"children":2498},{"id":2497},"page-6",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2501,"children":2502},{"class":787},[2503,2507],{"type":723,"nodeName":731,"attributes":2504,"children":2505},{"href":812},[2506],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},"\n\n\n",{"type":723,"nodeName":740,"attributes":2511,"children":2513},{"class":2512},"h3",[2514,2518],{"type":723,"nodeName":731,"attributes":2515,"children":2516},{"class":2434,"id":103,"href":838},[2517],{"type":728,"textContent":841},{"type":728,"textContent":2519},".  Roles",{"type":728,"textContent":2521},"\n\n   OAuth defines four roles:\n\n   resource owner\n      An entity capable of granting access to a protected resource.\n      When the resource owner is a person, it is referred to as an\n      end-user.\n\n   resource server\n      The server hosting the protected resources, capable of accepting\n      and responding to protected resource requests using access tokens.\n\n   client\n      An application making protected resource requests on behalf of the\n      resource owner and with its authorization.  The term \"client\" does\n      not imply any particular implementation characteristics (e.g.,\n      whether the application executes on a server, a desktop, or other\n      devices).\n\n   authorization server\n      The server issuing access tokens to the client after successfully\n      authenticating the resource owner and obtaining authorization.\n\n   The interaction between the authorization server and resource server\n   is beyond the scope of this specification.  The authorization server\n   may be the same server as the resource server or a separate entity.\n   A single authorization server may issue access tokens accepted by\n   multiple resource servers.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2523,"children":2524},{"class":787},[2525],{"type":728,"textContent":2526},"Hardt                        Standards Track                    [Page 6]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2529,"children":2530},{"class":796},[],{"type":723,"nodeName":724,"attributes":2532,"children":2533},{"class":800},[2534,2538,2539,2547,2548,2557,2559],{"type":723,"nodeName":740,"attributes":2535,"children":2537},{"id":2536},"page-7",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2540,"children":2541},{"class":787},[2542,2546],{"type":723,"nodeName":731,"attributes":2543,"children":2544},{"href":812},[2545],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":2549,"children":2550},{"class":2512},[2551,2555],{"type":723,"nodeName":731,"attributes":2552,"children":2553},{"class":2434,"id":108,"href":853},[2554],{"type":728,"textContent":856},{"type":728,"textContent":2556},".  Protocol Flow",{"type":728,"textContent":2558},"\n\n     +--------+                               +---------------+\n     |        |--(A)- Authorization Request ->|   Resource    |\n     |        |                               |     Owner     |\n     |        |\u003C-(B)-- Authorization Grant ---|               |\n     |        |                               +---------------+\n     |        |\n     |        |                               +---------------+\n     |        |--(C)-- Authorization Grant -->| Authorization |\n     | Client |                               |     Server    |\n     |        |\u003C-(D)----- Access Token -------|               |\n     |        |                               +---------------+\n     |        |\n     |        |                               +---------------+\n     |        |--(E)----- Access Token ------>|    Resource   |\n     |        |                               |     Server    |\n     |        |\u003C-(F)--- Protected Resource ---|               |\n     +--------+                               +---------------+\n\n                     Figure 1: Abstract Protocol Flow\n\n   The abstract OAuth 2.0 flow illustrated in Figure 1 describes the\n   interaction between the four roles and includes the following steps:\n\n   (A)  The client requests authorization from the resource owner.  The\n        authorization request can be made directly to the resource owner\n        (as shown), or preferably indirectly via the authorization\n        server as an intermediary.\n\n   (B)  The client receives an authorization grant, which is a\n        credential representing the resource owner's authorization,\n        expressed using one of four grant types defined in this\n        specification or using an extension grant type.  The\n        authorization grant type depends on the method used by the\n        client to request authorization and the types supported by the\n        authorization server.\n\n   (C)  The client requests an access token by authenticating with the\n        authorization server and presenting the authorization grant.\n\n   (D)  The authorization server authenticates the client and validates\n        the authorization grant, and if valid, issues an access token.\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2560,"children":2561},{"class":787},[2562],{"type":728,"textContent":2563},"Hardt                        Standards Track                    [Page 7]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2566,"children":2567},{"class":796},[],{"type":723,"nodeName":724,"attributes":2569,"children":2570},{"class":800},[2571,2575,2576,2584,2586,2591,2593,2602,2604,2614,2616,2620,2622,2631,2633],{"type":723,"nodeName":740,"attributes":2572,"children":2574},{"id":2573},"page-8",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2577,"children":2578},{"class":787},[2579,2583],{"type":723,"nodeName":731,"attributes":2580,"children":2581},{"href":812},[2582],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2585},"\n\n\n   (E)  The client requests the protected resource from the resource\n        server and authenticates by presenting the access token.\n\n   (F)  The resource server validates the access token, and if valid,\n        serves the request.\n\n   The preferred method for the client to obtain an authorization grant\n   from the resource owner (depicted in steps (A) and (B)) is to use the\n   authorization server as an intermediary, which is illustrated in\n   Figure 3 in ",{"type":723,"nodeName":731,"attributes":2587,"children":2588},{"href":1235},[2589],{"type":728,"textContent":2590},"Section 4.1",{"type":728,"textContent":2592},".\n\n",{"type":723,"nodeName":740,"attributes":2594,"children":2595},{"class":2512},[2596,2600],{"type":723,"nodeName":731,"attributes":2597,"children":2598},{"class":2434,"id":113,"href":868},[2599],{"type":728,"textContent":871},{"type":728,"textContent":2601},".  Authorization Grant",{"type":728,"textContent":2603},"\n\n   An authorization grant is a credential representing the resource\n   owner's authorization (to access its protected resources) used by the\n   client to obtain an access token.  This specification defines four\n   grant types -- authorization code, implicit, resource owner password\n   credentials, and client credentials -- as well as an extensibility\n   mechanism for defining additional types.\n\n",{"type":723,"nodeName":740,"attributes":2605,"children":2607},{"class":2606},"h4",[2608,2612],{"type":723,"nodeName":731,"attributes":2609,"children":2610},{"class":2434,"id":119,"href":884},[2611],{"type":728,"textContent":887},{"type":728,"textContent":2613},".  Authorization Code",{"type":728,"textContent":2615},"\n\n   The authorization code is obtained by using an authorization server\n   as an intermediary between the client and resource owner.  Instead of\n   requesting authorization directly from the resource owner, the client\n   directs the resource owner to an authorization server (via its\n   user-agent as defined in [",{"type":723,"nodeName":731,"attributes":2617,"children":2618},{"href":2470},[2619],{"type":728,"textContent":2473},{"type":728,"textContent":2621},"]), which in turn directs the\n   resource owner back to the client with the authorization code.\n\n   Before directing the resource owner back to the client with the\n   authorization code, the authorization server authenticates the\n   resource owner and obtains authorization.  Because the resource owner\n   only authenticates with the authorization server, the resource\n   owner's credentials are never shared with the client.\n\n   The authorization code provides a few important security benefits,\n   such as the ability to authenticate the client, as well as the\n   transmission of the access token directly to the client without\n   passing it through the resource owner's user-agent and potentially\n   exposing it to others, including the resource owner.\n\n",{"type":723,"nodeName":740,"attributes":2623,"children":2624},{"class":2606},[2625,2629],{"type":723,"nodeName":731,"attributes":2626,"children":2627},{"class":2434,"id":124,"href":897},[2628],{"type":728,"textContent":900},{"type":728,"textContent":2630},".  Implicit",{"type":728,"textContent":2632},"\n\n   The implicit grant is a simplified authorization code flow optimized\n   for clients implemented in a browser using a scripting language such\n   as JavaScript.  In the implicit flow, instead of issuing the client\n   an authorization code, the client is issued an access token directly\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2634,"children":2635},{"class":787},[2636],{"type":728,"textContent":2637},"Hardt                        Standards Track                    [Page 8]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2640,"children":2641},{"class":796},[],{"type":723,"nodeName":724,"attributes":2643,"children":2644},{"class":800},[2645,2649,2650,2658,2660,2664,2666,2672,2674,2683,2685,2694,2696],{"type":723,"nodeName":740,"attributes":2646,"children":2648},{"id":2647},"page-9",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2651,"children":2652},{"class":787},[2653,2657],{"type":723,"nodeName":731,"attributes":2654,"children":2655},{"href":812},[2656],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2659},"\n\n\n   (as the result of the resource owner authorization).  The grant type\n   is implicit, as no intermediate credentials (such as an authorization\n   code) are issued (and later used to obtain an access token).\n\n   When issuing an access token during the implicit grant flow, the\n   authorization server does not authenticate the client.  In some\n   cases, the client identity can be verified via the redirection URI\n   used to deliver the access token to the client.  The access token may\n   be exposed to the resource owner or other applications with access to\n   the resource owner's user-agent.\n\n   Implicit grants improve the responsiveness and efficiency of some\n   clients (such as a client implemented as an in-browser application),\n   since it reduces the number of round trips required to obtain an\n   access token.  However, this convenience should be weighed against\n   the security implications of using implicit grants, such as those\n   described in Sections ",{"type":723,"nodeName":731,"attributes":2661,"children":2662},{"href":1738},[2663],{"type":728,"textContent":1741},{"type":728,"textContent":2665}," and ",{"type":723,"nodeName":731,"attributes":2667,"children":2669},{"href":2668},"#section-10.16",[2670],{"type":728,"textContent":2671},"10.16",{"type":728,"textContent":2673},", especially when the\n   authorization code grant type is available.\n\n",{"type":723,"nodeName":740,"attributes":2675,"children":2676},{"class":2606},[2677,2681],{"type":723,"nodeName":731,"attributes":2678,"children":2679},{"class":2434,"id":129,"href":910},[2680],{"type":728,"textContent":913},{"type":728,"textContent":2682},".  Resource Owner Password Credentials",{"type":728,"textContent":2684},"\n\n   The resource owner password credentials (i.e., username and password)\n   can be used directly as an authorization grant to obtain an access\n   token.  The credentials should only be used when there is a high\n   degree of trust between the resource owner and the client (e.g., the\n   client is part of the device operating system or a highly privileged\n   application), and when other authorization grant types are not\n   available (such as an authorization code).\n\n   Even though this grant type requires direct client access to the\n   resource owner credentials, the resource owner credentials are used\n   for a single request and are exchanged for an access token.  This\n   grant type can eliminate the need for the client to store the\n   resource owner credentials for future use, by exchanging the\n   credentials with a long-lived access token or refresh token.\n\n",{"type":723,"nodeName":740,"attributes":2686,"children":2687},{"class":2606},[2688,2692],{"type":723,"nodeName":731,"attributes":2689,"children":2690},{"class":2434,"id":134,"href":925},[2691],{"type":728,"textContent":928},{"type":728,"textContent":2693},".  Client Credentials",{"type":728,"textContent":2695},"\n\n   The client credentials (or other forms of client authentication) can\n   be used as an authorization grant when the authorization scope is\n   limited to the protected resources under the control of the client,\n   or to protected resources previously arranged with the authorization\n   server.  Client credentials are used as an authorization grant\n   typically when the client is acting on its own behalf (the client is\n   also the resource owner) or is requesting access to protected\n   resources based on an authorization previously arranged with the\n   authorization server.\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2697,"children":2698},{"class":787},[2699],{"type":728,"textContent":2700},"Hardt                        Standards Track                    [Page 9]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2703,"children":2704},{"class":796},[],{"type":723,"nodeName":724,"attributes":2706,"children":2707},{"class":800},[2708,2712,2713,2721,2722,2731,2733,2739,2741,2750,2752],{"type":723,"nodeName":740,"attributes":2709,"children":2711},{"id":2710},"page-10",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2714,"children":2715},{"class":787},[2716,2720],{"type":723,"nodeName":731,"attributes":2717,"children":2718},{"href":812},[2719],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":2723,"children":2724},{"class":2512},[2725,2729],{"type":723,"nodeName":731,"attributes":2726,"children":2727},{"class":2434,"id":139,"href":938},[2728],{"type":728,"textContent":941},{"type":728,"textContent":2730},".  Access Token",{"type":728,"textContent":2732},"\n\n   Access tokens are credentials used to access protected resources.  An\n   access token is a string representing an authorization issued to the\n   client.  The string is usually opaque to the client.  Tokens\n   represent specific scopes and durations of access, granted by the\n   resource owner, and enforced by the resource server and authorization\n   server.\n\n   The token may denote an identifier used to retrieve the authorization\n   information or may self-contain the authorization information in a\n   verifiable manner (i.e., a token string consisting of some data and a\n   signature).  Additional authentication credentials, which are beyond\n   the scope of this specification, may be required in order for the\n   client to use a token.\n\n   The access token provides an abstraction layer, replacing different\n   authorization constructs (e.g., username and password) with a single\n   token understood by the resource server.  This abstraction enables\n   issuing access tokens more restrictive than the authorization grant\n   used to obtain them, as well as removing the resource server's need\n   to understand a wide range of authentication methods.\n\n   Access tokens can have different formats, structures, and methods of\n   utilization (e.g., cryptographic properties) based on the resource\n   server security requirements.  Access token attributes and the\n   methods used to access protected resources are beyond the scope of\n   this specification and are defined by companion specifications such\n   as [",{"type":723,"nodeName":731,"attributes":2734,"children":2736},{"href":2735},"\u002Finfo\u002Frfc6750\u002F",[2737],{"type":728,"textContent":2738},"RFC6750",{"type":728,"textContent":2740},"].\n\n",{"type":723,"nodeName":740,"attributes":2742,"children":2743},{"class":2512},[2744,2748],{"type":723,"nodeName":731,"attributes":2745,"children":2746},{"class":2434,"id":144,"href":953},[2747],{"type":728,"textContent":956},{"type":728,"textContent":2749},".  Refresh Token",{"type":728,"textContent":2751},"\n\n   Refresh tokens are credentials used to obtain access tokens.  Refresh\n   tokens are issued to the client by the authorization server and are\n   used to obtain a new access token when the current access token\n   becomes invalid or expires, or to obtain additional access tokens\n   with identical or narrower scope (access tokens may have a shorter\n   lifetime and fewer permissions than authorized by the resource\n   owner).  Issuing a refresh token is optional at the discretion of the\n   authorization server.  If the authorization server issues a refresh\n   token, it is included when issuing an access token (i.e., step (D) in\n   Figure 1).\n\n   A refresh token is a string representing the authorization granted to\n   the client by the resource owner.  The string is usually opaque to\n   the client.  The token denotes an identifier used to retrieve the\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2753,"children":2754},{"class":787},[2755],{"type":728,"textContent":2756},"Hardt                        Standards Track                   [Page 10]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2759,"children":2760},{"class":796},[],{"type":723,"nodeName":724,"attributes":2762,"children":2763},{"class":800},[2764,2768,2769,2777,2779],{"type":723,"nodeName":740,"attributes":2765,"children":2767},{"id":2766},"page-11",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2770,"children":2771},{"class":787},[2772,2776],{"type":723,"nodeName":731,"attributes":2773,"children":2774},{"href":812},[2775],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2778},"\n\n\n   authorization information.  Unlike access tokens, refresh tokens are\n   intended for use only with authorization servers and are never sent\n   to resource servers.\n\n  +--------+                                           +---------------+\n  |        |--(A)------- Authorization Grant --------->|               |\n  |        |                                           |               |\n  |        |\u003C-(B)----------- Access Token -------------|               |\n  |        |               & Refresh Token             |               |\n  |        |                                           |               |\n  |        |                            +----------+   |               |\n  |        |--(C)---- Access Token ---->|          |   |               |\n  |        |                            |          |   |               |\n  |        |\u003C-(D)- Protected Resource --| Resource |   | Authorization |\n  | Client |                            |  Server  |   |     Server    |\n  |        |--(E)---- Access Token ---->|          |   |               |\n  |        |                            |          |   |               |\n  |        |\u003C-(F)- Invalid Token Error -|          |   |               |\n  |        |                            +----------+   |               |\n  |        |                                           |               |\n  |        |--(G)----------- Refresh Token ----------->|               |\n  |        |                                           |               |\n  |        |\u003C-(H)----------- Access Token -------------|               |\n  +--------+           & Optional Refresh Token        +---------------+\n\n               Figure 2: Refreshing an Expired Access Token\n\n   The flow illustrated in Figure 2 includes the following steps:\n\n   (A)  The client requests an access token by authenticating with the\n        authorization server and presenting an authorization grant.\n\n   (B)  The authorization server authenticates the client and validates\n        the authorization grant, and if valid, issues an access token\n        and a refresh token.\n\n   (C)  The client makes a protected resource request to the resource\n        server by presenting the access token.\n\n   (D)  The resource server validates the access token, and if valid,\n        serves the request.\n\n   (E)  Steps (C) and (D) repeat until the access token expires.  If the\n        client knows the access token expired, it skips to step (G);\n        otherwise, it makes another protected resource request.\n\n   (F)  Since the access token is invalid, the resource server returns\n        an invalid token error.\n\n\n\n",{"type":723,"nodeName":740,"attributes":2780,"children":2781},{"class":787},[2782],{"type":728,"textContent":2783},"Hardt                        Standards Track                   [Page 11]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2786,"children":2787},{"class":796},[],{"type":723,"nodeName":724,"attributes":2789,"children":2790},{"class":800},[2791,2795,2796,2804,2806,2811,2812,2821,2823,2829,2831,2837,2839,2848,2850,2859,2861],{"type":723,"nodeName":740,"attributes":2792,"children":2794},{"id":2793},"page-12",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2797,"children":2798},{"class":787},[2799,2803],{"type":723,"nodeName":731,"attributes":2800,"children":2801},{"href":812},[2802],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2805},"\n\n\n   (G)  The client requests a new access token by authenticating with\n        the authorization server and presenting the refresh token.  The\n        client authentication requirements are based on the client type\n        and on the authorization server policies.\n\n   (H)  The authorization server authenticates the client and validates\n        the refresh token, and if valid, issues a new access token (and,\n        optionally, a new refresh token).\n\n   Steps (C), (D), (E), and (F) are outside the scope of this\n   specification, as described in ",{"type":723,"nodeName":731,"attributes":2807,"children":2808},{"href":1560},[2809],{"type":728,"textContent":2810},"Section 7",{"type":728,"textContent":2592},{"type":723,"nodeName":740,"attributes":2813,"children":2814},{"class":2512},[2815,2819],{"type":723,"nodeName":731,"attributes":2816,"children":2817},{"class":2434,"id":149,"href":966},[2818],{"type":728,"textContent":969},{"type":728,"textContent":2820},".  TLS Version",{"type":728,"textContent":2822},"\n\n   Whenever Transport Layer Security (TLS) is used by this\n   specification, the appropriate version (or versions) of TLS will vary\n   over time, based on the widespread deployment and known security\n   vulnerabilities.  At the time of this writing, TLS version 1.2\n   [",{"type":723,"nodeName":731,"attributes":2824,"children":2826},{"href":2825},"\u002Finfo\u002Frfc5246\u002F",[2827],{"type":728,"textContent":2828},"RFC5246",{"type":728,"textContent":2830},"] is the most recent version, but has a very limited\n   deployment base and might not be readily available for\n   implementation.  TLS version 1.0 [",{"type":723,"nodeName":731,"attributes":2832,"children":2834},{"href":2833},"\u002Finfo\u002Frfc2246\u002F",[2835],{"type":728,"textContent":2836},"RFC2246",{"type":728,"textContent":2838},"] is the most widely\n   deployed version and will provide the broadest interoperability.\n\n   Implementations MAY also support additional transport-layer security\n   mechanisms that meet their security requirements.\n\n",{"type":723,"nodeName":740,"attributes":2840,"children":2841},{"class":2512},[2842,2846],{"type":723,"nodeName":731,"attributes":2843,"children":2844},{"class":2434,"id":154,"href":981},[2845],{"type":728,"textContent":984},{"type":728,"textContent":2847},".  HTTP Redirections",{"type":728,"textContent":2849},"\n\n   This specification makes extensive use of HTTP redirections, in which\n   the client or the authorization server directs the resource owner's\n   user-agent to another destination.  While the examples in this\n   specification show the use of the HTTP 302 status code, any other\n   method available via the user-agent to accomplish this redirection is\n   allowed and is considered to be an implementation detail.\n\n",{"type":723,"nodeName":740,"attributes":2851,"children":2852},{"class":2512},[2853,2857],{"type":723,"nodeName":731,"attributes":2854,"children":2855},{"class":2434,"id":159,"href":994},[2856],{"type":728,"textContent":997},{"type":728,"textContent":2858},".  Interoperability",{"type":728,"textContent":2860},"\n\n   OAuth 2.0 provides a rich authorization framework with well-defined\n   security properties.  However, as a rich and highly extensible\n   framework with many optional components, on its own, this\n   specification is likely to produce a wide range of non-interoperable\n   implementations.\n\n   In addition, this specification leaves a few required components\n   partially or fully undefined (e.g., client registration,\n   authorization server capabilities, endpoint discovery).  Without\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2862,"children":2863},{"class":787},[2864],{"type":728,"textContent":2865},"Hardt                        Standards Track                   [Page 12]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2868,"children":2869},{"class":796},[],{"type":723,"nodeName":724,"attributes":2871,"children":2872},{"class":800},[2873,2877,2878,2886,2888,2897,2899,2905,2907,2913,2915,2921,2923,2929,2931,2940,2942],{"type":723,"nodeName":740,"attributes":2874,"children":2876},{"id":2875},"page-13",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2879,"children":2880},{"class":787},[2881,2885],{"type":723,"nodeName":731,"attributes":2882,"children":2883},{"href":812},[2884],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2887},"\n\n\n   these components, clients must be manually and specifically\n   configured against a specific authorization server and resource\n   server in order to interoperate.\n\n   This framework was designed with the clear expectation that future\n   work will define prescriptive profiles and extensions necessary to\n   achieve full web-scale interoperability.\n\n",{"type":723,"nodeName":740,"attributes":2889,"children":2890},{"class":2512},[2891,2895],{"type":723,"nodeName":731,"attributes":2892,"children":2893},{"class":2434,"id":164,"href":1007},[2894],{"type":728,"textContent":1010},{"type":728,"textContent":2896},".  Notational Conventions",{"type":728,"textContent":2898},"\n\n   The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\",\n   \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\" in this\n   specification are to be interpreted as described in [",{"type":723,"nodeName":731,"attributes":2900,"children":2902},{"href":2901},"\u002Finfo\u002Frfc2119\u002F",[2903],{"type":728,"textContent":2904},"RFC2119",{"type":728,"textContent":2906},"].\n\n   This specification uses the Augmented Backus-Naur Form (ABNF)\n   notation of [",{"type":723,"nodeName":731,"attributes":2908,"children":2910},{"href":2909},"\u002Finfo\u002Frfc5234\u002F",[2911],{"type":728,"textContent":2912},"RFC5234",{"type":728,"textContent":2914},"].  Additionally, the rule URI-reference is\n   included from \"Uniform Resource Identifier (URI): Generic Syntax\"\n   [",{"type":723,"nodeName":731,"attributes":2916,"children":2918},{"href":2917},"\u002Finfo\u002Frfc3986\u002F",[2919],{"type":728,"textContent":2920},"RFC3986",{"type":728,"textContent":2922},"].\n\n   Certain security-related terms are to be understood in the sense\n   defined in [",{"type":723,"nodeName":731,"attributes":2924,"children":2926},{"href":2925},"\u002Finfo\u002Frfc4949\u002F",[2927],{"type":728,"textContent":2928},"RFC4949",{"type":728,"textContent":2930},"].  These terms include, but are not limited to,\n   \"attack\", \"authentication\", \"authorization\", \"certificate\",\n   \"confidentiality\", \"credential\", \"encryption\", \"identity\", \"sign\",\n   \"signature\", \"trust\", \"validate\", and \"verify\".\n\n   Unless otherwise noted, all the protocol parameter names and values\n   are case sensitive.\n\n",{"type":723,"nodeName":740,"attributes":2932,"children":2933},{"class":2430},[2934,2938],{"type":723,"nodeName":731,"attributes":2935,"children":2936},{"class":2434,"id":169,"href":1023},[2937],{"type":728,"textContent":1026},{"type":728,"textContent":2939},".  Client Registration",{"type":728,"textContent":2941},"\n\n   Before initiating the protocol, the client registers with the\n   authorization server.  The means through which the client registers\n   with the authorization server are beyond the scope of this\n   specification but typically involve end-user interaction with an HTML\n   registration form.\n\n   Client registration does not require a direct interaction between the\n   client and the authorization server.  When supported by the\n   authorization server, registration can rely on other means for\n   establishing trust and obtaining the required client properties\n   (e.g., redirection URI, client type).  For example, registration can\n   be accomplished using a self-issued or third-party-issued assertion,\n   or by the authorization server performing client discovery using a\n   trusted channel.\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2943,"children":2944},{"class":787},[2945],{"type":728,"textContent":2946},"Hardt                        Standards Track                   [Page 13]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":2949,"children":2950},{"class":796},[],{"type":723,"nodeName":724,"attributes":2952,"children":2953},{"class":800},[2954,2958,2959,2967,2969,2974,2976,2981,2983,2992,2994],{"type":723,"nodeName":740,"attributes":2955,"children":2957},{"id":2956},"page-14",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":2960,"children":2961},{"class":787},[2962,2966],{"type":723,"nodeName":731,"attributes":2963,"children":2964},{"href":812},[2965],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2968},"\n\n\n   When registering a client, the client developer SHALL:\n\n   o  specify the client type as described in ",{"type":723,"nodeName":731,"attributes":2970,"children":2971},{"href":1036},[2972],{"type":728,"textContent":2973},"Section 2.1",{"type":728,"textContent":2975},",\n\n   o  provide its client redirection URIs as described in ",{"type":723,"nodeName":731,"attributes":2977,"children":2978},{"href":1165},[2979],{"type":728,"textContent":2980},"Section 3.1.2",{"type":728,"textContent":2982},",\n      and\n\n   o  include any other information required by the authorization server\n      (e.g., application name, website, description, logo image, the\n      acceptance of legal terms).\n\n",{"type":723,"nodeName":740,"attributes":2984,"children":2985},{"class":2512},[2986,2990],{"type":723,"nodeName":731,"attributes":2987,"children":2988},{"class":2434,"id":175,"href":1036},[2989],{"type":728,"textContent":1039},{"type":728,"textContent":2991},".  Client Types",{"type":728,"textContent":2993},"\n\n   OAuth defines two client types, based on their ability to\n   authenticate securely with the authorization server (i.e., ability to\n   maintain the confidentiality of their client credentials):\n\n   confidential\n      Clients capable of maintaining the confidentiality of their\n      credentials (e.g., client implemented on a secure server with\n      restricted access to the client credentials), or capable of secure\n      client authentication using other means.\n\n   public\n      Clients incapable of maintaining the confidentiality of their\n      credentials (e.g., clients executing on the device used by the\n      resource owner, such as an installed native application or a web\n      browser-based application), and incapable of secure client\n      authentication via any other means.\n\n   The client type designation is based on the authorization server's\n   definition of secure authentication and its acceptable exposure\n   levels of client credentials.  The authorization server SHOULD NOT\n   make assumptions about the client type.\n\n   A client may be implemented as a distributed set of components, each\n   with a different client type and security context (e.g., a\n   distributed client with both a confidential server-based component\n   and a public browser-based component).  If the authorization server\n   does not provide support for such clients or does not provide\n   guidance with regard to their registration, the client SHOULD\n   register each component as a separate client.\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":2995,"children":2996},{"class":787},[2997],{"type":728,"textContent":2998},"Hardt                        Standards Track                   [Page 14]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3001,"children":3002},{"class":796},[],{"type":723,"nodeName":724,"attributes":3004,"children":3005},{"class":800},[3006,3010,3011,3019,3021,3030,3032],{"type":723,"nodeName":740,"attributes":3007,"children":3009},{"id":3008},"page-15",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3012,"children":3013},{"class":787},[3014,3018],{"type":723,"nodeName":731,"attributes":3015,"children":3016},{"href":812},[3017],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3020},"\n\n\n   This specification has been designed around the following client\n   profiles:\n\n   web application\n      A web application is a confidential client running on a web\n      server.  Resource owners access the client via an HTML user\n      interface rendered in a user-agent on the device used by the\n      resource owner.  The client credentials as well as any access\n      token issued to the client are stored on the web server and are\n      not exposed to or accessible by the resource owner.\n\n   user-agent-based application\n      A user-agent-based application is a public client in which the\n      client code is downloaded from a web server and executes within a\n      user-agent (e.g., web browser) on the device used by the resource\n      owner.  Protocol data and credentials are easily accessible (and\n      often visible) to the resource owner.  Since such applications\n      reside within the user-agent, they can make seamless use of the\n      user-agent capabilities when requesting authorization.\n\n   native application\n      A native application is a public client installed and executed on\n      the device used by the resource owner.  Protocol data and\n      credentials are accessible to the resource owner.  It is assumed\n      that any client authentication credentials included in the\n      application can be extracted.  On the other hand, dynamically\n      issued credentials such as access tokens or refresh tokens can\n      receive an acceptable level of protection.  At a minimum, these\n      credentials are protected from hostile servers with which the\n      application may interact.  On some platforms, these credentials\n      might be protected from other applications residing on the same\n      device.\n\n",{"type":723,"nodeName":740,"attributes":3022,"children":3023},{"class":2512},[3024,3028],{"type":723,"nodeName":731,"attributes":3025,"children":3026},{"class":2434,"id":180,"href":1051},[3027],{"type":728,"textContent":1054},{"type":728,"textContent":3029},".  Client Identifier",{"type":728,"textContent":3031},"\n\n   The authorization server issues the registered client a client\n   identifier -- a unique string representing the registration\n   information provided by the client.  The client identifier is not a\n   secret; it is exposed to the resource owner and MUST NOT be used\n   alone for client authentication.  The client identifier is unique to\n   the authorization server.\n\n   The client identifier string size is left undefined by this\n   specification.  The client should avoid making assumptions about the\n   identifier size.  The authorization server SHOULD document the size\n   of any identifier it issues.\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3033,"children":3034},{"class":787},[3035],{"type":728,"textContent":3036},"Hardt                        Standards Track                   [Page 15]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3039,"children":3040},{"class":796},[],{"type":723,"nodeName":724,"attributes":3042,"children":3043},{"class":800},[3044,3048,3049,3057,3058,3067,3069,3078,3080,3086,3088,3092,3094,3099,3101],{"type":723,"nodeName":740,"attributes":3045,"children":3047},{"id":3046},"page-16",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3050,"children":3051},{"class":787},[3052,3056],{"type":723,"nodeName":731,"attributes":3053,"children":3054},{"href":812},[3055],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":3059,"children":3060},{"class":2512},[3061,3065],{"type":723,"nodeName":731,"attributes":3062,"children":3063},{"class":2434,"id":185,"href":1066},[3064],{"type":728,"textContent":1069},{"type":728,"textContent":3066},".  Client Authentication",{"type":728,"textContent":3068},"\n\n   If the client type is confidential, the client and authorization\n   server establish a client authentication method suitable for the\n   security requirements of the authorization server.  The authorization\n   server MAY accept any form of client authentication meeting its\n   security requirements.\n\n   Confidential clients are typically issued (or establish) a set of\n   client credentials used for authenticating with the authorization\n   server (e.g., password, public\u002Fprivate key pair).\n\n   The authorization server MAY establish a client authentication method\n   with public clients.  However, the authorization server MUST NOT rely\n   on public client authentication for the purpose of identifying the\n   client.\n\n   The client MUST NOT use more than one authentication method in each\n   request.\n\n",{"type":723,"nodeName":740,"attributes":3070,"children":3071},{"class":2606},[3072,3076],{"type":723,"nodeName":731,"attributes":3073,"children":3074},{"class":2434,"id":191,"href":1081},[3075],{"type":728,"textContent":1084},{"type":728,"textContent":3077},".  Client Password",{"type":728,"textContent":3079},"\n\n   Clients in possession of a client password MAY use the HTTP Basic\n   authentication scheme as defined in [",{"type":723,"nodeName":731,"attributes":3081,"children":3083},{"href":3082},"\u002Finfo\u002Frfc2617\u002F",[3084],{"type":728,"textContent":3085},"RFC2617",{"type":728,"textContent":3087},"] to authenticate with\n   the authorization server.  The client identifier is encoded using the\n   \"application\u002Fx-www-form-urlencoded\" encoding algorithm per\n   ",{"type":723,"nodeName":731,"attributes":3089,"children":3090},{"href":2401},[3091],{"type":728,"textContent":2404},{"type":728,"textContent":3093},", and the encoded value is used as the username; the client\n   password is encoded using the same algorithm and used as the\n   password.  The authorization server MUST support the HTTP Basic\n   authentication scheme for authenticating clients that were issued a\n   client password.\n\n   For example (with extra line breaks for display purposes only):\n\n     Authorization: Basic czZCaGRSa3F0Mzo3RmpmcDBaQnIxS3REUmJuZlZkbUl3\n\n   Alternatively, the authorization server MAY support including the\n   client credentials in the request-body using the following\n   parameters:\n\n   client_id\n         REQUIRED.  The client identifier issued to the client during\n         the registration process described by ",{"type":723,"nodeName":731,"attributes":3095,"children":3096},{"href":1051},[3097],{"type":728,"textContent":3098},"Section 2.2",{"type":728,"textContent":3100},".\n\n   client_secret\n         REQUIRED.  The client secret.  The client MAY omit the\n         parameter if the client secret is an empty string.\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3102,"children":3103},{"class":787},[3104],{"type":728,"textContent":3105},"Hardt                        Standards Track                   [Page 16]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3108,"children":3109},{"class":796},[],{"type":723,"nodeName":724,"attributes":3111,"children":3112},{"class":800},[3113,3117,3118,3126,3128,3133,3135,3140,3142,3151,3153,3162,3164],{"type":723,"nodeName":740,"attributes":3114,"children":3116},{"id":3115},"page-17",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3119,"children":3120},{"class":787},[3121,3125],{"type":723,"nodeName":731,"attributes":3122,"children":3123},{"href":812},[3124],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3127},"\n\n\n   Including the client credentials in the request-body using the two\n   parameters is NOT RECOMMENDED and SHOULD be limited to clients unable\n   to directly utilize the HTTP Basic authentication scheme (or other\n   password-based HTTP authentication schemes).  The parameters can only\n   be transmitted in the request-body and MUST NOT be included in the\n   request URI.\n\n   For example, a request to refresh an access token (",{"type":723,"nodeName":731,"attributes":3129,"children":3130},{"href":1546},[3131],{"type":728,"textContent":3132},"Section 6",{"type":728,"textContent":3134},") using\n   the body parameters (with extra line breaks for display purposes\n   only):\n\n     POST \u002Ftoken HTTP\u002F1.1\n     Host: server.example.com\n     Content-Type: application\u002Fx-www-form-urlencoded\n\n     grant_type=refresh_token&refresh_token=tGzv3JOkF0XG5Qx2TlKWIA\n     &client_id=s6BhdRkqt3&client_secret=7Fjfp0ZBr1KtDRbnfVdmIw\n\n   The authorization server MUST require the use of TLS as described in\n   ",{"type":723,"nodeName":731,"attributes":3136,"children":3137},{"href":966},[3138],{"type":728,"textContent":3139},"Section 1.6",{"type":728,"textContent":3141}," when sending requests using password authentication.\n\n   Since this client authentication method involves a password, the\n   authorization server MUST protect any endpoint utilizing it against\n   brute force attacks.\n\n",{"type":723,"nodeName":740,"attributes":3143,"children":3144},{"class":2606},[3145,3149],{"type":723,"nodeName":731,"attributes":3146,"children":3147},{"class":2434,"id":196,"href":1094},[3148],{"type":728,"textContent":1097},{"type":728,"textContent":3150},".  Other Authentication Methods",{"type":728,"textContent":3152},"\n\n   The authorization server MAY support any suitable HTTP authentication\n   scheme matching its security requirements.  When using other\n   authentication methods, the authorization server MUST define a\n   mapping between the client identifier (registration record) and\n   authentication scheme.\n\n",{"type":723,"nodeName":740,"attributes":3154,"children":3155},{"class":2512},[3156,3160],{"type":723,"nodeName":731,"attributes":3157,"children":3158},{"class":2434,"id":201,"href":1109},[3159],{"type":728,"textContent":1112},{"type":728,"textContent":3161},".  Unregistered Clients",{"type":728,"textContent":3163},"\n\n   This specification does not exclude the use of unregistered clients.\n   However, the use of such clients is beyond the scope of this\n   specification and requires additional security analysis and review of\n   its interoperability impact.\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3165,"children":3166},{"class":787},[3167],{"type":728,"textContent":3168},"Hardt                        Standards Track                   [Page 17]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3171,"children":3172},{"class":796},[],{"type":723,"nodeName":724,"attributes":3174,"children":3175},{"class":800},[3176,3180,3181,3189,3190,3199,3201,3210,3212,3216,3218,3224,3226,3230,3232,3236,3238],{"type":723,"nodeName":740,"attributes":3177,"children":3179},{"id":3178},"page-18",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3182,"children":3183},{"class":787},[3184,3188],{"type":723,"nodeName":731,"attributes":3185,"children":3186},{"href":812},[3187],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":3191,"children":3192},{"class":2430},[3193,3197],{"type":723,"nodeName":731,"attributes":3194,"children":3195},{"class":2434,"id":206,"href":1122},[3196],{"type":728,"textContent":1125},{"type":728,"textContent":3198},".  Protocol Endpoints",{"type":728,"textContent":3200},"\n\n   The authorization process utilizes two authorization server endpoints\n   (HTTP resources):\n\n   o  Authorization endpoint - used by the client to obtain\n      authorization from the resource owner via user-agent redirection.\n\n   o  Token endpoint - used by the client to exchange an authorization\n      grant for an access token, typically with client authentication.\n\n   As well as one client endpoint:\n\n   o  Redirection endpoint - used by the authorization server to return\n      responses containing authorization credentials to the client via\n      the resource owner user-agent.\n\n   Not every authorization grant type utilizes both endpoints.\n   Extension grant types MAY define additional endpoints as needed.\n\n",{"type":723,"nodeName":740,"attributes":3202,"children":3203},{"class":2512},[3204,3208],{"type":723,"nodeName":731,"attributes":3205,"children":3206},{"class":2434,"id":212,"href":1137},[3207],{"type":728,"textContent":1140},{"type":728,"textContent":3209},".  Authorization Endpoint",{"type":728,"textContent":3211},"\n\n   The authorization endpoint is used to interact with the resource\n   owner and obtain an authorization grant.  The authorization server\n   MUST first verify the identity of the resource owner.  The way in\n   which the authorization server authenticates the resource owner\n   (e.g., username and password login, session cookies) is beyond the\n   scope of this specification.\n\n   The means through which the client obtains the location of the\n   authorization endpoint are beyond the scope of this specification,\n   but the location is typically provided in the service documentation.\n\n   The endpoint URI MAY include an \"application\u002Fx-www-form-urlencoded\"\n   formatted (per ",{"type":723,"nodeName":731,"attributes":3213,"children":3214},{"href":2401},[3215],{"type":728,"textContent":2404},{"type":728,"textContent":3217},") query component (",{"type":723,"nodeName":731,"attributes":3219,"children":3221},{"href":3220},"\u002Finfo\u002Frfc3986\u002F#section-3.4",[3222],{"type":728,"textContent":3223},"[RFC3986] Section 3.4",{"type":728,"textContent":3225},"),\n   which MUST be retained when adding additional query parameters.  The\n   endpoint URI MUST NOT include a fragment component.\n\n   Since requests to the authorization endpoint result in user\n   authentication and the transmission of clear-text credentials (in the\n   HTTP response), the authorization server MUST require the use of TLS\n   as described in ",{"type":723,"nodeName":731,"attributes":3227,"children":3228},{"href":966},[3229],{"type":728,"textContent":3139},{"type":728,"textContent":3231}," when sending requests to the\n   authorization endpoint.\n\n   The authorization server MUST support the use of the HTTP \"GET\"\n   method [",{"type":723,"nodeName":731,"attributes":3233,"children":3234},{"href":2470},[3235],{"type":728,"textContent":2473},{"type":728,"textContent":3237},"] for the authorization endpoint and MAY support the\n   use of the \"POST\" method as well.\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3239,"children":3240},{"class":787},[3241],{"type":728,"textContent":3242},"Hardt                        Standards Track                   [Page 18]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3245,"children":3246},{"class":796},[],{"type":723,"nodeName":724,"attributes":3248,"children":3249},{"class":800},[3250,3254,3255,3263,3265,3274,3276,3281,3283,3288,3290,3295,3297,3303,3304,3313,3315,3321,3323,3327,3329,3333,3335],{"type":723,"nodeName":740,"attributes":3251,"children":3253},{"id":3252},"page-19",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3256,"children":3257},{"class":787},[3258,3262],{"type":723,"nodeName":731,"attributes":3259,"children":3260},{"href":812},[3261],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3264},"\n\n\n   Parameters sent without a value MUST be treated as if they were\n   omitted from the request.  The authorization server MUST ignore\n   unrecognized request parameters.  Request and response parameters\n   MUST NOT be included more than once.\n\n",{"type":723,"nodeName":740,"attributes":3266,"children":3267},{"class":2606},[3268,3272],{"type":723,"nodeName":731,"attributes":3269,"children":3270},{"class":2434,"id":218,"href":1150},[3271],{"type":728,"textContent":1153},{"type":728,"textContent":3273},".  Response Type",{"type":728,"textContent":3275},"\n\n   The authorization endpoint is used by the authorization code grant\n   type and implicit grant type flows.  The client informs the\n   authorization server of the desired grant type using the following\n   parameter:\n\n   response_type\n         REQUIRED.  The value MUST be one of \"code\" for requesting an\n         authorization code as described by ",{"type":723,"nodeName":731,"attributes":3277,"children":3278},{"href":1250},[3279],{"type":728,"textContent":3280},"Section 4.1.1",{"type":728,"textContent":3282},", \"token\" for\n         requesting an access token (implicit grant) as described by\n         ",{"type":723,"nodeName":731,"attributes":3284,"children":3285},{"href":1325},[3286],{"type":728,"textContent":3287},"Section 4.2.1",{"type":728,"textContent":3289},", or a registered extension value as described by\n         ",{"type":723,"nodeName":731,"attributes":3291,"children":3292},{"href":1656},[3293],{"type":728,"textContent":3294},"Section 8.4",{"type":728,"textContent":3296},".\n\n   Extension response types MAY contain a space-delimited (%x20) list of\n   values, where the order of values does not matter (e.g., response\n   type \"a b\" is the same as \"b a\").  The meaning of such composite\n   response types is defined by their respective specifications.\n\n   If an authorization request is missing the \"response_type\" parameter,\n   or if the response type is not understood, the authorization server\n   MUST return an error response as described in ",{"type":723,"nodeName":731,"attributes":3298,"children":3300},{"href":3299},"#section-4.1.2.1",[3301],{"type":728,"textContent":3302},"Section 4.1.2.1",{"type":728,"textContent":2592},{"type":723,"nodeName":740,"attributes":3305,"children":3306},{"class":2606},[3307,3311],{"type":723,"nodeName":731,"attributes":3308,"children":3309},{"class":2434,"id":223,"href":1165},[3310],{"type":728,"textContent":1168},{"type":728,"textContent":3312},".  Redirection Endpoint",{"type":728,"textContent":3314},"\n\n   After completing its interaction with the resource owner, the\n   authorization server directs the resource owner's user-agent back to\n   the client.  The authorization server redirects the user-agent to the\n   client's redirection endpoint previously established with the\n   authorization server during the client registration process or when\n   making the authorization request.\n\n   The redirection endpoint URI MUST be an absolute URI as defined by\n   ",{"type":723,"nodeName":731,"attributes":3316,"children":3318},{"href":3317},"\u002Finfo\u002Frfc3986\u002F#section-4.3",[3319],{"type":728,"textContent":3320},"[RFC3986] Section 4.3",{"type":728,"textContent":3322},".  The endpoint URI MAY include an\n   \"application\u002Fx-www-form-urlencoded\" formatted (per ",{"type":723,"nodeName":731,"attributes":3324,"children":3325},{"href":2401},[3326],{"type":728,"textContent":2404},{"type":728,"textContent":3328},") query\n   component (",{"type":723,"nodeName":731,"attributes":3330,"children":3331},{"href":3220},[3332],{"type":728,"textContent":3223},{"type":728,"textContent":3334},"), which MUST be retained when adding\n   additional query parameters.  The endpoint URI MUST NOT include a\n   fragment component.\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3336,"children":3337},{"class":787},[3338],{"type":728,"textContent":3339},"Hardt                        Standards Track                   [Page 19]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3342,"children":3343},{"class":796},[],{"type":723,"nodeName":724,"attributes":3345,"children":3346},{"class":800},[3347,3351,3352,3360,3361,3373,3375,3379,3381,3392,3394,3399,3401],{"type":723,"nodeName":740,"attributes":3348,"children":3350},{"id":3349},"page-20",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3353,"children":3354},{"class":787},[3355,3359],{"type":723,"nodeName":731,"attributes":3356,"children":3357},{"href":812},[3358],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":3362,"children":3364},{"class":3363},"h5",[3365,3371],{"type":723,"nodeName":731,"attributes":3366,"children":3368},{"class":2434,"id":229,"href":3367},"#section-3.1.2.1",[3369],{"type":728,"textContent":3370},"3.1.2.1",{"type":728,"textContent":3372},".  Endpoint Request Confidentiality",{"type":728,"textContent":3374},"\n\n   The redirection endpoint SHOULD require the use of TLS as described\n   in ",{"type":723,"nodeName":731,"attributes":3376,"children":3377},{"href":966},[3378],{"type":728,"textContent":3139},{"type":728,"textContent":3380}," when the requested response type is \"code\" or \"token\",\n   or when the redirection request will result in the transmission of\n   sensitive credentials over an open network.  This specification does\n   not mandate the use of TLS because at the time of this writing,\n   requiring clients to deploy TLS is a significant hurdle for many\n   client developers.  If TLS is not available, the authorization server\n   SHOULD warn the resource owner about the insecure endpoint prior to\n   redirection (e.g., display a message during the authorization\n   request).\n\n   Lack of transport-layer security can have a severe impact on the\n   security of the client and the protected resources it is authorized\n   to access.  The use of transport-layer security is particularly\n   critical when the authorization process is used as a form of\n   delegated end-user authentication by the client (e.g., third-party\n   sign-in service).\n\n",{"type":723,"nodeName":740,"attributes":3382,"children":3383},{"class":3363},[3384,3390],{"type":723,"nodeName":731,"attributes":3385,"children":3387},{"class":2434,"id":234,"href":3386},"#section-3.1.2.2",[3388],{"type":728,"textContent":3389},"3.1.2.2",{"type":728,"textContent":3391},".  Registration Requirements",{"type":728,"textContent":3393},"\n\n   The authorization server MUST require the following clients to\n   register their redirection endpoint:\n\n   o  Public clients.\n\n   o  Confidential clients utilizing the implicit grant type.\n\n   The authorization server SHOULD require all clients to register their\n   redirection endpoint prior to utilizing the authorization endpoint.\n\n   The authorization server SHOULD require the client to provide the\n   complete redirection URI (the client MAY use the \"state\" request\n   parameter to achieve per-request customization).  If requiring the\n   registration of the complete redirection URI is not possible, the\n   authorization server SHOULD require the registration of the URI\n   scheme, authority, and path (allowing the client to dynamically vary\n   only the query component of the redirection URI when requesting\n   authorization).\n\n   The authorization server MAY allow the client to register multiple\n   redirection endpoints.\n\n   Lack of a redirection URI registration requirement can enable an\n   attacker to use the authorization endpoint as an open redirector as\n   described in ",{"type":723,"nodeName":731,"attributes":3395,"children":3396},{"href":1906},[3397],{"type":728,"textContent":3398},"Section 10.15",{"type":728,"textContent":3400},".\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3402,"children":3403},{"class":787},[3404],{"type":728,"textContent":3405},"Hardt                        Standards Track                   [Page 20]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3408,"children":3409},{"class":796},[],{"type":723,"nodeName":724,"attributes":3411,"children":3412},{"class":800},[3413,3417,3418,3426,3427,3438,3440,3446,3448,3454,3455,3466,3468,3479,3481,3490,3492],{"type":723,"nodeName":740,"attributes":3414,"children":3416},{"id":3415},"page-21",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3419,"children":3420},{"class":787},[3421,3425],{"type":723,"nodeName":731,"attributes":3422,"children":3423},{"href":812},[3424],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":3428,"children":3429},{"class":3363},[3430,3436],{"type":723,"nodeName":731,"attributes":3431,"children":3433},{"class":2434,"id":239,"href":3432},"#section-3.1.2.3",[3434],{"type":728,"textContent":3435},"3.1.2.3",{"type":728,"textContent":3437},".  Dynamic Configuration",{"type":728,"textContent":3439},"\n\n   If multiple redirection URIs have been registered, if only part of\n   the redirection URI has been registered, or if no redirection URI has\n   been registered, the client MUST include a redirection URI with the\n   authorization request using the \"redirect_uri\" request parameter.\n\n   When a redirection URI is included in an authorization request, the\n   authorization server MUST compare and match the value received\n   against at least one of the registered redirection URIs (or URI\n   components) as defined in ",{"type":723,"nodeName":731,"attributes":3441,"children":3443},{"href":3442},"\u002Finfo\u002Frfc3986\u002F#section-6",[3444],{"type":728,"textContent":3445},"[RFC3986] Section 6",{"type":728,"textContent":3447},", if any redirection\n   URIs were registered.  If the client registration included the full\n   redirection URI, the authorization server MUST compare the two URIs\n   using simple string comparison as defined in ",{"type":723,"nodeName":731,"attributes":3449,"children":3451},{"href":3450},"\u002Finfo\u002Frfc3986\u002F#section-6.2.1",[3452],{"type":728,"textContent":3453},"[RFC3986] Section 6.2.1",{"type":728,"textContent":2592},{"type":723,"nodeName":740,"attributes":3456,"children":3457},{"class":3363},[3458,3464],{"type":723,"nodeName":731,"attributes":3459,"children":3461},{"class":2434,"id":244,"href":3460},"#section-3.1.2.4",[3462],{"type":728,"textContent":3463},"3.1.2.4",{"type":728,"textContent":3465},".  Invalid Endpoint",{"type":728,"textContent":3467},"\n\n   If an authorization request fails validation due to a missing,\n   invalid, or mismatching redirection URI, the authorization server\n   SHOULD inform the resource owner of the error and MUST NOT\n   automatically redirect the user-agent to the invalid redirection URI.\n\n",{"type":723,"nodeName":740,"attributes":3469,"children":3470},{"class":3363},[3471,3477],{"type":723,"nodeName":731,"attributes":3472,"children":3474},{"class":2434,"id":249,"href":3473},"#section-3.1.2.5",[3475],{"type":728,"textContent":3476},"3.1.2.5",{"type":728,"textContent":3478},".  Endpoint Content",{"type":728,"textContent":3480},"\n\n   The redirection request to the client's endpoint typically results in\n   an HTML document response, processed by the user-agent.  If the HTML\n   response is served directly as the result of the redirection request,\n   any script included in the HTML document will execute with full\n   access to the redirection URI and the credentials it contains.\n\n   The client SHOULD NOT include any third-party scripts (e.g., third-\n   party analytics, social plug-ins, ad networks) in the redirection\n   endpoint response.  Instead, it SHOULD extract the credentials from\n   the URI and redirect the user-agent again to another endpoint without\n   exposing the credentials (in the URI or elsewhere).  If third-party\n   scripts are included, the client MUST ensure that its own scripts\n   (used to extract and remove the credentials from the URI) will\n   execute first.\n\n",{"type":723,"nodeName":740,"attributes":3482,"children":3483},{"class":2512},[3484,3488],{"type":723,"nodeName":731,"attributes":3485,"children":3486},{"class":2434,"id":254,"href":1178},[3487],{"type":728,"textContent":1181},{"type":728,"textContent":3489},".  Token Endpoint",{"type":728,"textContent":3491},"\n\n   The token endpoint is used by the client to obtain an access token by\n   presenting its authorization grant or refresh token.  The token\n   endpoint is used with every authorization grant except for the\n   implicit grant type (since an access token is issued directly).\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3493,"children":3494},{"class":787},[3495],{"type":728,"textContent":3496},"Hardt                        Standards Track                   [Page 21]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3499,"children":3500},{"class":796},[],{"type":723,"nodeName":724,"attributes":3502,"children":3503},{"class":800},[3504,3508,3509,3517,3519,3523,3524,3528,3530,3534,3536,3544,3546,3551,3553],{"type":723,"nodeName":740,"attributes":3505,"children":3507},{"id":3506},"page-22",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3510,"children":3511},{"class":787},[3512,3516],{"type":723,"nodeName":731,"attributes":3513,"children":3514},{"href":812},[3515],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3518},"\n\n\n   The means through which the client obtains the location of the token\n   endpoint are beyond the scope of this specification, but the location\n   is typically provided in the service documentation.\n\n   The endpoint URI MAY include an \"application\u002Fx-www-form-urlencoded\"\n   formatted (per ",{"type":723,"nodeName":731,"attributes":3520,"children":3521},{"href":2401},[3522],{"type":728,"textContent":2404},{"type":728,"textContent":3217},{"type":723,"nodeName":731,"attributes":3525,"children":3526},{"href":3220},[3527],{"type":728,"textContent":3223},{"type":728,"textContent":3529},"),\n   which MUST be retained when adding additional query parameters.  The\n   endpoint URI MUST NOT include a fragment component.\n\n   Since requests to the token endpoint result in the transmission of\n   clear-text credentials (in the HTTP request and response), the\n   authorization server MUST require the use of TLS as described in\n   ",{"type":723,"nodeName":731,"attributes":3531,"children":3532},{"href":966},[3533],{"type":728,"textContent":3139},{"type":728,"textContent":3535}," when sending requests to the token endpoint.\n\n   The client MUST use the HTTP \"POST\" method when making access token\n   requests.\n\n   Parameters sent without a value MUST be treated as if they were\n   omitted from the request.  The authorization server MUST ignore\n   unrecognized request parameters.  Request and response parameters\n   MUST NOT be included more than once.\n\n",{"type":723,"nodeName":740,"attributes":3537,"children":3538},{"class":2606},[3539,3543],{"type":723,"nodeName":731,"attributes":3540,"children":3541},{"class":2434,"id":260,"href":1193},[3542],{"type":728,"textContent":1196},{"type":728,"textContent":3066},{"type":728,"textContent":3545},"\n\n   Confidential clients or other clients issued client credentials MUST\n   authenticate with the authorization server as described in\n   ",{"type":723,"nodeName":731,"attributes":3547,"children":3548},{"href":1066},[3549],{"type":728,"textContent":3550},"Section 2.3",{"type":728,"textContent":3552}," when making requests to the token endpoint.  Client\n   authentication is used for:\n\n   o  Enforcing the binding of refresh tokens and authorization codes to\n      the client they were issued to.  Client authentication is critical\n      when an authorization code is transmitted to the redirection\n      endpoint over an insecure channel or when the redirection URI has\n      not been registered in full.\n\n   o  Recovering from a compromised client by disabling the client or\n      changing its credentials, thus preventing an attacker from abusing\n      stolen refresh tokens.  Changing a single set of client\n      credentials is significantly faster than revoking an entire set of\n      refresh tokens.\n\n   o  Implementing authentication management best practices, which\n      require periodic credential rotation.  Rotation of an entire set\n      of refresh tokens can be challenging, while rotation of a single\n      set of client credentials is significantly easier.\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3554,"children":3555},{"class":787},[3556],{"type":728,"textContent":3557},"Hardt                        Standards Track                   [Page 22]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3560,"children":3561},{"class":796},[],{"type":723,"nodeName":724,"attributes":3563,"children":3564},{"class":800},[3565,3569,3570,3578,3580,3589,3591,3600,3602],{"type":723,"nodeName":740,"attributes":3566,"children":3568},{"id":3567},"page-23",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3571,"children":3572},{"class":787},[3573,3577],{"type":723,"nodeName":731,"attributes":3574,"children":3575},{"href":812},[3576],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3579},"\n\n\n   A client MAY use the \"client_id\" request parameter to identify itself\n   when sending requests to the token endpoint.  In the\n   \"authorization_code\" \"grant_type\" request to the token endpoint, an\n   unauthenticated client MUST send its \"client_id\" to prevent itself\n   from inadvertently accepting a code intended for a client with a\n   different \"client_id\".  This protects the client from substitution of\n   the authentication code.  (It provides no additional security for the\n   protected resource.)\n\n",{"type":723,"nodeName":740,"attributes":3581,"children":3582},{"class":2512},[3583,3587],{"type":723,"nodeName":731,"attributes":3584,"children":3585},{"class":2434,"id":265,"href":1208},[3586],{"type":728,"textContent":1211},{"type":728,"textContent":3588},".  Access Token Scope",{"type":728,"textContent":3590},"\n\n   The authorization and token endpoints allow the client to specify the\n   scope of the access request using the \"scope\" request parameter.  In\n   turn, the authorization server uses the \"scope\" response parameter to\n   inform the client of the scope of the access token issued.\n\n   The value of the scope parameter is expressed as a list of space-\n   delimited, case-sensitive strings.  The strings are defined by the\n   authorization server.  If the value contains multiple space-delimited\n   strings, their order does not matter, and each string adds an\n   additional access range to the requested scope.\n\n     scope       = scope-token *( SP scope-token )\n     scope-token = 1*( %x21 \u002F %x23-5B \u002F %x5D-7E )\n\n   The authorization server MAY fully or partially ignore the scope\n   requested by the client, based on the authorization server policy or\n   the resource owner's instructions.  If the issued access token scope\n   is different from the one requested by the client, the authorization\n   server MUST include the \"scope\" response parameter to inform the\n   client of the actual scope granted.\n\n   If the client omits the scope parameter when requesting\n   authorization, the authorization server MUST either process the\n   request using a pre-defined default value or fail the request\n   indicating an invalid scope.  The authorization server SHOULD\n   document its scope requirements and default value (if defined).\n\n",{"type":723,"nodeName":740,"attributes":3592,"children":3593},{"class":2430},[3594,3598],{"type":723,"nodeName":731,"attributes":3595,"children":3596},{"class":2434,"id":270,"href":1223},[3597],{"type":728,"textContent":833},{"type":728,"textContent":3599},".  Obtaining Authorization",{"type":728,"textContent":3601},"\n\n   To request an access token, the client obtains authorization from the\n   resource owner.  The authorization is expressed in the form of an\n   authorization grant, which the client uses to request the access\n   token.  OAuth defines four grant types: authorization code, implicit,\n   resource owner password credentials, and client credentials.  It also\n   provides an extension mechanism for defining additional grant types.\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3603,"children":3604},{"class":787},[3605],{"type":728,"textContent":3606},"Hardt                        Standards Track                   [Page 23]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3609,"children":3610},{"class":796},[],{"type":723,"nodeName":724,"attributes":3612,"children":3613},{"class":800},[3614,3618,3619,3627,3628,3637,3639],{"type":723,"nodeName":740,"attributes":3615,"children":3617},{"id":3616},"page-24",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3620,"children":3621},{"class":787},[3622,3626],{"type":723,"nodeName":731,"attributes":3623,"children":3624},{"href":812},[3625],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":3629,"children":3630},{"class":2512},[3631,3635],{"type":723,"nodeName":731,"attributes":3632,"children":3633},{"class":2434,"id":276,"href":1235},[3634],{"type":728,"textContent":1238},{"type":728,"textContent":3636},".  Authorization Code Grant",{"type":728,"textContent":3638},"\n\n   The authorization code grant type is used to obtain both access\n   tokens and refresh tokens and is optimized for confidential clients.\n   Since this is a redirection-based flow, the client must be capable of\n   interacting with the resource owner's user-agent (typically a web\n   browser) and capable of receiving incoming requests (via redirection)\n   from the authorization server.\n\n     +----------+\n     | Resource |\n     |   Owner  |\n     |          |\n     +----------+\n          ^\n          |\n         (B)\n     +----|-----+          Client Identifier      +---------------+\n     |         -+----(A)-- & Redirection URI ---->|               |\n     |  User-   |                                 | Authorization |\n     |  Agent  -+----(B)-- User authenticates --->|     Server    |\n     |          |                                 |               |\n     |         -+----(C)-- Authorization Code ---\u003C|               |\n     +-|----|---+                                 +---------------+\n       |    |                                         ^      v\n      (A)  (C)                                        |      |\n       |    |                                         |      |\n       ^    v                                         |      |\n     +---------+                                      |      |\n     |         |>---(D)-- Authorization Code ---------'      |\n     |  Client |          & Redirection URI                  |\n     |         |                                             |\n     |         |\u003C---(E)----- Access Token -------------------'\n     +---------+       (w\u002F Optional Refresh Token)\n\n   Note: The lines illustrating steps (A), (B), and (C) are broken into\n   two parts as they pass through the user-agent.\n\n                     Figure 3: Authorization Code Flow\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3640,"children":3641},{"class":787},[3642],{"type":728,"textContent":3643},"Hardt                        Standards Track                   [Page 24]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3646,"children":3647},{"class":796},[],{"type":723,"nodeName":724,"attributes":3649,"children":3650},{"class":800},[3651,3655,3656,3664,3666,3675,3677,3681,3683,3687,3689,3693,3695],{"type":723,"nodeName":740,"attributes":3652,"children":3654},{"id":3653},"page-25",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3657,"children":3658},{"class":787},[3659,3663],{"type":723,"nodeName":731,"attributes":3660,"children":3661},{"href":812},[3662],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3665},"\n\n\n   The flow illustrated in Figure 3 includes the following steps:\n\n   (A)  The client initiates the flow by directing the resource owner's\n        user-agent to the authorization endpoint.  The client includes\n        its client identifier, requested scope, local state, and a\n        redirection URI to which the authorization server will send the\n        user-agent back once access is granted (or denied).\n\n   (B)  The authorization server authenticates the resource owner (via\n        the user-agent) and establishes whether the resource owner\n        grants or denies the client's access request.\n\n   (C)  Assuming the resource owner grants access, the authorization\n        server redirects the user-agent back to the client using the\n        redirection URI provided earlier (in the request or during\n        client registration).  The redirection URI includes an\n        authorization code and any local state provided by the client\n        earlier.\n\n   (D)  The client requests an access token from the authorization\n        server's token endpoint by including the authorization code\n        received in the previous step.  When making the request, the\n        client authenticates with the authorization server.  The client\n        includes the redirection URI used to obtain the authorization\n        code for verification.\n\n   (E)  The authorization server authenticates the client, validates the\n        authorization code, and ensures that the redirection URI\n        received matches the URI used to redirect the client in\n        step (C).  If valid, the authorization server responds back with\n        an access token and, optionally, a refresh token.\n\n",{"type":723,"nodeName":740,"attributes":3667,"children":3668},{"class":2606},[3669,3673],{"type":723,"nodeName":731,"attributes":3670,"children":3671},{"class":2434,"id":282,"href":1250},[3672],{"type":728,"textContent":1253},{"type":728,"textContent":3674},".  Authorization Request",{"type":728,"textContent":3676},"\n\n   The client constructs the request URI by adding the following\n   parameters to the query component of the authorization endpoint URI\n   using the \"application\u002Fx-www-form-urlencoded\" format, per ",{"type":723,"nodeName":731,"attributes":3678,"children":3679},{"href":2401},[3680],{"type":728,"textContent":2404},{"type":728,"textContent":3682},":\n\n   response_type\n         REQUIRED.  Value MUST be set to \"code\".\n\n   client_id\n         REQUIRED.  The client identifier as described in ",{"type":723,"nodeName":731,"attributes":3684,"children":3685},{"href":1051},[3686],{"type":728,"textContent":3098},{"type":728,"textContent":3688},".\n\n   redirect_uri\n         OPTIONAL.  As described in ",{"type":723,"nodeName":731,"attributes":3690,"children":3691},{"href":1165},[3692],{"type":728,"textContent":2980},{"type":728,"textContent":3694},".\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3696,"children":3697},{"class":787},[3698],{"type":728,"textContent":3699},"Hardt                        Standards Track                   [Page 25]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3702,"children":3703},{"class":796},[],{"type":723,"nodeName":724,"attributes":3705,"children":3706},{"class":800},[3707,3711,3712,3720,3722,3727,3729,3734,3736,3745,3747,3751,3753],{"type":723,"nodeName":740,"attributes":3708,"children":3710},{"id":3709},"page-26",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3713,"children":3714},{"class":787},[3715,3719],{"type":723,"nodeName":731,"attributes":3716,"children":3717},{"href":812},[3718],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3721},"\n\n\n   scope\n         OPTIONAL.  The scope of the access request as described by\n         ",{"type":723,"nodeName":731,"attributes":3723,"children":3724},{"href":1208},[3725],{"type":728,"textContent":3726},"Section 3.3",{"type":728,"textContent":3728},".\n\n   state\n         RECOMMENDED.  An opaque value used by the client to maintain\n         state between the request and callback.  The authorization\n         server includes this value when redirecting the user-agent back\n         to the client.  The parameter SHOULD be used for preventing\n         cross-site request forgery as described in ",{"type":723,"nodeName":731,"attributes":3730,"children":3731},{"href":1863},[3732],{"type":728,"textContent":3733},"Section 10.12",{"type":728,"textContent":3735},".\n\n   The client directs the resource owner to the constructed URI using an\n   HTTP redirection response, or by other means available to it via the\n   user-agent.\n\n   For example, the client directs the user-agent to make the following\n   HTTP request using TLS (with extra line breaks for display purposes\n   only):\n\n    GET \u002Fauthorize?response_type=code&client_id=s6BhdRkqt3&state=xyz\n        &redirect_uri=https%3A%2F%2Fclient%2Eexample%2Ecom%2Fcb HTTP\u002F1.1\n    Host: server.example.com\n\n   The authorization server validates the request to ensure that all\n   required parameters are present and valid.  If the request is valid,\n   the authorization server authenticates the resource owner and obtains\n   an authorization decision (by asking the resource owner or by\n   establishing approval via other means).\n\n   When a decision is established, the authorization server directs the\n   user-agent to the provided client redirection URI using an HTTP\n   redirection response, or by other means available to it via the\n   user-agent.\n\n",{"type":723,"nodeName":740,"attributes":3737,"children":3738},{"class":2606},[3739,3743],{"type":723,"nodeName":731,"attributes":3740,"children":3741},{"class":2434,"id":287,"href":1265},[3742],{"type":728,"textContent":1268},{"type":728,"textContent":3744},".  Authorization Response",{"type":728,"textContent":3746},"\n\n   If the resource owner grants the access request, the authorization\n   server issues an authorization code and delivers it to the client by\n   adding the following parameters to the query component of the\n   redirection URI using the \"application\u002Fx-www-form-urlencoded\" format,\n   per ",{"type":723,"nodeName":731,"attributes":3748,"children":3749},{"href":2401},[3750],{"type":728,"textContent":2404},{"type":728,"textContent":3752},":\n\n   code\n         REQUIRED.  The authorization code generated by the\n         authorization server.  The authorization code MUST expire\n         shortly after it is issued to mitigate the risk of leaks.  A\n         maximum authorization code lifetime of 10 minutes is\n         RECOMMENDED.  The client MUST NOT use the authorization code\n\n\n\n",{"type":723,"nodeName":740,"attributes":3754,"children":3755},{"class":787},[3756],{"type":728,"textContent":3757},"Hardt                        Standards Track                   [Page 26]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3760,"children":3761},{"class":796},[],{"type":723,"nodeName":724,"attributes":3763,"children":3764},{"class":800},[3765,3769,3770,3778,3780,3790,3792,3796,3798,3804,3806],{"type":723,"nodeName":740,"attributes":3766,"children":3768},{"id":3767},"page-27",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3771,"children":3772},{"class":787},[3773,3777],{"type":723,"nodeName":731,"attributes":3774,"children":3775},{"href":812},[3776],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3779},"\n\n\n         more than once.  If an authorization code is used more than\n         once, the authorization server MUST deny the request and SHOULD\n         revoke (when possible) all tokens previously issued based on\n         that authorization code.  The authorization code is bound to\n         the client identifier and redirection URI.\n\n   state\n         REQUIRED if the \"state\" parameter was present in the client\n         authorization request.  The exact value received from the\n         client.\n\n   For example, the authorization server redirects the user-agent by\n   sending the following HTTP response:\n\n     HTTP\u002F1.1 302 Found\n     Location: https:\u002F\u002Fclient.example.com\u002Fcb?code=SplxlOBeZQQYbYS6WxSbIA\n               &state=xyz\n\n   The client MUST ignore unrecognized response parameters.  The\n   authorization code string size is left undefined by this\n   specification.  The client should avoid making assumptions about code\n   value sizes.  The authorization server SHOULD document the size of\n   any value it issues.\n\n",{"type":723,"nodeName":740,"attributes":3781,"children":3782},{"class":3363},[3783,3788],{"type":723,"nodeName":731,"attributes":3784,"children":3785},{"class":2434,"id":293,"href":3299},[3786],{"type":728,"textContent":3787},"4.1.2.1",{"type":728,"textContent":3789},".  Error Response",{"type":728,"textContent":3791},"\n\n   If the request fails due to a missing, invalid, or mismatching\n   redirection URI, or if the client identifier is missing or invalid,\n   the authorization server SHOULD inform the resource owner of the\n   error and MUST NOT automatically redirect the user-agent to the\n   invalid redirection URI.\n\n   If the resource owner denies the access request or if the request\n   fails for reasons other than a missing or invalid redirection URI,\n   the authorization server informs the client by adding the following\n   parameters to the query component of the redirection URI using the\n   \"application\u002Fx-www-form-urlencoded\" format, per ",{"type":723,"nodeName":731,"attributes":3793,"children":3794},{"href":2401},[3795],{"type":728,"textContent":2404},{"type":728,"textContent":3797},":\n\n   error\n         REQUIRED.  A single ASCII [",{"type":723,"nodeName":731,"attributes":3799,"children":3801},{"href":3800},"#ref-USASCII",[3802],{"type":728,"textContent":3803},"USASCII",{"type":728,"textContent":3805},"] error code from the\n         following:\n\n         invalid_request\n               The request is missing a required parameter, includes an\n               invalid parameter value, includes a parameter more than\n               once, or is otherwise malformed.\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3807,"children":3808},{"class":787},[3809],{"type":728,"textContent":3810},"Hardt                        Standards Track                   [Page 27]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3813,"children":3814},{"class":796},[],{"type":723,"nodeName":724,"attributes":3816,"children":3817},{"class":800},[3818,3822,3823,3831,3833,3837,3839],{"type":723,"nodeName":740,"attributes":3819,"children":3821},{"id":3820},"page-28",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3824,"children":3825},{"class":787},[3826,3830],{"type":723,"nodeName":731,"attributes":3827,"children":3828},{"href":812},[3829],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3832},"\n\n\n         unauthorized_client\n               The client is not authorized to request an authorization\n               code using this method.\n\n         access_denied\n               The resource owner or authorization server denied the\n               request.\n\n         unsupported_response_type\n               The authorization server does not support obtaining an\n               authorization code using this method.\n\n         invalid_scope\n               The requested scope is invalid, unknown, or malformed.\n\n         server_error\n               The authorization server encountered an unexpected\n               condition that prevented it from fulfilling the request.\n               (This error code is needed because a 500 Internal Server\n               Error HTTP status code cannot be returned to the client\n               via an HTTP redirect.)\n\n         temporarily_unavailable\n               The authorization server is currently unable to handle\n               the request due to a temporary overloading or maintenance\n               of the server.  (This error code is needed because a 503\n               Service Unavailable HTTP status code cannot be returned\n               to the client via an HTTP redirect.)\n\n         Values for the \"error\" parameter MUST NOT include characters\n         outside the set %x20-21 \u002F %x23-5B \u002F %x5D-7E.\n\n   error_description\n         OPTIONAL.  Human-readable ASCII [",{"type":723,"nodeName":731,"attributes":3834,"children":3835},{"href":3800},[3836],{"type":728,"textContent":3803},{"type":728,"textContent":3838},"] text providing\n         additional information, used to assist the client developer in\n         understanding the error that occurred.\n         Values for the \"error_description\" parameter MUST NOT include\n         characters outside the set %x20-21 \u002F %x23-5B \u002F %x5D-7E.\n\n   error_uri\n         OPTIONAL.  A URI identifying a human-readable web page with\n         information about the error, used to provide the client\n         developer with additional information about the error.\n         Values for the \"error_uri\" parameter MUST conform to the\n         URI-reference syntax and thus MUST NOT include characters\n         outside the set %x21 \u002F %x23-5B \u002F %x5D-7E.\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3840,"children":3841},{"class":787},[3842],{"type":728,"textContent":3843},"Hardt                        Standards Track                   [Page 28]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3846,"children":3847},{"class":796},[],{"type":723,"nodeName":724,"attributes":3849,"children":3850},{"class":800},[3851,3855,3856,3864,3866,3875,3877,3881,3883,3887,3889,3894,3896,3900,3902],{"type":723,"nodeName":740,"attributes":3852,"children":3854},{"id":3853},"page-29",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3857,"children":3858},{"class":787},[3859,3863],{"type":723,"nodeName":731,"attributes":3860,"children":3861},{"href":812},[3862],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3865},"\n\n\n   state\n         REQUIRED if a \"state\" parameter was present in the client\n         authorization request.  The exact value received from the\n         client.\n\n   For example, the authorization server redirects the user-agent by\n   sending the following HTTP response:\n\n   HTTP\u002F1.1 302 Found\n   Location: https:\u002F\u002Fclient.example.com\u002Fcb?error=access_denied&state=xyz\n\n",{"type":723,"nodeName":740,"attributes":3867,"children":3868},{"class":2606},[3869,3873],{"type":723,"nodeName":731,"attributes":3870,"children":3871},{"class":2434,"id":298,"href":1280},[3872],{"type":728,"textContent":1283},{"type":728,"textContent":3874},".  Access Token Request",{"type":728,"textContent":3876},"\n\n   The client makes a request to the token endpoint by sending the\n   following parameters using the \"application\u002Fx-www-form-urlencoded\"\n   format per ",{"type":723,"nodeName":731,"attributes":3878,"children":3879},{"href":2401},[3880],{"type":728,"textContent":2404},{"type":728,"textContent":3882}," with a character encoding of UTF-8 in the HTTP\n   request entity-body:\n\n   grant_type\n         REQUIRED.  Value MUST be set to \"authorization_code\".\n\n   code\n         REQUIRED.  The authorization code received from the\n         authorization server.\n\n   redirect_uri\n         REQUIRED, if the \"redirect_uri\" parameter was included in the\n         authorization request as described in ",{"type":723,"nodeName":731,"attributes":3884,"children":3885},{"href":1250},[3886],{"type":728,"textContent":3280},{"type":728,"textContent":3888},", and their\n         values MUST be identical.\n\n   client_id\n         REQUIRED, if the client is not authenticating with the\n         authorization server as described in ",{"type":723,"nodeName":731,"attributes":3890,"children":3891},{"href":1193},[3892],{"type":728,"textContent":3893},"Section 3.2.1",{"type":728,"textContent":3895},".\n\n   If the client type is confidential or the client was issued client\n   credentials (or assigned other authentication requirements), the\n   client MUST authenticate with the authorization server as described\n   in ",{"type":723,"nodeName":731,"attributes":3897,"children":3898},{"href":1193},[3899],{"type":728,"textContent":3893},{"type":728,"textContent":3901},".\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3903,"children":3904},{"class":787},[3905],{"type":728,"textContent":3906},"Hardt                        Standards Track                   [Page 29]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3909,"children":3910},{"class":796},[],{"type":723,"nodeName":724,"attributes":3912,"children":3913},{"class":800},[3914,3918,3919,3927,3929,3933,3935,3944,3946,3951,3953,3958,3960],{"type":723,"nodeName":740,"attributes":3915,"children":3917},{"id":3916},"page-30",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3920,"children":3921},{"class":787},[3922,3926],{"type":723,"nodeName":731,"attributes":3923,"children":3924},{"href":812},[3925],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3928},"\n\n\n   For example, the client makes the following HTTP request using TLS\n   (with extra line breaks for display purposes only):\n\n     POST \u002Ftoken HTTP\u002F1.1\n     Host: server.example.com\n     Authorization: Basic czZCaGRSa3F0MzpnWDFmQmF0M2JW\n     Content-Type: application\u002Fx-www-form-urlencoded\n\n     grant_type=authorization_code&code=SplxlOBeZQQYbYS6WxSbIA\n     &redirect_uri=https%3A%2F%2Fclient%2Eexample%2Ecom%2Fcb\n\n   The authorization server MUST:\n\n   o  require client authentication for confidential clients or for any\n      client that was issued client credentials (or with other\n      authentication requirements),\n\n   o  authenticate the client if client authentication is included,\n\n   o  ensure that the authorization code was issued to the authenticated\n      confidential client, or if the client is public, ensure that the\n      code was issued to \"client_id\" in the request,\n\n   o  verify that the authorization code is valid, and\n\n   o  ensure that the \"redirect_uri\" parameter is present if the\n      \"redirect_uri\" parameter was included in the initial authorization\n      request as described in ",{"type":723,"nodeName":731,"attributes":3930,"children":3931},{"href":1250},[3932],{"type":728,"textContent":3280},{"type":728,"textContent":3934},", and if included ensure that\n      their values are identical.\n\n",{"type":723,"nodeName":740,"attributes":3936,"children":3937},{"class":2606},[3938,3942],{"type":723,"nodeName":731,"attributes":3939,"children":3940},{"class":2434,"id":303,"href":1295},[3941],{"type":728,"textContent":1298},{"type":728,"textContent":3943},".  Access Token Response",{"type":728,"textContent":3945},"\n\n   If the access token request is valid and authorized, the\n   authorization server issues an access token and optional refresh\n   token as described in ",{"type":723,"nodeName":731,"attributes":3947,"children":3948},{"href":1518},[3949],{"type":728,"textContent":3950},"Section 5.1",{"type":728,"textContent":3952},".  If the request client\n   authentication failed or is invalid, the authorization server returns\n   an error response as described in ",{"type":723,"nodeName":731,"attributes":3954,"children":3955},{"href":1531},[3956],{"type":728,"textContent":3957},"Section 5.2",{"type":728,"textContent":3959},".\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3961,"children":3962},{"class":787},[3963],{"type":728,"textContent":3964},"Hardt                        Standards Track                   [Page 30]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":3967,"children":3968},{"class":796},[],{"type":723,"nodeName":724,"attributes":3970,"children":3971},{"class":800},[3972,3976,3977,3985,3987,3996,3998],{"type":723,"nodeName":740,"attributes":3973,"children":3975},{"id":3974},"page-31",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":3978,"children":3979},{"class":787},[3980,3984],{"type":723,"nodeName":731,"attributes":3981,"children":3982},{"href":812},[3983],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":3986},"\n\n\n   An example successful response:\n\n     HTTP\u002F1.1 200 OK\n     Content-Type: application\u002Fjson;charset=UTF-8\n     Cache-Control: no-store\n     Pragma: no-cache\n\n     {\n       \"access_token\":\"2YotnFZFEjr1zCsicMWpAA\",\n       \"token_type\":\"example\",\n       \"expires_in\":3600,\n       \"refresh_token\":\"tGzv3JOkF0XG5Qx2TlKWIA\",\n       \"example_parameter\":\"example_value\"\n     }\n\n",{"type":723,"nodeName":740,"attributes":3988,"children":3989},{"class":2512},[3990,3994],{"type":723,"nodeName":731,"attributes":3991,"children":3992},{"class":2434,"id":308,"href":1310},[3993],{"type":728,"textContent":1313},{"type":728,"textContent":3995},".  Implicit Grant",{"type":728,"textContent":3997},"\n\n   The implicit grant type is used to obtain access tokens (it does not\n   support the issuance of refresh tokens) and is optimized for public\n   clients known to operate a particular redirection URI.  These clients\n   are typically implemented in a browser using a scripting language\n   such as JavaScript.\n\n   Since this is a redirection-based flow, the client must be capable of\n   interacting with the resource owner's user-agent (typically a web\n   browser) and capable of receiving incoming requests (via redirection)\n   from the authorization server.\n\n   Unlike the authorization code grant type, in which the client makes\n   separate requests for authorization and for an access token, the\n   client receives the access token as the result of the authorization\n   request.\n\n   The implicit grant type does not include client authentication, and\n   relies on the presence of the resource owner and the registration of\n   the redirection URI.  Because the access token is encoded into the\n   redirection URI, it may be exposed to the resource owner and other\n   applications residing on the same device.\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":3999,"children":4000},{"class":787},[4001],{"type":728,"textContent":4002},"Hardt                        Standards Track                   [Page 31]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4005,"children":4006},{"class":796},[],{"type":723,"nodeName":724,"attributes":4008,"children":4009},{"class":800},[4010,4014,4015,4023,4025],{"type":723,"nodeName":740,"attributes":4011,"children":4013},{"id":4012},"page-32",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4016,"children":4017},{"class":787},[4018,4022],{"type":723,"nodeName":731,"attributes":4019,"children":4020},{"href":812},[4021],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4024},"\n\n\n     +----------+\n     | Resource |\n     |  Owner   |\n     |          |\n     +----------+\n          ^\n          |\n         (B)\n     +----|-----+          Client Identifier     +---------------+\n     |         -+----(A)-- & Redirection URI --->|               |\n     |  User-   |                                | Authorization |\n     |  Agent  -|----(B)-- User authenticates -->|     Server    |\n     |          |                                |               |\n     |          |\u003C---(C)--- Redirection URI ----\u003C|               |\n     |          |          with Access Token     +---------------+\n     |          |            in Fragment\n     |          |                                +---------------+\n     |          |----(D)--- Redirection URI ---->|   Web-Hosted  |\n     |          |          without Fragment      |     Client    |\n     |          |                                |    Resource   |\n     |     (F)  |\u003C---(E)------- Script ---------\u003C|               |\n     |          |                                +---------------+\n     +-|--------+\n       |    |\n      (A)  (G) Access Token\n       |    |\n       ^    v\n     +---------+\n     |         |\n     |  Client |\n     |         |\n     +---------+\n\n   Note: The lines illustrating steps (A) and (B) are broken into two\n   parts as they pass through the user-agent.\n\n                       Figure 4: Implicit Grant Flow\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4026,"children":4027},{"class":787},[4028],{"type":728,"textContent":4029},"Hardt                        Standards Track                   [Page 32]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4032,"children":4033},{"class":796},[],{"type":723,"nodeName":724,"attributes":4035,"children":4036},{"class":800},[4037,4041,4042,4050,4052,4056,4058,4062,4063,4067,4069,4073,4074,4078,4080,4088,4089,4093,4095,4099,4101],{"type":723,"nodeName":740,"attributes":4038,"children":4040},{"id":4039},"page-33",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4043,"children":4044},{"class":787},[4045,4049],{"type":723,"nodeName":731,"attributes":4046,"children":4047},{"href":812},[4048],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4051},"\n\n\n   The flow illustrated in Figure 4 includes the following steps:\n\n   (A)  The client initiates the flow by directing the resource owner's\n        user-agent to the authorization endpoint.  The client includes\n        its client identifier, requested scope, local state, and a\n        redirection URI to which the authorization server will send the\n        user-agent back once access is granted (or denied).\n\n   (B)  The authorization server authenticates the resource owner (via\n        the user-agent) and establishes whether the resource owner\n        grants or denies the client's access request.\n\n   (C)  Assuming the resource owner grants access, the authorization\n        server redirects the user-agent back to the client using the\n        redirection URI provided earlier.  The redirection URI includes\n        the access token in the URI fragment.\n\n   (D)  The user-agent follows the redirection instructions by making a\n        request to the web-hosted client resource (which does not\n        include the fragment per [",{"type":723,"nodeName":731,"attributes":4053,"children":4054},{"href":2470},[4055],{"type":728,"textContent":2473},{"type":728,"textContent":4057},"]).  The user-agent retains the\n        fragment information locally.\n\n   (E)  The web-hosted client resource returns a web page (typically an\n        HTML document with an embedded script) capable of accessing the\n        full redirection URI including the fragment retained by the\n        user-agent, and extracting the access token (and other\n        parameters) contained in the fragment.\n\n   (F)  The user-agent executes the script provided by the web-hosted\n        client resource locally, which extracts the access token.\n\n   (G)  The user-agent passes the access token to the client.\n\n   See Sections ",{"type":723,"nodeName":731,"attributes":4059,"children":4060},{"href":897},[4061],{"type":728,"textContent":900},{"type":728,"textContent":2665},{"type":723,"nodeName":731,"attributes":4064,"children":4065},{"href":1682},[4066],{"type":728,"textContent":921},{"type":728,"textContent":4068}," for background on using the implicit grant.\n   See Sections ",{"type":723,"nodeName":731,"attributes":4070,"children":4071},{"href":1738},[4072],{"type":728,"textContent":1741},{"type":728,"textContent":2665},{"type":723,"nodeName":731,"attributes":4075,"children":4076},{"href":2668},[4077],{"type":728,"textContent":2671},{"type":728,"textContent":4079}," for important security considerations\n   when using the implicit grant.\n\n",{"type":723,"nodeName":740,"attributes":4081,"children":4082},{"class":2606},[4083,4087],{"type":723,"nodeName":731,"attributes":4084,"children":4085},{"class":2434,"id":314,"href":1325},[4086],{"type":728,"textContent":1328},{"type":728,"textContent":3674},{"type":728,"textContent":3676},{"type":723,"nodeName":731,"attributes":4090,"children":4091},{"href":2401},[4092],{"type":728,"textContent":2404},{"type":728,"textContent":4094},":\n\n   response_type\n         REQUIRED.  Value MUST be set to \"token\".\n\n   client_id\n         REQUIRED.  The client identifier as described in ",{"type":723,"nodeName":731,"attributes":4096,"children":4097},{"href":1051},[4098],{"type":728,"textContent":3098},{"type":728,"textContent":4100},".\n\n\n\n",{"type":723,"nodeName":740,"attributes":4102,"children":4103},{"class":787},[4104],{"type":728,"textContent":4105},"Hardt                        Standards Track                   [Page 33]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4108,"children":4109},{"class":796},[],{"type":723,"nodeName":724,"attributes":4111,"children":4112},{"class":800},[4113,4117,4118,4126,4128,4132,4134,4138,4139,4143,4145,4149,4151],{"type":723,"nodeName":740,"attributes":4114,"children":4116},{"id":4115},"page-34",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4119,"children":4120},{"class":787},[4121,4125],{"type":723,"nodeName":731,"attributes":4122,"children":4123},{"href":812},[4124],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4127},"\n\n\n   redirect_uri\n         OPTIONAL.  As described in ",{"type":723,"nodeName":731,"attributes":4129,"children":4130},{"href":1165},[4131],{"type":728,"textContent":2980},{"type":728,"textContent":4133},".\n\n   scope\n         OPTIONAL.  The scope of the access request as described by\n         ",{"type":723,"nodeName":731,"attributes":4135,"children":4136},{"href":1208},[4137],{"type":728,"textContent":3726},{"type":728,"textContent":3728},{"type":723,"nodeName":731,"attributes":4140,"children":4141},{"href":1863},[4142],{"type":728,"textContent":3733},{"type":728,"textContent":4144},".\n\n   The client directs the resource owner to the constructed URI using an\n   HTTP redirection response, or by other means available to it via the\n   user-agent.\n\n   For example, the client directs the user-agent to make the following\n   HTTP request using TLS (with extra line breaks for display purposes\n   only):\n\n    GET \u002Fauthorize?response_type=token&client_id=s6BhdRkqt3&state=xyz\n        &redirect_uri=https%3A%2F%2Fclient%2Eexample%2Ecom%2Fcb HTTP\u002F1.1\n    Host: server.example.com\n\n   The authorization server validates the request to ensure that all\n   required parameters are present and valid.  The authorization server\n   MUST verify that the redirection URI to which it will redirect the\n   access token matches a redirection URI registered by the client as\n   described in ",{"type":723,"nodeName":731,"attributes":4146,"children":4147},{"href":1165},[4148],{"type":728,"textContent":2980},{"type":728,"textContent":4150},".\n\n   If the request is valid, the authorization server authenticates the\n   resource owner and obtains an authorization decision (by asking the\n   resource owner or by establishing approval via other means).\n\n   When a decision is established, the authorization server directs the\n   user-agent to the provided client redirection URI using an HTTP\n   redirection response, or by other means available to it via the\n   user-agent.\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4152,"children":4153},{"class":787},[4154],{"type":728,"textContent":4155},"Hardt                        Standards Track                   [Page 34]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4158,"children":4159},{"class":796},[],{"type":723,"nodeName":724,"attributes":4161,"children":4162},{"class":800},[4163,4167,4168,4176,4177,4185,4187,4191,4193,4198,4200,4204,4206],{"type":723,"nodeName":740,"attributes":4164,"children":4166},{"id":4165},"page-35",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4169,"children":4170},{"class":787},[4171,4175],{"type":723,"nodeName":731,"attributes":4172,"children":4173},{"href":812},[4174],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":4178,"children":4179},{"class":2606},[4180,4184],{"type":723,"nodeName":731,"attributes":4181,"children":4182},{"class":2434,"id":319,"href":1339},[4183],{"type":728,"textContent":1342},{"type":728,"textContent":3943},{"type":728,"textContent":4186},"\n\n   If the resource owner grants the access request, the authorization\n   server issues an access token and delivers it to the client by adding\n   the following parameters to the fragment component of the redirection\n   URI using the \"application\u002Fx-www-form-urlencoded\" format, per\n   ",{"type":723,"nodeName":731,"attributes":4188,"children":4189},{"href":2401},[4190],{"type":728,"textContent":2404},{"type":728,"textContent":4192},":\n\n   access_token\n         REQUIRED.  The access token issued by the authorization server.\n\n   token_type\n         REQUIRED.  The type of the token issued as described in\n         ",{"type":723,"nodeName":731,"attributes":4194,"children":4195},{"href":1574},[4196],{"type":728,"textContent":4197},"Section 7.1",{"type":728,"textContent":4199},".  Value is case insensitive.\n\n   expires_in\n         RECOMMENDED.  The lifetime in seconds of the access token.  For\n         example, the value \"3600\" denotes that the access token will\n         expire in one hour from the time the response was generated.\n         If omitted, the authorization server SHOULD provide the\n         expiration time via other means or document the default value.\n\n   scope\n         OPTIONAL, if identical to the scope requested by the client;\n         otherwise, REQUIRED.  The scope of the access token as\n         described by ",{"type":723,"nodeName":731,"attributes":4201,"children":4202},{"href":1208},[4203],{"type":728,"textContent":3726},{"type":728,"textContent":4205},".\n\n   state\n         REQUIRED if the \"state\" parameter was present in the client\n         authorization request.  The exact value received from the\n         client.\n\n   The authorization server MUST NOT issue a refresh token.\n\n   For example, the authorization server redirects the user-agent by\n   sending the following HTTP response (with extra line breaks for\n   display purposes only):\n\n     HTTP\u002F1.1 302 Found\n     Location: http:\u002F\u002Fexample.com\u002Fcb#access_token=2YotnFZFEjr1zCsicMWpAA\n               &state=xyz&token_type=example&expires_in=3600\n\n   Developers should note that some user-agents do not support the\n   inclusion of a fragment component in the HTTP \"Location\" response\n   header field.  Such clients will require using other methods for\n   redirecting the client than a 3xx redirection response -- for\n   example, returning an HTML page that includes a 'continue' button\n   with an action linked to the redirection URI.\n\n\n\n",{"type":723,"nodeName":740,"attributes":4207,"children":4208},{"class":787},[4209],{"type":728,"textContent":4210},"Hardt                        Standards Track                   [Page 35]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4213,"children":4214},{"class":796},[],{"type":723,"nodeName":724,"attributes":4216,"children":4217},{"class":800},[4218,4222,4223,4231,4233,4243,4245,4249,4250,4254,4256],{"type":723,"nodeName":740,"attributes":4219,"children":4221},{"id":4220},"page-36",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4224,"children":4225},{"class":787},[4226,4230],{"type":723,"nodeName":731,"attributes":4227,"children":4228},{"href":812},[4229],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4232},"\n\n\n   The client MUST ignore unrecognized response parameters.  The access\n   token string size is left undefined by this specification.  The\n   client should avoid making assumptions about value sizes.  The\n   authorization server SHOULD document the size of any value it issues.\n\n",{"type":723,"nodeName":740,"attributes":4234,"children":4235},{"class":3363},[4236,4242],{"type":723,"nodeName":731,"attributes":4237,"children":4239},{"class":2434,"id":325,"href":4238},"#section-4.2.2.1",[4240],{"type":728,"textContent":4241},"4.2.2.1",{"type":728,"textContent":3789},{"type":728,"textContent":4244},"\n\n   If the request fails due to a missing, invalid, or mismatching\n   redirection URI, or if the client identifier is missing or invalid,\n   the authorization server SHOULD inform the resource owner of the\n   error and MUST NOT automatically redirect the user-agent to the\n   invalid redirection URI.\n\n   If the resource owner denies the access request or if the request\n   fails for reasons other than a missing or invalid redirection URI,\n   the authorization server informs the client by adding the following\n   parameters to the fragment component of the redirection URI using the\n   \"application\u002Fx-www-form-urlencoded\" format, per ",{"type":723,"nodeName":731,"attributes":4246,"children":4247},{"href":2401},[4248],{"type":728,"textContent":2404},{"type":728,"textContent":3797},{"type":723,"nodeName":731,"attributes":4251,"children":4252},{"href":3800},[4253],{"type":728,"textContent":3803},{"type":728,"textContent":4255},"] error code from the\n         following:\n\n         invalid_request\n               The request is missing a required parameter, includes an\n               invalid parameter value, includes a parameter more than\n               once, or is otherwise malformed.\n\n         unauthorized_client\n               The client is not authorized to request an access token\n               using this method.\n\n         access_denied\n               The resource owner or authorization server denied the\n               request.\n\n         unsupported_response_type\n               The authorization server does not support obtaining an\n               access token using this method.\n\n         invalid_scope\n               The requested scope is invalid, unknown, or malformed.\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4257,"children":4258},{"class":787},[4259],{"type":728,"textContent":4260},"Hardt                        Standards Track                   [Page 36]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4263,"children":4264},{"class":796},[],{"type":723,"nodeName":724,"attributes":4266,"children":4267},{"class":800},[4268,4272,4273,4281,4283,4287,4289,4298,4300],{"type":723,"nodeName":740,"attributes":4269,"children":4271},{"id":4270},"page-37",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4274,"children":4275},{"class":787},[4276,4280],{"type":723,"nodeName":731,"attributes":4277,"children":4278},{"href":812},[4279],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4282},"\n\n\n         server_error\n               The authorization server encountered an unexpected\n               condition that prevented it from fulfilling the request.\n               (This error code is needed because a 500 Internal Server\n               Error HTTP status code cannot be returned to the client\n               via an HTTP redirect.)\n\n         temporarily_unavailable\n               The authorization server is currently unable to handle\n               the request due to a temporary overloading or maintenance\n               of the server.  (This error code is needed because a 503\n               Service Unavailable HTTP status code cannot be returned\n               to the client via an HTTP redirect.)\n\n         Values for the \"error\" parameter MUST NOT include characters\n         outside the set %x20-21 \u002F %x23-5B \u002F %x5D-7E.\n\n   error_description\n         OPTIONAL.  Human-readable ASCII [",{"type":723,"nodeName":731,"attributes":4284,"children":4285},{"href":3800},[4286],{"type":728,"textContent":3803},{"type":728,"textContent":4288},"] text providing\n         additional information, used to assist the client developer in\n         understanding the error that occurred.\n         Values for the \"error_description\" parameter MUST NOT include\n         characters outside the set %x20-21 \u002F %x23-5B \u002F %x5D-7E.\n\n   error_uri\n         OPTIONAL.  A URI identifying a human-readable web page with\n         information about the error, used to provide the client\n         developer with additional information about the error.\n         Values for the \"error_uri\" parameter MUST conform to the\n         URI-reference syntax and thus MUST NOT include characters\n         outside the set %x21 \u002F %x23-5B \u002F %x5D-7E.\n\n   state\n         REQUIRED if a \"state\" parameter was present in the client\n         authorization request.  The exact value received from the\n         client.\n\n   For example, the authorization server redirects the user-agent by\n   sending the following HTTP response:\n\n   HTTP\u002F1.1 302 Found\n   Location: https:\u002F\u002Fclient.example.com\u002Fcb#error=access_denied&state=xyz\n\n",{"type":723,"nodeName":740,"attributes":4290,"children":4291},{"class":2512},[4292,4296],{"type":723,"nodeName":731,"attributes":4293,"children":4294},{"class":2434,"id":330,"href":1353},[4295],{"type":728,"textContent":1356},{"type":728,"textContent":4297},".  Resource Owner Password Credentials Grant",{"type":728,"textContent":4299},"\n\n   The resource owner password credentials grant type is suitable in\n   cases where the resource owner has a trust relationship with the\n   client, such as the device operating system or a highly privileged\n\n\n\n",{"type":723,"nodeName":740,"attributes":4301,"children":4302},{"class":787},[4303],{"type":728,"textContent":4304},"Hardt                        Standards Track                   [Page 37]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4307,"children":4308},{"class":796},[],{"type":723,"nodeName":724,"attributes":4310,"children":4311},{"class":800},[4312,4316,4317,4325,4327],{"type":723,"nodeName":740,"attributes":4313,"children":4315},{"id":4314},"page-38",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4318,"children":4319},{"class":787},[4320,4324],{"type":723,"nodeName":731,"attributes":4321,"children":4322},{"href":812},[4323],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4326},"\n\n\n   application.  The authorization server should take special care when\n   enabling this grant type and only allow it when other flows are not\n   viable.\n\n   This grant type is suitable for clients capable of obtaining the\n   resource owner's credentials (username and password, typically using\n   an interactive form).  It is also used to migrate existing clients\n   using direct authentication schemes such as HTTP Basic or Digest\n   authentication to OAuth by converting the stored credentials to an\n   access token.\n\n     +----------+\n     | Resource |\n     |  Owner   |\n     |          |\n     +----------+\n          v\n          |    Resource Owner\n         (A) Password Credentials\n          |\n          v\n     +---------+                                  +---------------+\n     |         |>--(B)---- Resource Owner ------->|               |\n     |         |         Password Credentials     | Authorization |\n     | Client  |                                  |     Server    |\n     |         |\u003C--(C)---- Access Token ---------\u003C|               |\n     |         |    (w\u002F Optional Refresh Token)   |               |\n     +---------+                                  +---------------+\n\n            Figure 5: Resource Owner Password Credentials Flow\n\n   The flow illustrated in Figure 5 includes the following steps:\n\n   (A)  The resource owner provides the client with its username and\n        password.\n\n   (B)  The client requests an access token from the authorization\n        server's token endpoint by including the credentials received\n        from the resource owner.  When making the request, the client\n        authenticates with the authorization server.\n\n   (C)  The authorization server authenticates the client and validates\n        the resource owner credentials, and if valid, issues an access\n        token.\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4328,"children":4329},{"class":787},[4330],{"type":728,"textContent":4331},"Hardt                        Standards Track                   [Page 38]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4334,"children":4335},{"class":796},[],{"type":723,"nodeName":724,"attributes":4337,"children":4338},{"class":800},[4339,4343,4344,4352,4353,4362,4364,4372,4374,4378,4380,4384,4385,4389,4391],{"type":723,"nodeName":740,"attributes":4340,"children":4342},{"id":4341},"page-39",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4345,"children":4346},{"class":787},[4347,4351],{"type":723,"nodeName":731,"attributes":4348,"children":4349},{"href":812},[4350],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":4354,"children":4355},{"class":2606},[4356,4360],{"type":723,"nodeName":731,"attributes":4357,"children":4358},{"class":2434,"id":336,"href":1368},[4359],{"type":728,"textContent":1371},{"type":728,"textContent":4361},".  Authorization Request and Response",{"type":728,"textContent":4363},"\n\n   The method through which the client obtains the resource owner\n   credentials is beyond the scope of this specification.  The client\n   MUST discard the credentials once an access token has been obtained.\n\n",{"type":723,"nodeName":740,"attributes":4365,"children":4366},{"class":2606},[4367,4371],{"type":723,"nodeName":731,"attributes":4368,"children":4369},{"class":2434,"id":341,"href":1383},[4370],{"type":728,"textContent":1386},{"type":728,"textContent":3874},{"type":728,"textContent":4373},"\n\n   The client makes a request to the token endpoint by adding the\n   following parameters using the \"application\u002Fx-www-form-urlencoded\"\n   format per ",{"type":723,"nodeName":731,"attributes":4375,"children":4376},{"href":2401},[4377],{"type":728,"textContent":2404},{"type":728,"textContent":4379}," with a character encoding of UTF-8 in the HTTP\n   request entity-body:\n\n   grant_type\n         REQUIRED.  Value MUST be set to \"password\".\n\n   username\n         REQUIRED.  The resource owner username.\n\n   password\n         REQUIRED.  The resource owner password.\n\n   scope\n         OPTIONAL.  The scope of the access request as described by\n         ",{"type":723,"nodeName":731,"attributes":4381,"children":4382},{"href":1208},[4383],{"type":728,"textContent":3726},{"type":728,"textContent":3895},{"type":723,"nodeName":731,"attributes":4386,"children":4387},{"href":1193},[4388],{"type":728,"textContent":3893},{"type":728,"textContent":4390},".\n\n   For example, the client makes the following HTTP request using\n   transport-layer security (with extra line breaks for display purposes\n   only):\n\n     POST \u002Ftoken HTTP\u002F1.1\n     Host: server.example.com\n     Authorization: Basic czZCaGRSa3F0MzpnWDFmQmF0M2JW\n     Content-Type: application\u002Fx-www-form-urlencoded\n\n     grant_type=password&username=johndoe&password=A3ddj3w\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4392,"children":4393},{"class":787},[4394],{"type":728,"textContent":4395},"Hardt                        Standards Track                   [Page 39]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4398,"children":4399},{"class":796},[],{"type":723,"nodeName":724,"attributes":4401,"children":4402},{"class":800},[4403,4407,4408,4416,4418,4426,4427,4431,4433,4437,4439,4448,4450],{"type":723,"nodeName":740,"attributes":4404,"children":4406},{"id":4405},"page-40",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4409,"children":4410},{"class":787},[4411,4415],{"type":723,"nodeName":731,"attributes":4412,"children":4413},{"href":812},[4414],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4417},"\n\n\n   The authorization server MUST:\n\n   o  require client authentication for confidential clients or for any\n      client that was issued client credentials (or with other\n      authentication requirements),\n\n   o  authenticate the client if client authentication is included, and\n\n   o  validate the resource owner password credentials using its\n      existing password validation algorithm.\n\n   Since this access token request utilizes the resource owner's\n   password, the authorization server MUST protect the endpoint against\n   brute force attacks (e.g., using rate-limitation or generating\n   alerts).\n\n",{"type":723,"nodeName":740,"attributes":4419,"children":4420},{"class":2606},[4421,4425],{"type":723,"nodeName":731,"attributes":4422,"children":4423},{"class":2434,"id":346,"href":1395},[4424],{"type":728,"textContent":1398},{"type":728,"textContent":3943},{"type":728,"textContent":3945},{"type":723,"nodeName":731,"attributes":4428,"children":4429},{"href":1518},[4430],{"type":728,"textContent":3950},{"type":728,"textContent":4432},".  If the request failed client\n   authentication or is invalid, the authorization server returns an\n   error response as described in ",{"type":723,"nodeName":731,"attributes":4434,"children":4435},{"href":1531},[4436],{"type":728,"textContent":3957},{"type":728,"textContent":4438},".\n\n   An example successful response:\n\n     HTTP\u002F1.1 200 OK\n     Content-Type: application\u002Fjson;charset=UTF-8\n     Cache-Control: no-store\n     Pragma: no-cache\n\n     {\n       \"access_token\":\"2YotnFZFEjr1zCsicMWpAA\",\n       \"token_type\":\"example\",\n       \"expires_in\":3600,\n       \"refresh_token\":\"tGzv3JOkF0XG5Qx2TlKWIA\",\n       \"example_parameter\":\"example_value\"\n     }\n\n",{"type":723,"nodeName":740,"attributes":4440,"children":4441},{"class":2512},[4442,4446],{"type":723,"nodeName":731,"attributes":4443,"children":4444},{"class":2434,"id":351,"href":1409},[4445],{"type":728,"textContent":1412},{"type":728,"textContent":4447},".  Client Credentials Grant",{"type":728,"textContent":4449},"\n\n   The client can request an access token using only its client\n   credentials (or other supported means of authentication) when the\n   client is requesting access to the protected resources under its\n   control, or those of another resource owner that have been previously\n   arranged with the authorization server (the method of which is beyond\n   the scope of this specification).\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4451,"children":4452},{"class":787},[4453],{"type":728,"textContent":4454},"Hardt                        Standards Track                   [Page 40]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4457,"children":4458},{"class":796},[],{"type":723,"nodeName":724,"attributes":4460,"children":4461},{"class":800},[4462,4466,4467,4475,4477,4485,4487,4495,4496,4500,4502,4506,4508,4512,4514],{"type":723,"nodeName":740,"attributes":4463,"children":4465},{"id":4464},"page-41",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4468,"children":4469},{"class":787},[4470,4474],{"type":723,"nodeName":731,"attributes":4471,"children":4472},{"href":812},[4473],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4476},"\n\n\n   The client credentials grant type MUST only be used by confidential\n   clients.\n\n     +---------+                                  +---------------+\n     |         |                                  |               |\n     |         |>--(A)- Client Authentication --->| Authorization |\n     | Client  |                                  |     Server    |\n     |         |\u003C--(B)---- Access Token ---------\u003C|               |\n     |         |                                  |               |\n     +---------+                                  +---------------+\n\n                     Figure 6: Client Credentials Flow\n\n   The flow illustrated in Figure 6 includes the following steps:\n\n   (A)  The client authenticates with the authorization server and\n        requests an access token from the token endpoint.\n\n   (B)  The authorization server authenticates the client, and if valid,\n        issues an access token.\n\n",{"type":723,"nodeName":740,"attributes":4478,"children":4479},{"class":2606},[4480,4484],{"type":723,"nodeName":731,"attributes":4481,"children":4482},{"class":2434,"id":357,"href":1422},[4483],{"type":728,"textContent":1425},{"type":728,"textContent":4361},{"type":728,"textContent":4486},"\n\n   Since the client authentication is used as the authorization grant,\n   no additional authorization request is needed.\n\n",{"type":723,"nodeName":740,"attributes":4488,"children":4489},{"class":2606},[4490,4494],{"type":723,"nodeName":731,"attributes":4491,"children":4492},{"class":2434,"id":362,"href":1436},[4493],{"type":728,"textContent":1439},{"type":728,"textContent":3874},{"type":728,"textContent":4373},{"type":723,"nodeName":731,"attributes":4497,"children":4498},{"href":2401},[4499],{"type":728,"textContent":2404},{"type":728,"textContent":4501}," with a character encoding of UTF-8 in the HTTP\n   request entity-body:\n\n   grant_type\n         REQUIRED.  Value MUST be set to \"client_credentials\".\n\n   scope\n         OPTIONAL.  The scope of the access request as described by\n         ",{"type":723,"nodeName":731,"attributes":4503,"children":4504},{"href":1208},[4505],{"type":728,"textContent":3726},{"type":728,"textContent":4507},".\n\n   The client MUST authenticate with the authorization server as\n   described in ",{"type":723,"nodeName":731,"attributes":4509,"children":4510},{"href":1193},[4511],{"type":728,"textContent":3893},{"type":728,"textContent":4513},".\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4515,"children":4516},{"class":787},[4517],{"type":728,"textContent":4518},"Hardt                        Standards Track                   [Page 41]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4521,"children":4522},{"class":796},[],{"type":723,"nodeName":724,"attributes":4524,"children":4525},{"class":800},[4526,4530,4531,4539,4541,4549,4551,4555,4557,4561,4563,4572,4574],{"type":723,"nodeName":740,"attributes":4527,"children":4529},{"id":4528},"page-42",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4532,"children":4533},{"class":787},[4534,4538],{"type":723,"nodeName":731,"attributes":4535,"children":4536},{"href":812},[4537],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4540},"\n\n\n   For example, the client makes the following HTTP request using\n   transport-layer security (with extra line breaks for display purposes\n   only):\n\n     POST \u002Ftoken HTTP\u002F1.1\n     Host: server.example.com\n     Authorization: Basic czZCaGRSa3F0MzpnWDFmQmF0M2JW\n     Content-Type: application\u002Fx-www-form-urlencoded\n\n     grant_type=client_credentials\n\n   The authorization server MUST authenticate the client.\n\n",{"type":723,"nodeName":740,"attributes":4542,"children":4543},{"class":2606},[4544,4548],{"type":723,"nodeName":731,"attributes":4545,"children":4546},{"class":2434,"id":367,"href":1448},[4547],{"type":728,"textContent":1451},{"type":728,"textContent":3943},{"type":728,"textContent":4550},"\n\n   If the access token request is valid and authorized, the\n   authorization server issues an access token as described in\n   ",{"type":723,"nodeName":731,"attributes":4552,"children":4553},{"href":1518},[4554],{"type":728,"textContent":3950},{"type":728,"textContent":4556},".  A refresh token SHOULD NOT be included.  If the request\n   failed client authentication or is invalid, the authorization server\n   returns an error response as described in ",{"type":723,"nodeName":731,"attributes":4558,"children":4559},{"href":1531},[4560],{"type":728,"textContent":3957},{"type":728,"textContent":4562},".\n\n   An example successful response:\n\n     HTTP\u002F1.1 200 OK\n     Content-Type: application\u002Fjson;charset=UTF-8\n     Cache-Control: no-store\n     Pragma: no-cache\n\n     {\n       \"access_token\":\"2YotnFZFEjr1zCsicMWpAA\",\n       \"token_type\":\"example\",\n       \"expires_in\":3600,\n       \"example_parameter\":\"example_value\"\n     }\n\n",{"type":723,"nodeName":740,"attributes":4564,"children":4565},{"class":2512},[4566,4570],{"type":723,"nodeName":731,"attributes":4567,"children":4568},{"class":2434,"id":372,"href":1462},[4569],{"type":728,"textContent":1465},{"type":728,"textContent":4571},".  Extension Grants",{"type":728,"textContent":4573},"\n\n   The client uses an extension grant type by specifying the grant type\n   using an absolute URI (defined by the authorization server) as the\n   value of the \"grant_type\" parameter of the token endpoint, and by\n   adding any additional parameters necessary.\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4575,"children":4576},{"class":787},[4577],{"type":728,"textContent":4578},"Hardt                        Standards Track                   [Page 42]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4581,"children":4582},{"class":796},[],{"type":723,"nodeName":724,"attributes":4584,"children":4585},{"class":800},[4586,4590,4591,4599,4601,4607,4609,4613,4614,4618,4619,4628,4629,4633,4634,4638,4639,4648,4650,4654,4656],{"type":723,"nodeName":740,"attributes":4587,"children":4589},{"id":4588},"page-43",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4592,"children":4593},{"class":787},[4594,4598],{"type":723,"nodeName":731,"attributes":4595,"children":4596},{"href":812},[4597],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4600},"\n\n\n   For example, to request an access token using a Security Assertion\n   Markup Language (SAML) 2.0 assertion grant type as defined by\n   [",{"type":723,"nodeName":731,"attributes":4602,"children":4604},{"href":4603},"#ref-OAuth-SAML2",[4605],{"type":728,"textContent":4606},"OAuth-SAML2",{"type":728,"textContent":4608},"], the client could make the following HTTP request using\n   TLS (with extra line breaks for display purposes only):\n\n     POST \u002Ftoken HTTP\u002F1.1\n     Host: server.example.com\n     Content-Type: application\u002Fx-www-form-urlencoded\n\n     grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Asaml2-\n     bearer&assertion=PEFzc2VydGlvbiBJc3N1ZUluc3RhbnQ9IjIwMTEtMDU\n     [...omitted for brevity...]aG5TdGF0ZW1lbnQ-PC9Bc3NlcnRpb24-\n\n   If the access token request is valid and authorized, the\n   authorization server issues an access token and optional refresh\n   token as described in ",{"type":723,"nodeName":731,"attributes":4610,"children":4611},{"href":1518},[4612],{"type":728,"textContent":3950},{"type":728,"textContent":4432},{"type":723,"nodeName":731,"attributes":4615,"children":4616},{"href":1531},[4617],{"type":728,"textContent":3957},{"type":728,"textContent":2592},{"type":723,"nodeName":740,"attributes":4620,"children":4621},{"class":2430},[4622,4626],{"type":723,"nodeName":731,"attributes":4623,"children":4624},{"class":2434,"id":377,"href":1503},[4625],{"type":728,"textContent":1506},{"type":728,"textContent":4627},".  Issuing an Access Token",{"type":728,"textContent":3945},{"type":723,"nodeName":731,"attributes":4630,"children":4631},{"href":1518},[4632],{"type":728,"textContent":3950},{"type":728,"textContent":4432},{"type":723,"nodeName":731,"attributes":4635,"children":4636},{"href":1531},[4637],{"type":728,"textContent":3957},{"type":728,"textContent":2592},{"type":723,"nodeName":740,"attributes":4640,"children":4641},{"class":2512},[4642,4646],{"type":723,"nodeName":731,"attributes":4643,"children":4644},{"class":2434,"id":383,"href":1518},[4645],{"type":728,"textContent":1521},{"type":728,"textContent":4647},".  Successful Response",{"type":728,"textContent":4649},"\n\n   The authorization server issues an access token and optional refresh\n   token, and constructs the response by adding the following parameters\n   to the entity-body of the HTTP response with a 200 (OK) status code:\n\n   access_token\n         REQUIRED.  The access token issued by the authorization server.\n\n   token_type\n         REQUIRED.  The type of the token issued as described in\n         ",{"type":723,"nodeName":731,"attributes":4651,"children":4652},{"href":1574},[4653],{"type":728,"textContent":4197},{"type":728,"textContent":4655},".  Value is case insensitive.\n\n   expires_in\n         RECOMMENDED.  The lifetime in seconds of the access token.  For\n         example, the value \"3600\" denotes that the access token will\n         expire in one hour from the time the response was generated.\n         If omitted, the authorization server SHOULD provide the\n         expiration time via other means or document the default value.\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4657,"children":4658},{"class":787},[4659],{"type":728,"textContent":4660},"Hardt                        Standards Track                   [Page 43]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4663,"children":4664},{"class":796},[],{"type":723,"nodeName":724,"attributes":4666,"children":4667},{"class":800},[4668,4672,4673,4681,4683,4687,4689,4693,4695,4701,4703,4707,4709,4713,4715],{"type":723,"nodeName":740,"attributes":4669,"children":4671},{"id":4670},"page-44",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4674,"children":4675},{"class":787},[4676,4680],{"type":723,"nodeName":731,"attributes":4677,"children":4678},{"href":812},[4679],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4682},"\n\n\n   refresh_token\n         OPTIONAL.  The refresh token, which can be used to obtain new\n         access tokens using the same authorization grant as described\n         in ",{"type":723,"nodeName":731,"attributes":4684,"children":4685},{"href":1546},[4686],{"type":728,"textContent":3132},{"type":728,"textContent":4688},".\n\n   scope\n         OPTIONAL, if identical to the scope requested by the client;\n         otherwise, REQUIRED.  The scope of the access token as\n         described by ",{"type":723,"nodeName":731,"attributes":4690,"children":4691},{"href":1208},[4692],{"type":728,"textContent":3726},{"type":728,"textContent":4694},".\n\n   The parameters are included in the entity-body of the HTTP response\n   using the \"application\u002Fjson\" media type as defined by [",{"type":723,"nodeName":731,"attributes":4696,"children":4698},{"href":4697},"\u002Finfo\u002Frfc4627\u002F",[4699],{"type":728,"textContent":4700},"RFC4627",{"type":728,"textContent":4702},"].  The\n   parameters are serialized into a JavaScript Object Notation (JSON)\n   structure by adding each parameter at the highest structure level.\n   Parameter names and string values are included as JSON strings.\n   Numerical values are included as JSON numbers.  The order of\n   parameters does not matter and can vary.\n\n   The authorization server MUST include the HTTP \"Cache-Control\"\n   response header field [",{"type":723,"nodeName":731,"attributes":4704,"children":4705},{"href":2470},[4706],{"type":728,"textContent":2473},{"type":728,"textContent":4708},"] with a value of \"no-store\" in any\n   response containing tokens, credentials, or other sensitive\n   information, as well as the \"Pragma\" response header field [",{"type":723,"nodeName":731,"attributes":4710,"children":4711},{"href":2470},[4712],{"type":728,"textContent":2473},{"type":728,"textContent":4714},"]\n   with a value of \"no-cache\".\n\n   For example:\n\n     HTTP\u002F1.1 200 OK\n     Content-Type: application\u002Fjson;charset=UTF-8\n     Cache-Control: no-store\n     Pragma: no-cache\n\n     {\n       \"access_token\":\"2YotnFZFEjr1zCsicMWpAA\",\n       \"token_type\":\"example\",\n       \"expires_in\":3600,\n       \"refresh_token\":\"tGzv3JOkF0XG5Qx2TlKWIA\",\n       \"example_parameter\":\"example_value\"\n     }\n\n   The client MUST ignore unrecognized value names in the response.  The\n   sizes of tokens and other values received from the authorization\n   server are left undefined.  The client should avoid making\n   assumptions about value sizes.  The authorization server SHOULD\n   document the size of any value it issues.\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4716,"children":4717},{"class":787},[4718],{"type":728,"textContent":4719},"Hardt                        Standards Track                   [Page 44]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4722,"children":4723},{"class":796},[],{"type":723,"nodeName":724,"attributes":4725,"children":4726},{"class":800},[4727,4731,4732,4740,4741,4749,4751,4755,4757],{"type":723,"nodeName":740,"attributes":4728,"children":4730},{"id":4729},"page-45",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4733,"children":4734},{"class":787},[4735,4739],{"type":723,"nodeName":731,"attributes":4736,"children":4737},{"href":812},[4738],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":4742,"children":4743},{"class":2512},[4744,4748],{"type":723,"nodeName":731,"attributes":4745,"children":4746},{"class":2434,"id":388,"href":1531},[4747],{"type":728,"textContent":1534},{"type":728,"textContent":3789},{"type":728,"textContent":4750},"\n\n   The authorization server responds with an HTTP 400 (Bad Request)\n   status code (unless specified otherwise) and includes the following\n   parameters with the response:\n\n   error\n         REQUIRED.  A single ASCII [",{"type":723,"nodeName":731,"attributes":4752,"children":4753},{"href":3800},[4754],{"type":728,"textContent":3803},{"type":728,"textContent":4756},"] error code from the\n         following:\n\n         invalid_request\n               The request is missing a required parameter, includes an\n               unsupported parameter value (other than grant type),\n               repeats a parameter, includes multiple credentials,\n               utilizes more than one mechanism for authenticating the\n               client, or is otherwise malformed.\n\n         invalid_client\n               Client authentication failed (e.g., unknown client, no\n               client authentication included, or unsupported\n               authentication method).  The authorization server MAY\n               return an HTTP 401 (Unauthorized) status code to indicate\n               which HTTP authentication schemes are supported.  If the\n               client attempted to authenticate via the \"Authorization\"\n               request header field, the authorization server MUST\n               respond with an HTTP 401 (Unauthorized) status code and\n               include the \"WWW-Authenticate\" response header field\n               matching the authentication scheme used by the client.\n\n         invalid_grant\n               The provided authorization grant (e.g., authorization\n               code, resource owner credentials) or refresh token is\n               invalid, expired, revoked, does not match the redirection\n               URI used in the authorization request, or was issued to\n               another client.\n\n         unauthorized_client\n               The authenticated client is not authorized to use this\n               authorization grant type.\n\n         unsupported_grant_type\n               The authorization grant type is not supported by the\n               authorization server.\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4758,"children":4759},{"class":787},[4760],{"type":728,"textContent":4761},"Hardt                        Standards Track                   [Page 45]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4764,"children":4765},{"class":796},[],{"type":723,"nodeName":724,"attributes":4767,"children":4768},{"class":800},[4769,4773,4774,4782,4784,4788,4790,4794,4796],{"type":723,"nodeName":740,"attributes":4770,"children":4772},{"id":4771},"page-46",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4775,"children":4776},{"class":787},[4777,4781],{"type":723,"nodeName":731,"attributes":4778,"children":4779},{"href":812},[4780],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4783},"\n\n\n         invalid_scope\n               The requested scope is invalid, unknown, malformed, or\n               exceeds the scope granted by the resource owner.\n\n         Values for the \"error\" parameter MUST NOT include characters\n         outside the set %x20-21 \u002F %x23-5B \u002F %x5D-7E.\n\n   error_description\n         OPTIONAL.  Human-readable ASCII [",{"type":723,"nodeName":731,"attributes":4785,"children":4786},{"href":3800},[4787],{"type":728,"textContent":3803},{"type":728,"textContent":4789},"] text providing\n         additional information, used to assist the client developer in\n         understanding the error that occurred.\n         Values for the \"error_description\" parameter MUST NOT include\n         characters outside the set %x20-21 \u002F %x23-5B \u002F %x5D-7E.\n\n   error_uri\n         OPTIONAL.  A URI identifying a human-readable web page with\n         information about the error, used to provide the client\n         developer with additional information about the error.\n         Values for the \"error_uri\" parameter MUST conform to the\n         URI-reference syntax and thus MUST NOT include characters\n         outside the set %x21 \u002F %x23-5B \u002F %x5D-7E.\n\n   The parameters are included in the entity-body of the HTTP response\n   using the \"application\u002Fjson\" media type as defined by [",{"type":723,"nodeName":731,"attributes":4791,"children":4792},{"href":4697},[4793],{"type":728,"textContent":4700},{"type":728,"textContent":4795},"].  The\n   parameters are serialized into a JSON structure by adding each\n   parameter at the highest structure level.  Parameter names and string\n   values are included as JSON strings.  Numerical values are included\n   as JSON numbers.  The order of parameters does not matter and can\n   vary.\n\n   For example:\n\n     HTTP\u002F1.1 400 Bad Request\n     Content-Type: application\u002Fjson;charset=UTF-8\n     Cache-Control: no-store\n     Pragma: no-cache\n\n     {\n       \"error\":\"invalid_request\"\n     }\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4797,"children":4798},{"class":787},[4799],{"type":728,"textContent":4800},"Hardt                        Standards Track                   [Page 46]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4803,"children":4804},{"class":796},[],{"type":723,"nodeName":724,"attributes":4806,"children":4807},{"class":800},[4808,4812,4813,4821,4822,4831,4833,4837,4839,4843,4845,4849,4851],{"type":723,"nodeName":740,"attributes":4809,"children":4811},{"id":4810},"page-47",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4814,"children":4815},{"class":787},[4816,4820],{"type":723,"nodeName":731,"attributes":4817,"children":4818},{"href":812},[4819],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":4823,"children":4824},{"class":2430},[4825,4829],{"type":723,"nodeName":731,"attributes":4826,"children":4827},{"class":2434,"id":393,"href":1546},[4828],{"type":728,"textContent":849},{"type":728,"textContent":4830},".  Refreshing an Access Token",{"type":728,"textContent":4832},"\n\n   If the authorization server issued a refresh token to the client, the\n   client makes a refresh request to the token endpoint by adding the\n   following parameters using the \"application\u002Fx-www-form-urlencoded\"\n   format per ",{"type":723,"nodeName":731,"attributes":4834,"children":4835},{"href":2401},[4836],{"type":728,"textContent":2404},{"type":728,"textContent":4838}," with a character encoding of UTF-8 in the HTTP\n   request entity-body:\n\n   grant_type\n         REQUIRED.  Value MUST be set to \"refresh_token\".\n\n   refresh_token\n         REQUIRED.  The refresh token issued to the client.\n\n   scope\n         OPTIONAL.  The scope of the access request as described by\n         ",{"type":723,"nodeName":731,"attributes":4840,"children":4841},{"href":1208},[4842],{"type":728,"textContent":3726},{"type":728,"textContent":4844},".  The requested scope MUST NOT include any scope\n         not originally granted by the resource owner, and if omitted is\n         treated as equal to the scope originally granted by the\n         resource owner.\n\n   Because refresh tokens are typically long-lasting credentials used to\n   request additional access tokens, the refresh token is bound to the\n   client to which it was issued.  If the client type is confidential or\n   the client was issued client credentials (or assigned other\n   authentication requirements), the client MUST authenticate with the\n   authorization server as described in ",{"type":723,"nodeName":731,"attributes":4846,"children":4847},{"href":1193},[4848],{"type":728,"textContent":3893},{"type":728,"textContent":4850},".\n\n   For example, the client makes the following HTTP request using\n   transport-layer security (with extra line breaks for display purposes\n   only):\n\n     POST \u002Ftoken HTTP\u002F1.1\n     Host: server.example.com\n     Authorization: Basic czZCaGRSa3F0MzpnWDFmQmF0M2JW\n     Content-Type: application\u002Fx-www-form-urlencoded\n\n     grant_type=refresh_token&refresh_token=tGzv3JOkF0XG5Qx2TlKWIA\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4852,"children":4853},{"class":787},[4854],{"type":728,"textContent":4855},"Hardt                        Standards Track                   [Page 47]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4858,"children":4859},{"class":796},[],{"type":723,"nodeName":724,"attributes":4861,"children":4862},{"class":800},[4863,4867,4868,4876,4878,4882,4884,4888,4890,4899,4901,4905,4907,4911,4913],{"type":723,"nodeName":740,"attributes":4864,"children":4866},{"id":4865},"page-48",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4869,"children":4870},{"class":787},[4871,4875],{"type":723,"nodeName":731,"attributes":4872,"children":4873},{"href":812},[4874],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":4877},"\n\n\n   The authorization server MUST:\n\n   o  require client authentication for confidential clients or for any\n      client that was issued client credentials (or with other\n      authentication requirements),\n\n   o  authenticate the client if client authentication is included and\n      ensure that the refresh token was issued to the authenticated\n      client, and\n\n   o  validate the refresh token.\n\n   If valid and authorized, the authorization server issues an access\n   token as described in ",{"type":723,"nodeName":731,"attributes":4879,"children":4880},{"href":1518},[4881],{"type":728,"textContent":3950},{"type":728,"textContent":4883},".  If the request failed\n   verification or is invalid, the authorization server returns an error\n   response as described in ",{"type":723,"nodeName":731,"attributes":4885,"children":4886},{"href":1531},[4887],{"type":728,"textContent":3957},{"type":728,"textContent":4889},".\n\n   The authorization server MAY issue a new refresh token, in which case\n   the client MUST discard the old refresh token and replace it with the\n   new refresh token.  The authorization server MAY revoke the old\n   refresh token after issuing a new refresh token to the client.  If a\n   new refresh token is issued, the refresh token scope MUST be\n   identical to that of the refresh token included by the client in the\n   request.\n\n",{"type":723,"nodeName":740,"attributes":4891,"children":4892},{"class":2430},[4893,4897],{"type":723,"nodeName":731,"attributes":4894,"children":4895},{"class":2434,"id":398,"href":1560},[4896],{"type":728,"textContent":864},{"type":728,"textContent":4898},".  Accessing Protected Resources",{"type":728,"textContent":4900},"\n\n   The client accesses protected resources by presenting the access\n   token to the resource server.  The resource server MUST validate the\n   access token and ensure that it has not expired and that its scope\n   covers the requested resource.  The methods used by the resource\n   server to validate the access token (as well as any error responses)\n   are beyond the scope of this specification but generally involve an\n   interaction or coordination between the resource server and the\n   authorization server.\n\n   The method in which the client utilizes the access token to\n   authenticate with the resource server depends on the type of access\n   token issued by the authorization server.  Typically, it involves\n   using the HTTP \"Authorization\" request header field [",{"type":723,"nodeName":731,"attributes":4902,"children":4903},{"href":3082},[4904],{"type":728,"textContent":3085},{"type":728,"textContent":4906},"] with an\n   authentication scheme defined by the specification of the access\n   token type used, such as [",{"type":723,"nodeName":731,"attributes":4908,"children":4909},{"href":2735},[4910],{"type":728,"textContent":2738},{"type":728,"textContent":4912},"].\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4914,"children":4915},{"class":787},[4916],{"type":728,"textContent":4917},"Hardt                        Standards Track                   [Page 48]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":4920,"children":4921},{"class":796},[],{"type":723,"nodeName":724,"attributes":4923,"children":4924},{"class":800},[4925,4929,4930,4938,4939,4948,4950,4954,4956,4962,4964,4968,4970,4974,4976,4984,4986,4991,4993],{"type":723,"nodeName":740,"attributes":4926,"children":4928},{"id":4927},"page-49",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":4931,"children":4932},{"class":787},[4933,4937],{"type":723,"nodeName":731,"attributes":4934,"children":4935},{"href":812},[4936],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":4940,"children":4941},{"class":2512},[4942,4946],{"type":723,"nodeName":731,"attributes":4943,"children":4944},{"class":2434,"id":404,"href":1574},[4945],{"type":728,"textContent":1577},{"type":728,"textContent":4947},".  Access Token Types",{"type":728,"textContent":4949},"\n\n   The access token type provides the client with the information\n   required to successfully utilize the access token to make a protected\n   resource request (along with type-specific attributes).  The client\n   MUST NOT use an access token if it does not understand the token\n   type.\n\n   For example, the \"bearer\" token type defined in [",{"type":723,"nodeName":731,"attributes":4951,"children":4952},{"href":2735},[4953],{"type":728,"textContent":2738},{"type":728,"textContent":4955},"] is utilized\n   by simply including the access token string in the request:\n\n     GET \u002Fresource\u002F1 HTTP\u002F1.1\n     Host: example.com\n     Authorization: Bearer mF_9.B5f-4.1JqM\n\n   while the \"mac\" token type defined in [",{"type":723,"nodeName":731,"attributes":4957,"children":4959},{"href":4958},"#ref-OAuth-HTTP-MAC",[4960],{"type":728,"textContent":4961},"OAuth-HTTP-MAC",{"type":728,"textContent":4963},"] is utilized by\n   issuing a Message Authentication Code (MAC) key together with the\n   access token that is used to sign certain components of the HTTP\n   requests:\n\n     GET \u002Fresource\u002F1 HTTP\u002F1.1\n     Host: example.com\n     Authorization: MAC id=\"h480djs93hd8\",\n                        nonce=\"274312:dj83hs9s\",\n                        mac=\"kDZvddkndxvhGRXZhvuDjEWhGeE=\"\n\n   The above examples are provided for illustration purposes only.\n   Developers are advised to consult the [",{"type":723,"nodeName":731,"attributes":4965,"children":4966},{"href":2735},[4967],{"type":728,"textContent":2738},{"type":728,"textContent":4969},"] and [",{"type":723,"nodeName":731,"attributes":4971,"children":4972},{"href":4958},[4973],{"type":728,"textContent":4961},{"type":728,"textContent":4975},"]\n   specifications before use.\n\n   Each access token type definition specifies the additional attributes\n   (if any) sent to the client together with the \"access_token\" response\n   parameter.  It also defines the HTTP authentication method used to\n   include the access token when making a protected resource request.\n\n",{"type":723,"nodeName":740,"attributes":4977,"children":4978},{"class":2512},[4979,4983],{"type":723,"nodeName":731,"attributes":4980,"children":4981},{"class":2434,"id":409,"href":1589},[4982],{"type":728,"textContent":1592},{"type":728,"textContent":3789},{"type":728,"textContent":4985},"\n\n   If a resource access request fails, the resource server SHOULD inform\n   the client of the error.  While the specifics of such error responses\n   are beyond the scope of this specification, this document establishes\n   a common registry in ",{"type":723,"nodeName":731,"attributes":4987,"children":4988},{"href":2051},[4989],{"type":728,"textContent":4990},"Section 11.4",{"type":728,"textContent":4992}," for error values to be shared among\n   OAuth token authentication schemes.\n\n   New authentication schemes designed primarily for OAuth token\n   authentication SHOULD define a mechanism for providing an error\n   status code to the client, in which the error values allowed are\n   registered in the error registry established by this specification.\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":4994,"children":4995},{"class":787},[4996],{"type":728,"textContent":4997},"Hardt                        Standards Track                   [Page 49]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5000,"children":5001},{"class":796},[],{"type":723,"nodeName":724,"attributes":5003,"children":5004},{"class":800},[5005,5009,5010,5018,5020,5029,5030,5039,5041,5046,5048,5052,5054,5063,5065,5070,5072],{"type":723,"nodeName":740,"attributes":5006,"children":5008},{"id":5007},"page-50",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5011,"children":5012},{"class":787},[5013,5017],{"type":723,"nodeName":731,"attributes":5014,"children":5015},{"href":812},[5016],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5019},"\n\n\n   Such schemes MAY limit the set of valid error codes to a subset of\n   the registered values.  If the error code is returned using a named\n   parameter, the parameter name SHOULD be \"error\".\n\n   Other schemes capable of being used for OAuth token authentication,\n   but not primarily designed for that purpose, MAY bind their error\n   values to the registry in the same manner.\n\n   New authentication schemes MAY choose to also specify the use of the\n   \"error_description\" and \"error_uri\" parameters to return error\n   information in a manner parallel to their usage in this\n   specification.\n\n",{"type":723,"nodeName":740,"attributes":5021,"children":5022},{"class":2430},[5023,5027],{"type":723,"nodeName":731,"attributes":5024,"children":5025},{"class":2434,"id":414,"href":1601},[5026],{"type":728,"textContent":879},{"type":728,"textContent":5028},".  Extensibility",{"type":728,"textContent":2427},{"type":723,"nodeName":740,"attributes":5031,"children":5032},{"class":2512},[5033,5037],{"type":723,"nodeName":731,"attributes":5034,"children":5035},{"class":2434,"id":420,"href":1615},[5036],{"type":728,"textContent":1618},{"type":728,"textContent":5038},".  Defining Access Token Types",{"type":728,"textContent":5040},"\n\n   Access token types can be defined in one of two ways: registered in\n   the Access Token Types registry (following the procedures in\n   ",{"type":723,"nodeName":731,"attributes":5042,"children":5043},{"href":1942},[5044],{"type":728,"textContent":5045},"Section 11.1",{"type":728,"textContent":5047},"), or by using a unique absolute URI as its name.\n\n   Types utilizing a URI name SHOULD be limited to vendor-specific\n   implementations that are not commonly applicable, and are specific to\n   the implementation details of the resource server where they are\n   used.\n\n   All other types MUST be registered.  Type names MUST conform to the\n   type-name ABNF.  If the type definition includes a new HTTP\n   authentication scheme, the type name SHOULD be identical to the HTTP\n   authentication scheme name (as defined by [",{"type":723,"nodeName":731,"attributes":5049,"children":5050},{"href":3082},[5051],{"type":728,"textContent":3085},{"type":728,"textContent":5053},"]).  The token type\n   \"example\" is reserved for use in examples.\n\n     type-name  = 1*name-char\n     name-char  = \"-\" \u002F \".\" \u002F \"_\" \u002F DIGIT \u002F ALPHA\n\n",{"type":723,"nodeName":740,"attributes":5055,"children":5056},{"class":2512},[5057,5061],{"type":723,"nodeName":731,"attributes":5058,"children":5059},{"class":2434,"id":425,"href":1628},[5060],{"type":728,"textContent":1631},{"type":728,"textContent":5062},".  Defining New Endpoint Parameters",{"type":728,"textContent":5064},"\n\n   New request or response parameters for use with the authorization\n   endpoint or the token endpoint are defined and registered in the\n   OAuth Parameters registry following the procedure in ",{"type":723,"nodeName":731,"attributes":5066,"children":5067},{"href":1968},[5068],{"type":728,"textContent":5069},"Section 11.2",{"type":728,"textContent":5071},".\n\n   Parameter names MUST conform to the param-name ABNF, and parameter\n   values syntax MUST be well-defined (e.g., using ABNF, or a reference\n   to the syntax of an existing parameter).\n\n     param-name  = 1*name-char\n     name-char   = \"-\" \u002F \".\" \u002F \"_\" \u002F DIGIT \u002F ALPHA\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":5073,"children":5074},{"class":787},[5075],{"type":728,"textContent":5076},"Hardt                        Standards Track                   [Page 50]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5079,"children":5080},{"class":796},[],{"type":723,"nodeName":724,"attributes":5082,"children":5083},{"class":800},[5084,5088,5089,5097,5099,5108,5110,5114,5115,5124,5126,5131,5133,5142,5144,5148,5150,5155,5157,5161,5163,5168,5170],{"type":723,"nodeName":740,"attributes":5085,"children":5087},{"id":5086},"page-51",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5090,"children":5091},{"class":787},[5092,5096],{"type":723,"nodeName":731,"attributes":5093,"children":5094},{"href":812},[5095],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5098},"\n\n\n   Unregistered vendor-specific parameter extensions that are not\n   commonly applicable and that are specific to the implementation\n   details of the authorization server where they are used SHOULD\n   utilize a vendor-specific prefix that is not likely to conflict with\n   other registered values (e.g., begin with 'companyname_').\n\n",{"type":723,"nodeName":740,"attributes":5100,"children":5101},{"class":2512},[5102,5106],{"type":723,"nodeName":731,"attributes":5103,"children":5104},{"class":2434,"id":430,"href":1641},[5105],{"type":728,"textContent":1644},{"type":728,"textContent":5107},".  Defining New Authorization Grant Types",{"type":728,"textContent":5109},"\n\n   New authorization grant types can be defined by assigning them a\n   unique absolute URI for use with the \"grant_type\" parameter.  If the\n   extension grant type requires additional token endpoint parameters,\n   they MUST be registered in the OAuth Parameters registry as described\n   by ",{"type":723,"nodeName":731,"attributes":5111,"children":5112},{"href":1968},[5113],{"type":728,"textContent":5069},{"type":728,"textContent":2592},{"type":723,"nodeName":740,"attributes":5116,"children":5117},{"class":2512},[5118,5122],{"type":723,"nodeName":731,"attributes":5119,"children":5120},{"class":2434,"id":435,"href":1656},[5121],{"type":728,"textContent":1659},{"type":728,"textContent":5123},".  Defining New Authorization Endpoint Response Types",{"type":728,"textContent":5125},"\n\n   New response types for use with the authorization endpoint are\n   defined and registered in the Authorization Endpoint Response Types\n   registry following the procedure in ",{"type":723,"nodeName":731,"attributes":5127,"children":5128},{"href":2010},[5129],{"type":728,"textContent":5130},"Section 11.3",{"type":728,"textContent":5132},".  Response type\n   names MUST conform to the response-type ABNF.\n\n     response-type  = response-name *( SP response-name )\n     response-name  = 1*response-char\n     response-char  = \"_\" \u002F DIGIT \u002F ALPHA\n\n   If a response type contains one or more space characters (%x20), it\n   is compared as a space-delimited list of values in which the order of\n   values does not matter.  Only one order of values can be registered,\n   which covers all other arrangements of the same set of values.\n\n   For example, the response type \"token code\" is left undefined by this\n   specification.  However, an extension can define and register the\n   \"token code\" response type.  Once registered, the same combination\n   cannot be registered as \"code token\", but both values can be used to\n   denote the same response type.\n\n",{"type":723,"nodeName":740,"attributes":5134,"children":5135},{"class":2512},[5136,5140],{"type":723,"nodeName":731,"attributes":5137,"children":5138},{"class":2434,"id":440,"href":1669},[5139],{"type":728,"textContent":1672},{"type":728,"textContent":5141},".  Defining Additional Error Codes",{"type":728,"textContent":5143},"\n\n   In cases where protocol extensions (i.e., access token types,\n   extension parameters, or extension grant types) require additional\n   error codes to be used with the authorization code grant error\n   response (",{"type":723,"nodeName":731,"attributes":5145,"children":5146},{"href":3299},[5147],{"type":728,"textContent":3302},{"type":728,"textContent":5149},"), the implicit grant error response\n   (",{"type":723,"nodeName":731,"attributes":5151,"children":5152},{"href":4238},[5153],{"type":728,"textContent":5154},"Section 4.2.2.1",{"type":728,"textContent":5156},"), the token error response (",{"type":723,"nodeName":731,"attributes":5158,"children":5159},{"href":1531},[5160],{"type":728,"textContent":3957},{"type":728,"textContent":5162},"), or the\n   resource access error response (",{"type":723,"nodeName":731,"attributes":5164,"children":5165},{"href":1589},[5166],{"type":728,"textContent":5167},"Section 7.2",{"type":728,"textContent":5169},"), such error codes MAY be\n   defined.\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":5171,"children":5172},{"class":787},[5173],{"type":728,"textContent":5174},"Hardt                        Standards Track                   [Page 51]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5177,"children":5178},{"class":796},[],{"type":723,"nodeName":724,"attributes":5180,"children":5181},{"class":800},[5182,5186,5187,5195,5197,5201,5203,5212,5214],{"type":723,"nodeName":740,"attributes":5183,"children":5185},{"id":5184},"page-52",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5188,"children":5189},{"class":787},[5190,5194],{"type":723,"nodeName":731,"attributes":5191,"children":5192},{"href":812},[5193],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5196},"\n\n\n   Extension error codes MUST be registered (following the procedures in\n   ",{"type":723,"nodeName":731,"attributes":5198,"children":5199},{"href":2051},[5200],{"type":728,"textContent":4990},{"type":728,"textContent":5202},") if the extension they are used in conjunction with is a\n   registered access token type, a registered endpoint parameter, or an\n   extension grant type.  Error codes used with unregistered extensions\n   MAY be registered.\n\n   Error codes MUST conform to the error ABNF and SHOULD be prefixed by\n   an identifying name when possible.  For example, an error identifying\n   an invalid value set to the extension parameter \"example\" SHOULD be\n   named \"example_invalid\".\n\n     error      = 1*error-char\n     error-char = %x20-21 \u002F %x23-5B \u002F %x5D-7E\n\n",{"type":723,"nodeName":740,"attributes":5204,"children":5205},{"class":2430},[5206,5210],{"type":723,"nodeName":731,"attributes":5207,"children":5208},{"class":2434,"id":445,"href":1682},[5209],{"type":728,"textContent":921},{"type":728,"textContent":5211},".  Native Applications",{"type":728,"textContent":5213},"\n\n   Native applications are clients installed and executed on the device\n   used by the resource owner (i.e., desktop application, native mobile\n   application).  Native applications require special consideration\n   related to security, platform capabilities, and overall end-user\n   experience.\n\n   The authorization endpoint requires interaction between the client\n   and the resource owner's user-agent.  Native applications can invoke\n   an external user-agent or embed a user-agent within the application.\n   For example:\n\n   o  External user-agent - the native application can capture the\n      response from the authorization server using a redirection URI\n      with a scheme registered with the operating system to invoke the\n      client as the handler, manual copy-and-paste of the credentials,\n      running a local web server, installing a user-agent extension, or\n      by providing a redirection URI identifying a server-hosted\n      resource under the client's control, which in turn makes the\n      response available to the native application.\n\n   o  Embedded user-agent - the native application obtains the response\n      by directly communicating with the embedded user-agent by\n      monitoring state changes emitted during the resource load, or\n      accessing the user-agent's cookies storage.\n\n   When choosing between an external or embedded user-agent, developers\n   should consider the following:\n\n   o  An external user-agent may improve completion rate, as the\n      resource owner may already have an active session with the\n      authorization server, removing the need to re-authenticate.  It\n      provides a familiar end-user experience and functionality.  The\n\n\n\n",{"type":723,"nodeName":740,"attributes":5215,"children":5216},{"class":787},[5217],{"type":728,"textContent":5218},"Hardt                        Standards Track                   [Page 52]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5221,"children":5222},{"class":796},[],{"type":723,"nodeName":724,"attributes":5224,"children":5225},{"class":800},[5226,5230,5231,5239,5241,5250,5252,5256,5258,5264,5265,5273,5275],{"type":723,"nodeName":740,"attributes":5227,"children":5229},{"id":5228},"page-53",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5232,"children":5233},{"class":787},[5234,5238],{"type":723,"nodeName":731,"attributes":5235,"children":5236},{"href":812},[5237],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5240},"\n\n\n      resource owner may also rely on user-agent features or extensions\n      to assist with authentication (e.g., password manager, 2-factor\n      device reader).\n\n   o  An embedded user-agent may offer improved usability, as it removes\n      the need to switch context and open new windows.\n\n   o  An embedded user-agent poses a security challenge because resource\n      owners are authenticating in an unidentified window without access\n      to the visual protections found in most external user-agents.  An\n      embedded user-agent educates end-users to trust unidentified\n      requests for authentication (making phishing attacks easier to\n      execute).\n\n   When choosing between the implicit grant type and the authorization\n   code grant type, the following should be considered:\n\n   o  Native applications that use the authorization code grant type\n      SHOULD do so without using client credentials, due to the native\n      application's inability to keep client credentials confidential.\n\n   o  When using the implicit grant type flow, a refresh token is not\n      returned, which requires repeating the authorization process once\n      the access token expires.\n\n",{"type":723,"nodeName":740,"attributes":5242,"children":5243},{"class":2430},[5244,5248],{"type":723,"nodeName":731,"attributes":5245,"children":5246},{"class":2434,"id":450,"href":1696},[5247],{"type":728,"textContent":949},{"type":728,"textContent":5249},".  Security Considerations",{"type":728,"textContent":5251},"\n\n   As a flexible and extensible framework, OAuth's security\n   considerations depend on many factors.  The following sections\n   provide implementers with security guidelines focused on the three\n   client profiles described in ",{"type":723,"nodeName":731,"attributes":5253,"children":5254},{"href":1036},[5255],{"type":728,"textContent":2973},{"type":728,"textContent":5257},": web application,\n   user-agent-based application, and native application.\n\n   A comprehensive OAuth security model and analysis, as well as\n   background for the protocol design, is provided by\n   [",{"type":723,"nodeName":731,"attributes":5259,"children":5261},{"href":5260},"#ref-OAuth-THREATMODEL",[5262],{"type":728,"textContent":5263},"OAuth-THREATMODEL",{"type":728,"textContent":2740},{"type":723,"nodeName":740,"attributes":5266,"children":5267},{"class":2512},[5268,5272],{"type":723,"nodeName":731,"attributes":5269,"children":5270},{"class":2434,"id":456,"href":1710},[5271],{"type":728,"textContent":1713},{"type":728,"textContent":3066},{"type":728,"textContent":5274},"\n\n   The authorization server establishes client credentials with web\n   application clients for the purpose of client authentication.  The\n   authorization server is encouraged to consider stronger client\n   authentication means than a client password.  Web application clients\n   MUST ensure confidentiality of client passwords and other client\n   credentials.\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":5276,"children":5277},{"class":787},[5278],{"type":728,"textContent":5279},"Hardt                        Standards Track                   [Page 53]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5282,"children":5283},{"class":796},[],{"type":723,"nodeName":724,"attributes":5285,"children":5286},{"class":800},[5287,5291,5292,5300,5302,5311,5313],{"type":723,"nodeName":740,"attributes":5288,"children":5290},{"id":5289},"page-54",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5293,"children":5294},{"class":787},[5295,5299],{"type":723,"nodeName":731,"attributes":5296,"children":5297},{"href":812},[5298],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5301},"\n\n\n   The authorization server MUST NOT issue client passwords or other\n   client credentials to native application or user-agent-based\n   application clients for the purpose of client authentication.  The\n   authorization server MAY issue a client password or other credentials\n   for a specific installation of a native application client on a\n   specific device.\n\n   When client authentication is not possible, the authorization server\n   SHOULD employ other means to validate the client's identity -- for\n   example, by requiring the registration of the client redirection URI\n   or enlisting the resource owner to confirm identity.  A valid\n   redirection URI is not sufficient to verify the client's identity\n   when asking for resource owner authorization but can be used to\n   prevent delivering credentials to a counterfeit client after\n   obtaining resource owner authorization.\n\n   The authorization server must consider the security implications of\n   interacting with unauthenticated clients and take measures to limit\n   the potential exposure of other credentials (e.g., refresh tokens)\n   issued to such clients.\n\n",{"type":723,"nodeName":740,"attributes":5303,"children":5304},{"class":2512},[5305,5309],{"type":723,"nodeName":731,"attributes":5306,"children":5307},{"class":2434,"id":461,"href":1723},[5308],{"type":728,"textContent":1726},{"type":728,"textContent":5310},".  Client Impersonation",{"type":728,"textContent":5312},"\n\n   A malicious client can impersonate another client and obtain access\n   to protected resources if the impersonated client fails to, or is\n   unable to, keep its client credentials confidential.\n\n   The authorization server MUST authenticate the client whenever\n   possible.  If the authorization server cannot authenticate the client\n   due to the client's nature, the authorization server MUST require the\n   registration of any redirection URI used for receiving authorization\n   responses and SHOULD utilize other means to protect resource owners\n   from such potentially malicious clients.  For example, the\n   authorization server can engage the resource owner to assist in\n   identifying the client and its origin.\n\n   The authorization server SHOULD enforce explicit resource owner\n   authentication and provide the resource owner with information about\n   the client and the requested authorization scope and lifetime.  It is\n   up to the resource owner to review the information in the context of\n   the current client and to authorize or deny the request.\n\n   The authorization server SHOULD NOT process repeated authorization\n   requests automatically (without active resource owner interaction)\n   without authenticating the client or relying on other measures to\n   ensure that the repeated request comes from the original client and\n   not an impersonator.\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":5314,"children":5315},{"class":787},[5316],{"type":728,"textContent":5317},"Hardt                        Standards Track                   [Page 54]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5320,"children":5321},{"class":796},[],{"type":723,"nodeName":724,"attributes":5323,"children":5324},{"class":800},[5325,5329,5330,5338,5339,5348,5350,5354,5356,5362,5364,5373,5375,5379,5380,5384,5386],{"type":723,"nodeName":740,"attributes":5326,"children":5328},{"id":5327},"page-55",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5331,"children":5332},{"class":787},[5333,5337],{"type":723,"nodeName":731,"attributes":5334,"children":5335},{"href":812},[5336],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":5340,"children":5341},{"class":2512},[5342,5346],{"type":723,"nodeName":731,"attributes":5343,"children":5344},{"class":2434,"id":466,"href":1738},[5345],{"type":728,"textContent":1741},{"type":728,"textContent":5347},".  Access Tokens",{"type":728,"textContent":5349},"\n\n   Access token credentials (as well as any confidential access token\n   attributes) MUST be kept confidential in transit and storage, and\n   only shared among the authorization server, the resource servers the\n   access token is valid for, and the client to whom the access token is\n   issued.  Access token credentials MUST only be transmitted using TLS\n   as described in ",{"type":723,"nodeName":731,"attributes":5351,"children":5352},{"href":966},[5353],{"type":728,"textContent":3139},{"type":728,"textContent":5355}," with server authentication as defined by\n   [",{"type":723,"nodeName":731,"attributes":5357,"children":5359},{"href":5358},"\u002Finfo\u002Frfc2818\u002F",[5360],{"type":728,"textContent":5361},"RFC2818",{"type":728,"textContent":5363},"].\n\n   When using the implicit grant type, the access token is transmitted\n   in the URI fragment, which can expose it to unauthorized parties.\n\n   The authorization server MUST ensure that access tokens cannot be\n   generated, modified, or guessed to produce valid access tokens by\n   unauthorized parties.\n\n   The client SHOULD request access tokens with the minimal scope\n   necessary.  The authorization server SHOULD take the client identity\n   into account when choosing how to honor the requested scope and MAY\n   issue an access token with less rights than requested.\n\n   This specification does not provide any methods for the resource\n   server to ensure that an access token presented to it by a given\n   client was issued to that client by the authorization server.\n\n",{"type":723,"nodeName":740,"attributes":5365,"children":5366},{"class":2512},[5367,5371],{"type":723,"nodeName":731,"attributes":5368,"children":5369},{"class":2434,"id":471,"href":1753},[5370],{"type":728,"textContent":1756},{"type":728,"textContent":5372},".  Refresh Tokens",{"type":728,"textContent":5374},"\n\n   Authorization servers MAY issue refresh tokens to web application\n   clients and native application clients.\n\n   Refresh tokens MUST be kept confidential in transit and storage, and\n   shared only among the authorization server and the client to whom the\n   refresh tokens were issued.  The authorization server MUST maintain\n   the binding between a refresh token and the client to whom it was\n   issued.  Refresh tokens MUST only be transmitted using TLS as\n   described in ",{"type":723,"nodeName":731,"attributes":5376,"children":5377},{"href":966},[5378],{"type":728,"textContent":3139},{"type":728,"textContent":5355},{"type":723,"nodeName":731,"attributes":5381,"children":5382},{"href":5358},[5383],{"type":728,"textContent":5361},{"type":728,"textContent":5385},"].\n\n   The authorization server MUST verify the binding between the refresh\n   token and client identity whenever the client identity can be\n   authenticated.  When client authentication is not possible, the\n   authorization server SHOULD deploy other means to detect refresh\n   token abuse.\n\n   For example, the authorization server could employ refresh token\n   rotation in which a new refresh token is issued with every access\n   token refresh response.  The previous refresh token is invalidated\n\n\n\n",{"type":723,"nodeName":740,"attributes":5387,"children":5388},{"class":787},[5389],{"type":728,"textContent":5390},"Hardt                        Standards Track                   [Page 55]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5393,"children":5394},{"class":796},[],{"type":723,"nodeName":724,"attributes":5396,"children":5397},{"class":800},[5398,5402,5403,5411,5413,5422,5424,5433,5435],{"type":723,"nodeName":740,"attributes":5399,"children":5401},{"id":5400},"page-56",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5404,"children":5405},{"class":787},[5406,5410],{"type":723,"nodeName":731,"attributes":5407,"children":5408},{"href":812},[5409],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5412},"\n\n\n   but retained by the authorization server.  If a refresh token is\n   compromised and subsequently used by both the attacker and the\n   legitimate client, one of them will present an invalidated refresh\n   token, which will inform the authorization server of the breach.\n\n   The authorization server MUST ensure that refresh tokens cannot be\n   generated, modified, or guessed to produce valid refresh tokens by\n   unauthorized parties.\n\n",{"type":723,"nodeName":740,"attributes":5414,"children":5415},{"class":2512},[5416,5420],{"type":723,"nodeName":731,"attributes":5417,"children":5418},{"class":2434,"id":476,"href":1766},[5419],{"type":728,"textContent":1769},{"type":728,"textContent":5421},".  Authorization Codes",{"type":728,"textContent":5423},"\n\n   The transmission of authorization codes SHOULD be made over a secure\n   channel, and the client SHOULD require the use of TLS with its\n   redirection URI if the URI identifies a network resource.  Since\n   authorization codes are transmitted via user-agent redirections, they\n   could potentially be disclosed through user-agent history and HTTP\n   referrer headers.\n\n   Authorization codes operate as plaintext bearer credentials, used to\n   verify that the resource owner who granted authorization at the\n   authorization server is the same resource owner returning to the\n   client to complete the process.  Therefore, if the client relies on\n   the authorization code for its own resource owner authentication, the\n   client redirection endpoint MUST require the use of TLS.\n\n   Authorization codes MUST be short lived and single-use.  If the\n   authorization server observes multiple attempts to exchange an\n   authorization code for an access token, the authorization server\n   SHOULD attempt to revoke all access tokens already granted based on\n   the compromised authorization code.\n\n   If the client can be authenticated, the authorization servers MUST\n   authenticate the client and ensure that the authorization code was\n   issued to the same client.\n\n",{"type":723,"nodeName":740,"attributes":5425,"children":5426},{"class":2512},[5427,5431],{"type":723,"nodeName":731,"attributes":5428,"children":5429},{"class":2434,"id":481,"href":1781},[5430],{"type":728,"textContent":1784},{"type":728,"textContent":5432},".  Authorization Code Redirection URI Manipulation",{"type":728,"textContent":5434},"\n\n   When requesting authorization using the authorization code grant\n   type, the client can specify a redirection URI via the \"redirect_uri\"\n   parameter.  If an attacker can manipulate the value of the\n   redirection URI, it can cause the authorization server to redirect\n   the resource owner user-agent to a URI under the control of the\n   attacker with the authorization code.\n\n   An attacker can create an account at a legitimate client and initiate\n   the authorization flow.  When the attacker's user-agent is sent to\n   the authorization server to grant access, the attacker grabs the\n   authorization URI provided by the legitimate client and replaces the\n\n\n\n",{"type":723,"nodeName":740,"attributes":5436,"children":5437},{"class":787},[5438],{"type":728,"textContent":5439},"Hardt                        Standards Track                   [Page 56]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5442,"children":5443},{"class":796},[],{"type":723,"nodeName":724,"attributes":5445,"children":5446},{"class":800},[5447,5451,5452,5460,5462,5470,5472],{"type":723,"nodeName":740,"attributes":5448,"children":5450},{"id":5449},"page-57",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5453,"children":5454},{"class":787},[5455,5459],{"type":723,"nodeName":731,"attributes":5456,"children":5457},{"href":812},[5458],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5461},"\n\n\n   client's redirection URI with a URI under the control of the\n   attacker.  The attacker then tricks the victim into following the\n   manipulated link to authorize access to the legitimate client.\n\n   Once at the authorization server, the victim is prompted with a\n   normal, valid request on behalf of a legitimate and trusted client,\n   and authorizes the request.  The victim is then redirected to an\n   endpoint under the control of the attacker with the authorization\n   code.  The attacker completes the authorization flow by sending the\n   authorization code to the client using the original redirection URI\n   provided by the client.  The client exchanges the authorization code\n   with an access token and links it to the attacker's client account,\n   which can now gain access to the protected resources authorized by\n   the victim (via the client).\n\n   In order to prevent such an attack, the authorization server MUST\n   ensure that the redirection URI used to obtain the authorization code\n   is identical to the redirection URI provided when exchanging the\n   authorization code for an access token.  The authorization server\n   MUST require public clients and SHOULD require confidential clients\n   to register their redirection URIs.  If a redirection URI is provided\n   in the request, the authorization server MUST validate it against the\n   registered value.\n\n",{"type":723,"nodeName":740,"attributes":5463,"children":5464},{"class":2512},[5465,5469],{"type":723,"nodeName":731,"attributes":5466,"children":5467},{"class":2434,"id":486,"href":1794},[5468],{"type":728,"textContent":1797},{"type":728,"textContent":2682},{"type":728,"textContent":5471},"\n\n   The resource owner password credentials grant type is often used for\n   legacy or migration reasons.  It reduces the overall risk of storing\n   usernames and passwords by the client but does not eliminate the need\n   to expose highly privileged credentials to the client.\n\n   This grant type carries a higher risk than other grant types because\n   it maintains the password anti-pattern this protocol seeks to avoid.\n   The client could abuse the password, or the password could\n   unintentionally be disclosed to an attacker (e.g., via log files or\n   other records kept by the client).\n\n   Additionally, because the resource owner does not have control over\n   the authorization process (the resource owner's involvement ends when\n   it hands over its credentials to the client), the client can obtain\n   access tokens with a broader scope than desired by the resource\n   owner.  The authorization server should consider the scope and\n   lifetime of access tokens issued via this grant type.\n\n   The authorization server and client SHOULD minimize use of this grant\n   type and utilize other grant types whenever possible.\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":5473,"children":5474},{"class":787},[5475],{"type":728,"textContent":5476},"Hardt                        Standards Track                   [Page 57]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5479,"children":5480},{"class":796},[],{"type":723,"nodeName":724,"attributes":5482,"children":5483},{"class":800},[5484,5488,5489,5497,5498,5507,5509,5518,5520,5524,5526,5532,5534,5543,5545,5554,5556],{"type":723,"nodeName":740,"attributes":5485,"children":5487},{"id":5486},"page-58",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5490,"children":5491},{"class":787},[5492,5496],{"type":723,"nodeName":731,"attributes":5493,"children":5494},{"href":812},[5495],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":5499,"children":5500},{"class":2512},[5501,5505],{"type":723,"nodeName":731,"attributes":5502,"children":5503},{"class":2434,"id":491,"href":1809},[5504],{"type":728,"textContent":1812},{"type":728,"textContent":5506},".  Request Confidentiality",{"type":728,"textContent":5508},"\n\n   Access tokens, refresh tokens, resource owner passwords, and client\n   credentials MUST NOT be transmitted in the clear.  Authorization\n   codes SHOULD NOT be transmitted in the clear.\n\n   The \"state\" and \"scope\" parameters SHOULD NOT include sensitive\n   client or resource owner information in plain text, as they can be\n   transmitted over insecure channels or stored insecurely.\n\n",{"type":723,"nodeName":740,"attributes":5510,"children":5511},{"class":2512},[5512,5516],{"type":723,"nodeName":731,"attributes":5513,"children":5514},{"class":2434,"id":496,"href":1824},[5515],{"type":728,"textContent":1827},{"type":728,"textContent":5517},".  Ensuring Endpoint Authenticity",{"type":728,"textContent":5519},"\n\n   In order to prevent man-in-the-middle attacks, the authorization\n   server MUST require the use of TLS with server authentication as\n   defined by [",{"type":723,"nodeName":731,"attributes":5521,"children":5522},{"href":5358},[5523],{"type":728,"textContent":5361},{"type":728,"textContent":5525},"] for any request sent to the authorization and\n   token endpoints.  The client MUST validate the authorization server's\n   TLS certificate as defined by [",{"type":723,"nodeName":731,"attributes":5527,"children":5529},{"href":5528},"\u002Finfo\u002Frfc6125\u002F",[5530],{"type":728,"textContent":5531},"RFC6125",{"type":728,"textContent":5533},"] and in accordance with its\n   requirements for server identity authentication.\n\n",{"type":723,"nodeName":740,"attributes":5535,"children":5536},{"class":2512},[5537,5541],{"type":723,"nodeName":731,"attributes":5538,"children":5539},{"class":2434,"id":501,"href":1837},[5540],{"type":728,"textContent":1840},{"type":728,"textContent":5542},".  Credentials-Guessing Attacks",{"type":728,"textContent":5544},"\n\n   The authorization server MUST prevent attackers from guessing access\n   tokens, authorization codes, refresh tokens, resource owner\n   passwords, and client credentials.\n\n   The probability of an attacker guessing generated tokens (and other\n   credentials not intended for handling by end-users) MUST be less than\n   or equal to 2^(-128) and SHOULD be less than or equal to 2^(-160).\n\n   The authorization server MUST utilize other means to protect\n   credentials intended for end-user usage.\n\n",{"type":723,"nodeName":740,"attributes":5546,"children":5547},{"class":2512},[5548,5552],{"type":723,"nodeName":731,"attributes":5549,"children":5550},{"class":2434,"id":506,"href":1850},[5551],{"type":728,"textContent":1853},{"type":728,"textContent":5553},".  Phishing Attacks",{"type":728,"textContent":5555},"\n\n   Wide deployment of this and similar protocols may cause end-users to\n   become inured to the practice of being redirected to websites where\n   they are asked to enter their passwords.  If end-users are not\n   careful to verify the authenticity of these websites before entering\n   their credentials, it will be possible for attackers to exploit this\n   practice to steal resource owners' passwords.\n\n   Service providers should attempt to educate end-users about the risks\n   phishing attacks pose and should provide mechanisms that make it easy\n   for end-users to confirm the authenticity of their sites.  Client\n   developers should consider the security implications of how they\n   interact with the user-agent (e.g., external, embedded), and the\n   ability of the end-user to verify the authenticity of the\n   authorization server.\n\n\n\n",{"type":723,"nodeName":740,"attributes":5557,"children":5558},{"class":787},[5559],{"type":728,"textContent":5560},"Hardt                        Standards Track                   [Page 58]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5563,"children":5564},{"class":796},[],{"type":723,"nodeName":724,"attributes":5566,"children":5567},{"class":800},[5568,5572,5573,5581,5583,5592,5594,5599,5601],{"type":723,"nodeName":740,"attributes":5569,"children":5571},{"id":5570},"page-59",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5574,"children":5575},{"class":787},[5576,5580],{"type":723,"nodeName":731,"attributes":5577,"children":5578},{"href":812},[5579],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5582},"\n\n\n   To reduce the risk of phishing attacks, the authorization servers\n   MUST require the use of TLS on every endpoint used for end-user\n   interaction.\n\n",{"type":723,"nodeName":740,"attributes":5584,"children":5585},{"class":2512},[5586,5590],{"type":723,"nodeName":731,"attributes":5587,"children":5588},{"class":2434,"id":511,"href":1863},[5589],{"type":728,"textContent":1866},{"type":728,"textContent":5591},".  Cross-Site Request Forgery",{"type":728,"textContent":5593},"\n\n   Cross-site request forgery (CSRF) is an exploit in which an attacker\n   causes the user-agent of a victim end-user to follow a malicious URI\n   (e.g., provided to the user-agent as a misleading link, image, or\n   redirection) to a trusting server (usually established via the\n   presence of a valid session cookie).\n\n   A CSRF attack against the client's redirection URI allows an attacker\n   to inject its own authorization code or access token, which can\n   result in the client using an access token associated with the\n   attacker's protected resources rather than the victim's (e.g., save\n   the victim's bank account information to a protected resource\n   controlled by the attacker).\n\n   The client MUST implement CSRF protection for its redirection URI.\n   This is typically accomplished by requiring any request sent to the\n   redirection URI endpoint to include a value that binds the request to\n   the user-agent's authenticated state (e.g., a hash of the session\n   cookie used to authenticate the user-agent).  The client SHOULD\n   utilize the \"state\" request parameter to deliver this value to the\n   authorization server when making an authorization request.\n\n   Once authorization has been obtained from the end-user, the\n   authorization server redirects the end-user's user-agent back to the\n   client with the required binding value contained in the \"state\"\n   parameter.  The binding value enables the client to verify the\n   validity of the request by matching the binding value to the\n   user-agent's authenticated state.  The binding value used for CSRF\n   protection MUST contain a non-guessable value (as described in\n   ",{"type":723,"nodeName":731,"attributes":5595,"children":5596},{"href":1837},[5597],{"type":728,"textContent":5598},"Section 10.10",{"type":728,"textContent":5600},"), and the user-agent's authenticated state (e.g.,\n   session cookie, HTML5 local storage) MUST be kept in a location\n   accessible only to the client and the user-agent (i.e., protected by\n   same-origin policy).\n\n   A CSRF attack against the authorization server's authorization\n   endpoint can result in an attacker obtaining end-user authorization\n   for a malicious client without involving or alerting the end-user.\n\n   The authorization server MUST implement CSRF protection for its\n   authorization endpoint and ensure that a malicious client cannot\n   obtain authorization without the awareness and explicit consent of\n   the resource owner.\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":5602,"children":5603},{"class":787},[5604],{"type":728,"textContent":5605},"Hardt                        Standards Track                   [Page 59]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5608,"children":5609},{"class":796},[],{"type":723,"nodeName":724,"attributes":5611,"children":5612},{"class":800},[5613,5617,5618,5626,5627,5636,5638,5647,5649,5658,5660],{"type":723,"nodeName":740,"attributes":5614,"children":5616},{"id":5615},"page-60",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5619,"children":5620},{"class":787},[5621,5625],{"type":723,"nodeName":731,"attributes":5622,"children":5623},{"href":812},[5624],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":5628,"children":5629},{"class":2512},[5630,5634],{"type":723,"nodeName":731,"attributes":5631,"children":5632},{"class":2434,"id":516,"href":1878},[5633],{"type":728,"textContent":1881},{"type":728,"textContent":5635},".  Clickjacking",{"type":728,"textContent":5637},"\n\n   In a clickjacking attack, an attacker registers a legitimate client\n   and then constructs a malicious site in which it loads the\n   authorization server's authorization endpoint web page in a\n   transparent iframe overlaid on top of a set of dummy buttons, which\n   are carefully constructed to be placed directly under important\n   buttons on the authorization page.  When an end-user clicks a\n   misleading visible button, the end-user is actually clicking an\n   invisible button on the authorization page (such as an \"Authorize\"\n   button).  This allows an attacker to trick a resource owner into\n   granting its client access without the end-user's knowledge.\n\n   To prevent this form of attack, native applications SHOULD use\n   external browsers instead of embedding browsers within the\n   application when requesting end-user authorization.  For most newer\n   browsers, avoidance of iframes can be enforced by the authorization\n   server using the (non-standard) \"x-frame-options\" header.  This\n   header can have two values, \"deny\" and \"sameorigin\", which will block\n   any framing, or framing by sites with a different origin,\n   respectively.  For older browsers, JavaScript frame-busting\n   techniques can be used but may not be effective in all browsers.\n\n",{"type":723,"nodeName":740,"attributes":5639,"children":5640},{"class":2512},[5641,5645],{"type":723,"nodeName":731,"attributes":5642,"children":5643},{"class":2434,"id":521,"href":1893},[5644],{"type":728,"textContent":1896},{"type":728,"textContent":5646},".  Code Injection and Input Validation",{"type":728,"textContent":5648},"\n\n   A code injection attack occurs when an input or otherwise external\n   variable is used by an application unsanitized and causes\n   modification to the application logic.  This may allow an attacker to\n   gain access to the application device or its data, cause denial of\n   service, or introduce a wide range of malicious side-effects.\n\n   The authorization server and client MUST sanitize (and validate when\n   possible) any value received -- in particular, the value of the\n   \"state\" and \"redirect_uri\" parameters.\n\n",{"type":723,"nodeName":740,"attributes":5650,"children":5651},{"class":2512},[5652,5656],{"type":723,"nodeName":731,"attributes":5653,"children":5654},{"class":2434,"id":526,"href":1906},[5655],{"type":728,"textContent":1909},{"type":728,"textContent":5657},".  Open Redirectors",{"type":728,"textContent":5659},"\n\n   The authorization server, authorization endpoint, and client\n   redirection endpoint can be improperly configured and operate as open\n   redirectors.  An open redirector is an endpoint using a parameter to\n   automatically redirect a user-agent to the location specified by the\n   parameter value without any validation.\n\n   Open redirectors can be used in phishing attacks, or by an attacker\n   to get end-users to visit malicious sites by using the URI authority\n   component of a familiar and trusted destination.  In addition, if the\n   authorization server allows the client to register only part of the\n   redirection URI, an attacker can use an open redirector operated by\n\n\n\n",{"type":723,"nodeName":740,"attributes":5661,"children":5662},{"class":787},[5663],{"type":728,"textContent":5664},"Hardt                        Standards Track                   [Page 60]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5667,"children":5668},{"class":796},[],{"type":723,"nodeName":724,"attributes":5670,"children":5671},{"class":800},[5672,5676,5677,5685,5687,5696,5697,5701,5703],{"type":723,"nodeName":740,"attributes":5673,"children":5675},{"id":5674},"page-61",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5678,"children":5679},{"class":787},[5680,5684],{"type":723,"nodeName":731,"attributes":5681,"children":5682},{"href":812},[5683],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5686},"\n\n\n   the client to construct a redirection URI that will pass the\n   authorization server validation but will send the authorization code\n   or access token to an endpoint under the control of the attacker.\n\n",{"type":723,"nodeName":740,"attributes":5688,"children":5689},{"class":2512},[5690,5694],{"type":723,"nodeName":731,"attributes":5691,"children":5692},{"class":2434,"id":531,"href":2668},[5693],{"type":728,"textContent":2671},{"type":728,"textContent":5695},".  Misuse of Access Token to Impersonate Resource Owner in Implicit",{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5698,"children":5699},{"class":2512,"id":536},[5700],{"type":728,"textContent":537},{"type":728,"textContent":5702},"\n\n   For public clients using implicit flows, this specification does not\n   provide any method for the client to determine what client an access\n   token was issued to.\n\n   A resource owner may willingly delegate access to a resource by\n   granting an access token to an attacker's malicious client.  This may\n   be due to phishing or some other pretext.  An attacker may also steal\n   a token via some other mechanism.  An attacker may then attempt to\n   impersonate the resource owner by providing the access token to a\n   legitimate public client.\n\n   In the implicit flow (response_type=token), the attacker can easily\n   switch the token in the response from the authorization server,\n   replacing the real access token with the one previously issued to the\n   attacker.\n\n   Servers communicating with native applications that rely on being\n   passed an access token in the back channel to identify the user of\n   the client may be similarly compromised by an attacker creating a\n   compromised application that can inject arbitrary stolen access\n   tokens.\n\n   Any public client that makes the assumption that only the resource\n   owner can present it with a valid access token for the resource is\n   vulnerable to this type of attack.\n\n   This type of attack may expose information about the resource owner\n   at the legitimate client to the attacker (malicious client).  This\n   will also allow the attacker to perform operations at the legitimate\n   client with the same permissions as the resource owner who originally\n   granted the access token or authorization code.\n\n   Authenticating resource owners to clients is out of scope for this\n   specification.  Any specification that uses the authorization process\n   as a form of delegated end-user authentication to the client (e.g.,\n   third-party sign-in service) MUST NOT use the implicit flow without\n   additional security mechanisms that would enable the client to\n   determine if the access token was issued for its use (e.g., audience-\n   restricting the access token).\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":5704,"children":5705},{"class":787},[5706],{"type":728,"textContent":5707},"Hardt                        Standards Track                   [Page 61]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5710,"children":5711},{"class":796},[],{"type":723,"nodeName":724,"attributes":5713,"children":5714},{"class":800},[5715,5719,5720,5728,5729,5738,5739,5748,5750,5756,5758,5767,5769,5773,5775],{"type":723,"nodeName":740,"attributes":5716,"children":5718},{"id":5717},"page-62",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5721,"children":5722},{"class":787},[5723,5727],{"type":723,"nodeName":731,"attributes":5724,"children":5725},{"href":812},[5726],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":5730,"children":5731},{"class":2430},[5732,5736],{"type":723,"nodeName":731,"attributes":5733,"children":5734},{"class":2434,"id":541,"href":1927},[5735],{"type":728,"textContent":1930},{"type":728,"textContent":5737},".  IANA Considerations",{"type":728,"textContent":2427},{"type":723,"nodeName":740,"attributes":5740,"children":5741},{"class":2512},[5742,5746],{"type":723,"nodeName":731,"attributes":5743,"children":5744},{"class":2434,"id":547,"href":1942},[5745],{"type":728,"textContent":1945},{"type":728,"textContent":5747},".  OAuth Access Token Types Registry",{"type":728,"textContent":5749},"\n\n   This specification establishes the OAuth Access Token Types registry.\n\n   Access token types are registered with a Specification Required\n   ([",{"type":723,"nodeName":731,"attributes":5751,"children":5753},{"href":5752},"\u002Finfo\u002Frfc5226\u002F",[5754],{"type":728,"textContent":5755},"RFC5226",{"type":728,"textContent":5757},"]) after a two-week review period on the\n   oauth-ext-review@ietf.org mailing list, on the advice of one or more\n   Designated Experts.  However, to allow for the allocation of values\n   prior to publication, the Designated Expert(s) may approve\n   registration once they are satisfied that such a specification will\n   be published.\n\n   Registration requests must be sent to the oauth-ext-review@ietf.org\n   mailing list for review and comment, with an appropriate subject\n   (e.g., \"Request for access token type: example\").\n\n   Within the review period, the Designated Expert(s) will either\n   approve or deny the registration request, communicating this decision\n   to the review list and IANA.  Denials should include an explanation\n   and, if applicable, suggestions as to how to make the request\n   successful.\n\n   IANA must only accept registry updates from the Designated Expert(s)\n   and should direct all requests for registration to the review mailing\n   list.\n\n",{"type":723,"nodeName":740,"attributes":5759,"children":5760},{"class":2606},[5761,5765],{"type":723,"nodeName":731,"attributes":5762,"children":5763},{"class":2434,"id":553,"href":1955},[5764],{"type":728,"textContent":1958},{"type":728,"textContent":5766},".  Registration Template",{"type":728,"textContent":5768},"\n\n   Type name:\n      The name requested (e.g., \"example\").\n\n   Additional Token Endpoint Response Parameters:\n      Additional response parameters returned together with the\n      \"access_token\" parameter.  New parameters MUST be separately\n      registered in the OAuth Parameters registry as described by\n      ",{"type":723,"nodeName":731,"attributes":5770,"children":5771},{"href":1968},[5772],{"type":728,"textContent":5069},{"type":728,"textContent":5774},".\n\n   HTTP Authentication Scheme(s):\n      The HTTP authentication scheme name(s), if any, used to\n      authenticate protected resource requests using access tokens of\n      this type.\n\n   Change controller:\n      For Standards Track RFCs, state \"IETF\".  For others, give the name\n      of the responsible party.  Other details (e.g., postal address,\n      email address, home page URI) may also be included.\n\n\n\n",{"type":723,"nodeName":740,"attributes":5776,"children":5777},{"class":787},[5778],{"type":728,"textContent":5779},"Hardt                        Standards Track                   [Page 62]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5782,"children":5783},{"class":796},[],{"type":723,"nodeName":724,"attributes":5785,"children":5786},{"class":800},[5787,5791,5792,5800,5802,5811,5813,5817,5819,5827,5829],{"type":723,"nodeName":740,"attributes":5788,"children":5790},{"id":5789},"page-63",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5793,"children":5794},{"class":787},[5795,5799],{"type":723,"nodeName":731,"attributes":5796,"children":5797},{"href":812},[5798],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5801},"\n\n\n   Specification document(s):\n      Reference to the document(s) that specify the parameter,\n      preferably including a URI that can be used to retrieve a copy of\n      the document(s).  An indication of the relevant sections may also\n      be included but is not required.\n\n",{"type":723,"nodeName":740,"attributes":5803,"children":5804},{"class":2512},[5805,5809],{"type":723,"nodeName":731,"attributes":5806,"children":5807},{"class":2434,"id":558,"href":1968},[5808],{"type":728,"textContent":1971},{"type":728,"textContent":5810},".  OAuth Parameters Registry",{"type":728,"textContent":5812},"\n\n   This specification establishes the OAuth Parameters registry.\n\n   Additional parameters for inclusion in the authorization endpoint\n   request, the authorization endpoint response, the token endpoint\n   request, or the token endpoint response are registered with a\n   Specification Required ([",{"type":723,"nodeName":731,"attributes":5814,"children":5815},{"href":5752},[5816],{"type":728,"textContent":5755},{"type":728,"textContent":5818},"]) after a two-week review period on\n   the oauth-ext-review@ietf.org mailing list, on the advice of one or\n   more Designated Experts.  However, to allow for the allocation of\n   values prior to publication, the Designated Expert(s) may approve\n   registration once they are satisfied that such a specification will\n   be published.\n\n   Registration requests must be sent to the oauth-ext-review@ietf.org\n   mailing list for review and comment, with an appropriate subject\n   (e.g., \"Request for parameter: example\").\n\n   Within the review period, the Designated Expert(s) will either\n   approve or deny the registration request, communicating this decision\n   to the review list and IANA.  Denials should include an explanation\n   and, if applicable, suggestions as to how to make the request\n   successful.\n\n   IANA must only accept registry updates from the Designated Expert(s)\n   and should direct all requests for registration to the review mailing\n   list.\n\n",{"type":723,"nodeName":740,"attributes":5820,"children":5821},{"class":2606},[5822,5826],{"type":723,"nodeName":731,"attributes":5823,"children":5824},{"class":2434,"id":564,"href":1983},[5825],{"type":728,"textContent":1986},{"type":728,"textContent":5766},{"type":728,"textContent":5828},"\n\n   Parameter name:\n      The name requested (e.g., \"example\").\n\n   Parameter usage location:\n      The location(s) where parameter can be used.  The possible\n      locations are authorization request, authorization response, token\n      request, or token response.\n\n   Change controller:\n      For Standards Track RFCs, state \"IETF\".  For others, give the name\n      of the responsible party.  Other details (e.g., postal address,\n      email address, home page URI) may also be included.\n\n\n\n",{"type":723,"nodeName":740,"attributes":5830,"children":5831},{"class":787},[5832],{"type":728,"textContent":5833},"Hardt                        Standards Track                   [Page 63]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5836,"children":5837},{"class":796},[],{"type":723,"nodeName":724,"attributes":5839,"children":5840},{"class":800},[5841,5845,5846,5854,5855,5864,5866,5870,5872,5876,5878,5882,5884,5888,5890,5894,5896,5900,5902,5906,5907],{"type":723,"nodeName":740,"attributes":5842,"children":5844},{"id":5843},"page-64",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5847,"children":5848},{"class":787},[5849,5853],{"type":723,"nodeName":731,"attributes":5850,"children":5851},{"href":812},[5852],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5801},{"type":723,"nodeName":740,"attributes":5856,"children":5857},{"class":2606},[5858,5862],{"type":723,"nodeName":731,"attributes":5859,"children":5860},{"class":2434,"id":569,"href":1995},[5861],{"type":728,"textContent":1998},{"type":728,"textContent":5863},".  Initial Registry Contents",{"type":728,"textContent":5865},"\n\n   The OAuth Parameters registry's initial contents are:\n\n   o  Parameter name: client_id\n   o  Parameter usage location: authorization request, token request\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5867,"children":5868},{"href":812},[5869],{"type":728,"textContent":815},{"type":728,"textContent":5871},"\n\n   o  Parameter name: client_secret\n   o  Parameter usage location: token request\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5873,"children":5874},{"href":812},[5875],{"type":728,"textContent":815},{"type":728,"textContent":5877},"\n\n   o  Parameter name: response_type\n   o  Parameter usage location: authorization request\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5879,"children":5880},{"href":812},[5881],{"type":728,"textContent":815},{"type":728,"textContent":5883},"\n\n   o  Parameter name: redirect_uri\n   o  Parameter usage location: authorization request, token request\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5885,"children":5886},{"href":812},[5887],{"type":728,"textContent":815},{"type":728,"textContent":5889},"\n\n   o  Parameter name: scope\n   o  Parameter usage location: authorization request, authorization\n      response, token request, token response\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5891,"children":5892},{"href":812},[5893],{"type":728,"textContent":815},{"type":728,"textContent":5895},"\n\n   o  Parameter name: state\n   o  Parameter usage location: authorization request, authorization\n      response\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5897,"children":5898},{"href":812},[5899],{"type":728,"textContent":815},{"type":728,"textContent":5901},"\n\n   o  Parameter name: code\n   o  Parameter usage location: authorization response, token request\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5903,"children":5904},{"href":812},[5905],{"type":728,"textContent":815},{"type":728,"textContent":2116},{"type":723,"nodeName":740,"attributes":5908,"children":5909},{"class":787},[5910],{"type":728,"textContent":5911},"Hardt                        Standards Track                   [Page 64]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5914,"children":5915},{"class":796},[],{"type":723,"nodeName":724,"attributes":5917,"children":5918},{"class":800},[5919,5923,5924,5932,5934,5938,5940,5944,5946,5950,5952,5956,5958,5962,5964,5968,5970,5974,5976,5980,5982,5986,5988],{"type":723,"nodeName":740,"attributes":5920,"children":5922},{"id":5921},"page-65",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":5925,"children":5926},{"class":787},[5927,5931],{"type":723,"nodeName":731,"attributes":5928,"children":5929},{"href":812},[5930],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":5933},"\n\n\n   o  Parameter name: error_description\n   o  Parameter usage location: authorization response, token response\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5935,"children":5936},{"href":812},[5937],{"type":728,"textContent":815},{"type":728,"textContent":5939},"\n\n   o  Parameter name: error_uri\n   o  Parameter usage location: authorization response, token response\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5941,"children":5942},{"href":812},[5943],{"type":728,"textContent":815},{"type":728,"textContent":5945},"\n\n   o  Parameter name: grant_type\n   o  Parameter usage location: token request\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5947,"children":5948},{"href":812},[5949],{"type":728,"textContent":815},{"type":728,"textContent":5951},"\n\n   o  Parameter name: access_token\n   o  Parameter usage location: authorization response, token response\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5953,"children":5954},{"href":812},[5955],{"type":728,"textContent":815},{"type":728,"textContent":5957},"\n\n   o  Parameter name: token_type\n   o  Parameter usage location: authorization response, token response\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5959,"children":5960},{"href":812},[5961],{"type":728,"textContent":815},{"type":728,"textContent":5963},"\n\n   o  Parameter name: expires_in\n   o  Parameter usage location: authorization response, token response\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5965,"children":5966},{"href":812},[5967],{"type":728,"textContent":815},{"type":728,"textContent":5969},"\n\n   o  Parameter name: username\n   o  Parameter usage location: token request\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5971,"children":5972},{"href":812},[5973],{"type":728,"textContent":815},{"type":728,"textContent":5975},"\n\n   o  Parameter name: password\n   o  Parameter usage location: token request\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5977,"children":5978},{"href":812},[5979],{"type":728,"textContent":815},{"type":728,"textContent":5981},"\n\n   o  Parameter name: refresh_token\n   o  Parameter usage location: token request, token response\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":5983,"children":5984},{"href":812},[5985],{"type":728,"textContent":815},{"type":728,"textContent":5987},"\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":5989,"children":5990},{"class":787},[5991],{"type":728,"textContent":5992},"Hardt                        Standards Track                   [Page 65]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":5995,"children":5996},{"class":796},[],{"type":723,"nodeName":724,"attributes":5998,"children":5999},{"class":800},[6000,6004,6005,6013,6014,6023,6025,6029,6031,6039,6041],{"type":723,"nodeName":740,"attributes":6001,"children":6003},{"id":6002},"page-66",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":6006,"children":6007},{"class":787},[6008,6012],{"type":723,"nodeName":731,"attributes":6009,"children":6010},{"href":812},[6011],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":6015,"children":6016},{"class":2512},[6017,6021],{"type":723,"nodeName":731,"attributes":6018,"children":6019},{"class":2434,"id":574,"href":2010},[6020],{"type":728,"textContent":2013},{"type":728,"textContent":6022},".  OAuth Authorization Endpoint Response Types Registry",{"type":728,"textContent":6024},"\n\n   This specification establishes the OAuth Authorization Endpoint\n   Response Types registry.\n\n   Additional response types for use with the authorization endpoint are\n   registered with a Specification Required ([",{"type":723,"nodeName":731,"attributes":6026,"children":6027},{"href":5752},[6028],{"type":728,"textContent":5755},{"type":728,"textContent":6030},"]) after a two-week\n   review period on the oauth-ext-review@ietf.org mailing list, on the\n   advice of one or more Designated Experts.  However, to allow for the\n   allocation of values prior to publication, the Designated Expert(s)\n   may approve registration once they are satisfied that such a\n   specification will be published.\n\n   Registration requests must be sent to the oauth-ext-review@ietf.org\n   mailing list for review and comment, with an appropriate subject\n   (e.g., \"Request for response type: example\").\n\n   Within the review period, the Designated Expert(s) will either\n   approve or deny the registration request, communicating this decision\n   to the review list and IANA.  Denials should include an explanation\n   and, if applicable, suggestions as to how to make the request\n   successful.\n\n   IANA must only accept registry updates from the Designated Expert(s)\n   and should direct all requests for registration to the review mailing\n   list.\n\n",{"type":723,"nodeName":740,"attributes":6032,"children":6033},{"class":2606},[6034,6038],{"type":723,"nodeName":731,"attributes":6035,"children":6036},{"class":2434,"id":580,"href":2025},[6037],{"type":728,"textContent":2028},{"type":728,"textContent":5766},{"type":728,"textContent":6040},"\n\n   Response type name:\n      The name requested (e.g., \"example\").\n\n   Change controller:\n      For Standards Track RFCs, state \"IETF\".  For others, give the name\n      of the responsible party.  Other details (e.g., postal address,\n      email address, home page URI) may also be included.\n\n   Specification document(s):\n      Reference to the document(s) that specify the type, preferably\n      including a URI that can be used to retrieve a copy of the\n      document(s).  An indication of the relevant sections may also be\n      included but is not required.\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":6042,"children":6043},{"class":787},[6044],{"type":728,"textContent":6045},"Hardt                        Standards Track                   [Page 66]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":6048,"children":6049},{"class":796},[],{"type":723,"nodeName":724,"attributes":6051,"children":6052},{"class":800},[6053,6057,6058,6066,6067,6075,6077,6081,6083,6087,6088,6097,6099,6103,6105],{"type":723,"nodeName":740,"attributes":6054,"children":6056},{"id":6055},"page-67",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":6059,"children":6060},{"class":787},[6061,6065],{"type":723,"nodeName":731,"attributes":6062,"children":6063},{"href":812},[6064],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":6068,"children":6069},{"class":2606},[6070,6074],{"type":723,"nodeName":731,"attributes":6071,"children":6072},{"class":2434,"id":585,"href":2037},[6073],{"type":728,"textContent":2040},{"type":728,"textContent":5863},{"type":728,"textContent":6076},"\n\n   The OAuth Authorization Endpoint Response Types registry's initial\n   contents are:\n\n   o  Response type name: code\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":6078,"children":6079},{"href":812},[6080],{"type":728,"textContent":815},{"type":728,"textContent":6082},"\n\n   o  Response type name: token\n   o  Change controller: IETF\n   o  Specification document(s): ",{"type":723,"nodeName":731,"attributes":6084,"children":6085},{"href":812},[6086],{"type":728,"textContent":815},{"type":728,"textContent":2427},{"type":723,"nodeName":740,"attributes":6089,"children":6090},{"class":2512},[6091,6095],{"type":723,"nodeName":731,"attributes":6092,"children":6093},{"class":2434,"id":590,"href":2051},[6094],{"type":728,"textContent":2054},{"type":728,"textContent":6096},".  OAuth Extensions Error Registry",{"type":728,"textContent":6098},"\n\n   This specification establishes the OAuth Extensions Error registry.\n\n   Additional error codes used together with other protocol extensions\n   (i.e., extension grant types, access token types, or extension\n   parameters) are registered with a Specification Required ([",{"type":723,"nodeName":731,"attributes":6100,"children":6101},{"href":5752},[6102],{"type":728,"textContent":5755},{"type":728,"textContent":6104},"])\n   after a two-week review period on the oauth-ext-review@ietf.org\n   mailing list, on the advice of one or more Designated Experts.\n   However, to allow for the allocation of values prior to publication,\n   the Designated Expert(s) may approve registration once they are\n   satisfied that such a specification will be published.\n\n   Registration requests must be sent to the oauth-ext-review@ietf.org\n   mailing list for review and comment, with an appropriate subject\n   (e.g., \"Request for error code: example\").\n\n   Within the review period, the Designated Expert(s) will either\n   approve or deny the registration request, communicating this decision\n   to the review list and IANA.  Denials should include an explanation\n   and, if applicable, suggestions as to how to make the request\n   successful.\n\n   IANA must only accept registry updates from the Designated Expert(s)\n   and should direct all requests for registration to the review mailing\n   list.\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":6106,"children":6107},{"class":787},[6108],{"type":728,"textContent":6109},"Hardt                        Standards Track                   [Page 67]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":6112,"children":6113},{"class":796},[],{"type":723,"nodeName":724,"attributes":6115,"children":6116},{"class":800},[6117,6121,6122,6130,6131,6139,6141,6145,6147,6151,6153,6157,6159,6163,6165,6174,6175,6184,6186,6191,6193,6199,6201,6206,6208,6213,6215,6220,6222,6227,6229,6234,6236,6241,6243,6248,6250],{"type":723,"nodeName":740,"attributes":6118,"children":6120},{"id":6119},"page-68",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":6123,"children":6124},{"class":787},[6125,6129],{"type":723,"nodeName":731,"attributes":6126,"children":6127},{"href":812},[6128],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":6132,"children":6133},{"class":2606},[6134,6138],{"type":723,"nodeName":731,"attributes":6135,"children":6136},{"class":2434,"id":596,"href":2064},[6137],{"type":728,"textContent":2067},{"type":728,"textContent":5766},{"type":728,"textContent":6140},"\n\n   Error name:\n      The name requested (e.g., \"example\").  Values for the error name\n      MUST NOT include characters outside the set %x20-21 \u002F %x23-5B \u002F\n      %x5D-7E.\n\n   Error usage location:\n      The location(s) where the error can be used.  The possible\n      locations are authorization code grant error response\n      (",{"type":723,"nodeName":731,"attributes":6142,"children":6143},{"href":3299},[6144],{"type":728,"textContent":3302},{"type":728,"textContent":6146},"), implicit grant error response\n      (",{"type":723,"nodeName":731,"attributes":6148,"children":6149},{"href":4238},[6150],{"type":728,"textContent":5154},{"type":728,"textContent":6152},"), token error response (",{"type":723,"nodeName":731,"attributes":6154,"children":6155},{"href":1531},[6156],{"type":728,"textContent":3957},{"type":728,"textContent":6158},"), or resource\n      access error response (",{"type":723,"nodeName":731,"attributes":6160,"children":6161},{"href":1589},[6162],{"type":728,"textContent":5167},{"type":728,"textContent":6164},").\n\n   Related protocol extension:\n      The name of the extension grant type, access token type, or\n      extension parameter that the error code is used in conjunction\n      with.\n\n   Change controller:\n      For Standards Track RFCs, state \"IETF\".  For others, give the name\n      of the responsible party.  Other details (e.g., postal address,\n      email address, home page URI) may also be included.\n\n   Specification document(s):\n      Reference to the document(s) that specify the error code,\n      preferably including a URI that can be used to retrieve a copy of\n      the document(s).  An indication of the relevant sections may also\n      be included but is not required.\n\n",{"type":723,"nodeName":740,"attributes":6166,"children":6167},{"class":2430},[6168,6172],{"type":723,"nodeName":731,"attributes":6169,"children":6170},{"class":2434,"id":601,"href":2078},[6171],{"type":728,"textContent":977},{"type":728,"textContent":6173},".  References",{"type":728,"textContent":2427},{"type":723,"nodeName":740,"attributes":6176,"children":6177},{"class":2512},[6178,6182],{"type":723,"nodeName":731,"attributes":6179,"children":6180},{"class":2434,"id":607,"href":2090},[6181],{"type":728,"textContent":2093},{"type":728,"textContent":6183},".  Normative References",{"type":728,"textContent":6185},"\n\n   [",{"type":723,"nodeName":731,"attributes":6187,"children":6189},{"id":6188},"ref-RFC2119",[6190],{"type":728,"textContent":2904},{"type":728,"textContent":6192},"]  Bradner, S., \"Key words for use in RFCs to Indicate\n              Requirement Levels\", ",{"type":723,"nodeName":731,"attributes":6194,"children":6196},{"href":6195},"\u002Fbcp\u002Fbcp14",[6197],{"type":728,"textContent":6198},"BCP 14",{"type":728,"textContent":6200},", ",{"type":723,"nodeName":731,"attributes":6202,"children":6203},{"href":2901},[6204],{"type":728,"textContent":6205},"RFC 2119",{"type":728,"textContent":6207},", March 1997.\n\n   [",{"type":723,"nodeName":731,"attributes":6209,"children":6211},{"id":6210},"ref-RFC2246",[6212],{"type":728,"textContent":2836},{"type":728,"textContent":6214},"]  Dierks, T. and C. Allen, \"The TLS Protocol Version 1.0\",\n              ",{"type":723,"nodeName":731,"attributes":6216,"children":6217},{"href":2833},[6218],{"type":728,"textContent":6219},"RFC 2246",{"type":728,"textContent":6221},", January 1999.\n\n   [",{"type":723,"nodeName":731,"attributes":6223,"children":6225},{"id":6224},"ref-RFC2616",[6226],{"type":728,"textContent":2473},{"type":728,"textContent":6228},"]  Fielding, R., Gettys, J., Mogul, J., Frystyk, H.,\n              Masinter, L., Leach, P., and T. Berners-Lee, \"Hypertext\n              Transfer Protocol -- HTTP\u002F1.1\", ",{"type":723,"nodeName":731,"attributes":6230,"children":6231},{"href":2470},[6232],{"type":728,"textContent":6233},"RFC 2616",{"type":728,"textContent":6235},", June 1999.\n\n   [",{"type":723,"nodeName":731,"attributes":6237,"children":6239},{"id":6238},"ref-RFC2617",[6240],{"type":728,"textContent":3085},{"type":728,"textContent":6242},"]  Franks, J., Hallam-Baker, P., Hostetler, J., Lawrence, S.,\n              Leach, P., Luotonen, A., and L. Stewart, \"HTTP\n              Authentication: Basic and Digest Access Authentication\",\n              ",{"type":723,"nodeName":731,"attributes":6244,"children":6245},{"href":3082},[6246],{"type":728,"textContent":6247},"RFC 2617",{"type":728,"textContent":6249},", June 1999.\n\n\n\n",{"type":723,"nodeName":740,"attributes":6251,"children":6252},{"class":787},[6253],{"type":728,"textContent":6254},"Hardt                        Standards Track                   [Page 68]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":6257,"children":6258},{"class":796},[],{"type":723,"nodeName":724,"attributes":6260,"children":6261},{"class":800},[6262,6266,6267,6275,6277,6282,6284,6289,6291,6297,6299,6305,6307,6312,6314,6319,6321,6326,6328,6333,6335,6340,6342,6347,6349,6354,6356,6362,6363,6368,6370,6375,6377,6382,6384,6389,6391,6396,6398,6403,6405,6410,6412,6417,6419,6425,6427,6432,6434,6440,6442,6447,6449],{"type":723,"nodeName":740,"attributes":6263,"children":6265},{"id":6264},"page-69",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":6268,"children":6269},{"class":787},[6270,6274],{"type":723,"nodeName":731,"attributes":6271,"children":6272},{"href":812},[6273],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":6276},"\n\n\n   [",{"type":723,"nodeName":731,"attributes":6278,"children":6280},{"id":6279},"ref-RFC2818",[6281],{"type":728,"textContent":5361},{"type":728,"textContent":6283},"]  Rescorla, E., \"HTTP Over TLS\", ",{"type":723,"nodeName":731,"attributes":6285,"children":6286},{"href":5358},[6287],{"type":728,"textContent":6288},"RFC 2818",{"type":728,"textContent":6290},", May 2000.\n\n   [",{"type":723,"nodeName":731,"attributes":6292,"children":6294},{"id":6293},"ref-RFC3629",[6295],{"type":728,"textContent":6296},"RFC3629",{"type":728,"textContent":6298},"]  Yergeau, F., \"UTF-8, a transformation format of\n              ISO 10646\", STD 63, ",{"type":723,"nodeName":731,"attributes":6300,"children":6302},{"href":6301},"\u002Finfo\u002Frfc3629\u002F",[6303],{"type":728,"textContent":6304},"RFC 3629",{"type":728,"textContent":6306},", November 2003.\n\n   [",{"type":723,"nodeName":731,"attributes":6308,"children":6310},{"id":6309},"ref-RFC3986",[6311],{"type":728,"textContent":2920},{"type":728,"textContent":6313},"]  Berners-Lee, T., Fielding, R., and L. Masinter, \"Uniform\n              Resource Identifier (URI): Generic Syntax\", STD 66,\n              ",{"type":723,"nodeName":731,"attributes":6315,"children":6316},{"href":2917},[6317],{"type":728,"textContent":6318},"RFC 3986",{"type":728,"textContent":6320},", January 2005.\n\n   [",{"type":723,"nodeName":731,"attributes":6322,"children":6324},{"id":6323},"ref-RFC4627",[6325],{"type":728,"textContent":4700},{"type":728,"textContent":6327},"]  Crockford, D., \"The application\u002Fjson Media Type for\n              JavaScript Object Notation (JSON)\", ",{"type":723,"nodeName":731,"attributes":6329,"children":6330},{"href":4697},[6331],{"type":728,"textContent":6332},"RFC 4627",{"type":728,"textContent":6334},", July 2006.\n\n   [",{"type":723,"nodeName":731,"attributes":6336,"children":6338},{"id":6337},"ref-RFC4949",[6339],{"type":728,"textContent":2928},{"type":728,"textContent":6341},"]  Shirey, R., \"Internet Security Glossary, Version 2\",\n              ",{"type":723,"nodeName":731,"attributes":6343,"children":6344},{"href":2925},[6345],{"type":728,"textContent":6346},"RFC 4949",{"type":728,"textContent":6348},", August 2007.\n\n   [",{"type":723,"nodeName":731,"attributes":6350,"children":6352},{"id":6351},"ref-RFC5226",[6353],{"type":728,"textContent":5755},{"type":728,"textContent":6355},"]  Narten, T. and H. Alvestrand, \"Guidelines for Writing an\n              IANA Considerations Section in RFCs\", ",{"type":723,"nodeName":731,"attributes":6357,"children":6359},{"href":6358},"\u002Fbcp\u002Fbcp26",[6360],{"type":728,"textContent":6361},"BCP 26",{"type":728,"textContent":6200},{"type":723,"nodeName":731,"attributes":6364,"children":6365},{"href":5752},[6366],{"type":728,"textContent":6367},"RFC 5226",{"type":728,"textContent":6369},",\n              May 2008.\n\n   [",{"type":723,"nodeName":731,"attributes":6371,"children":6373},{"id":6372},"ref-RFC5234",[6374],{"type":728,"textContent":2912},{"type":728,"textContent":6376},"]  Crocker, D. and P. Overell, \"Augmented BNF for Syntax\n              Specifications: ABNF\", STD 68, ",{"type":723,"nodeName":731,"attributes":6378,"children":6379},{"href":2909},[6380],{"type":728,"textContent":6381},"RFC 5234",{"type":728,"textContent":6383},", January 2008.\n\n   [",{"type":723,"nodeName":731,"attributes":6385,"children":6387},{"id":6386},"ref-RFC5246",[6388],{"type":728,"textContent":2828},{"type":728,"textContent":6390},"]  Dierks, T. and E. Rescorla, \"The Transport Layer Security\n              (TLS) Protocol Version 1.2\", ",{"type":723,"nodeName":731,"attributes":6392,"children":6393},{"href":2825},[6394],{"type":728,"textContent":6395},"RFC 5246",{"type":728,"textContent":6397},", August 2008.\n\n   [",{"type":723,"nodeName":731,"attributes":6399,"children":6401},{"id":6400},"ref-RFC6125",[6402],{"type":728,"textContent":5531},{"type":728,"textContent":6404},"]  Saint-Andre, P. and J. Hodges, \"Representation and\n              Verification of Domain-Based Application Service Identity\n              within Internet Public Key Infrastructure Using X.509\n              (PKIX) Certificates in the Context of Transport Layer\n              Security (TLS)\", ",{"type":723,"nodeName":731,"attributes":6406,"children":6407},{"href":5528},[6408],{"type":728,"textContent":6409},"RFC 6125",{"type":728,"textContent":6411},", March 2011.\n\n   [",{"type":723,"nodeName":731,"attributes":6413,"children":6415},{"id":6414},"ref-USASCII",[6416],{"type":728,"textContent":3803},{"type":728,"textContent":6418},"]  American National Standards Institute, \"Coded Character\n              Set -- 7-bit American Standard Code for Information\n              Interchange\", ANSI X3.4, 1986.\n\n   [",{"type":723,"nodeName":731,"attributes":6420,"children":6422},{"id":6421},"ref-W3C.REC-html401-19991224",[6423],{"type":728,"textContent":6424},"W3C.REC-html401-19991224",{"type":728,"textContent":6426},"]\n              Raggett, D., Le Hors, A., and I. Jacobs, \"HTML 4.01\n              Specification\", World Wide Web Consortium\n              Recommendation REC-html401-19991224, December 1999,\n              \u003C",{"type":723,"nodeName":731,"attributes":6428,"children":6430},{"href":6429},"http:\u002F\u002Fwww.w3.org\u002FTR\u002F1999\u002FREC-html401-19991224",[6431],{"type":728,"textContent":6429},{"type":728,"textContent":6433},">.\n\n   [",{"type":723,"nodeName":731,"attributes":6435,"children":6437},{"id":6436},"ref-W3C.REC-xml-20081126",[6438],{"type":728,"textContent":6439},"W3C.REC-xml-20081126",{"type":728,"textContent":6441},"]\n              Bray, T., Paoli, J., Sperberg-McQueen, C., Maler, E.,\n              and F. Yergeau, \"Extensible Markup Language (XML) 1.0\n              (Fifth Edition)\", World Wide Web Consortium\n               Recommendation REC-xml-20081126, November 2008,\n              \u003C",{"type":723,"nodeName":731,"attributes":6443,"children":6445},{"href":6444},"http:\u002F\u002Fwww.w3.org\u002FTR\u002F2008\u002FREC-xml-20081126",[6446],{"type":728,"textContent":6444},{"type":728,"textContent":6448},">.\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":6450,"children":6451},{"class":787},[6452],{"type":728,"textContent":6453},"Hardt                        Standards Track                   [Page 69]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":6456,"children":6457},{"class":796},[],{"type":723,"nodeName":724,"attributes":6459,"children":6460},{"class":800},[6461,6465,6466,6474,6475,6484,6485,6490,6492,6497,6499,6504,6506,6512,6514,6519,6521,6525,6527,6532,6534,6539,6541],{"type":723,"nodeName":740,"attributes":6462,"children":6464},{"id":6463},"page-70",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":6467,"children":6468},{"class":787},[6469,6473],{"type":723,"nodeName":731,"attributes":6470,"children":6471},{"href":812},[6472],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":6476,"children":6477},{"class":2512},[6478,6482],{"type":723,"nodeName":731,"attributes":6479,"children":6480},{"class":2434,"id":612,"href":2103},[6481],{"type":728,"textContent":2106},{"type":728,"textContent":6483},".  Informative References",{"type":728,"textContent":6185},{"type":723,"nodeName":731,"attributes":6486,"children":6488},{"id":6487},"ref-OAuth-HTTP-MAC",[6489],{"type":728,"textContent":4961},{"type":728,"textContent":6491},"]\n              Hammer-Lahav, E., Ed., \"HTTP Authentication: MAC Access\n              Authentication\", Work in Progress, February 2012.\n\n   [",{"type":723,"nodeName":731,"attributes":6493,"children":6495},{"id":6494},"ref-OAuth-SAML2",[6496],{"type":728,"textContent":4606},{"type":728,"textContent":6498},"]\n              Campbell, B. and C. Mortimore, \"SAML 2.0 Bearer Assertion\n              Profiles for OAuth 2.0\", Work in Progress, September 2012.\n\n   [",{"type":723,"nodeName":731,"attributes":6500,"children":6502},{"id":6501},"ref-OAuth-THREATMODEL",[6503],{"type":728,"textContent":5263},{"type":728,"textContent":6505},"]\n              Lodderstedt, T., Ed., McGloin, M., and P. Hunt, \"OAuth 2.0\n              Threat Model and Security Considerations\", Work\n              in Progress, October 2012.\n\n   [",{"type":723,"nodeName":731,"attributes":6507,"children":6509},{"id":6508},"ref-OAuth-WRAP",[6510],{"type":728,"textContent":6511},"OAuth-WRAP",{"type":728,"textContent":6513},"]\n              Hardt, D., Ed., Tom, A., Eaton, B., and Y. Goland, \"OAuth\n              Web Resource Authorization Profiles\", Work in Progress,\n              January 2010.\n\n   [",{"type":723,"nodeName":731,"attributes":6515,"children":6517},{"id":6516},"ref-RFC5849",[6518],{"type":728,"textContent":2480},{"type":728,"textContent":6520},"]  Hammer-Lahav, E., \"The OAuth 1.0 Protocol\", ",{"type":723,"nodeName":731,"attributes":6522,"children":6523},{"href":733},[6524],{"type":728,"textContent":751},{"type":728,"textContent":6526},",\n              April 2010.\n\n   [",{"type":723,"nodeName":731,"attributes":6528,"children":6530},{"id":6529},"ref-RFC6750",[6531],{"type":728,"textContent":2738},{"type":728,"textContent":6533},"]  Jones, M. and D. Hardt, \"The OAuth 2.0 Authorization\n              Framework: Bearer Token Usage\", ",{"type":723,"nodeName":731,"attributes":6535,"children":6536},{"href":2735},[6537],{"type":728,"textContent":6538},"RFC 6750",{"type":728,"textContent":6540},", October 2012.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":740,"attributes":6542,"children":6543},{"class":787},[6544],{"type":728,"textContent":6545},"Hardt                        Standards Track                   [Page 70]",{"type":728,"textContent":792},{"type":723,"nodeName":794,"attributes":6548,"children":6549},{"class":796},[],{"type":723,"nodeName":724,"attributes":6551,"children":6552},{"class":800},[6553,6557,6558,6566,6567,6576,6578,6582,6584,6589,6591,6595,6597,6601,6603,6612,6614,6619,6621,6630,6632,6636,6638,6647,6649,6653,6654,6658,6660],{"type":723,"nodeName":740,"attributes":6554,"children":6556},{"id":6555},"page-71",[],{"type":728,"textContent":792},{"type":723,"nodeName":740,"attributes":6559,"children":6560},{"class":787},[6561,6565],{"type":723,"nodeName":731,"attributes":6562,"children":6563},{"href":812},[6564],{"type":728,"textContent":815},{"type":728,"textContent":817},{"type":728,"textContent":2509},{"type":723,"nodeName":740,"attributes":6568,"children":6569},{"class":2430},[6570,6574],{"type":723,"nodeName":731,"attributes":6571,"children":6572},{"class":2434,"id":617,"href":2145},[6573],{"type":728,"textContent":2148},{"type":728,"textContent":6575},".  Augmented Backus-Naur Form (ABNF) Syntax",{"type":728,"textContent":6577},"\n\n   This section provides Augmented Backus-Naur Form (ABNF) syntax\n   descriptions for the elements defined in this specification using the\n   notation of [",{"type":723,"nodeName":731,"attributes":6579,"children":6580},{"href":2909},[6581],{"type":728,"textContent":2912},{"type":728,"textContent":6583},"].  The ABNF below is defined in terms of Unicode\n   code points [",{"type":723,"nodeName":731,"attributes":6585,"children":6587},{"href":6586},"#ref-W3C.REC-xml-20081126",[6588],{"type":728,"textContent":6439},{"type":728,"textContent":6590},"]; these characters are typically\n   encoded in UTF-8.  Elements are presented in the order first defined.\n\n   Some of the definitions that follow use the \"URI-reference\"\n   definition from [",{"type":723,"nodeName":731,"attributes":6592,"children":6593},{"href":2917},[6594],{"type":728,"textContent":2920},{"type":728,"textContent":6596},"].\n\n   Some of the definitions that follow use these common definitions:\n\n     VSCHAR     = %x20-7E\n     NQCHAR     = %x21 \u002F %x23-5B \u002F %x5D-7E\n     NQSCHAR    = %x20-21 \u002F %x23-5B \u002F %x5D-7E\n     UNICODECHARNOCRLF = %x09 \u002F%x20-7E \u002F %x80-D7FF \u002F\n                         %xE000-FFFD \u002F %x10000-10FFFF\n\n   (The UNICODECHARNOCRLF definition is based upon the Char definition\n   in Section 2.2 of [",{"type":723,"nodeName":731,"attributes":6598,"children":6599},{"href":6586},[6600],{"type":728,"textContent":6439},{"type":728,"textContent":6602},"], but omitting the Carriage\n   Return and Linefeed characters.)\n\n",{"type":723,"nodeName":740,"attributes":6604,"children":6605},{"class":2512},[6606,6610],{"type":723,"nodeName":731,"attributes":6607,"children":6608},{"class":2434,"id":623,"href":2161},[6609],{"type":728,"textContent":2164},{"type":728,"textContent":6611},".  \"client_id\" Syntax",{"type":728,"textContent":6613},"\n\n   The \"client_id\" element is defined in ",{"type":723,"nodeName":731,"attributes":6615,"children":6616},{"href":1081},[6617],{"type":728,"textContent":6618},"Section 2.3.1",{"type":728,"textContent":6620},":\n\n     client-id     = *VSCHAR\n\n",{"type":723,"nodeName":740,"attributes":6622,"children":6623},{"class":2512},[6624,6628],{"type":723,"nodeName":731,"attributes":6625,"children":6626},{"class":2434,"id":628,"href":2174},[6627],{"type":728,"textContent":2177},{"type":728,"textContent":6629},".  \"client_secret\" Syntax",{"type":728,"textContent":6631},"\n\n   The \"client_secret\" element is defined in ",{"type":723,"nodeName":731,"attributes":6633,"children":6634},{"href":1081},[6635],{"type":728,"textContent":6618},{"type":728,"textContent":6637},":\n\n     client-secret = *VSCHAR\n\n",{"type":723,"nodeName":740,"attributes":6639,"children":6640},{"class":2512},[6641,6645],{"type":723,"nodeName":731,"attributes":6642,"children":6643},{"class":2434,"id":633,"href":2187},[6644],{"type":728,"textContent":2190},{"type":728,"textContent":6646},".  \"response_type\" Syntax",{"type":728,"textContent":6648},"\n\n   The \"response_type\" element is defined in Sections ",{"type":723,"nodeName":731,"attributes":6650,"children":6651},{"href":1150},[6652],{"type":728,"textContent":1153},{"type":728,"textContent":2665},{"type":723,"nodeName":731,"attributes":6655,"children":6656},{"href":1656},[6657],{"type":728,"textContent":1659},{"type":728,"textContent":6659},":\n\n     response-type = response-name *( SP response-name )\n     response-name = 1*response-char\n     response-char = \"_\" \u002F DIGIT \u002F ALPHA\n\n\n\n\n\n\n\n\n\n",{"type":723,"nodeName":