0,"path":812,"pinia":7401},["ShallowReactive",3],{"info-buckethtmldocument-rfc6749":4},{"rfc":5,"tableOfContents":91,"documentHtmlType":720,"documentHtmlObj":721,"maxPreformattedLineLength":7189,"errataList":7191,"timestampIso":7392},{"number":6,"title":7,"published":8,"area":9,"pages":12,"status":13,"subseries":16,"authors":17,"group":26,"stream":31,"identifiers":34,"obsoletes":38,"obsoleted_by":43,"updates":44,"updated_by":45,"keywords":58,"formats":75,"abstract":82,"reefStats":83,"reefSubjectTags":88},6749,"The OAuth 2.0 Authorization Framework","2012-10-13",{"acronym":10,"name":11},"sec","Security Area",76,{"slug":14,"name":15},"ps","proposed standard",[],[18],{"titlepage_name":19,"is_editor":20,"person":21,"email":22,"affiliation":23,"country":24,"datatracker_person_path":25},"D. Hardt",true,110961,"dick.hardt@gmail.com","Microsoft","","\u002Fperson\u002FDick%20Hardt",{"acronym":27,"name":28,"state":29,"type":30},"oauth","Web Authorization Protocol","active","wg",{"slug":32,"name":32,"description":33},"IETF","Internet Engineering Task Force (IETF)",[35],{"type":36,"value":37},"doi","10.17487\u002FRFC6749",[39],{"id":40,"number":41,"title":42},127720,5849,"The OAuth 1.0 Protocol",[],[],[46,50,54],{"id":47,"number":48,"title":49},130071,8252,"OAuth 2.0 for Native Apps",{"id":51,"number":52,"title":53},130798,8996,"Deprecating TLS 1.0 and TLS 1.1",{"id":55,"number":56,"title":57},142818,9700,"Best Current Practice for OAuth 2.0 Security",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74],"Client","Resource Owner","Authorization Server","Resource Server","Token Endpoint","Authorization Endpoint","Authorization Request","Authorization Grant","Protected Resource","Access Token","Refresh Token","Authorization Code","Implicit Grant","Client Identifier","Access Token Scope","Delegation",[76,78,80],{"format":77},"txt",{"format":79},"html",{"format":81},"json","The OAuth 2.0 authorization framework enables a third-party application to obtain limited access to an HTTP service, either on behalf of a resource owner by orchestrating an approval interaction between the resource owner and the HTTP service, or by allowing the third-party application to obtain access on its own behalf.  This specification replaces and obsoletes the OAuth 1.0 protocol described in RFC 5849. [STANDARDS-TRACK]",{"ratingAggregate":84,"subscriberCount":86,"setCount":87},{"count":85},0,9,10,[89],{"slug":27,"title":90},"OAuth",{"title":92,"sections":93},"Table of contents",[94,166,203,267,374,390,395,411,442,447,538,598,614,710,715],{"links":95,"sections":99},[96],{"id":97,"title":98},"section-1","1.  Introduction",[100,105,110,136,141,146,151,156,161],{"links":101},[102],{"id":103,"title":104},"section-1.1","1.1.  Roles",{"links":106},[107],{"id":108,"title":109},"section-1.2","1.2.  Protocol Flow",{"links":111,"sections":115},[112],{"id":113,"title":114},"section-1.3","1.3.  Authorization Grant",[116,121,126,131],{"links":117},[118],{"id":119,"title":120},"section-1.3.1","1.3.1.  Authorization Code",{"links":122},[123],{"id":124,"title":125},"section-1.3.2","1.3.2.  Implicit",{"links":127},[128],{"id":129,"title":130},"section-1.3.3","1.3.3.  Resource Owner Password Credentials",{"links":132},[133],{"id":134,"title":135},"section-1.3.4","1.3.4.  Client Credentials",{"links":137},[138],{"id":139,"title":140},"section-1.4","1.4.  Access Token",{"links":142},[143],{"id":144,"title":145},"section-1.5","1.5.  Refresh Token",{"links":147},[148],{"id":149,"title":150},"section-1.6","1.6.  TLS Version",{"links":152},[153],{"id":154,"title":155},"section-1.7","1.7.  HTTP Redirections",{"links":157},[158],{"id":159,"title":160},"section-1.8","1.8.  Interoperability",{"links":162},[163],{"id":164,"title":165},"section-1.9","1.9.  Notational Conventions",{"links":167,"sections":171},[168],{"id":169,"title":170},"section-2","2.  Client Registration",[172,177,182,198],{"links":173},[174],{"id":175,"title":176},"section-2.1","2.1.  Client Types",{"links":178},[179],{"id":180,"t