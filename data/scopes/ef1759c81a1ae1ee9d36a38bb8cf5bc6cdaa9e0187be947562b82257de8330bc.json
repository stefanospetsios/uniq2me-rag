        "byteDigest": "sha256:6a0c6c6263855737e371ab7580b7cdb84feb81ceda1cb5e72dea8f5f2fba5a33",
        "textDigest": "sha256:fbe949828eb71ebc07f1e897cdb25ec6daecc04698b26a76e2044e7878de8b6d",
        "finalUrl": "https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/9/pdf/configuring_firewalls_and_packet_filters/red_hat_enterprise_linux-9-configuring_firewalls_and_packet_filters-en-us.pdf",
        "retrievedAt": "2026-10-15T21:24:50Z",
        "contentType": "application/pdf",
        "snapshotPath": "source-6a0c6c6263855737e371ab7580b7cdb84feb81ceda1cb5e72dea8f5f2fba5a33.bin",
        "textPath": "source-fbe949828eb71ebc07f1e897cdb25ec6daecc04698b26a76e2044e7878de8b6d.txt",
        "sourceStatus": "fetched-and-passage-checked",
        "passages": [
          {
            "id": "p1",
            "locator": "article/heading/page",
            "text": "firewalld uses the concepts of zones, policies, and services to simplify traffic management. Zones logically separate a network. Network interfaces and sources can be assigned to a zone. Policies are used to deny or allow traffic flowing between zones."
          },
          {
            "id": "p2",
            "locator": "article/heading/page",
            "text": "          4. Intrazone traffic (within the same zone) is allowed by default.\n\n           5. Interzone traffic (from zone to zone) is denied by default."
          }
        ],
        "quotationMatchPolicy": "unicode-typography-v1",
        "typographyNormalizedPassages": []
      }
