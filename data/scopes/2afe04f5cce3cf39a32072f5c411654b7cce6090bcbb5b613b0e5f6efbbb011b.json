        ]
      },
      {
        "id": "6-concern-2",
        "sfsId": "6",
        "description": "ICT-related incidents must be classified using specified criteria to distinguish ordinary incidents, major ICT-related incidents, and significant cyber threats pursuant to regulatory technical standards",
        "sourceRefs": [
          {
            "sourceId": "6-source-2",
            "passageId": "p1"
          }
        ]
      },
