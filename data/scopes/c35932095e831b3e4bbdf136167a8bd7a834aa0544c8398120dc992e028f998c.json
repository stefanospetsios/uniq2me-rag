        "sourceStatus": "fetched-and-passage-checked",
        "passages": [
          {
            "id": "p1",
            "locator": "Section 2.2 Overview",
            "text": "The PSOC™ 64 Secure Boot MCU line, based on the PSOC™ 6 MCU platform, features out-of-box security functionality. This line provides an isolated Root of Trust (RoT) with true attestation and provisioning services"
          },
          {
            "id": "p2",
            "locator": "Section 2.3.1",
            "text": "The PSOC™ 64 Secure Boot MCU now uses the OEM RoT public key as the root key to validate any OEM asset (for example, image keys, policies, etc.)"
          }
        ],
        "quotationMatchPolicy": "unicode-typography-v1",
        "typographyNormalizedPassages": []
      },
