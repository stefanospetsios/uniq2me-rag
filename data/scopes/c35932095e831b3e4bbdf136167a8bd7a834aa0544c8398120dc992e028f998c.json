        "passages": [
          {
            "id": "p1",
            "locator": "Overview Section",
            "text": "STM32Trust provides developers with a robust, multilevel strategy to enhance security in their new product designs. With a set of 12 security functions offering hardware, software, and design services from ST and third parties"
          },
          {
            "id": "p2",
            "locator": "Security Functions",
            "text": "1. Secure boot\n\n\n \n Ability to ensure the authenticity and integrity of an application that runs inside a device."
          }
        ],
