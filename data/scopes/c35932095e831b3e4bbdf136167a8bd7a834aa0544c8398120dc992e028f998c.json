        "sourceStatus": "fetched-and-passage-checked",
        "passages": [
          {
            "id": "p1",
            "locator": "Guideline 8.1",
            "text": "It shall be made clear which services are running over both logical and external physical interfaces, and whether the user or organisation can disable those services"
          },
          {
            "id": "p2",
            "locator": "Guideline 8.4",
            "text": "The manufacturer shall state which mitigations against interface misuse are available"
          },
          {
            "id": "p3",
            "locator": "Guideline 8.4 Example",
            "text": "A device is left unattended and an attacker takes the opportunity to physically attack the device to gain access. The device is using an IOMMU which prevents an unsophisticated actor from successfully conducting a Direct Memory Access attack"
          }
        ],
        "quotationMatchPolicy": "unicode-typography-v1",
        "typographyNormalizedPassages": []
      },
      "B-source-3": {
