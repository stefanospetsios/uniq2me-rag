        "type": "technical-doc",
        "title": "Device security principles for manufacturers: Constrain the use of all device interfaces",
        "publisher": "National Cyber Security Centre (NCSC)",
        "url": "https://www.ncsc.gov.uk/collection/device-security-principles-for-manufacturers/constrain-the-use-of-all-device-interfaces",
        "language": "en",
        "jurisdiction": "United Kingdom",
        "applicability": "Provides authoritative guidelines for manufacturers on securing device interfaces, including explicit requirements for disabling unnecessary services, mitigating interface misuse, and managing physical and logical interfaces to prevent unauthorized access and exfiltration",
        "publicationDate": null,
        "effectiveDate": null,
        "redistribution": "metadata-and-short-passages",
