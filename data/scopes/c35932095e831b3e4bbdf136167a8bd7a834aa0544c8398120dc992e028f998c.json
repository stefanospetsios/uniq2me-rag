        "finalUrl": "https://www.ncsc.gov.uk/collection/device-security-principles-for-manufacturers/constrain-the-use-of-all-device-interfaces",
        "retrievedAt": "2026-10-15T22:01:59Z",
        "contentType": "text/html; charset=UTF-8",
        "snapshotPath": "source-4419bbe40fdb7a502f52756a6cd4f45f1c416393c49e66a2cfe0668ccbbdcec4.bin",
